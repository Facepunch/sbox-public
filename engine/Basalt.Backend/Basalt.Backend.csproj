<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Basalt's GpuDevice and GpuContext on Basalt.Gpu: what lets an unmodified RenderSystem render through Basalt's own
    Vulkan device instead of Source 2's. The first, small form of the renderer services that sit between Basalt and its
    RHI. See docs/managed/basalt-gpu.md.
  -->

  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Basalt.Backend</AssemblyName>
    <PackageId>Basalt.Backend</PackageId>
    <OutputPath>..\..\game\bin\managed</OutputPath>
    <!-- Keep CS1591 enabled for public API documentation. -->
    <NoWarn>1701;1702</NoWarn>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Basalt\Basalt.csproj" Private="false" />
    <ProjectReference Include="..\Basalt.Gpu\Basalt.Gpu.csproj" Private="false" />
    <ProjectReference Include="..\Basalt.Source2\Basalt.Source2.csproj" Private="false" />
    <ProjectReference Include="..\Sandbox.System\Sandbox.System.csproj" Private="false" />
  </ItemGroup>

</Project>
