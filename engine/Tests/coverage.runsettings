<?xml version="1.0" encoding="utf-8"?>
<!--
	Pass this file via the "settings" option when collecting coverage with the
	"XPlat Code Coverage" collector.
-->
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<!-- Assemblies to leave out of instrumentation, for example: -->
					<!-- <Exclude>[Sandbox.Test.Example]*</Exclude> -->
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
