<?xml version="1.0" encoding="utf-8"?>
<!-- Layout conformance fixtures from Taffy (https://github.com/DioxusLabs/taffy), MIT licensed. Generated from Chrome. Group: blockgrid -->
<tests group="blockgrid">
<test name="blockgrid_block_in_grid_auto__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" grid-template-columns="auto">
      <text display="block" direction="ltr">
        HH​HH
      </text>
      <div display="block" direction="ltr"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="10" resolved-rows="10px 0px" resolved-columns="40px">
      <node x="0" y="0" width="40" height="10"/>
      <node x="0" y="10" width="40" height="0"/>
    </node>
  </expectations>
</test>
