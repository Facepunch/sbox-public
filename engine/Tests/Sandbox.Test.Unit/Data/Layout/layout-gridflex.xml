<tests group="gridflex">
<test name="gridflex_column_integration__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" flex-direction="column">
      <div display="grid" direction="ltr" grid-template-rows="1fr 1fr" grid-template-columns="1fr 1fr">
        <text direction="ltr">
          HH
        </text>
        <text direction="ltr">
          HH
        </text>
        <text direction="ltr">
          HH
        </text>
        <text direction="ltr">
          HH
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="20">
      <node x="0" y="0" width="40" height="20" resolved-rows="10px 10px" resolved-columns="20px 20px">
        <node x="0" y="0" width="20" height="10"/>
        <node x="20" y="0" width="20" height="10"/>
        <node x="0" y="10" width="20" height="10"/>
        <node x="20" y="10" width="20" height="10"/>
      </node>
    </node>
  </expectations>
</test>
