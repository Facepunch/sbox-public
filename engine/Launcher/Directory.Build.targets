<Project>
	<!-- StageLinuxRuntime ships this ICU version beside CoreCLR, in the host's native search path.
	     The Steam runtime need not provide ICU. Keep in sync with SboxBuild's ICU package reference. -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
	</ItemGroup>

	<PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
		<NoWarn>$(NoWarn);IL3000</NoWarn>
		<_SuppressSingleFileAnalysisWarnings>true</_SuppressSingleFileAnalysisWarnings>
	</PropertyGroup>

	<!-- The engine remains in game/bin/managed. A framework-dependent launcher bundle carries
	     only itself and its runtime config, avoiding loose files without embedding .NET or engine code.

	     AppHostForPublishIntermediatePath is the host when AppHostRelativeDotNet is set, which the
	     Linux build does so the launchers find game/bin/dotnet. It has to survive the filter or the
	     bundler is handed no host and fails with "Must specify the host binary". -->
	<Target Name="FilterLauncherSingleFilePublish"
		AfterTargets="ComputeResolvedFilesToPublishList;_ComputeFilesToBundle"
		Condition="'$(PublishSingleFile)' == 'true' and '$(GenerateDependencyFile)' == 'false'">
		<ItemGroup>
			<LauncherRuntimeAsset Include="@(RuntimePackAsset)" />
			<LauncherExternalAsset Include="@(ResolvedFileToPublish)"
				Exclude="@(LauncherRuntimeAsset);@(IntermediateAssembly);$(ProjectRuntimeConfigFilePath);$(AppHostIntermediatePath);$(SingleFileHostIntermediatePath);$(AppHostForPublishIntermediatePath)" />
			<ResolvedFileToPublish Remove="@(LauncherExternalAsset)" />
			<FilesToBundle Remove="@(LauncherExternalAsset)" />
		</ItemGroup>
	</Target>
</Project>
