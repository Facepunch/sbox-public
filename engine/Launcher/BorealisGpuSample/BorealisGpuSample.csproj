<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Borealis.Gpu's sample: a Borealis.Sdl window rendering a clear, a triangle, textured meshes with depth and a compute
		dispatch, and Borealis's renderer on top. Needs nothing of the engine. See docs/managed/borealis-gpu.md.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>borealisgpusample</AssemblyName>
		<RootNamespace>BorealisGpuSample</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>../../../game/bin/managed/</OutputPath>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591</NoWarn>
		<LangVersion>14</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Borealis.Gpu\Borealis.Gpu.csproj" />
		<ProjectReference Include="..\..\Borealis.Sdl\Borealis.Sdl.csproj" />
		<ProjectReference Include="..\..\Borealis.Backend\Borealis.Backend.csproj" />
		<ProjectReference Include="..\..\Borealis\Borealis.csproj" />
		<ProjectReference Include="..\..\Sandbox.System\Sandbox.System.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- WithCulture: "mesh.ps.spv" would otherwise be taken for a Pashto satellite resource -->
		<EmbeddedResource Include="Shaders\*.spv" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>

</Project>
