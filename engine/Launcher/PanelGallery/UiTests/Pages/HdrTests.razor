@namespace PanelGallery.UiTests
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Group( "Effects" )]
@attribute [Title( "color: HDR" )]
@attribute [Description( "colour * n on everything that takes a colour" )]
@attribute [Icon( "flare" )]

<root>

    <h2>Backgrounds</h2>

    <div class="cases">
        <UiTestCase Caption="SDR reference" class="dark" Setup="@Square" Css="background-color: #4a9eff" Note="The SDR reference for the row." />
        <UiTestCase Caption="2x brightness" class="dark" Setup="@Square" Css="background-color: #4a9eff * 2" />
        <UiTestCase Caption="8x brightness" class="dark" Setup="@Square" Css="background-color: #4a9eff * 8" />
        <UiTestCase Caption="rgba( 74, 158, 255, 0.5 ) * 8" class="dark" Setup="@Square" Css="background-color: rgba( 74, 158, 255, 0.5 ) * 8"
                    Note="Half transparent and HDR. It must still glow - alpha is not coverage." />
        <UiTestCase Caption="0.5" class="dark" Setup="@Square" Css="background-color: #4a9eff * 8; opacity: 0.5"
                    Note="Same again through opacity rather than the colour's alpha." />
        <UiTestCase Caption="white * 4" class="dark" Setup="@Square" Css="background-color: white * 4" />
    </div>

    <h2>Edges</h2>

    <p>
        The interesting part. 30% coverage of a 4.0 colour lands at 1.2, so an HDR fill can make its
        own antialiased edge read as solid - corners fatten and curves turn into steps. Compare each
        against the SDR case beside it.
    </p>

    <div class="cases">
        <UiTestCase Caption="24px" class="dark" Setup="@Square" Css="background-color: #4a9eff; border-radius: 24px" />
        <UiTestCase Caption="24px" class="dark" Setup="@Square" Css="background-color: #4a9eff * 8; border-radius: 24px"
                    Note="The corner must keep the same shape and softness as the SDR one." />
        <UiTestCase Caption="50%" class="dark" Setup="@Square" Css="background-color: #4a9eff * 8; border-radius: 50%"
                    Note="A full circle is the worst case - the whole outline is a ramp." />
        <UiTestCase Caption="4px" class="dark" Setup="@Small" Css="background-color: #4a9eff * 8; border-radius: 4px"
                    Note="Small and bright, where a fattened edge swallows the shape." />
        <UiTestCase Caption="rotate( 8deg )" class="dark roomy" Setup="@Square" Css="background-color: #4a9eff * 8; border-radius: 24px; transform: rotate( 8deg )" />
    </div>

    <h2>Borders</h2>

    <div class="cases">
        <UiTestCase Caption="2px solid #4ac2e8 * 6" class="dark" Setup="@BoxDim" Css="border: 2px solid #4ac2e8 * 6" Note="A thin HDR border is a two pixel wide ramp - it mustn't bloat." />
        <UiTestCase Caption="20px" class="dark" Setup="@BoxDim" Css="border: 6px solid #4ac2e8 * 6; border-radius: 20px" />
        <UiTestCase Caption="20px" class="dark" Setup="@BoxDim" Css="border: 1px solid #ffffff * 10; border-radius: 20px" Note="One pixel, very bright." />
        <UiTestCase Caption="20px" class="dark" Setup="@BoxDim" Css="border-left: 6px solid #e84a4a * 6; border-top: 6px solid #4ae86e * 6; border-radius: 20px"
                    Note="Two HDR colours meeting at a mitre." />
        <UiTestCase Caption="20px" class="dark" Setup="@BoxDim" Css="border: 4px solid rgba( 74, 194, 232, 0.5 ) * 6; border-radius: 20px"
                    Note="Translucent HDR border over the fill behind it." />
        <UiTestCase Caption="4px" class="dark roomy" Setup="@BoxDim" Css="outline: 3px solid #4ac2e8 * 6; outline-offset: 4px" />
    </div>

    <h2>Shadows and glows</h2>

    <div class="cases">
        <UiTestCase Caption="20px" class="dark roomy" Setup="@Square" Css="box-shadow: 0 0 20px #4a9eff * 6; border-radius: 20px"
                    Note="A blurred shadow is mostly low alpha, so this is the case that proves alpha isn't treated as coverage." />
        <UiTestCase Caption="20px" class="dark roomy" Setup="@Square" Css="box-shadow: 0 0 0 6px #4a9eff * 6; border-radius: 20px"
                    Note="Hard spread ring, HDR." />
        <UiTestCase Caption="20px" class="dark roomy" Setup="@Square" Css="box-shadow: inset 0 0 20px #4a9eff * 6; border-radius: 20px" />
        <UiTestCase Caption="20px" class="dark roomy" Setup="@BoxDim" Css="filter: drop-shadow( 0 0 10px #4a9eff * 6 ); border-radius: 20px"
                    Note="drop-shadow goes through a panel layer, which is 8 bit - so this one can't stay HDR. Worth knowing." />
    </div>

    <h2>Text</h2>

    <div class="cases">
        <UiTestCase Caption="#ffffff" class="dark" Setup="@Text" Css="color: #ffffff" Text="@Sample" Note="SDR reference." />
        <UiTestCase Caption="#ffffff * 4" class="dark" Setup="@Text" Css="color: #ffffff * 4" Text="@Sample"
                    Note="Glyph edges are nearly all partial coverage, so this is the strictest edge test on the page." />
        <UiTestCase Caption="#4ac2e8 * 6" class="dark" Setup="@Text" Css="color: #4ac2e8 * 6" Text="@Sample" />
        <UiTestCase Caption="32px" class="dark" Setup="@Text" Css="color: #ffffff * 4; font-size: 32px" Text="@Sample" Note="Bigger glyphs, less of the area is edge." />
        <UiTestCase Caption="9px" class="dark" Setup="@Text" Css="color: #ffffff * 4; font-size: 9px" Text="@Sample" Note="Small enough that it's almost all edge." />


        <UiTestCase Caption="Linear gradient / to right" class="dark" Setup="@Text" Css="color: linear-gradient( to right, #ffffff, #4a9eff * 8 )" Text="@Sample" />
    </div>

    <h2>Gradients</h2>

    <div class="cases">
        <UiTestCase Caption="Linear gradient / to right" class="dark" Setup="@Wide" Css="background-image: linear-gradient( to right, #000000, #ffffff * 4 )"
                    Note="Where the ramp crosses 1 is where bloom starts." />
        <UiTestCase Caption="Radial gradient" class="dark" Setup="@Wide" Css="background-image: radial-gradient( circle, #4a9eff * 8, rgba( 74, 158, 255, 0 ) )"
                    Note="HDR core fading to nothing - the falloff must stay smooth all the way out." />
        <UiTestCase Caption="24px" class="dark" Setup="@Wide" Css="background-image: linear-gradient( to right, #000000, #ffffff * 4 ); border-radius: 24px" />
        <UiTestCase Caption="50%" class="dark" Setup="@Wide" Css="background-image: conic-gradient( #4a9eff * 8, #000000, #4a9eff * 8 ); border-radius: 50%" />
    </div>

    <h2>Parsing</h2>

    <div class="cases">
        <UiTestCase Caption="rgba( white * 4, 0.5 )" class="dark" Setup="@Square" Css="background-color: rgba( white * 4, 0.5 )" Note="The multiplier inside an rgba()." />
        <UiTestCase Caption="#f00 * 2" class="dark" Setup="@Square" Css="background-color: #f00 * 2" Note="Short hex with a multiplier." />
        <UiTestCase Caption="red * 0" class="dark" Setup="@Square" Css="background-color: red * 0" Note="Times zero is black, not broken." />
        <UiTestCase Caption="red * 1" class="dark" Setup="@Square" Css="background-color: red * 1" Note="Times one is the plain colour." />
    </div>

</root>

@code
{
    const string Square = "width: 200px; height: 200px";
    const string Small = "width: 30px; height: 30px";
    const string Wide = "width: 200px; height: 200px";

    const string BoxDim = "width: 200px; height: 200px; background-color: #1b2b3b";

    const string Text = "width: 200px; font-size: 16px";
    const string Sample = "Sphinx of black quartz";
}
