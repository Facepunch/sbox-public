@using Sandbox.PanelGallery;
@namespace PanelGallery.UiTests
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Group( "Borders" )]
@attribute [Title( "border-radius" )]
@attribute [Description( "border-radius - shorthands, ellipses, borders, clipping, shadows" )]
@attribute [Icon( "rounded_corner" )]

<root>

    <h2>Shorthand</h2>

    <div class="cases">
        <UiTestCase Caption="8px" Css="border-radius: 8px" />
        <UiTestCase Caption="0" Css="border-radius: 0" />
        <UiTestCase Caption="20px 0" Css="border-radius: 20px 0" Note="Two values are TL/BR then TR/BL." />
        <UiTestCase Caption="20px 0 40px" Css="border-radius: 20px 0 40px" Note="Three values are TL, TR/BL, BR." />
        <UiTestCase Caption="10px 20px 30px 40px" Css="border-radius: 10px 20px 30px 40px" Note="Four go clockwise from top-left." />
        <UiTestCase Caption="30px 30px 0 0" Setup="@Short" Css="border-radius: 30px 30px 0 0" Note="On a 100x40 box the web keeps all 30px - it doesn't scale them down." />
        <UiTestCase Caption="100px" Setup="@Short" Css="border-radius: 100px" Note="A radius past half the height clamps to a pill." />
        <UiTestCase Caption="50px 0 0 0" Setup="@Half" Css="border-radius: 50px 0 0 0" Note="One corner taking the whole height." />
        <UiTestCase Caption="60px 60px 0 0" Css="border-radius: 60px 60px 0 0" Note="Adjacent radii that overflow the side scale together, keeping their ratio." />
        <UiTestCase Caption="100% 0" Setup="@Wide" Css="border-radius: 100% 0" Note="Opposite corners can each take the whole box - the web draws a lens." />
    </div>

    <h2>Percentages and ellipses</h2>

    <div class="cases">
        <UiTestCase Caption="50%" Setup="@Wide" Css="border-radius: 50%" Note="On 200x100 this is a full ellipse, not a circle: x resolves against width, y against height." />
        <UiTestCase Caption="50%" Css="border-radius: 50%" Note="Square, so it's a circle." />
        <UiTestCase Caption="10%" Setup="@Wide" Css="border-radius: 10%" Note="20x10 ellipses." />
        <UiTestCase Caption="40px 20px / 20px 40px" Setup="@Wide" Css="border-radius: 40px 20px / 20px 40px" Note="Horizontal radii before the slash, vertical after." />
        <UiTestCase Caption="50px 20px" Css="border-top-left-radius: 50px 20px" Note="Longhand takes two values the same way." />
        <UiTestCase Caption="50% / 20px" Setup="@Wide" Css="border-radius: 50% / 20px" />
    </div>

    <h2>With borders</h2>

    <div class="cases">
        <UiTestCase Caption="2px solid Cyan" Css="@($"border-radius: 20px; border: 2px solid {GalleryPalette.CyanHex}")" Note="The inner edge keeps a 18px radius - the border width comes off it." />
        <UiTestCase Caption="10px solid Cyan" Css="@($"border-radius: 20px; border: 10px solid {GalleryPalette.CyanHex}")" />
        <UiTestCase Caption="25px solid Cyan" Css="@($"border-radius: 20px; border: 25px solid {GalleryPalette.CyanHex}")" Note="Border thicker than the radius: the inner corner is square." />
        <UiTestCase Caption="10px solid Pink" Css="@($"border-radius: 20px; border-left: 10px solid {GalleryPalette.PinkHex}; border-top: 2px solid {GalleryPalette.LimeHex}; border-right: 2px solid {GalleryPalette.CyanHex}; border-bottom: 10px solid {GalleryPalette.PinkHex}")"
                    Note="Where two colours meet the join is a straight line, mitred at the corner." />
        <UiTestCase Caption="2px solid Lime" Css="@($"border-left: 10px solid {GalleryPalette.PinkHex}; border-top: 2px solid {GalleryPalette.LimeHex}")"
                    Note="No radius, uneven widths - the join line's slope follows the widths." />
        <UiTestCase Caption="3px solid Cyan" Css="@($"border-radius: 20px; border-bottom: 3px solid {GalleryPalette.CyanHex}")" Note="One side only still follows the corner." />
        <UiTestCase Caption="1px solid Cyan" Setup="@Small" Css="@($"border-radius: 6px; border: 1px solid {GalleryPalette.CyanHex}")" Note="Small and thin - a 1px border shouldn't disappear or double up." />
        <UiTestCase Caption="2px solid Pink" Css="@($"border-radius: 0; border: 2px solid {GalleryPalette.PinkHex}")" />
    </div>

    <h2>Clipping children</h2>

    <div class="cases">
        <UiTestCase Caption="hidden" Css="@($"border-radius: 20px; border: 4px solid {GalleryPalette.CyanHex}; overflow: hidden")">
            <ChildContent><div style="@Child"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Caption="hidden" Setup="@WideNoFill" Css="border-radius: 50%; overflow: hidden">
            <ChildContent><div style="@Child"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Caption="hidden" Css="border-radius: 20px; overflow: hidden" Note="Text is clipped by the same corners as anything else.">
            <ChildContent>
                <label style="position: absolute; left: -10px; top: 40px; width: 200px; font-size: 16px; color: #000; white-space: nowrap">Clipped text runs off the edge</label>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Caption="scale( 0.5 )" Setup="@WideNoFill" Css="border-radius: 50%; overflow: hidden; transform: scale( 0.5 )" Note="The clip's antialiasing follows the transform - one screen pixel wide, not one layout pixel.">
            <ChildContent><div style="@Child"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Caption="rotate( 15deg )" Css="border-radius: 20px; overflow: hidden; transform: rotate( 15deg )" class="roomy">
            <ChildContent><div style="@Child"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Caption="hidden" Css="border-radius: 30px; overflow: hidden" Note="Nested clips - the child's corners and the parent's both apply.">
            <ChildContent>
                <div style="@($"position: absolute; left: 20px; top: -20px; width: 120px; height: 120px; border-radius: 10px; overflow: hidden; background-color: {GalleryPalette.CyanHex}")">
                    <div style="@Child"></div>
                </div>
            </ChildContent>
        </UiTestCase>
    </div>

    <h2>Filters, backdrops and scale</h2>

    <div class="cases">
        <UiTestCase Caption="drop-shadow( 6px 6px 10px #000 )" class="roomy" Css="border-radius: 20px; filter: drop-shadow( 6px 6px 10px #000 )" Note="drop-shadow follows the drawn shape, so the corners are round." />
        <UiTestCase Caption="blur( 4px )" class="roomy" Css="border-radius: 20px; filter: blur( 4px )" />
        <UiTestCase Caption="1px solid #fff" class="checkered" Setup="@NoFill" Css="border-radius: 20px; backdrop-filter: blur( 8px ); border: 1px solid #fff" Note="The blur is clipped to the corners." />
        <UiTestCase Caption="blur( 8px )" class="checkered" Setup="@NoFill" Css="@($"border-radius: 20px; background-color: rgba( {GalleryPalette.LimeHex}, 0.5 ); backdrop-filter: blur( 8px )")" />
        <UiTestCase Caption="scale( 0.5 )" Css="@($"border-radius: 20px; border: 2px solid {GalleryPalette.CyanHex}; transform: scale( 0.5 )")" Note="Corners and border stay sharp when scaled down." />
        <UiTestCase Setup="width: 200px; height: 200px; align-items: center; justify-content: center" Caption="10× scale" Note="A tiny circle enlarged around its centre, with room reserved for the result.">
            <ChildContent><div style="@($"width: 20px; height: 20px; flex-shrink: 0; background-color: {GalleryPalette.LimeHex}; border-radius: 10px; border: 2px solid {GalleryPalette.CyanHex}; transform: scale(10); transform-origin: 50% 50%")"></div></ChildContent>
        </UiTestCase>
    </div>

</root>

@code
{
    const string Short = $"width: 100px; height: 40px; background-color: {GalleryPalette.LimeHex}";
    const string Half = $"width: 100px; height: 50px; background-color: {GalleryPalette.LimeHex}";
    const string Wide = $"width: 200px; height: 100px; background-color: {GalleryPalette.LimeHex}";
    const string Small = $"width: 30px; height: 20px; background-color: {GalleryPalette.LimeHex}";
    const string Tiny = $"width: 20px; height: 20px; background-color: {GalleryPalette.LimeHex}";

    const string NoFill = "width: 100px; height: 100px";
    const string WideNoFill = "width: 200px; height: 100px";

    const string Child = $"position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: {GalleryPalette.PinkHex}";
}
