@namespace PanelGallery.UiTests
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Title( "Background clip" )]
@attribute [Description( "background-clip - the box the background stops at, and clipping it to text" )]
@attribute [Icon( "content_cut" )]
@attribute [Order( 62 )]

@*
    background-clip decides how far the background is painted. The box values pull it in to the
    padding or content edge; "text" keeps only what the panel's text covers, so the background
    shows through the glyphs. The border is never clipped - it always paints over the top.
*@

<root>

    <h2>Boxes</h2>

    <p>
        A thick see-through border and generous padding, so it's obvious where each clip stops.
        Only the background moves - the border and the layout stay put.
    </p>

    <div class="cases">
        <UiTestCase Setup="@Boxed" Css="background-clip: border-box"
                    Note="The default - the background runs all the way under the border." />
        <UiTestCase Setup="@Boxed" Css="background-clip: padding-box"
                    Note="Stops at the inside edge of the border, so the border goes see-through." />
        <UiTestCase Setup="@Boxed" Css="background-clip: content-box"
                    Note="Stops at the inside edge of the padding too." />
        <UiTestCase Setup="@BoxedRound" Css="background-clip: padding-box"
                    Note="The clip edge is rounded as well, each corner losing the border it sits between." />
        <UiTestCase Setup="@BoxedRound" Css="background-clip: content-box"
                    Note="Pulled in far enough that the corners give up their radius and go square, like CSS." />
        <UiTestCase Setup="@BoxedImage" Css="background-clip: content-box"
                    Note="An image is clipped the same as a colour - the tiling isn't moved, just cut." />
        <UiTestCase Setup="@Boxed" Css="background: linear-gradient( to bottom right, #4a9eff, #e8b04a ) padding-box"
                    Note="The shorthand takes the box value too." />
    </div>

    <h2>Text</h2>

    <p>
        The text becomes the stencil for the background and isn't drawn itself, so what you read is
        the gradient or image showing through the glyphs.
    </p>

    <div class="cases">
        <UiTestCase Setup="@TextPlate" Text="Gradient" Css="background-image: linear-gradient( to right, #ff4a6e, #4a9eff ); background-clip: text" />
        <UiTestCase Setup="@TextPlate" Text="Sunset" Css="background-image: linear-gradient( 45deg, #e8b04a, #ff4a6e, #7d4aff ); background-clip: text" />
        <UiTestCase Setup="@TextPlate" Text="Photo" Css="background-image: url( https://cdn.sbox.game/upload/b/9c9201ad/eff8/4b0c/81af/58c8a68667b9.png ); background-size: cover; background-clip: text"
                    Note="Any background works - this one is an image rather than a gradient." />
        <UiTestCase Setup="@TextPlate" Text="Flat" Css="background-color: #4ac2e8; background-clip: text"
                    Note="A plain colour clipped to text is just coloured text, the long way round." />
        <UiTestCase Setup="@TextPlateBig" Text="Big" Css="background-image: linear-gradient( to bottom, #ffffff, #4a9eff ); background-clip: text"
                    Note="Bigger glyphs, so the gradient has room to read across a single word." />
        <UiTestCase Setup="@TextPlate" Text="Words that wrap" Css="background-image: linear-gradient( to right, #ff4a6e, #4a9eff ); background-clip: text"
                    Note="The gradient belongs to the box, not to each line, so it carries across the wrap." />
    </div>

    <h2>Text in a div</h2>

    <p>
        The clip is set on a panel and the text sits in labels under it, which is what a div with
        text in it builds. Each label is stencilled out of the same background.
    </p>

    <div class="cases">
        <div class="divcase">
            <div class="plate">One label</div>
            <label class="css">a div with text in it</label>
        </div>
        <div class="divcase">
            <div class="plate">
                <label>First</label>
                <label>Second</label>
            </div>
            <label class="css">two labels under the div</label>
        </div>
        <div class="divcase">
            <div class="plate">
                <div><label>Nested deeper</label></div>
            </div>
            <label class="css">a label further down the tree</label>
        </div>
        <div class="divcase">
            <div class="plate"></div>
            <label class="css">no text at all</label>
            <label class="note">Nothing to stencil, so nothing is painted.</label>
        </div>
    </div>

    <h2>With the rest of the box</h2>

    <div class="cases">
        <UiTestCase Setup="@TextPlateBordered" Text="Border" Css="background-image: linear-gradient( to right, #ff4a6e, #4a9eff ); background-clip: text"
                    Note="The border isn't clipped to the text - it draws as normal, once." />
        <UiTestCase Setup="@TextPlate" Text="Faded" Css="background-image: linear-gradient( to right, #ff4a6e, #4a9eff ); background-clip: text; opacity: 0.4"
                    Note="Opacity applies to the painted result like anywhere else." />
        <UiTestCase Setup="@TextPlate" Text="Shadow" Css="background-image: linear-gradient( to right, #ff4a6e, #4a9eff ); background-clip: text; text-shadow: 2px 2px 3px black"
                    Note="Text effects are baked into the stencil, so a shadow becomes part of the shape." />
    </div>

</root>

@code
{
    // Thick translucent border and fat padding, so each clip edge is easy to pick out
    const string Boxed = "width: 120px; height: 120px; background-color: #4a9eff; border: 12px solid rgba( 255, 255, 255, 0.35 ); padding: 16px";
    const string BoxedRound = Boxed + "; border-radius: 28px";
    const string BoxedImage = "width: 120px; height: 120px; background-image: url( /ui/sbox_ident_default.svg ); background-size: 30px 30px; border: 12px solid rgba( 255, 255, 255, 0.35 ); padding: 16px";

    const string TextPlate = "width: 200px; font-size: 32px; font-weight: 700; background-color: #23262e";
    const string TextPlateBig = "width: 200px; font-size: 64px; font-weight: 700; background-color: #23262e";
    const string TextPlateBordered = TextPlate + "; border: 6px solid #4ac2e8";
}
