@using Sandbox.PanelGallery;
@namespace PanelGallery.UiTests
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Group( "Text" )]
@attribute [Title( "white-space" )]
@attribute [Description( "Whitespace, wrapping and intrinsic text sizing" )]
@attribute [Icon( "wrap_text" )]

<root>

    <h2>Wrapping</h2>

    <div class="cases">
        <UiTestCase Caption="normal" Setup="@Text" Css="white-space: normal" Text="@Paragraph" Note="Wraps at spaces, and the box grows to fit the lines." />
        <UiTestCase Caption="nowrap" Setup="@Text" Css="white-space: nowrap" Text="@Paragraph" Note="One line, overflowing the 200px box - nothing clips it here." />
        <UiTestCase Caption="pre" Setup="@Text" Css="white-space: pre" Text="@Preformatted" Note="Newlines and runs of spaces are kept." />
        <UiTestCase Caption="normal" Setup="@Text" Css="white-space: normal" Text="@LongWord" Note="A word longer than the box: the web overflows rather than breaking it." />

        <UiTestCase Caption="normal" Setup="@Narrow" Css="white-space: normal" Text="@Paragraph" Note="Narrow box, so most lines are one word." />
    </div>

    <h2>Sizing its own box</h2>

    <div class="cases">
        <UiTestCase Caption="140px" Setup="font-size: 16px; color: #e6eaf2" Css="max-width: 140px" Text="@Paragraph"
                    Note="No width: the text sizes the box, up to max-width." />
        <UiTestCase Caption="180px" Setup="font-size: 16px; color: #e6eaf2" Css="min-width: 180px" Text="Short" />
        <UiTestCase Caption="hidden" Setup="@Text" Css="height: 20px; overflow: hidden" Text="@Paragraph"
                    Note="Fixed height smaller than the text - clipped, not shrunk." />
        <UiTestCase Caption="Text with padding" Setup="@Text" Css="padding: 10px; background-color: rgba( 255, 255, 255, 0.08 )" Text="@Paragraph"
                    Note="Padding is inside the width, so the text wraps earlier." />
    </div>

    <h2>In a flex row</h2>

    <p>
        Text is the usual reason a flex row misbehaves: it wants its content width, which shoves
        everything else along. These check the fix for that as much as the text itself.
    </p>

    <div class="cases">
        <UiTestCase Caption="Wrapping beside a fixed item" Setup="width: 200px; height: 40px; background-color: rgba( 255, 255, 255, 0.06 )" Css="flex-direction: row">
            <ChildContent>
                <label style="font-size: 14px; color: #e6eaf2">@Paragraph</label>
                <div style="@($"width: 24px; height: 24px; flex-shrink: 0; background-color: {GalleryPalette.CyanHex}")"></div>
            </ChildContent>
        </UiTestCase>

    </div>

</root>

@code
{
    const string Text = UiTestCase.TextSetup;
    const string Narrow = "width: 80px; font-size: 16px; color: #e6eaf2";

    const string Paragraph = "Sphinx of black quartz, judge my vow.";
    const string LongWord = "Pneumonoultramicroscopicsilicovolcanoconiosis";
    const string Preformatted = "one    two\nthree";
}
