<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Basalt.Gpu's sample: a Win32 window rendering a clear, a triangle, textured meshes with depth and a compute
		dispatch, and Basalt's renderer on top. Needs nothing of the engine. See docs/managed/basalt-gpu.md.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>basaltgpusample</AssemblyName>
		<RootNamespace>BasaltGpuSample</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>../../../game/bin/managed/</OutputPath>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591</NoWarn>
		<LangVersion>14</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Basalt.Gpu\Basalt.Gpu.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- WithCulture: "mesh.ps.spv" would otherwise be taken for a Pashto satellite resource -->
		<EmbeddedResource Include="Shaders\*.spv" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>

</Project>
