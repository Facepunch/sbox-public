<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source 2 content for Borealis: reads s&box's compiled shaders (.shader_c), materials (.vmat_c) and textures (.vtex_c)
    and makes Borealis.Gpu shader modules, binding layouts, pipelines and textures from them. Borealis.Gpu stays a narrow
    RHI that knows nothing of Source 2. See docs/managed/borealis-gpu.md.
  -->

  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Borealis.Source2</AssemblyName>
    <PackageId>Borealis.Source2</PackageId>
    <OutputPath>..\..\game\bin\managed</OutputPath>
    <!-- Keep CS1591 enabled for public API documentation. -->
    <NoWarn>1701;1702</NoWarn>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Borealis.Gpu\Borealis.Gpu.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- vfx's Zstandard dictionary (src/vfx/vfx_compression_dict.c), which every compiled shader is compressed with -->
    <EmbeddedResource Include="Compression\VfxDictionary.zdict" LogicalName="Borealis.Source2.VfxDictionary.zdict" WithCulture="false" />
  </ItemGroup>

</Project>
