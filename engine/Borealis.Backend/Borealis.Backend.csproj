<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Borealis's GpuDevice and GpuContext on Borealis.Gpu: what lets an unmodified RenderSystem render through Borealis's own
    Vulkan device instead of Source 2's. The first, small form of the renderer services that sit between Borealis and its
    RHI. See docs/managed/borealis-gpu.md.
  -->

  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Borealis.Backend</AssemblyName>
    <PackageId>Borealis.Backend</PackageId>
    <OutputPath>..\..\game\bin\managed</OutputPath>
    <!-- Keep CS1591 enabled for public API documentation. -->
    <NoWarn>1701;1702</NoWarn>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Borealis\Borealis.csproj" Private="false" />
    <ProjectReference Include="..\Borealis.Gpu\Borealis.Gpu.csproj" Private="false" />
    <ProjectReference Include="..\Borealis.Source2\Borealis.Source2.csproj" Private="false" />
    <ProjectReference Include="..\Sandbox.System\Sandbox.System.csproj" Private="false" />
    <ProjectReference Include="..\Sandbox.ShaderCompiler\Sandbox.ShaderCompiler.csproj" Private="false" />
  </ItemGroup>

</Project>
