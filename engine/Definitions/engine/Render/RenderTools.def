
#include "sbox/rendertools.h"

native static class RenderTools as NativeEngine.RenderTools
{

	bool PackSceneEnvMap( CSceneObject sceneObject, void* pOut );
	ulong GetSceneObjectLightmapKey( CSceneObject sceneObject );
	void GetSceneWorldWind( ISceneWorld world, CastTo[Vector4D*] void* pStrengthFreq, CastTo[Vector4D*] void* pDir );
	int GetLightProbeVolume( CSceneObject sceneObject, CastTo[Vector*] void* pBoxMins, CastTo[Vector*] void* pBoxMaxs, CastTo[int*] void* pRenderPriority, CastTo[uint32*] void* pLightGroups, int nMaxLightGroups );
	IMaterial GetSceneObjectDraw( CSceneObject sceneObject, int nIndex, CastTo[int*] void* pMeshIndex, CastTo[int*] void* pDrawCall, CastTo[int*] void* pFlags );
	float GetTextureLodScale( bool bFallback );
	IModel GetAggregateModel( CSceneObject sceneObject, CastTo[bool*] void* pLightmapped );
	IModel CreateBufferObjectModel( CSceneObject sceneObject );
	int GetAggregateFragments( CSceneObject sceneObject, void* pOut, int nMaxFragments );
	int GetLightProbeVolumeHandshake( CSceneObject sceneObject );

	// The engine's debug visualizers as lines and labels for Borealis to draw (native views drew them before)
	int GetDebugVisualizers( void* pLines, int nMaxLines, void* pTexts, int nMaxTexts, CastTo[int*] void* pTextCount );

	// The resource a texture was loaded from, or empty for one made at run time
	inline string GetTextureResourceName( ITexture texture )
	{
		static thread_local CBufferString name;
		name.RemoveAll();
		if ( texture != RENDER_TEXTURE_HANDLE_INVALID )
			texture.GetResourceName( &name );
		return name.String();
	}
	int PackSceneLight( CSceneLightObject light, void* pOut, CastTo[int*] void* pBakeLightIndex );
	bool ReadSceneLightDescription( CSceneLightObject light, void* pOut );

	inline void SetDynamicConstantBufferData( CRenderAttributes attributes, StringToken nTokenID, void* data, int dataSize )
	{
		RenderTools::SetDynamicConstantBufferData( attributes, nTokenID, nullptr, data, dataSize );
	}

}

native class VertexLayout as NativeEngine.VertexLayout
{
	static VertexLayout Create( string name, int size ); [new]
	
	void Destroy(); [delete]
	void Free();

	void Add( string semanticName, int semanticIndex, uint format, int offset );
	void Build();

	int m_Size;
}