native static class globalBox2d as NativeEngine.Box2d
{
	inline b2WorldId b2CreateWorld( b2WorldDef def ) 
	{
		return ::b2CreateWorld( &def ); 
	}

	inline b2BodyId b2CreateBody( b2WorldId worldId, b2BodyDef def )
	{
		return ::b2CreateBody( worldId, &def );
	}

	inline b2ShapeId b2CreateCircleShape( b2BodyId bodyId, b2ShapeDef def, b2Circle circle )
	{
		return ::b2CreateCircleShape( bodyId, &def, &circle );
	}

	inline b2ShapeId b2CreateSegmentShape( b2BodyId bodyId, b2ShapeDef def, b2Segment segment )
	{
		return ::b2CreateSegmentShape( bodyId, &def, &segment );
	}

	inline b2ShapeId b2CreateCapsuleShape( b2BodyId bodyId, b2ShapeDef def, b2Capsule capsule )
	{
		return ::b2CreateCapsuleShape( bodyId, &def, &capsule );
	}

	inline b2ShapeId b2CreatePolygonShape( b2BodyId bodyId, b2ShapeDef def, b2Polygon polygon )
	{
		return ::b2CreatePolygonShape( bodyId, &def, &polygon );
	}

	inline b2ChainId b2CreateChain( b2BodyId bodyId, b2ChainDef def )
	{
		return ::b2CreateChain( bodyId, &def );
	}

	inline b2JointId b2CreateDistanceJoint( b2WorldId worldId, b2DistanceJointDef def )
	{
		return ::b2CreateDistanceJoint( worldId, &def );
	}

	inline b2JointId b2CreateMotorJoint( b2WorldId worldId, b2MotorJointDef def )
	{
		return ::b2CreateMotorJoint( worldId, &def );
	}

	inline b2JointId b2CreateFilterJoint( b2WorldId worldId, b2FilterJointDef def )
	{
		return ::b2CreateFilterJoint( worldId, &def );
	}

	inline b2JointId b2CreatePrismaticJoint( b2WorldId worldId, b2PrismaticJointDef def )
	{
		return ::b2CreatePrismaticJoint( worldId, &def );
	}

	inline b2JointId b2CreateRevoluteJoint( b2WorldId worldId, b2RevoluteJointDef def )
	{
		return ::b2CreateRevoluteJoint( worldId, &def );
	}

	inline b2JointId b2CreateWeldJoint( b2WorldId worldId, b2WeldJointDef def )
	{
		return ::b2CreateWeldJoint( worldId, &def );
	}

	inline b2JointId b2CreateWheelJoint( b2WorldId worldId, b2WheelJointDef def )
	{
		return ::b2CreateWheelJoint( worldId, &def );
	}

	inline void b2World_Explode( b2WorldId worldId, b2ExplosionDef explosionDef )
	{
		::b2World_Explode( worldId, &explosionDef );
	}

