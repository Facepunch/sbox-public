native struct SboxVertex_t is Sandbox.Vertex
native struct VertexField_t as NativeEngine.VertexField
native enum GenerateUVsMode_t as NativeEngine.GenerateUVsMode_t
native enum AlignEdgeUV_t as NativeEngine.AlignEdgeUV_t

