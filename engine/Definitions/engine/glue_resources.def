
include "sbox/glue_resources.h"

native static class Glue.Resources as NativeGlue.Resources
{
	IMaterial GetMaterial( string name, Guid guid );
	ITexture GetTexture( string name, Guid guid );
	bool IsTextureWebStreamingActive();
	bool HasTextureWebStreamingRequests();
	bool PrefetchTextureWebStreaming( string path, string url, int size, int generation );
	int CancelTextureWebStreamingPrefetch();
	void SetTextureWebStreamingState( bool paused, int bytesPerSecond );
	IModel GetModel( string name, Guid guid );

	inline string GetModelResourceName( IModel model )
	{
		if ( ResourceIsAnonymous( model.GetBinding() ) )
			return model->GetModelName();

		static thread_local CBufferString name;
		model.GetResourceName( &name );
		return name.String();
	}

	CPhysicsData GetPhysics( string name, Guid guid );
	HAnimationGraph GetAnimationGraph( string name, Guid guid );
	CVfx GetShader( string name, Guid guid );
}
