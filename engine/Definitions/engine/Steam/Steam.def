managed static class Sandbox.SteamApi.Callbacks
{
	static void SteamApiCallCompleted( ulong call );
	static void SteamShutdown();
	static void WebAuthTicketReceived( string ticket );
	static void NewUrlLaunchParameters();
	static void ValidateAuthTicket( ulong steamId, EAuthSessionResponse response, ulong owner, bool server );
	static void FriendChanged( ulong steamId, EPersonaChange flags );
	static void GameRichPresenceJoinRequested( string connect );
	static void GameLobbyJoinRequested( ulong lobbyId );
	static void InventoryDefinitionsUpdated( void* ids, int count );
	static void InventoryPricesUpdated( string catalog );
	static void ItemInstalled( uint appId, ulong fileId, bool server );
	static void ItemDownloadFinished( uint appId, ulong fileId, EResult result, bool server );
	static void WorkshopSubscriptionsChanged( uint appId );
	static void WorkshopQueryCompleted( ulong requestId, string json );
	static void BrowserNeedsPaint( uint browser, void* pixels, uint width, uint height );
	static bool BrowserAllowsNavigation( uint browser, string url );
	static void BrowserUrlChanged( uint browser, string url );
	static void BrowserTitleChanged( uint browser, string title );
	static void BrowserFinishedRequest( uint browser, string url, string title );
	static void BrowserSetCursor( uint browser, string cursor );
	static void SteamServersConnected();
	static void SteamServerConnectFailure( EResult result, bool stillRetrying );
	static void SteamServersDisconnected( EResult result );

	static void LobbyInvite( ulong lobbyId, ulong memberId );
	static void LobbyMemberEntered( ulong lobbyId, ulong memberId );
	static void LobbyMemberLeft( ulong lobbyId, ulong memberId );
	static void LobbyEntered( ulong lobbyId );
	static void LobbyDataUpdated( ulong lobbyId, ulong targetId );
	static void LobbyChatMessage( ulong lobbyId, ulong memberId, void* message, int length );
	static void NetworkingDebugOutput( int level, string message );
	static void SocketConnected( HSteamListenSocket socket, HSteamNetConnection connection );
	static void SocketDisconnected( HSteamListenSocket socket, HSteamNetConnection connection );
	static bool ShouldAcceptConnection( HSteamListenSocket socket, HSteamNetConnection connection );
	static void Disconnected( HSteamNetConnection connection, int reasonCode, string reasonString );
	static void MessagingSessionAccepted( ulong steamId );
	static void MessagingSessionFailed( ulong steamId, ESteamNetworkingConnectionState state, int reasonCode, string reason );
}

