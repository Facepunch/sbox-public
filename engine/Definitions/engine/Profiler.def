include "tier0/profiler.h"

native static class Profiler as NativeEngine.Profiler
{
	static uint RegisterScope( string name, string file, int line );
	static string GetScopeName( uint scope );
	static string GetScopeFile( uint scope );
	static int GetScopeLine( uint scope );

	static bool AttachThread();
	[nogc]
	static bool ScopesActive();

	[nogc]
	static ulong Begin( uint scope );
	[nogc]
	static void End( ulong token );

	static uint Start();
	static void Stop();
	static ulong Now();
	static ulong Frequency();
	static ulong DroppedEvents();
	static int ThreadSlots();
	inline static int Drain( int slot, void* events, int capacity, void* threadInfo )
	{
		return Profiler::Drain( slot, (ProfilerEvent_t*)events, capacity, (ProfilerThread_t*)threadInfo );
	}
}
