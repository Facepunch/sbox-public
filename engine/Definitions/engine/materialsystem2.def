
#include "materialsystem2/imaterialsystem2.h"
#include "materialsystem2/imaterialsystem2utils.h"

native pointer HMaterial as NativeEngine.HMaterial

native accessor g_pMaterialSystem2 as NativeEngine.MaterialSystem2
{
	IMaterial CreateRawMaterial( string materialName, string shader, bool anonymous );
	IMaterial CreateProceduralMaterialCopy( IMaterial hSrcMaterial,  CastTo[ProceduralResourceType_t] int nResourceType, bool bRecreateStaticBuffers );

	// doesn't work, pResourceName becomes invalid
	IMaterial FindOrCreateMaterialFromResource( string pResourceName );

	void FrameUpdate();
}

native accessor g_pMaterialSystem2Utils as NativeEngine.MaterialSystem2Utils
{
	void DrawScreenSpaceRectangle( IRenderContext context, IMaterial material, CRenderAttributes attributes, int x, int y, int width, int height, float sourceX0, float sourceY0, float sourceX1, float sourceY1, int textureWidth, int textureHeight );
}
