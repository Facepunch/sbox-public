include "sbox/glue_renderdevice.h"
include "rendersystem/irenderhardwareconfig.h"

native static class Glue.RenderDeviceManager as NativeEngine.RenderDeviceManager
{
	inline RenderMultisampleType GetBestMultisampleType( RenderMultisampleType multisample )
	{
		return g_pRenderHardwareConfig->GetBestMSAAMode( IMAGE_FORMAT_RGBA8888, multisample );
	}

	// Queries the native render device for upscaler support. nUpscalerType is the UpscalerType
	// enum from rendersystem/iupscaler.h (UPSCALER_NONE=0, UPSCALER_AMD_FSR3=2, UPSCALER_NVIDIA_DLSS=3).
	// Returns false for DLSS on non-NVIDIA hardware.
	bool IsUpscalerSupported( int nUpscalerType );

	// The adapter's name as the driver reports it, e.g. "llvmpipe (LLVM 21.1.0, 256 bits)" for Lavapipe
	inline string GetAdapterName()
	{
		return g_pRenderHardwareConfig->AdapterInfo().m_pDriverName;
	}

	// Whether the device has a queue for async compute work (RCFLAG_ASYNC_COMPUTE_QUEUE)
	inline bool SupportsAsyncCompute()
	{
		return g_pRenderHardwareConfig->SupportsAsyncCompute();
	}
}
