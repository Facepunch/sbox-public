	void SetAngularFogParams( float flFogMinStart, float flFogMinEnd, float flFogMaxStart, float flFogMaxEnd );

	float GetFogMinStart();
	float GetFogMinEnd();
	float GetFogMaxStart();
	float GetFogMaxEnd();
}