
#include "scenesystem/sceneanimatableobject.h"

native struct SceneDeformationVolumeData_t is Sandbox.SceneDeformationVolumeData;

delegate SboxAnimationEventCallback;
delegate SboxAnimTagEventCallback;
delegate SboxAnimGraphChangedCallback;
delegate SboxAnimGraph2ControllerCreatedCallback;

[Handle:Sandbox.SceneModel]
native class CSceneAnimatableObject as NativeEngine.CSceneAnimatableObject : CSceneObject
{
	inline void SetDeformationVolumes( int count, void* volumes )
	{
		self->SetDeformationVolumes( count, static_cast<const SceneDeformationVolumeData_t *>( volumes ) );
	}

	inline void SetDeformationAnchors( int count, void* anchors )
	{
		self->SetDeformationAnchors( count, static_cast<const Vector4D *>( anchors ) );
	}

	[nogc]
	void SetWorldSpaceRenderBoneTransform( int nBoneIndex, Transform pRenderWorldTransform );
	[nogc]
	Transform GetWorldSpaceRenderBoneTransform( int nBoneIndex );
	Transform GetWorldSpaceRenderBoneTransform( string boneName );
	[nogc]
	Transform GetWorldSpaceRenderBonePreviousTransform( int nBoneIndex );
	Transform GetWorldSpaceRenderBonePreviousTransform( string boneName );
	[nogc]
	Transform GetLocalSpaceRenderBoneTransform( int nBoneIndex );
	Transform GetLocalSpaceRenderBoneTransform( string boneName );
	[nogc]
	Transform GetWorldSpaceAnimationTransform( int nBoneIndex );

	[nogc]
	void GetWorldSpaceRenderBoneTransforms( int nNumBones, void* pOut );
	[nogc]
	void GetWorldSpaceRenderBonePreviousTransforms( int nNumBones, void* pOut );

	// The render bones as they're kept, matrix3x4_t each, without a round trip through CTransform; identity past the last
	[nogc]
	inline void GetWorldSpaceRenderBoneMatrices( int nNumBones, void* pOut )
	{
		matrix3x4_t *pDest = static_cast<matrix3x4_t *>( pOut );
		const int nCopy = MIN( nNumBones, self->m_worldSpaceRenderBones.Count() );
		for ( int i = 0; i < nCopy; ++i )
			pDest[ i ] = self->m_worldSpaceRenderBones[ i ];
		for ( int i = nCopy; i < nNumBones; ++i )
			SetIdentityMatrix( pDest[ i ] );
	}
	[nogc]
	int GetClosestBoneIndex( Vector3 vWorldPoint );

	// s&box: a CModelAnimationInstance animates this object's SceneModel. It stops animating itself (now and when its model
	// changes) and keeps the pose it's given, for Source 2's views
	inline void SetExternalAnimation()
	{
		self->m_bExternalAnimation = true;
		self->m_bManaged = false;
	}

	// The pose to draw with: matrix3x4_t world-space render bones by model bone, as many as it has
	[nogc]
	inline void SetWorldSpaceRenderBoneMatrices( int nNumBones, void* pBones )
	{
		const matrix3x4_t *pSrc = static_cast<const matrix3x4_t *>( pBones );
		const int nCopy = MIN( nNumBones, self->m_worldSpaceRenderBones.Count() );
		self->m_worldSpaceRenderBonesPrevious.CopyArray( self->m_worldSpaceRenderBones.Base(), self->m_worldSpaceRenderBones.Count() );
		for ( int i = 0; i < nCopy; ++i )
			self->m_worldSpaceRenderBones[ i ] = pSrc[ i ];
	}

	// The flex controllers' weights to morph with, by the model's flex controller index, as many as it has
	[nogc]
	inline void SetFlexControllerWeights( void* pWeights, int nCount )
	{
		const int nCopy = MIN( nCount, self->m_flexControllerWeights.Count() );
		if ( pWeights && nCopy > 0 )
			V_memcpy( self->m_flexControllerWeights.Base(), pWeights, nCopy * sizeof( float ) );
	}

	[nogc]
	Transform GetParentSpaceBone( int index );
	[nogc]
	void GetParentSpaceBones( int nNumBones, void* pOut );
	// The flex controllers' weights as the object morphs with them (animation, then overrides), one float each by the
	// model's flex controller index, into pOut up to nMax; returns how many it has
	[nogc]
	inline int GetFlexControllerWeights( void* pOut, int nMax )
	{
		const int nCount = self->m_flexControllerWeights.Count();
		const int nCopy = MIN( nMax, nCount );
		if ( pOut && nCopy > 0 )
			V_memcpy( pOut, self->m_flexControllerWeights.Base(), nCopy * sizeof( float ) );
		return nCount;
	}

	bool SBox_GetAttachment( StringToken name, bool worldspace, cref out Transform tx );

	BBox m_worldBounds;
	BBox m_localBounds;
}

native class IAnimParameterInstance as NativeEngine.IAnimParameterInstance
{
	CUtlString GetName();
	NativeEngine.AnimVariant GetValue();
	NativeEngine.AnimParamType GetParameterType();

	bool IsAutoReset();

	void SetValue( NativeEngine.AnimVariant val );
}
