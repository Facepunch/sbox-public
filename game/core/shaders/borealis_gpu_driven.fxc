#ifndef BOREALIS_GPU_DRIVEN_FXC
#define BOREALIS_GPU_DRIVEN_FXC

//
// Borealis's GPU-driven variant of a shader (compiled with ShaderCompiler -gpudriven). The compiler appends this to
// every vertex and pixel program and wraps MainVs and MainPs: vertex inputs are pulled by vertex index, the transform
// comes from the instance record, material constants and texture slots from the material record. Shader authors
// don't include or call anything here. Record layouts: sbox/records.slangh, read at borealis_records.fxc's offsets
// (docs/reference/borealis-records.md).
//

#include "common.fxc"
#include "borealis_records.fxc"

// The raw buffer array in the bindless set: geometry pages and Borealis's tables. Binding 63, as RENDER_GLOBAL_BINDING_VERTEX_BUFFERS
#ifndef BINDLESS_VERTEX_BUFFERS_DECLARED
#define BINDLESS_VERTEX_BUFFERS_DECLARED
ByteAddressBuffer g_bindless_VertexBuffers[] EXTERNAL_DESC_SET( t, g_globalLateBoundBindlessSet, 17 );
#endif

// Which entries of g_bindless_VertexBuffers hold the tables, for the draws being recorded
cbuffer BorealisGpuDriven_t
{
	uint g_nBorealisInstances;	// instance records (InstanceRecord)
	uint g_nBorealisDraws;		// draw records (DrawRecord)
	uint g_nBorealisGeometry;		// geometry records: 32-byte semantic mask, then 16 bytes per present semantic
	uint g_nBorealisMaterials;	// material records: $Globals as compiled, then a bindless slot per material texture
	uint g_nBorealisVertexBases;	// with the visibility-driven forward pass's ids: each instance's first vertex bit, a word per instance from here
	uint g_nBorealisLighting;		// lighting records, 160 bytes: BakedLightingConstantBuffer_t, then PerBatchLightProbeVolumeConstantBuffer_t; a draw's is its flags' top 24 bits, in 16 bytes
};

// With one material per multi-draw (specialization constant 120): its pixel record's offset. Set per bucket as an
// object attribute, so changing it moves a dynamic offset and nothing else
cbuffer BorealisGpuDrivenMaterial_t
{
	uint g_nBorealisPixelMaterial;
};

// The instance's transform slot and draw (the transform word's top byte is its LOD fade's, sbox/lod_fade.slangh)
uint2 BorealisGpuDrivenInstance( uint nInstance )
{
	ByteAddressBuffer instances = g_bindless_VertexBuffers[ g_nBorealisInstances ];
	uint nAt = nInstance * InstanceRecord_Size;
	uint2 vRecord = instances.Load2( nAt + InstanceRecord_Transform );
	return uint2( vRecord.x & 0xffffffu, vRecord.y );
}

// The instance's LOD fade (LodFadeKeep in sbox/lod_fade.slangh): 0 none; else the share of pixels the new LOD keeps, of
// 128, bit 7 set for the LOD it fades from
uint BorealisGpuDrivenFade( uint nInstance )
{
	return g_bindless_VertexBuffers[ g_nBorealisInstances ].Load( nInstance * InstanceRecord_Size + InstanceRecord_Transform ) >> 24;
}

// A LOD cross-fade's dither: the new LOD keeps the pixels whose noise is under its share, the old one the rest, so the two
// cover each pixel once, in every pass and whatever the multisampling
void BorealisLodFadeClip( uint nFade, float2 vPositionSs )
{
	if ( nFade == 0 )
		return;

	float flNoise = frac( 52.9829189 * frac( dot( floor( vPositionSs ), float2( 0.06711056, 0.00583715 ) ) ) );
	bool bNew = flNoise < ( nFade & 127 ) / 128.0;
	if ( bNew == ( ( nFade & 128 ) != 0 ) )
		discard;
}

// The vertex's bit in the visibility mask: its aggregate's first vertex bit (written beside the instance records, where
// the prepass draws ids) plus the vertex. Meaningless elsewhere, and unused there
uint BorealisGpuDrivenVertexBit( uint nInstance, uint nVertex )
{
	uint nBase = g_bindless_VertexBuffers[ g_nBorealisInstances ].Load( g_nBorealisVertexBases + nInstance * 4 );
	return nBase == 0xffffffffu ? 0xffffffffu : nBase + nVertex;
}

// What the id prepass writes for the vertex, less the 1 its first word adds: its bit, and its instance record as the frame
// chunk's bindless slot (top 10 bits) and the record's index in it (low 22 bits), all ones past them. Where the view's ids
// target has a second word (BackendDevice.IdsNormals) both land, for the normals resolve; otherwise only the bit does
uint2 BorealisGpuDrivenIds( uint nInstance, uint nVertex )
{
	uint nPointer = nInstance < ( 1u << 22 ) && g_nBorealisInstances < 1024 ? ( g_nBorealisInstances << 22 ) | nInstance : 0xffffffffu;
	return uint2( BorealisGpuDrivenVertexBit( nInstance, nVertex ), nPointer );
}

// The draw's geometry record, vertex material record and pixel material record offsets, and its flags
uint4 BorealisGpuDrivenDraw( uint nDraw )
{
	ByteAddressBuffer draws = g_bindless_VertexBuffers[ g_nBorealisDraws ];
	uint nAt = nDraw * DrawRecord_Size;
	return uint4( draws.Load( nAt + DrawRecord_Geometry ), draws.Load( nAt + DrawRecord_VertexMaterial ), draws.Load( nAt + DrawRecord_PixelMaterial ), draws.Load( nAt + DrawRecord_Flags ) );
}

//
// One vertex input by its semantic (usage * 16 + index): decoded from the stream the geometry record names, with the
// decoders of the engine's vertex formats. A semantic the mesh doesn't have reads ( 0, 0, 0, 1 ), as the default
// stream does.
//
uint4 BorealisGpuDrivenFetch( uint nGeometry, uint nSemantic, uint nVertex, bool bFloat )
{
	uint4 result = uint4( 0, 0, 0, bFloat ? asuint( 1.0f ) : 1u );

	ByteAddressBuffer geometry = g_bindless_VertexBuffers[ g_nBorealisGeometry ];
	uint nMaskWord = nSemantic >> 5;
	uint nBit = 1u << ( nSemantic & 31 );
	uint nMask = geometry.Load( nGeometry + GeometryRecord_Semantics + nMaskWord * GeometryRecord_SemanticsStride );
	if ( ( nMask & nBit ) == 0 )
		return result;

	uint nAttribute = countbits( nMask & ( nBit - 1 ) );
	for ( uint i = 0; i < nMaskWord; i++ )
		nAttribute += countbits( geometry.Load( nGeometry + GeometryRecord_Semantics + i * GeometryRecord_SemanticsStride ) );

	// Its stream (GeometryStream): page + 1, byte offset of element 0, format and stride, element count and per-instance flag
	uint nStreamAt = nGeometry + GeometryRecord_Size + nAttribute * GeometryStream_Size;
	uint4 attribute = geometry.Load4( nStreamAt + GeometryStream_Page );
	if ( nVertex >= ( attribute.w >> 1 ) )
		return result;

	uint nFormat = attribute.z;
	uint nStride = nFormat >> 16;
	uint nBits = nFormat & 63;
	uint nCount = ( nFormat >> 6 ) & 7;
	uint nConversion = ( nFormat >> 9 ) & 7;
	uint nOffset = attribute.y + nVertex * nStride;
	ByteAddressBuffer page = g_bindless_VertexBuffers[ NonUniformResourceIndex( attribute.x - 1 ) ];

	// 32-bit components need no decoding
	if ( nBits == 32 )
	{
		if ( nCount == 4 ) return page.Load4( nOffset );
		if ( nCount == 3 ) result.xyz = page.Load3( nOffset );
		else if ( nCount == 2 ) result.xy = page.Load2( nOffset );
		else result.x = page.Load( nOffset );
		return result;
	}

	// 10:10:10:2
	if ( nBits == 10 )
	{
		uint4 values = ( page.Load( nOffset ) >> uint4( 0, 10, 20, 30 ) ) & uint4( 1023, 1023, 1023, 3 );
		return nConversion == 1 ? asuint( float4( values ) / float4( 1023, 1023, 1023, 3 ) ) : values;
	}

	// 8 and 16-bit components, from up to three words
	uint nBitOffset = ( nOffset & 3 ) * 8;
	uint nAligned = nOffset & ~3u;
	uint nBitCount = nBits * nCount;
	uint3 words = uint3( page.Load( nAligned ), 0, 0 );
	if ( nBitOffset + nBitCount > 32 ) words.y = page.Load( nAligned + 4 );
	if ( nBitOffset + nBitCount > 64 ) words.z = page.Load( nAligned + 8 );

	uint4 shifts = nBitOffset + uint4( 0, 1, 2, 3 ) * nBits;
	uint4 packed = shifts < 32 ? words.xxxx : ( shifts < 64 ? words.yyyy : words.zzzz );
	uint nMaskBits = 0xffffffffu >> ( 32 - nBits );
	uint4 values = ( packed >> ( shifts & 31 ) ) & nMaskBits;
	if ( nConversion == 0 )
		values = asuint( f16tof32( values ) );
	else if ( nConversion == 1 )
		values = asuint( float4( values ) * ( nBits == 8 ? 1.0f / 255.0f : 1.0f / 65535.0f ) );
	else if ( nConversion == 2 || nConversion == 4 )
	{
		int4 signedValues = int4( values << ( 32 - nBits ) ) >> ( 32 - nBits );
		values = nConversion == 2 ? asuint( max( -1.0f, float4( signedValues ) * ( nBits == 8 ? 1.0f / 127.0f : 1.0f / 32767.0f ) ) ) : asuint( signedValues );
	}
	result = uint4( 0, 1, 2, 3 ) < nCount ? values : result;

	// BGRA colours
	if ( ( nFormat & 4096 ) != 0 )
		result.xyz = result.zyx;

	return result;
}

#endif // BOREALIS_GPU_DRIVEN_FXC
