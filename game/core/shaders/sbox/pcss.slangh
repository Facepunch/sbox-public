	float2( -0.214393, -0.0592364 ), float2( -0.204932, -0.483566 ), float2( -0.183569, -0.266274 ), float2( -0.123936, -0.754448 ),
	float2( -0.0859096, 0.118625 ), float2( -0.0610675, 0.460555 ), float2( -0.0234687, -0.962523 ), float2( -0.00485244, -0.373394 ),
