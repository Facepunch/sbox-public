	float2( 0.369549, -0.655019 ), float2( 0.423627, 0.429975 ), float2( 0.530747, -0.364971 ), float2( 0.566027, -0.940489 ),
	float2( 0.639332, 0.0284127 ), float2( 0.652089, 0.669668 ), float2( 0.773797, 0.345012 ), float2( 0.968871, 0.840449 ),
	float2( 0.991882, -0.657338 )
};

