/// What a soft shadow lookup is given about the light: projected to linear depth (x * d + y) / (z * d + w), the light's
/// radius in shadow-map uv and in world units, and the near plane.
struct PCSSParams_t
{
	float4 vProjectedDepthToLinearDepth;
	float2 vLightRadiusUv;
	float flLightRadiusWs;
	float flNearPlane;
};

/// One disc point: the comparison's result (1 lit, 0 shadowed) on the map, 0 off its edge.
float PcssTap( Texture2D tShadowMapCmp, SamplerComparisonState sShadowMapCmp, float2 vUv, float flProjectedDepth )
{
	if ( !all( vUv >= 0.0 ) || !all( vUv <= 1.0 ) ) return 0.0;
	return Tex2DCmpLevelZeroS( tShadowMapCmp, sShadowMapCmp, vUv, flProjectedDepth );
}

/// The share of the 25-point disc around vUv (scaled by vFilterRadiusUv) that's lit.
float PCSS_ShadowPCF_25( Texture2D tShadowMapCmp, SamplerComparisonState sShadowMapCmp, float2 vUv, float flProjectedDepth, float2 vFilterRadiusUv )
{
	float flLit = 0.0;
	for ( int i = 0; i < 25; i++ )
		flLit += PcssTap( tShadowMapCmp, sShadowMapCmp, vUv + g_vPoisson25[i] * vFilterRadiusUv, flProjectedDepth );
	return flLit / 25.0;
}

/// The share of the 64-point disc around vUv (scaled by vFilterRadiusUv) that's lit.
float PCSS_ShadowPCF_64( Texture2D tShadowMapCmp, SamplerComparisonState sShadowMapCmp, float2 vUv, float flProjectedDepth, float2 vFilterRadiusUv )
{
	float flLit = 0.0;
	for ( int i = 0; i < 64; i++ )
		flLit += PcssTap( tShadowMapCmp, sShadowMapCmp, vUv + g_vPoisson64[i] * vFilterRadiusUv, flProjectedDepth );
	return flLit / 64.0;
}

#endif // PCSS_FXC
