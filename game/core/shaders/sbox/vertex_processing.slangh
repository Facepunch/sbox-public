// The vertex shader frame of the classic shaders. VS_CommonProcessing turns a VS_INPUT into the PS_INPUT interpolants: the
// instance's tint, the world position, normal and tangent frame (read from the animated vertex cache, or decompressed in
// object space and carried through the instance's transform), the clip position, UVs and lightmap UV.
// VS_CommonProcessing_Post comes last and makes the position camera-relative. Slang compiles read it in place of
// vr_common_vs_code.fxc (SlangHeaders), so it keeps that header's names, material parameters (in their order), include guard
// and results.
#ifndef VR_COMMON_VS_CODE_FXC
#define VR_COMMON_VS_CODE_FXC

// The old header's includes, in its order: shaders that include this one may use any of them
#include "sbox/math.slangh"
#include "common/utils/normal_transform.hlsl"
#include "sbox/instancing.slangh"
#include "sbox/vertex_decompress.slangh"
#include "sbox/morph.slangh"
#include "sbox/light_probe_volume.slangh"
#include "sbox/lighting.slangh"

BoolAttribute( CanBatchWithDynamicShaderConstants, true );

bool g_bWrinkleOverride < Default( 0.0f ); UiType( CheckBox ); UiGroup( "Wrinkle/10" ); >;
float g_flWrinkleOverride < Default( 0.0 ); Range( -1.0, 1.0 ); UiGroup( "Wrinkle/20" ); >;

#ifdef COMMON_VS_INPUT_DEFINED

/// The vertex's object-space normal, and its tangent with the bitangent's sign in w. A compressed frame packs both into the
/// normal stream. An uncompressed one is marked by w = 1 on its normal and brings its tangent in a stream of its own, or
/// takes +Z when the input has none.
void VS_DecodeObjectSpaceNormalAndTangent( const VS_INPUT i, out float3 vNormalOs, out float4 vTangentUOs_flTangentVSign )
{
	float4 vNormalStream = i.vNormalOs;
	float4 vTangentStream = float4( 0.0, 0.0, 1.0, 1.0 );
	if ( g_bUncompressedTangentFrame )
	{
		vNormalStream.w = 1.0f;
	#if ( VS_INPUT_HAS_TANGENT_BASIS )
		vTangentStream = i.vTangentUOs_flTangentVSign;
	#endif
	}

	DecompressNormalTangent( vNormalStream, vTangentStream, vNormalOs, vTangentUOs_flTangentVSign );
}

#if ( D_CS_VERTEX_ANIMATION )

/// The vertex's world position and frame from the animated vertex cache, which compute skinning and morphing fill in world
/// space.
void VS_SboxWorldFrame( const VS_INPUT i, ExtraShaderData_t extra, out float3 vPositionWs, out float3 vNormalWs, out float3 vTangentUWs, out float3 vTangentVWs )
{
	CachedAnimatedVertex_t vertex = FetchCachedVertex( extra.nVertexCacheOffset + uint( i.nVertexCacheIndex ) );

	float flBitangentSign;
	DecodeCachedVertexTangentSpace( vertex, vNormalWs, vTangentUWs, flBitangentSign );
	vPositionWs = vertex.vPosWs;
	vTangentVWs = cross( vNormalWs, vTangentUWs ) * flBitangentSign;
}

#else

/// The vertex's world position and frame through its instance's transform (and bone). The normal goes by the inverse
/// transpose; the tangent is made perpendicular to it again (Gram-Schmidt), and the bitangent turns over for a mirrored
/// transform as well as by its own sign.
void VS_SboxWorldFrame( const VS_INPUT i, ExtraShaderData_t extra, out float3 vPositionWs, out float3 vNormalWs, out float3 vTangentUWs, out float3 vTangentVWs )
{
	float3 vNormalOs;
	float4 vTangentOs;
	VS_DecodeObjectSpaceNormalAndTangent( i, vNormalOs, vTangentOs );

	float3x4 matObjectToWorld = GetTransformMatrix( i.nInstanceTransformID, i.nBoneIndex.x );
	vPositionWs = mul( matObjectToWorld, float4( i.vPositionOs.xyz, 1.0 ) );

	float flMirrorSign;
	vNormalWs = TransformNormalInverseTranspose( vNormalOs, (float3x3)matObjectToWorld, flMirrorSign );

	float3 vTangentWs = mul( matObjectToWorld, float4( vTangentOs.xyz, 0.0 ) );
	vTangentUWs = normalize( vTangentWs - ( vNormalWs * dot( vTangentWs, vNormalWs ) ) );
	vTangentVWs = cross( vNormalWs, vTangentUWs ) * vTangentOs.w * flMirrorSign;
}

#endif

/// The interpolants from a classic vertex input, the position still in world space (VS_CommonProcessing_Post moves it).
PS_INPUT VS_CommonProcessing( VS_INPUT i )
{
	PS_INPUT o;

	ExtraShaderData_t extra = GetExtraPerInstanceShaderData( i.nInstanceTransformID );
	o.vVertexColor = extra.vTint;

	float3 vNormalWs;
	float3 vTangentUWs;
	float3 vTangentVWs;
	VS_SboxWorldFrame( i, extra, o.vPositionWs, vNormalWs, vTangentUWs, vTangentVWs );
	o.vNormalWs.xyz = vNormalWs;
#if ( PS_INPUT_HAS_TANGENT_BASIS )
	o.vTangentUWs = vTangentUWs;
	o.vTangentVWs = vTangentVWs;
#endif

	o.vPositionPs = Position3WsToPs( o.vPositionWs );

#if ( S_USE_PER_VERTEX_CURVATURE )
	o.flSSSCurvature = i.flSSSCurvature;
#endif

	// The second UV set, when the material uses one, rides in zw
	o.vTextureCoords.xy = i.vTexCoord.xy;
#if ( S_UV2 )
	o.vTextureCoords.zw = i.vTexCoord2.xy;
#endif

#if ( D_BAKED_LIGHTING_FROM_LIGHTMAP )
	o.vLightmapUV = i.vLightmapUV.xy * g_vLightmapUvScale.xy;
#else
	o.vLightmapUV = float2( 0.0, 0.0 );
#endif

	return o;
}

/// The last step of the vertex shader: the position relative to the high precision lighting offset (near the camera), which
/// keeps it precise through interpolation. PS_CommonProcessing adds the offset back.
PS_INPUT VS_CommonProcessing_Post( const PS_INPUT i )
{
	PS_INPUT o = i;
	o.vPositionWs = i.vPositionWs.xyz - g_vHighPrecisionLightingOffsetWs.xyz;
	return o;
}

#endif // COMMON_VS_INPUT_DEFINED

#endif // VR_COMMON_VS_CODE_FXC
