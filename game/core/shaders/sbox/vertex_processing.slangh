// The classic vertex shader's processing: the instance's tint, the world position, normal and tangent frame (from the
// animated vertex cache, or the decompressed object-space frame through the instance's transform), clip position, UVs and the
// lightmap UV, then the camera-relative position (VS_CommonProcessing_Post). Ours, in place of the old vr_common_vs_code.fxc
// in Slang compiles (SlangHeaders): the same names, material parameters (in the same order) and results. Shares the old
// header's include guard.
#ifndef VR_COMMON_VS_CODE_FXC
#define VR_COMMON_VS_CODE_FXC

// What the old header included, in its order, which code that includes it may rely on
#include "sbox/math.slangh"
#include "common/utils/normal_transform.hlsl"
#include "sbox/instancing.slangh"
#include "sbox/vertex_decompress.slangh"
#include "sbox/morph.slangh"
#include "sbox/light_probe_volume.slangh"
#include "sbox/lighting.slangh"

BoolAttribute( CanBatchWithDynamicShaderConstants, true );

bool g_bWrinkleOverride < Default( 0.0f ); UiType( CheckBox ); UiGroup( "Wrinkle/10" ); >;
float g_flWrinkleOverride < Default( 0.0 ); Range( -1.0, 1.0 ); UiGroup( "Wrinkle/20" ); >;

#ifdef COMMON_VS_INPUT_DEFINED

/// The vertex's object-space normal and tangent (with the bitangent's sign in w), decompressed. An uncompressed frame takes
/// its tangent from the input (or +Z without a tangent basis).
void VS_DecodeObjectSpaceNormalAndTangent( const VS_INPUT i, out float3 vNormalOs, out float4 vTangentUOs_flTangentVSign )
{
	float4 vPackedNormal = i.vNormalOs;
	float4 vPackedTangent = float4( 0.0, 0.0, 1.0, 1.0 );
	if ( g_bUncompressedTangentFrame )
	{
		vPackedNormal.w = 1.0f;
	#if ( VS_INPUT_HAS_TANGENT_BASIS )
		vPackedTangent = i.vTangentUOs_flTangentVSign;
	#else
		vPackedTangent = float4( 0.0, 0.0, 1.0, 1.0 );
	#endif
	}

	DecompressNormalTangent( vPackedNormal, vPackedTangent, vNormalOs, vTangentUOs_flTangentVSign );
}

/// The interpolants from a classic vertex input.
PS_INPUT VS_CommonProcessing( VS_INPUT i )
{
	PS_INPUT o;

	ExtraShaderData_t extra = GetExtraPerInstanceShaderData( i.nInstanceTransformID );
	o.vVertexColor = extra.vTint;

#if ( D_CS_VERTEX_ANIMATION )
	// Skinned or morphed by compute into the vertex cache, already in world space
	uint nVertexId = extra.nVertexCacheOffset + uint( i.nVertexCacheIndex );
	CachedAnimatedVertex_t vertex = FetchCachedVertex( nVertexId );

	float3 vNormal;
	float3 vTangent;
	float flSign;
	DecodeCachedVertexTangentSpace( vertex, vNormal, vTangent, flSign );

	o.vPositionWs = vertex.vPosWs;
	o.vNormalWs.xyz = vNormal;

	#if ( PS_INPUT_HAS_TANGENT_BASIS )
		o.vTangentUWs = vTangent;
		o.vTangentVWs = cross( vNormal, vTangent ) * flSign;
	#endif
#else
	float3 vNormalOs;
	float4 vTangentUOs_flTangentVSign;
	VS_DecodeObjectSpaceNormalAndTangent( i, vNormalOs, vTangentUOs_flTangentVSign );

	float3 vPositionOs = i.vPositionOs.xyz;
	float3x4 matObjectToWorld = GetTransformMatrix( i.nInstanceTransformID, i.nBoneIndex.x );
	o.vPositionWs = mul( matObjectToWorld, float4( vPositionOs.xyz, 1.0 ) );

	// The normal by the inverse transpose; its sign flips the bitangent of a mirrored transform
	float flTransformSign;
	o.vNormalWs.xyz = TransformNormalInverseTranspose( vNormalOs.xyz, (float3x3)matObjectToWorld, flTransformSign );

	#if ( PS_INPUT_HAS_TANGENT_BASIS )
		// The tangent made perpendicular to the normal (Gram-Schmidt), the bitangent from both
		float3 vTangentUWs = mul( matObjectToWorld, float4( vTangentUOs_flTangentVSign.xyz, 0.0 ) );
		vTangentUWs = normalize( vTangentUWs - ( o.vNormalWs.xyz * dot( vTangentUWs, o.vNormalWs.xyz ) ) );
		o.vTangentUWs = vTangentUWs;
		o.vTangentVWs = cross( o.vNormalWs.xyz, vTangentUWs ) * vTangentUOs_flTangentVSign.w * flTransformSign;
	#endif
#endif

	o.vPositionPs = Position3WsToPs( o.vPositionWs.xyz );

#if ( S_USE_PER_VERTEX_CURVATURE )
	o.flSSSCurvature = i.flSSSCurvature;
#endif

	o.vTextureCoords.xy = i.vTexCoord.xy;
#if ( S_UV2 )
	o.vTextureCoords.zw = i.vTexCoord2.xy;
#endif

#if ( D_BAKED_LIGHTING_FROM_LIGHTMAP )
	o.vLightmapUV = i.vLightmapUV.xy * g_vLightmapUvScale.xy;
#else
	o.vLightmapUV = float2( 0.0, 0.0 );
#endif

	return o;
}

/// The world position made camera-relative (the high precision lighting offset), last in the vertex shader.
PS_INPUT VS_CommonProcessing_Post( const PS_INPUT i )
{
	PS_INPUT o = i;
	o.vPositionWs.xyz -= g_vHighPrecisionLightingOffsetWs.xyz;
	return o;
}

#endif // COMMON_VS_INPUT_DEFINED

#endif // VR_COMMON_VS_CODE_FXC
