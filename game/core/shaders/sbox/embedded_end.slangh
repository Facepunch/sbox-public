// common/material.hlsl's sampler, before it moved to common/utils/Material.CommonInputs.hlsl
#ifdef SBOX_EMBEDDED_TEXTURE_FILTERING
#ifdef F_TEXTURE_FILTERING
SamplerState TextureFiltering < Filter( ( F_TEXTURE_FILTERING == 0 ? ANISOTROPIC : ( F_TEXTURE_FILTERING == 1 ? BILINEAR : ( F_TEXTURE_FILTERING == 2 ? TRILINEAR : ( F_TEXTURE_FILTERING == 3 ? POINT : NEAREST ) ) ) ) ); MaxAniso( 8 ); >;
#else
SamplerState TextureFiltering < Filter( ANISOTROPIC ); MaxAniso( 8 ); >;
#endif
#endif

// instancing.fxc's GetExtraPerInstanceShaderData took the vertex input before it took the instance's transform index
#ifdef SBOX_EMBEDDED_EXTRA_DATA_FROM_INPUT
ExtraShaderData_t GetExtraPerInstanceShaderData( VS_INPUT i )
{
	return GetExtraPerInstanceShaderData( i.nInstanceTransformID );
}
#endif

// The base library's screen uv and depth back to a position through a matrix, before it went
#ifdef SBOX_EMBEDDED_INV_PROJECT_POSITION
float3 InvProjectPosition( float3 coord, float4x4 mat )
{
	coord.y = 1 - coord.y;
	coord.xy = coord.xy * 2 - 1;
	float4 p = mul( mat, float4( coord, 1 ) );
	return p.xyz / p.w;
}
#endif

// morph.fxc's morphs read the atlas width from a declaration its includer makes (skinning_cs's). An older engine's vertex
// code had a morph combo, which a package's compiled shader keeps: its morph combos declare the width here
#ifdef SBOX_EMBEDDED_MORPH_ATLAS_WIDTH
#if ( D_MORPH )
uint g_nMorphTextureAtlasWidth < Attribute( "MorphTextureAtlasWidth" ); >;
#endif
#endif

// What follows is Slang (extensions, operators, conversions). In vfx's compile of a recompiled package shader (SLANG
// defined, __SLANG__ not) vfx's HLSL parser can't read it: the pragmas take it past the parser to Slang alone
#if defined( __SLANG__ ) || defined( SLANG )
#ifndef __SLANG__
#pragma sbox_slang_begin
#endif

// A world position's screen position as SV_Position has it in a pixel stage: pixels, depth, 1 / view depth
#if defined( LIGHT_HLSL ) || defined( AMBIENTLIGHT_HLSL )
float4 EmbeddedPositionSs( float3 vPositionWs )
{
	float4 vPositionPs = Position3WsToPs( vPositionWs );
	float2 vNdc = vPositionPs.xy / vPositionPs.w;
	float2 vPositionSs = float2( vNdc.x * 0.5 + 0.5, 0.5 - vNdc.y * 0.5 ) * g_vViewportSize + g_vViewportOffset;
	return float4( vPositionSs, vPositionPs.z / vPositionPs.w, 1.0 / vPositionPs.w );
}
#endif

// common/classes/Light.hlsl's lookups before lights were found by screen position (world position only), and before
// that by tile (a pixel's xy)
#ifdef LIGHT_HLSL
extension Light
{
	static uint Count( float3 vPositionWs )
	{
		return Count( EmbeddedPositionSs( vPositionWs ) );
	}

	static Light From( float3 vPositionWs, uint nLightIndex, float2 vLightMapUV = 0.0f )
	{
		return From( vPositionWs, EmbeddedPositionSs( vPositionWs ), nLightIndex, vLightMapUV );
	}

	static uint Count( float2 vPositionSs )
	{
		return Count( float4( vPositionSs, 0.0, 1.0 ) );
	}

	static Light From( float2 vPositionSs, float3 vPositionWs, uint nLightIndex, float2 vLightMapUV = 0.0f )
	{
		return From( vPositionWs, EmbeddedPositionSs( vPositionWs ), nLightIndex, vLightMapUV );
	}
}
#endif

// common/classes/AmbientLight.hlsl's before it took a screen position
#ifdef AMBIENTLIGHT_HLSL
extension AmbientLight
{
	static float3 From( float3 WorldPosition, float3 WorldNormal, float2 LightMapUV = 0.0f )
	{
		return From( WorldPosition, EmbeddedPositionSs( WorldPosition ), WorldNormal );
	}

	static float3 FromEnvMapProbe( float3 WorldPosition, float3 WorldNormal )
	{
		return FromEnvMapProbe( WorldPosition, EmbeddedPositionSs( WorldPosition ), WorldNormal );
	}
}
#endif

// HLSL truncates the wider vector where vectors of two sizes meet (DXC warns): in an operator, an assignment, an
// argument or a return. Slang has no such conversion, so these say it, for float vectors, the ones packages mix.
float3 operator+( float3 a, float4 b ) { return a + b.xyz; }
float3 operator+( float4 a, float3 b ) { return a.xyz + b; }
void operator+=( inout float3 a, float4 b ) { a += b.xyz; }
float3 operator-( float3 a, float4 b ) { return a - b.xyz; }
float3 operator-( float4 a, float3 b ) { return a.xyz - b; }
void operator-=( inout float3 a, float4 b ) { a -= b.xyz; }
float3 operator*( float3 a, float4 b ) { return a * b.xyz; }
float3 operator*( float4 a, float3 b ) { return a.xyz * b; }
void operator*=( inout float3 a, float4 b ) { a *= b.xyz; }
float3 operator/( float3 a, float4 b ) { return a / b.xyz; }
float3 operator/( float4 a, float3 b ) { return a.xyz / b; }
void operator/=( inout float3 a, float4 b ) { a /= b.xyz; }
float2 operator+( float2 a, float4 b ) { return a + b.xy; }
float2 operator+( float4 a, float2 b ) { return a.xy + b; }
void operator+=( inout float2 a, float4 b ) { a += b.xy; }
float2 operator-( float2 a, float4 b ) { return a - b.xy; }
float2 operator-( float4 a, float2 b ) { return a.xy - b; }
void operator-=( inout float2 a, float4 b ) { a -= b.xy; }
float2 operator*( float2 a, float4 b ) { return a * b.xy; }
float2 operator*( float4 a, float2 b ) { return a.xy * b; }
void operator*=( inout float2 a, float4 b ) { a *= b.xy; }
float2 operator/( float2 a, float4 b ) { return a / b.xy; }
float2 operator/( float4 a, float2 b ) { return a.xy / b; }
void operator/=( inout float2 a, float4 b ) { a /= b.xy; }
float2 operator+( float2 a, float3 b ) { return a + b.xy; }
float2 operator+( float3 a, float2 b ) { return a.xy + b; }
void operator+=( inout float2 a, float3 b ) { a += b.xy; }
float2 operator-( float2 a, float3 b ) { return a - b.xy; }
float2 operator-( float3 a, float2 b ) { return a.xy - b; }
void operator-=( inout float2 a, float3 b ) { a -= b.xy; }
float2 operator*( float2 a, float3 b ) { return a * b.xy; }
float2 operator*( float3 a, float2 b ) { return a.xy * b; }
void operator*=( inout float2 a, float3 b ) { a *= b.xy; }
float2 operator/( float2 a, float3 b ) { return a / b.xy; }
float2 operator/( float3 a, float2 b ) { return a.xy / b; }
void operator/=( inout float2 a, float3 b ) { a /= b.xy; }

extension vector<float, 2>
{
	__implicit_conversion( 900 ) __init( float3 v ) { this = v.xy; }
	__implicit_conversion( 900 ) __init( float4 v ) { this = v.xy; }
}

extension vector<float, 3>
{
	__implicit_conversion( 900 ) __init( float4 v ) { this = v.xyz; }
}

// A float4 where a float goes (a float function returning float4( ... )) is its x, as HLSL takes it; dearer than the
// truncations above, so a vector keeps to a vector where it can
extension float
{
	__implicit_conversion( 950 ) __init( float4 v ) { this = v.x; }
}

// common/classes/ScreenSpaceTrace.hlsl's result before the trace gave a screen uv: the hit with its uv in xy, and whether
// it hit
#ifdef SCREEN_SPACE_TRACE_HLSL
extension TraceResult
{
	property float3 HitClipSpace { get { return float3( HitUv, 0.0 ); } }
	property bool ValidHit { get { return Confidence > 0.0; } }
}
#endif

// terrain/TerrainCommon.hlsl's TerrainStruct before its units per texel had that name (Rust Legacy's grass)
#ifdef TERRAIN_H
extension TerrainStruct
{
	property float Resolution { get { return UnitsPerTexel; } }
}
#endif

// common/classes/Bindless.hlsl's texture lookup before the sRGB view had its own (GetTexture2DSrgb): a flag that took the
// view after the slot's
#ifdef BINDLESS_H
extension Bindless
{
	static Texture2D GetTexture2D( int nIndex, bool srgb ) { return GetTexture2D( nIndex + ( srgb ? 1 : 0 ) ); }
}
#endif

// common/DDGI/DDGI.hlsl's volume lookup before volumes blended (EvaluateVolumes): the first volume around the position,
// or none
#ifdef DDGI_HLSL
extension DDGI
{
	static DDGIVolume GetVolume( float3 positionWs )
	{
		[loop]
		for ( uint volumeIdx = 0u; volumeIdx < DDGIVolumeCount; ++volumeIdx )
		{
			DDGIVolume candidate = DDGIVolumes[volumeIdx];
			if ( candidate.IsValid() && candidate.GetBlendWeight( positionWs ) > 0.0f ) return candidate;
		}

		DDGIVolume none = {};
		return none;
	}
}
#endif

// HLSL's min and max of float vectors of two sizes truncate the wider (a water shader's min( float4, float2 )); Slang's take
// one size. These take the narrower through a conversion of its own, so they cost more than any built-in that applies
// (the engine's min( float3, float ), say) and are picked only where none does
struct EmbeddedFloat2 { float2 Value; __implicit_conversion( 500 ) __init( float2 v ) { Value = v; } }
struct EmbeddedFloat3 { float3 Value; __implicit_conversion( 500 ) __init( float3 v ) { Value = v; } }
float2 min( float4 a, EmbeddedFloat2 b ) { return min( a.xy, b.Value ); }
float2 min( EmbeddedFloat2 a, float4 b ) { return min( a.Value, b.xy ); }
float2 min( float3 a, EmbeddedFloat2 b ) { return min( a.xy, b.Value ); }
float2 min( EmbeddedFloat2 a, float3 b ) { return min( a.Value, b.xy ); }
float3 min( float4 a, EmbeddedFloat3 b ) { return min( a.xyz, b.Value ); }
float3 min( EmbeddedFloat3 a, float4 b ) { return min( a.Value, b.xyz ); }
float2 max( float4 a, EmbeddedFloat2 b ) { return max( a.xy, b.Value ); }
float2 max( EmbeddedFloat2 a, float4 b ) { return max( a.Value, b.xy ); }
float2 max( float3 a, EmbeddedFloat2 b ) { return max( a.xy, b.Value ); }
float2 max( EmbeddedFloat2 a, float3 b ) { return max( a.Value, b.xy ); }
float3 max( float4 a, EmbeddedFloat3 b ) { return max( a.xyz, b.Value ); }
float3 max( EmbeddedFloat3 a, float4 b ) { return max( a.Value, b.xyz ); }

#ifndef __SLANG__
#pragma sbox_slang_end
#endif
#endif // __SLANG__ || SLANG

#endif // SBOX_EMBEDDED_END_SLANGH
