// The engine's passes for surfaces, generic over the material. The shader compiler writes a small instance file per
// [Material] struct that includes this, imports the material's module and names the entry points; every pass calls the
// same Evaluate. Vertex processing and lighting are today's (sbox/engine.slangh), so a surface shades exactly as a
// .shader written with common/pixel.hlsl does. See docs/managed/shader-format-replacement.md.
#ifndef SBOX_SURFACE_PASSES_SLANGH
#define SBOX_SURFACE_PASSES_SLANGH

// The includes' Material (common/material.hlsl) is ClassicMaterial here: Material is the surface's
#define Material ClassicMaterial
// A material with an [Opacity] texture (the instance file defines SURFACE_OPACITY_TEXTURE) compensates its mips
#ifdef SURFACE_OPACITY_TEXTURE
#define MATERIAL_ALPHA_TEXTURE SurfaceOpacityTexture()
#endif
// The light hook is the pixel stage's (PROGRAM 1 is the vertex stage: system.fxc isn't included yet)
#if defined( SURFACE_LIGHT_HOOK ) && ( PROGRAM == 1 )
#undef SURFACE_LIGHT_HOOK
#endif
#include "sbox/engine.slangh"
#undef Material

import sbox.surface;

/// What the vertex stage hands the pixel stage: the engine's interpolants and the draw's material record offset, flat.
struct SurfaceVertexOutput
{
	PixelInput Pixel;
	nointerpolation uint MaterialOffset : TEXCOORD15;
};

/// The same with an IInterpolatedSurface's Varyings. Varyings are matched by location (declaration order), as both
/// stages compile this struct.
struct SurfaceVertexOutputWith<V>
{
	PixelInput Pixel;
	nointerpolation uint MaterialOffset : TEXCOORD15;
	V Varyings;
};

/// An IInterpolatedSurface with its interpolated Varyings, as an ISurface for the passes.
struct SurfaceWithVaryings<S : IInterpolatedSurface> : ISurface
{
	S Surface;
	S.Varyings Values;
	Material Evaluate( SurfaceInput i ) { return Surface.Evaluate( i, Values ); }
};

#if ( PROGRAM == VFX_PROGRAM_VS )

/// The vertex stage's output with the record offset passed on, and the surface's Varyings.
SurfaceVertexOutputWith<S.Varyings> SurfaceOutputWith<S : IInterpolatedSurface>( PixelInput pixel, S.Varyings varyings )
{
	SurfaceVertexOutputWith<S.Varyings> o;
	o.Pixel = pixel;
	o.MaterialOffset = DrawMaterialOffset();
	o.Varyings = LoadMaterial<S>( DrawMaterialOffset() ).Vertex( varyings );
	return o;
}

/// The vertex stage's output with the record offset passed on.
SurfaceVertexOutput SurfaceOutput( PixelInput pixel )
{
	SurfaceVertexOutput o;
	o.Pixel = pixel;
	o.MaterialOffset = DrawMaterialOffset();
	return o;
}

/// The vertex stage: the engine's, as common/vertex.hlsl's shaders do it.
PixelInput SurfaceVertex( VertexInput i )
{
	PixelInput o = ProcessVertex( i );
	return FinalizeVertex( o );
}

/// The vertex stage of a surface that moves its vertices: Displace in object space, then the same transform.
PixelInput SurfaceVertexDisplaced<S : IVertexSurface>( VertexInput i )
{
	float3 normalOs;
	float4 tangentOs;
	VS_DecodeObjectSpaceNormalAndTangent( i, normalOs, tangentOs );
	float3x4 objectToWorld = GetTransformMatrix( i.nInstanceTransformID );

	VertexSurfaceInput v;
	v.Position = i.vPositionOs.xyz;
	v.Normal = normalOs;
	v.Color = i.vSurfaceColor;
	v.ObjectOrigin = mul( objectToWorld, float4( 0, 0, 0, 1 ) );
	v.Wind = g_vWindDirection.xyz * g_vWindStrengthFreqMulHighStrength.x;
	v.Time = g_flTime;

	i.vPositionOs = LoadMaterial<S>( DrawMaterialOffset() ).Displace( v );
	PixelInput o = ProcessVertex( i );
	return FinalizeVertex( o );
}

#else

/// The bindless slot of the texture Opacity comes from, for alpha to coverage's mip compensation (Shade reads it through
/// MATERIAL_ALPHA_TEXTURE, as Material.CommonInputs.hlsl's shaders use g_tColor). Set by the pass before shading.
static uint s_SurfaceOpacityTexture = 0;

Texture2D SurfaceOpacityTexture()
{
	return g_bindless_Texture2D[NonUniformResourceIndex( s_SurfaceOpacityTexture )];
}

/// What a raster pass hands Evaluate.
SurfaceInput MakeSurfaceInput( PixelInput i )
{
	SurfaceInput s;
	s.Position = i.vPositionWithOffsetWs.xyz + g_vHighPrecisionLightingOffsetWs.xyz;
	s.Normal = normalize( i.vNormalWs.xyz );
	s.TangentU = i.vTangentUWs;
	s.TangentV = i.vTangentVWs;
	s.Uv = i.vTextureCoords.xy;
	s.Color = i.vVertexColor;
	s.ScreenPosition = i.vPositionSs;
	s.View = normalize( g_vCameraPositionWs - s.Position );
	// From the lighting origin (the main view's camera, also in its shadow views), so distance fades agree across passes
	s.ViewDistance = length( i.vPositionWithOffsetWs.xyz );
	// The triangle's normal from screen-space derivatives of the position: a resolve gets it from the triangle instead
	s.FaceNormal = normalize( cross( ddx( i.vPositionWithOffsetWs.xyz ), ddy( i.vPositionWithOffsetWs.xyz ) ) );
#if ( S_ALPHA_TEST )
	s.AlphaReference = g_flAlphaTestReference;
#else
	s.AlphaReference = 0.5;
#endif
	// Taken here, in uniform control flow, for Light, which samples inside the light loop
	s.UvDdx = ddx( s.Uv );
	s.UvDdy = ddy( s.Uv );
	s.Gradients = false;
	return s;
}

/// The surface's properties as the lighting's Material.
ClassicMaterial ToClassicMaterial( PixelInput i, Material s )
{
	ClassicMaterial m = ClassicMaterial::Init( i );
	m.Albedo = s.Albedo;
	m.Metalness = s.Metalness;
	m.Roughness = s.Roughness;
	m.Emission = s.Emission;
	m.Normal = s.Normal;
	m.AmbientOcclusion = s.AmbientOcclusion;
	m.Opacity = s.Opacity;
	m.Transmission = s.Transmission;
	m.TintMask = s.TintMask;
	return m;
}

/// Shade a surface's properties with the engine's standard shading model, as common/pixel.hlsl's shaders do. Alpha-tested
/// passes are compiled with S_ALPHA_TEST, so Shade runs today's alpha to coverage: the sharpened cutoff, mip-compensated by
/// the opacity texture's size, a hard cut without multisampling. Coverage fades whole triangles on top of it. In the
/// alpha-tested depth pass (S_MODE_DEPTH) Shade returns that coverage before lighting, so prepass and colour agree exactly.
float4 SurfaceShade( PixelInput i, Material s, uint opacityTexture, bool alphaTest )
{
	s_SurfaceOpacityTexture = opacityTexture;
	bool spread = alphaTest && g_nMSAASampleCount > 1;
	if ( s.Coverage < 1.0 ) clip( s.Coverage - ( spread ? 1.0 / 255.0 : 0.5 ) );
	float4 color = ShadingModelStandard::Shade( i, ToClassicMaterial( i, s ) );
	if ( spread ) color.a *= s.Coverage;
	return color;
}

#ifdef SURFACE_LIGHT_HOOK
// A lit surface (ILitSurface): the engine's light loop (vr_lighting.fxc) calls SurfaceLightHook for every light it shades
// the pixel with, and the shading model adds the sum to the diffuse light. The instance file defines SurfaceLight, which
// calls the material's Light with what the pass kept here.
static SurfaceInput s_SurfaceLitInput;
static Material s_SurfaceLitMaterial;
static float3 s_SurfaceLight = 0;
static float s_SurfaceLightStrength = 1;   // a baked light's per-texel strength, set around it by the baked loop

SurfaceInput SurfaceLitInput() { return s_SurfaceLitInput; }
Material SurfaceLitMaterial() { return s_SurfaceLitMaterial; }
float3 SurfaceLightTotal() { return s_SurfaceLight; }
void SurfaceLightScale( float strength ) { s_SurfaceLightStrength = strength; }

void SurfaceLightHook( float3 direction, float3 color, float attenuation, float visibility, bool sun )
{
	LightSample light;
	light.Direction = direction;
	light.Color = color;
	light.Attenuation = attenuation * s_SurfaceLightStrength;
	light.Visibility = visibility;
	light.Sun = sun;
	s_SurfaceLight += SurfaceLight( light );
}
#endif

/// Forward, and the alpha-tested depth pass: evaluate, then shade. A lit surface's Light runs inside Shade's light loop,
/// on the input with the gradients taken here, since lanes diverge in the loop.
float4 SurfaceForward<S : ISurface, let AlphaTest : bool>( PixelInput i, S surface, uint opacityTexture )
{
	SurfaceInput input = MakeSurfaceInput( i );
	Material s = surface.Evaluate( input );
#ifdef SURFACE_LIGHT_HOOK
	input.Gradients = true;
	s_SurfaceLitInput = input;
	s_SurfaceLitMaterial = s;
	s_SurfaceLight = 0;
#endif
	return SurfaceShade( i, s, opacityTexture, AlphaTest );
}
#endif

#endif
