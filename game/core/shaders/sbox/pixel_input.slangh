// The classic vertex-to-pixel interpolants, included inside a shader's PS_INPUT: world position (camera-relative in the pixel
// shader), normal (with wrinkle in w), UVs, lightmap UV, vertex colour, tangent frame, curvature, and the position and
// facing. Ours, in place of the old vr_common_ps_input.fxc in Slang compiles (SlangHeaders): the same members and semantics.
// TEXCOORD13 and up are free for the shader's own.

#if ( PROGRAM == VFX_PROGRAM_PS )
	float3 vPositionWithOffsetWs : TEXCOORD0;
#else
	float3 vPositionWs : TEXCOORD0;
#endif
#if ( S_WRINKLE )
	float4 vNormalWs : TEXCOORD1;
#else
	float3 vNormalWs : TEXCOORD1;
#endif

#if ( S_UV2 )
	float4 vTextureCoords : TEXCOORD2;
#else
	float2 vTextureCoords : TEXCOORD2;
#endif

// When LightmappedLight::UsesLightmaps()
centroid float2 vLightmapUV : TEXCOORD3;

float4 vVertexColor : TEXCOORD4;

#if ( PS_INPUT_HAS_TANGENT_BASIS )
	float3 vTangentUWs : TEXCOORD6;
	float3 vTangentVWs : TEXCOORD7;
#endif

#if ( S_USE_PER_VERTEX_CURVATURE )
	float flSSSCurvature : TEXCOORD11;
#endif

#if ( PROGRAM != VFX_PROGRAM_PS )
	float4 vPositionPs : SV_Position;
#else
	float4 vPositionSs : SV_Position;
	// Whether the front face is drawn: any material can be two-sided (F_RENDER_BACKFACES), so every pixel shader has it
	bool face : SV_IsFrontFace;
#endif

#define COMMON_PS_INPUT_DEFINED
