    "welcome.screen3.intro1.game_desc": "The classic mess-about-with-physics experience.",
    "welcome.screen3.intro2.game_name": "Sausage Survivors 2",
    "welcome.screen3.intro2.game_desc": "A polished, fast-paced game that shows off what's possible.",
