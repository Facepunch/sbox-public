@using Sandbox;
@using Sandbox.UI;
@namespace MenuProject.AvatarEditor

<root>

    <FormRow Label="#menu.avatar.height">
        <Content>
            <SliderControl class="simple" Value:bind=@Manager.Height Min="@(0.0f)" Max="@(1.0f)" Step="@(0.01f)"></SliderControl>
        </Content>
    </FormRow>    

    <FormRow Label="#menu.avatar.skin">
        <Content>
            <div class="skin-groups">
                @foreach( var group in SkinGroups() )
                {
                    <div class="skin-items">
                        @foreach( var item in group )
                        {
                            var w = Manager.IsSelected(item);
                            var c = w ? "active" : "";

                            <ClothingIcon class="@c" onclick=@( () => Clicked( item ) ) Icon=@item.Icon.Path></ClothingIcon>
                        }
                    </div>
                }
            </div>

        </Content>
    </FormRow>

	<FormRow Label="#menu.avatar.eye_color">
		<Content>
			<ColorSwatchPicker Gradient="@Dresser.EyeColorGradient" Value:bind="@Manager.EyeColor" />
		</Content>
	</FormRow>

    @if (Manager.Container.Clothing.Any(x => x.Clothing?.AllowTintSelect ?? false ))
    {
        <div style="height:32px"></div>

        @foreach (var entry in Manager.Container.Clothing)
        {
            if (entry.Clothing == null) continue;
            if (!entry.Clothing.AllowTintSelect) continue;

            <FormRow Label="@entry.Clothing.Title">
                <Content>
                    <ClothingOptions Clothing="@entry.Clothing"></ClothingOptions>
                </Content>
            </FormRow>

        }
    }

</root>

@code
{
    /// <summary>
    /// The avatar editor whose Human appearance is being edited.
    /// </summary>
    [Parameter]
    public AvatarEditManager Manager { get; set; }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( Manager.Height );
		hash.Add( Manager.EyeColor );

        foreach ( var entry in Manager.Container.Clothing )
            hash.Add( entry );

        return hash.ToHashCode();
    }

    /// <summary>
    /// Skins split into one unlabelled block per body (by their human skin tags), male bodies first.
    /// </summary>
    IEnumerable<IGrouping<int, Clothing>> SkinGroups()
    {
        return Manager.GetAllClothing()
            .Where( x => x.HasHumanSkin )
            .GroupBy( SkinGroupOrder )
            .OrderBy( g => g.Key );
    }

    static int SkinGroupOrder( Clothing skin )
    {
        var tags = skin.HumanSkinTags;
        if ( tags is null ) return 2;
        if ( tags.Has( "male" ) ) return 0;
        if ( tags.Has( "female" ) ) return 1;
        return 2;
    }

    void Clicked( Clothing x )
    {
        // don't deselect skins - they just have to choose a new one!
        if ( Manager.IsSelected(x) )
            return;

        Manager.OnClothingToggle(x);
    }
}
