@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using Sandbox.Services;

@if (Package is null) return;

@*
    What you thought of a game - how you'd rate it, what stood out and what held it back, and a few
    words. A window of the menu's own look, like the pause menu's pages.
*@
<root>
    <div class="window">

        <div class="head">
            <div class="text">
                <label class="eyebrow">Write a review</label>
                <label class="title">What did you think of @Package.Title?</label>
            </div>
            <div class="grow"></div>
            <div class="close" onclick=@( () => CloseModal( false ) ) tooltip="Close"><i>close</i></div>
        </div>

        <div class="body">

            @* The one it needs - three big choices, each lit in its own colour when it's picked *@
            <div class="ratings">
                @foreach ( var (score, icon, text, tone) in Ratings )
                {
                    <div class="rating @tone @(Score == score ? "active" : "")" onclick=@( () => SetRating( score ) )>
                        <i>@icon</i>
                        <label>@text</label>
                    </div>
                }
            </div>

            <div class="tags positive">
                <label class="section-label">What stood out</label>
                <TagSelector Value:bind=@PositiveTags />
            </div>

            <div class="tags negative">
                <label class="section-label">What held it back</label>
                <TagSelector Value:bind=@NegativeTags />
            </div>

            <div class="words">
                <label class="section-label">Your review</label>
                <TextEntry @ref=_textEntry Value:bind=@ReviewText Multiline="@true" Placeholder="Say what you thought..." />
            </div>

        </div>

        <div class="footer">
            <label class="note">Shown publicly on the game's page</label>
            <div class="grow"></div>
            <Button class="cancel" Text="Cancel" onclick=@( () => CloseModal( false ) ) />
            <Button class="post" Icon="send" Text="@(_posting ? "Posting..." : "Post review")" Disabled=@( !CanPost ) onclick=@PostReview />
        </div>

    </div>
</root>

@code
{
    public Package Package { get; set; }

    string ReviewText{ get; set; }
    Review.ReviewScore Score { get; set; }
    Review.PositiveTags PositiveTags { get; set; }
    Review.NegativeTags NegativeTags { get; set; }

    TextEntry _textEntry = default;
    bool _posting;

    static readonly (Review.ReviewScore Score, string Icon, string Text, string Tone)[] Ratings =
    {
        (Review.ReviewScore.Negative, "thumb_down", "Needs work", "bad"),
        (Review.ReviewScore.Promise, "trending_up", "Promising", "meh"),
        (Review.ReviewScore.Positive, "thumb_up", "Recommended", "good"),
    };

    bool CanPost => !_posting && Score != Review.ReviewScore.None && !string.IsNullOrWhiteSpace( ReviewText );

    protected override int BuildHash() => System.HashCode.Combine( Package, Score, CanPost, _posting );

    protected override async Task OnParametersSetAsync()
    {
        var oldReview = await Sandbox.Services.Review.Get(Package.FullIdent, Sandbox.Utility.Steam.SteamId);
        ReviewText = oldReview?.Content;
        PositiveTags = oldReview?.Positives ?? Review.PositiveTags.None;
        NegativeTags = oldReview?.Negatives ?? Review.NegativeTags.None;
        Score = oldReview?.Score ?? Review.ReviewScore.None;
        StateHasChanged();
    }

    protected override void OnAfterTreeRender(bool firstTime)
    {
        if ( firstTime )
        {
            _textEntry?.Focus();
        }
    }

    void SetRating(Review.ReviewScore score )
    {
        Score = score;

        _textEntry?.SelectAllInChildren();
        _textEntry?.Focus();        
    }

    async Task PostReview()
    {
        if ( !CanPost ) return;

        _posting = true;
        StateHasChanged();

        try
        {
            await MenuUtility.PostReview(Package.FullIdent, Score, ReviewText, PositiveTags, NegativeTags);
            CloseModal(true);
        }
        finally
        {
            _posting = false;
        }
    }
}
