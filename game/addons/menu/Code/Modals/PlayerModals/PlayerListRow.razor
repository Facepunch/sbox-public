@using System;
@using Sandbox;
@using Sandbox.UI;

@inherits Panel
@namespace MenuProject.Modals

@*
    One player in the game with you - laid out like a row of the friends list: their face, their name
    and what they are to you under it, then their ping, or Host for whoever's running the server.
    Someone who isn't a friend yet gets the friends list's add button on the end when you point at
    them. Click for their s&box card, right click for the rest.
*@

@if ( Player is null )
	return;

<root class="@RowClass">

	<div class="avatar" style="background-image: url( avatar:@Player.SteamId )"></div>

	<div class="info">
		<label class="name">@Player.Name</label>
		<label class="status">@StatusText</label>
	</div>

	<div class="grow"></div>

	@if ( !Player.IsMe && !Player.IsFriend )
	{
		<div class="add" tooltip="Send a friend request" onclick=@( ( e ) => AddFriend( e ) )><i>person_add</i></div>
	}

	@* The host's ping is always nothing - its pill says whose server it is instead *@
	@if ( Player.IsHost )
	{
		<div class="ping host" tooltip="Running the server">
			<i>dns</i>
			<label>Host</label>
		</div>
	}
	else
	{
		<div class="ping @PingClass" tooltip="Ping">
			<i>signal_cellular_alt</i>
			<label>@($"{Player.Ping:0} ms")</label>
		</div>
	}

</root>

@code
{
	public PlayerList.Player Player { get; set; }

	Friend Friend => new Friend( Player.SteamId );

	/// <summary>
	/// What they are to you - the friends list's status line.
	/// </summary>
	string StatusText
	{
		get
		{
			if ( Player.IsMe ) return "You";
			return Player.IsFriend ? "Friend" : "Player";
		}
	}

	string RowClass
	{
		get
		{
			if ( Player.IsMe ) return "me";
			return Player.IsFriend ? "friend" : "";
		}
	}

	/// <summary>
	/// Green, amber or red - how their connection's holding up.
	/// </summary>
	string PingClass
	{
		get
		{
			if ( Player.Ping >= 120 ) return "bad";
			if ( Player.Ping >= 60 ) return "ok";
			return "good";
		}
	}

	Popup menu;
	MenuProject.MenuUI.Popups.FriendCard card;

	protected override int BuildHash() => HashCode.Combine( Player );

	void AddFriend( PanelEvent e )
	{
		e.StopPropagation();
		Friend.OpenAddFriendOverlay();
	}

	protected override void OnRightClick( MousePanelEvent e )
	{
		if ( menu.IsValid() )
		{
			menu.Delete();
			return;
		}

		menu = new Popup( this, Popup.PositionMode.UnderMouse, 0 );

		// Their Steam profile - their s&box one is the card a click brings up
		var friend = Friend;
		menu.AddOption( "View Profile", () => friend.OpenInOverlay() );

		// Anything below is for other players
		if ( Player.IsMe )
			return;

		if ( !Player.IsFriend )
			menu.AddOption( "Send Friend Request", () => friend.OpenAddFriendOverlay() );

		// Only the host can kick - and only someone who's really here
		if ( !Networking.IsHost || Player.Connection is not { } connection )
			return;

		menu.AddOption( "Kick", "", () => connection.Kick( "Kicked" ) );
	}

	/// <summary>
	/// Their s&box card - the friends list's, where you point - or shut it on a second click.
	/// </summary>
	protected override void OnClick( MousePanelEvent e )
	{
		if ( card.IsValid() )
		{
			card.Delete();
			card = null;
			return;
		}

		card = MenuProject.MenuUI.Popups.FriendCard.Show( this, Friend, Popup.PositionMode.UnderMouse, 0 );
	}
}
