@using Sandbox
@using Sandbox.UI

@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal

<root>
    <div class="window">
        <div class="content">
            <div class="header">
                <label class="heading">#streamermodepromptmodal.title</label>
            </div>
            <div class="body">
                <label class="body">#streamermodepromptmodal.body</label>
            </div>
        </div>
        <div class="footer">
            <Button class="clicky secondary" @onclick="@Decline">#streamermodepromptmodal.no</Button>
            <Button class="clicky primary" Icon="visibility_off" @onclick="@Enable">#streamermodepromptmodal.yes</Button>
        </div>
    </div>
</root>

@code
{
    // Set once the prompt has been shown so we only inform the user about Streamer Mode a single time.
    public const string CookieKey = "menu.streamermodeprompt.shown";

    void Enable()
    {
        Preferences.StreamerMode = true;
        Delete();
    }

    void Decline()
    {
        Delete();
    }
}
