@using Sandbox
@using Sandbox.UI
@using System
@using System.Globalization
@using System.Linq

@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal

@* The item drop popup. Sits beside the rail's Rewards entry, like the friends list sits
   beside the invite button - the drop, then what it still wants from you. *@
<root class="rewards-modal anchored">
	<div class="inner" @ref="Inner">

		<div class="header">
			<i>redeem</i>
			<h2>#menu.rewards.weekly_rewards</h2>
			<div class="grow" />

			<div class="refresh @( IsLoading ? "busy" : "" )" onclick=@Refresh>
				<icon>refresh</icon>
				<label>@( IsLoading ? "#menu.common.loading" : "#menu.common.refresh" )</label>
			</div>
		</div>

		<div class="rewards-list">

			@if ( LoadFailed )
			{
				<label class="load-error">#menu.rewards.load_failed</label>
			}

			@if ( Window is null && State?.Pending is null )
			{
				<div class="rewards-empty">
					@if ( IsLoading )
					{
						<Spinner />
					}
					else
					{
						<icon>redeem</icon>
					}
					<label class="title">@( IsLoading ? "#menu.rewards.checking_your_progress" : "#menu.rewards.no_drop_right_now" )</label>
					<label class="hint">@( IsLoading ? "#menu.rewards.one_moment" : "#menu.rewards.no_active_week" )</label>
				</div>
			}
			else
			{
				@* The hero - one arc for everything, the same number the rail's bar decides on. *@
				<div class="hero @( CanOpen ? "done" : "" )">

					<div class="ring">
						<div class="ring-fill" style="background-image: @RingGradient" />
						<div class="ring-inner">
							@if ( State?.Pending is not null || Window?.IsClaimed == true )
							{
								<icon class="reward-status">@( State?.Pending is not null ? "inventory_2" : "check" )</icon>
								<label class="progress-label">@( State?.Pending is not null ? "#menu.rewards.ready" : "#menu.rewards.collected" )</label>
							}
							else
							{
								<label class="progress-count">@Language.GetPhrase( "menu.rewards.progress_count", new() { ["complete"] = MetCount, ["total"] = Facets.Length } )</label>
								<label class="progress-label">#menu.rewards.progress_unlocked</label>
							}
						</div>
					</div>

					<div class="hero-body">
						<label class="hero-title">@Title</label>
						<label class="hero-hint">@StatusText</label>

						@if ( CanOpen )
						{
							<div class="open reward" onclick=@OpenReward>
								<icon>inventory_2</icon>
								<label>#menu.rewards.open_your_drop</label>
							</div>
						}
					</div>

				</div>

				@if ( Facets.Length > 0 )
				{
					<div class="section-head">
						<label class="title">#menu.rewards.objectives</label>
					</div>

					@foreach ( var facet in Facets )
					{
						<div class="objective @( facet.Met ? "met" : "" )">

							<div class="objective-head">
								<div class="achievement-icon">
									@if ( !string.IsNullOrWhiteSpace( facet.Icon ) )
									{
										<img src=@facet.Icon />
									}
									else
									{
										<icon>emoji_events</icon>
									}
								</div>

								<div class="objective-body">
									<label class="objective-title">@AchievementTitle( facet )</label>

									@if ( !string.IsNullOrWhiteSpace( facet.Description ) )
									{
										<label class="objective-hint">@facet.Description</label>
									}
								</div>

								<icon class="completion" tooltip="@( facet.Met ? "#menu.rewards.unlocked" : "#menu.rewards.not_unlocked" )">@( facet.Met ? "check_circle" : "radio_button_unchecked" )</icon>
							</div>

							@if ( !string.IsNullOrWhiteSpace( facet.GameIdent ) )
							{
								<div class="objective-game" onclick=@(() => OpenGame( facet )) tooltip="#menu.party.view_game_details">
									<icon>sports_esports</icon>
									<label>@( string.IsNullOrWhiteSpace( facet.GameTitle ) ? facet.GameIdent : facet.GameTitle )</label>
									<icon class="game-arrow">arrow_forward</icon>
								</div>
							}

						</div>
					}
				}
			}

		</div>

	</div>
</root>

@code
{
	// Mirrors $front-reward and $front-track in _front.scss. Progress is a hard-stopped
	// gradient set inline, so the colours have to be spelled out here as well.
	// HDR - a drop is the one thing on screen allowed to glow. The track stays in range so
	// only the filled part lights up.
	const string FillColor = "#3fc76a * 3";
	const string TrackColor = "rgba( 255, 255, 255, 0.13 )";

	/// <summary>
	/// Gap between the rail entry and the popup.
	/// </summary>
	const float AnchorOffset = 20f;

	Panel Inner;
	Panel Anchor;

	RewardState State { get; set; }

	bool IsLoading { get; set; }
	bool LoadFailed { get; set; }

	/// <summary>
	/// The current weekly challenge, independent of any pending offer from an earlier week.
	/// </summary>
	RewardWindow Window => State?.Windows.FirstOrDefault();

	RewardFacet[] Facets => Window?.Facets ?? Array.Empty<RewardFacet>();

	bool WeekEnded => Window is not null && Window.EndsAt != default && Window.EndsAt <= DateTimeOffset.UtcNow;

	bool CanOpen => State?.Pending is not null || (Window?.IsEligible == true && !WeekEnded);

	int MetCount => Window?.MetCount ?? 0;

	string Title => string.IsNullOrWhiteSpace( Window?.Title ) ? "#menu.rewards.item_drop" : Window.Title;

	/// <summary>
	/// Every objective averaged into one arc; reserved or collected rewards are complete.
	/// </summary>
	float Fraction => CanOpen || Window?.IsClaimed == true ? 1f : Window?.Progress ?? 0f;

	/// <summary>
	/// Prefer the separate achievement title; older servers still supply a combined title.
	/// </summary>
	static string AchievementTitle( RewardFacet facet )
	{
		if ( !string.IsNullOrWhiteSpace( facet.AchievementTitle ) ) return facet.AchievementTitle;

		return string.IsNullOrWhiteSpace( facet.Title ) ? facet.AchievementName : facet.Title;
	}

	string StatusText
	{
		get
		{
			if ( State?.Pending is not null ) return "#menu.rewards.you_started_opening_this_one_go_back_and_pick_your_item";
			if ( Window?.IsClaimed == true || Window?.Reason == "already_claimed" ) return "#menu.rewards.week_claimed";
			if ( WeekEnded ) return "#menu.rewards.week_ended";
			if ( CanOpen ) return "#menu.rewards.everything_s_met_open_it_and_choose_what_you_keep";

			return Window?.Reason switch
			{
				"disabled" => "#menu.rewards.disabled",
				"not_game_owner" => "#menu.rewards.not_game_owner",
				"untrusted" => "#menu.rewards.unavailable",
				"no_active_week" => "#menu.rewards.no_active_week",
				"week_ended" => "#menu.rewards.week_ended",
				_ => Facets.Length == 0 ? "#menu.rewards.no_active_week" : "#menu.rewards.unlock_objectives"
			};
		}
	}

	/// <summary>
	/// Create the weekly rewards popup beside its sidebar button.
	/// </summary>
	public RewardsModal( Panel anchor )
	{
		Anchor = anchor;

		// Before the first layout, not on first render - otherwise the base .modal styles land first
		// and it visibly transitions out of them (the dim and blur fading off) as it appears
		AddClass( "anchored" );
	}

	/// <summary>
	/// Two hard stops: filled arc up to the percentage, empty track the rest of the way.
	/// </summary>
	string RingGradient
	{
		get
		{
			var pct = (Fraction * 100f).ToString( "0.#", CultureInfo.InvariantCulture );

			return $"conic-gradient( {FillColor} 0%, {FillColor} {pct}%, {TrackColor} {pct}%, {TrackColor} 100% )";
		}
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( !firstTime ) return;

		PositionBesideAnchor();

		// Fetched every time it opens - progress moves while you're playing.
		_ = Load();
	}

	/// <summary>
	/// Keep the popup aligned with its sidebar anchor.
	/// </summary>
	public override void Tick()
	{
		base.Tick();

		// Keeps up with the resolution changing while it's open
		PositionBesideAnchor();
	}

	int _placedFor;

	/// <summary>
	/// Puts <see cref="Inner"/> to the right of <see cref="Anchor"/>, bottom edges aligned, so
	/// it grows upward from the rail's bottom cluster rather than off the foot of the screen.
	/// </summary>
	void PositionBesideAnchor()
	{
		if ( !Anchor.IsValid() || !Inner.IsValid() || Parent is null ) return;

		// The anchor's in the menu and we're in the overlay, and the two scale differently with
		// resolution - so work in screen pixels (the anchor's rect already is) and turn them into
		// our units with our parent's scale, which is laid out already even though we aren't yet.
		// The gap's in the rail's units, so it stays the same distance from the rail at any size.
		var anchor = Anchor.Box.Rect;
		var gap = AnchorOffset * Anchor.ScaleToScreen;
		var scale = Parent.ScaleFromScreen;

		// Only when something's moved - setting a style restarts its transitions
		var placed = HashCode.Combine( anchor, gap, scale, Screen.Height );
		if ( placed == _placedFor ) return;
		_placedFor = placed;

		Inner.Style.Position = PositionMode.Absolute;
		Inner.Style.Left = (anchor.Right + gap) * scale;
		Inner.Style.Bottom = (Screen.Height - anchor.Bottom) * scale;
		Inner.Style.Dirty();
	}

	void Refresh()
	{
		_ = Load();
	}

	async Task Load()
	{
		if ( IsLoading ) return;

		IsLoading = true;
		LoadFailed = false;
		StateHasChanged();

		try
		{
			var state = await MenuUtility.Rewards.GetRewards();
			if ( !this.IsValid() ) return;

			State = state;
			Sidebar.InvalidateBadges();
		}
		catch ( Exception e )
		{
			Log.Warning( $"Unable to load weekly rewards: {e.Message}" );
			if ( this.IsValid() ) LoadFailed = true;
		}
		finally
		{
			if ( this.IsValid() )
			{
				IsLoading = false;
				StateHasChanged();
			}
		}
	}

	/// <summary>
	/// Open the objective's game using the normal game details and Play flow.
	/// </summary>
	void OpenGame( RewardFacet facet )
	{
		if ( string.IsNullOrWhiteSpace( facet.GameIdent ) ) return;

		CloseModal( true );
		MenuHelpers.LaunchGame( facet.GameIdent );
	}

	void OpenReward()
	{
		if ( !CanOpen )
			return;

		CloseModal( true );
		SceneTransition.Load( "/scenes/reward-unbox.scene" );
	}

	protected override int BuildHash() => HashCode.Combine( State, IsLoading, LoadFailed, MetCount, Fraction, CanOpen, WeekEnded );
}
