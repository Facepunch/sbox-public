@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal
@using Sandbox;
@using Sandbox.Network;
@using MenuProject.Platform;
@using Sandbox.UI

<root>
	<div class="window">

		<div class="banner" style="background-image: url( @BannerImage )">
			<div class="banner-gradient">
				<div class="banner-info">
					<label class="server-name">@Server.Name</label>
					<div class="player-badge">
						<i>people</i>
						<span>@Server.Members / @Server.MaxMembers</span>
					</div>
				</div>
			</div>
		</div>

		<div class="details">

			<div class="detail-row" onclick=@OpenGameInfo>
				<div class="thumb">
					@if ( string.IsNullOrEmpty( GamePackage?.Thumb ) )
					{
						<i>sports_esports</i>
					}
					else
					{
						<div class="thumb-img" style="background-image: url( @GamePackage.Thumb )"></div>
					}
				</div>
				<div class="info">
					<label class="eyebrow">#menu.home.game</label>
					<label class="title">@(GamePackage?.Title ?? Server.Game)</label>
				</div>
			</div>

			<div class="detail-row @(MapUnavailable ? "unavailable" : "")" onclick=@OpenMapInfo>
				<div class="thumb">
					@if ( string.IsNullOrEmpty( MapThumb ) )
					{
						<i>map</i>
					}
					else
					{
						<div class="thumb-img" style="background-image: url( @MapThumb )"></div>
					}
				</div>
				<div class="info">
					<label class="eyebrow">#menu.home.map</label>
					<label class="title">@(MapTitle ?? (MapUnavailable ? "#menu.home.unknown" : Server.Map))</label>
				</div>
			</div>

		</div>

		<div class="footer">
			<Button class="clicky" @onclick=@(() => CloseModal( false ))>#menu.common.cancel</Button>
			<Button class="clicky primary" Disabled=@(!MenuHelpers.HasAuthority) Icon="play_circle" onclick=@JoinServer>#menu.home.join_server</Button>
		</div>

	</div>
</root>

@code
{
	public LobbyInformation Server { get; set; }

	Package GamePackage;
	GamePageLoad map;

	string MapThumb => map?.WorkshopItem?.Thumb ?? map?.Local?.Thumb;
	string MapTitle => map?.WorkshopItem?.Title ?? map?.Local?.Title;

	string BannerImage => GamePackage?.ThumbWide ?? GamePackage?.Thumb;
	bool MapUnavailable => string.IsNullOrEmpty( Server.Map );

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( firstTime )
			LoadDetails();
	}

	async void LoadDetails()
	{
		if ( Server.Game.Contains( '.' ) && !Server.Game.Contains( "local." ) )
		{
			var pkg = await Package.FetchAsync( Server.Game, true );
			if ( pkg?.Public ?? false )
			{
				GamePackage = pkg;
				StateHasChanged();
			}
		}

		map = new GamePageLoad( Server.Map, map: true );
		await map.Run();
		StateHasChanged();
	}

	void JoinServer()
	{
		MenuUtility.Connect( Server.LobbyId );
		CloseModal( true );
	}

	void OpenGameInfo()
	{
		if ( GamePackage is null ) return;
		Discovery.Clicked( new DiscoveryContext { Surface = "server" }, GamePackage );
		Game.Overlay.ShowGameModal( Server.Game );
	}

	void OpenMapInfo()
	{
		if ( map?.WorkshopItem is null && map?.Local is null ) return;
		Game.Overlay.ShowMapModal( Server.Map );
	}

	protected override int BuildHash() => System.HashCode.Combine( Server.LobbyId, GamePackage?.Thumb, map?.WorkshopItem, map?.Local, MenuHelpers.HasAuthority );
}
