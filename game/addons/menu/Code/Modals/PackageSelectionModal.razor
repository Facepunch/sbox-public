@using Sandbox;
@using Sandbox.UI;
@using MenuProject.UI;
@using MenuProject.MenuUI.Components;
@using MenuProject.Modals.MapSelect;
@using Sandbox.Mounting;
@using MountDirectory = Sandbox.Mounting.Directory;
@namespace MenuProject.Modals
@inherits BaseModal

<root class="package-picker-modal">
	<div class="window">
		<div class="picker-header">
			<div class="heading">
				<label class="picker-title">Choose a @PackageNoun</label>
				<label class="picker-subtitle">Select a @PackageNoun to continue.</label>
			</div>
			<Button class="close-button" Icon="close" onclick=@(() => CloseModal( false )) tooltip="#menu.common.close" />
		</div>

		<div class="picker-body">
			@* Laid out like the Games page's filters - headings with their icons, the sorts a row of round
			   buttons, the search under them. That much stays put; the filters under it scroll *@
			<div class="picker-sidebar">
				<div class="sidebar-top">
					@if ( ShowMapSources )
					{
						<div class="filter-section browse-options">
							<h2><WithIcon Icon="source" Text="#menu.games.source" /></h2>
							<Button class="picker-button browse-option" Active=@(!IsMountedSource && packageSource == PackageSource.Browse) Icon="business_center" Text="#menu.games.workshop" onclick=@(() => SelectPackageSource( PackageSource.Browse )) />
							<Button class="picker-button browse-option" Active=@(!IsMountedSource && packageSource == PackageSource.Subscribed) Icon="check_circle" Text="#menu.workshop.subscribed" tooltip="#menu.workshop.subscribed_tooltip" onclick=@(() => SelectPackageSource( PackageSource.Subscribed )) />
							@foreach ( var mount in MountDirectory.GetAll().Where( mount => mount.Mounted ).OrderBy( mount => mount.Title ) )
							{
								var mapCount = GetMountMaps( mount.Ident ).Count();
								if ( mapCount == 0 ) continue;

								<button class="picker-button browse-option mount-source @(selectedMount == mount.Ident ? "active" : "")" tooltip=@($"{mount.Title} — {mapCount:N0} maps") onclick=@(() => SelectSource( mount.Ident ))>
									<icon class="mount-icon">sports_esports</icon>
									<label class="button-label">@mount.Title</label>
									<label class="mount-count">@mapCount.ToString( "N0" )</label>
								</button>
							}
						</div>
					}

					@if ( !IsMountedSource && packageSource == PackageSource.Browse )
					{
						<GamePackageSortOrder Value:bind=@sortOrder />
					}

					<TextEntry class="package-search" Text=@searchText Placeholder=@($"Search {PackageNoun}s...") OnTextEdited=@OnSearchEdited />

					@if ( IsGamePicker )
					{
						<Button class="picker-button multiplayer-filter" Active=@selectedTags.Contains( "multiplayer" ) Icon="groups" Text="#menu.games.multiplayer_only" onclick=@ToggleMultiplayer />
					}
				</div>

				<div class="sidebar-filters">
					@if ( !IsMountedSource && packageSource == PackageSource.Browse )
					{
						@if ( Result?.Properties is { Length: > 0 } )
						{
							<div class="filter-section">
								<h2><WithIcon Icon="star" Text="#menu.games.features" /></h2>
								<PackagePropertyFilter Result=@Result Selected=@selectedTags />
							</div>
						}

						@if ( Result?.Facets is not null )
						{
							@foreach ( var facet in Result.Facets.Where( x => !MenuHelpers.IsRatingFacet( x ) ) )
							{
								<div class="filter-section">
									<h2><WithIcon Icon=@(facet.Entries.FirstOrDefault()?.Icon ?? "category") Text=@facet.Title /></h2>
									<PackageCategoryFilter Result=@Result Selected=@selectedCategories Facet=@facet />
								</div>
							}
						}

						<div class="filter-section">
							<h2><WithIcon Icon="tag" Text="#menu.games.tags" /></h2>
							<PackageTagFilter Result=@Result Selected=@selectedTags />
						</div>
					}
				</div>
			</div>
			<div class="picker-results">
				<div class="results-header">
					<label class="results-title">@(IsMountedSource ? selectedMountTitle : ResultsTitle)</label>
					@if ( IsMountedSource )
					{
						<label class="results-count">@mountedMaps.Length.ToString( "N0" ) maps</label>
					}
					else if ( IsWorkshopSource && workshopPackages is not null )
					{
						<label class="results-count">@Language.GetPhrase( "menu.games.result_count", new() { ["count"] = workshopPackages.Length.ToString( "N0" ) } )</label>
					}
					else if ( !IsWorkshopSource && packageList?.FoundPackages is not null && Result is not null )
					{
						<label class="results-count">@Language.GetPhrase( "menu.games.result_count", new() { ["count"] = Result.TotalCount.ToString( "N0" ) } )</label>
					}
					@if ( IsMountedSource ? !string.IsNullOrEmpty( searchText ) : HasFilters )
					{
						<Button class="picker-button clear-filters" Icon="filter_alt_off" Text="#menu.games.clear_filters" onclick=@ClearFilters />
					}
				</div>
				@if ( !IsMountedSource )
				{
					<MenuProject.UI.PackageList @ref=packageList Surface="package-picker" Query=@SearchQuery Packages=@(IsWorkshopSource ? workshopPackages ?? Array.Empty<Package>() : null) OnSelected=@SelectPackage Take=@(100) HoverPreview=@false ShowSubscribe=@ShowMapSources />
				}
				else if ( mountedMaps.Length == 0 )
				{
					<div class="mounted-maps-empty">
						<EmptyState Icon="search_off" Title="#menu.games.no_maps_found" Subtitle="#menu.games.try_a_different_search_or_choose_another_source" />
					</div>
				}
				else
				{
					<VirtualGrid class="mounted-map-grid" Items=@mountedMaps ItemSize=@(new Vector2( 260, 200 ))>
						<Item Context="item">
							@if ( item is ResourceLoader scene )
							{
								<MapTile Title=@scene.Name Thumbnail=@((scene as IThumbnailProvider)?.Thumbnail) Tooltip=@scene.Path OnSelect=@(() => SelectMountedMap( scene.Path )) />
							}
						</Item>
					</VirtualGrid>
				}
			</div>
		</div>
	</div>
</root>
