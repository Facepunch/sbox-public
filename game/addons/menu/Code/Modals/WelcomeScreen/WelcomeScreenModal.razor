@using Sandbox
@using Sandbox.UI

@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal

<root>
	<div class="window">

		<div class="screens">

			@if ( CurrentScreen == 0 )
			{
				<div class="screen">
                    <div class="screen-header" style="background-image: url( /ui/welcome/models.mp4 )">
						<Label class="eyebrow" Text="#welcome.screen0.eyebrow"></Label>
						<Label class="title" Text="#welcome.screen0.title"></Label>
					</div>
					<div class="body">
						<Label IsRich="@true" Text="#welcome.screen0.text_1"></Label>
						<Label IsRich="@true" Text="#welcome.screen0.text_2"></Label>
                        <Label IsRich="@true" Text="#welcome.screen0.text_3"></Label>
					</div>
				</div>
			}
			else if ( CurrentScreen == 1 )
			{
				<div class="screen">
                    <div class="screen-header" style="background-image: url( /ui/welcome/editor.mp4 )">
						<Label class="eyebrow" Text="#welcome.screen1.eyebrow"></Label>
						<Label class="title" Text="#welcome.screen1.title"></Label>
					</div>
					<div class="body">
						<Label Text="#welcome.screen1.text_1"></Label>
                        <Label IsRich="@true" Text="#welcome.screen1.text_2"></Label>
						<Label Text="#welcome.screen1.text_3"></Label>
						<Button class="clicky primary learn-button" Icon="open_in_new" @onclick=@OpenLearn>#welcome.screen1.button</Button>
					</div>
				</div>
			}
			else if ( CurrentScreen == 2 )
			{
				<div class="screen">
                    <div class="screen-header" style="background-image: url( /ui/welcome/playermodel.png )">
						<Label class="eyebrow" Text="#welcome.screen2.eyebrow"></Label>
						<Label class="title" Text="#welcome.screen2.title"></Label>
					</div>
					<div class="body">
						<Label Text="#welcome.screen2.text_1"></Label>
                        <Label Text="#welcome.screen2.text_2"></Label>
                        <Label IsRich="@true" Text="#welcome.screen2.text_3"></Label>
					</div>
				</div>
			}
			else
			{
				<div class="screen no-header">
					<div class="body">
						<Label class="intro-eyebrow" Text="#welcome.screen3.eyebrow"></Label>
						<Label class="intro-title" Text="#welcome.screen3.title"></Label>
						<Label Text="#welcome.screen3.text_1"></Label>
						<div class="game-buttons">
							<div class="game-button" style="background-image: url( /ui/welcome/sandbox_mode.webm )" @onclick=@OpenSandbox>
								<div class="game-button-label">
									<Label class="game-name" Text="#welcome.screen3.intro1.game_name"></Label>
									<Label class="game-desc" Text="#welcome.screen3.intro1.game_desc"></Label>
								</div>
							</div>
							<div class="game-button" style="background-image: url( /ui/welcome/sausage_survivors.webm )" @onclick=@OpenSausageSurvivors>
								<div class="game-button-label">
									<Label class="game-name" Text="#welcome.screen3.intro2.game_name"></Label>
									<Label class="game-desc" Text="#welcome.screen3.intro2.game_desc"></Label>
								</div>
							</div>
						</div>
					</div>
				</div>
			}

		</div>

		<div class="footer">

			<div class="dots">
				@for ( var i = 0; i < ScreenCount; i++ )
				{
					var index = i;
					<div class="dot @(index == CurrentScreen ? "active" : "")" @onclick=@( () => GoTo( index ) )></div>
				}
			</div>

			<div class="actions">

				@if ( IsLastScreen )
				{
					<div class="dont-show @(DontShowAgain ? "checked" : "")" @onclick=@ToggleDontShow>
						<icon>@(DontShowAgain ? "check_box" : "check_box_outline_blank")</icon>
						<Label Text="#welcome.button_dontshow"></Label>
					</div>
				}

				<div class="grow"></div>

				@if ( CurrentScreen > 0 )
				{
					<Button class="clicky secondary" @onclick=@Previous>#welcome.button_back</Button>
				}

				@if ( !IsLastScreen )
				{
					<Button class="clicky primary" @onclick=@Next>#welcome.button_next</Button>
				}
				else
				{
					<Button class="clicky primary" @onclick=@Finish>#welcome.button_close</Button>
				}

			</div>
		</div>

	</div>
</root>

@code
{
	public const string CookieKey = "menu.welcomescreen.hidden";

	const int ScreenCount = 4;

	int CurrentScreen { get; set; } = 0;
	bool DontShowAgain { get; set; } = false;

	bool IsLastScreen => CurrentScreen == ScreenCount - 1;

	void Next()
	{
		if ( CurrentScreen < ScreenCount - 1 )
		{
			CurrentScreen++;
			StateHasChanged();
		}
	}

	void Previous()
	{
		if ( CurrentScreen > 0 )
		{
			CurrentScreen--;
			StateHasChanged();
		}
	}

	void GoTo( int index )
	{
		if ( index < 0 || index >= ScreenCount ) return;
		CurrentScreen = index;
		StateHasChanged();
	}

	void ToggleDontShow()
	{
		DontShowAgain = !DontShowAgain;
		StateHasChanged();
	}

	void Finish()
	{
		if ( DontShowAgain )
		{
			Game.Cookies.Set( CookieKey, true );
		}

		Delete();
	}

	void OpenLearn()
	{
		MenuUtility.OpenUrl( "https://sbox.game/learn" );
	}

	void OpenSandbox()
	{
		Game.Overlay.ShowGameModal( "facepunch.sandbox" );
	}

	void OpenSausageSurvivors()
	{
		Game.Overlay.ShowGameModal( "facepunch.ss2" );
	}

	protected override int BuildHash() => HashCode.Combine( CurrentScreen, DontShowAgain );
}
