@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using Sandbox.Network
@using MenuProject.Modals.MapModalComponents;
@using MenuProject.Modals.PackageModalComponents;
@attribute [StyleSheet("/Modals/PackageModals/BasePackageModal.razor.scss")]

<root>

    <MegaCard>
        <Metrics>
            @* Just report - rating's along the bottom now, the rest is on the Overview *@
            <PackageMetrics Package="@Package" />
        </Metrics>
        <Tabs>
            @* A game's tabs - the Overview's the gallery and the map's own write-up *@
            <PackageTabs @ref=MapTabs Package=@Package Portal=@Portal ShowReviews=@false>
                <Overview>
                    <PackageStore Package=@Package Portal=@Portal OnChangelogClicked="@(() => MapTabs?.OpenChanges())">
                        <Gallery><Media Package=@Package Loaded=@HasFullPackage></Media></Gallery>
                    </PackageStore>
                </Overview>
            </PackageTabs>
        </Tabs>
        <Content><PortalTarget @ref=Portal></PortalTarget></Content>

        <Footer>
            <ActionBar Modal="@this" Package="@Package"></ActionBar>
        </Footer>
    </MegaCard>

</root>

@code
{
    public Package Package;
    public string PackageIdent { get; set; }
    public bool HasFullPackage { get; set; }

    PortalTarget Portal = default;
    PackageTabs MapTabs = default;

	public List<LobbyInformation> Lobbies = new();

	async Task RefreshLobbies()
	{
		var filters = new Dictionary<string, string> { { "map", Package.FullIdent } };
		
		Lobbies = await Networking.QueryLobbies( filters );
		
		StateHasChanged();
	}

	void OnLobbySelected ( LobbyInformation lobby )
	{
        MenuUtility.Connect( lobby.LobbyId );
		CloseModal(true);
	}

    protected override async Task OnParametersSetAsync()
    {
        if (PackageIdent is null)
            return;

        // Get whatever package info we have
        Package.TryGetCached(PackageIdent, out Package, true);

        // Get Full Package info
        Package = await Package.FetchAsync(PackageIdent, false);
        HasFullPackage = true;

        await RefreshLobbies();
    }

    protected override int BuildHash() => System.HashCode.Combine(Package);
}
