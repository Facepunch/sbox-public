@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using Sandbox.Network
@using MenuProject.Modals.GameModalComponents;
@using MenuProject.Modals.PackageModalComponents;

<root>

    <MegaCard>
        <Metrics>
            @* Just report - the rest is in the info column *@
            <PackageMetrics Package="@Package" ShowRatings="@false" ShowStats="@false"/>
        </Metrics>
        <Tabs>

            <PortalButton StartActive Portal=@Portal>
                <Button>
                    <SearchlightTab Title="Overview" Icon="people" />
                </Button>
                <Content>
                    <Media Package=@Package></Media>

                    @* Under the gallery, the newest update - not the long description *@
                    <PackageChanges Package=@Package Embedded=@true />
                </Content>
            </PortalButton>

            <PortalButton @ref=ReviewsTab Portal=@Portal>
                <Button>
                    <SearchlightTab Title="Reviews" Icon="reviews" />
                </Button>
                <Content>
                    <PackageReviews Package=@Package/>
                </Content>
            </PortalButton>

            @if (Package.LatestChangeLists.Length > 0)
            {
                <PortalButton @ref=ChangesTab Portal=@Portal>
                    <Button>
                        <SearchlightTab Title="Changes" Icon="history" />
                    </Button>
                    <Content>
                        <PackageChanges Package=@Package/>
                    </Content>
                </PortalButton>
            }

            @if (Package.LatestNewsPost is not null)
            {
                <PortalButton Portal=@Portal>
                    <Button>
                        <SearchlightTab Title="News" Icon="newspaper" />
                    </Button>
                    <Content>
                        <PackageNews Package=@Package/>
                    </Content>
                </PortalButton>
            }

            @* Only for a game that has some - no empty tab *@
            @if (HasAchievements)
            {
                <PortalButton Portal=@Portal>
                    <Button>
                        <SearchlightTab Title="Achievements" Icon="emoji_events" />
                    </Button>
                    <Content>
					    <AchievementList Package=@Package />
                    </Content>
                </PortalButton>
            }

        </Tabs>
        <Left>
            <PackageInfoPanel Portal=@Portal Package="@Package" OnChangelogClicked="@(() => ChangesTab?.ActivatePage())" OnReviewsClicked="@(() => ReviewsTab?.ActivatePage())" />

        </Left>

        <Content><PortalTarget @ref=Portal></PortalTarget></Content>

        <Footer>
            <ActionBar Modal="@this" Package="@Package"></ActionBar>
        </Footer>
    </MegaCard>

</root>

@code
{
    public Package Package;
    public string PackageIdent { get; set; }
    public bool HasFullPackage { get; set; }

    public List<LobbyInformation> Lobbies = new();

    PortalTarget Portal = default;
    PortalButton ChangesTab = default;
    PortalButton ReviewsTab = default;

    async Task RefreshLobbies()
    {
        var filters = new Dictionary<string, string> { { "game", PackageIdent } };
        Lobbies = await Networking.QueryLobbies( filters );

        StateHasChanged();
    }

    void OnLobbySelected ( LobbyInformation lobby )
    {
        MenuUtility.Connect( lobby.LobbyId );
        OrganizationModal.LastOpened?.CloseModal( true );
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PackageIdent is null)
            return;

        // Get whatever package info we have
        Package.TryGetCached(PackageIdent, out Package, true);

        // Get Full Package info
        Package = await Package.FetchAsync(PackageIdent, false);
        HasFullPackage = true;

        await RefreshLobbies();
        await CheckAchievements();
    }

    /// <summary>
    /// Whether it has any achievements at all - the tab's only there if it does.
    /// </summary>
    bool HasAchievements { get; set; }

    async Task CheckAchievements()
    {
        if ( Package is null ) return;

        try
        {
            var achievements = await Package.GetAchievements();
            HasAchievements = achievements?.All.Count > 0;
        }
        catch ( Exception e )
        {
            Log.Warning( $"Couldn't check {PackageIdent}'s achievements: {e.Message}" );
            HasAchievements = false;
        }

        StateHasChanged();
    }

    protected override int BuildHash() => System.HashCode.Combine(Package, HasAchievements);
}
