@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using Sandbox.Network
@using Sandbox.Modals
@using MenuProject.Modals.GameModalComponents;
@using MenuProject.Modals.PackageModalComponents;
@using MenuProject.MenuUI.Components.Multiplayer;

<root>

    <MegaCard>
        <Metrics>
            @* Just report - the rest is in the info column *@
            <PackageMetrics Package="@Package" ShowRatings="@false" ShowStats="@false"/>
        </Metrics>
        <Tabs>
            @* Setting up a new game, or looking through who's playing it - a trail back to the game's page
               in the tabs' place *@
            @if ( IsSettingUp || IsBrowsingSessions )
            {
                <div class="setup-trail">
                    <div class="back" onclick=@( () => { if ( IsBrowsingSessions ) CloseSessions(); else CloseSetup(); } )>
                        <i>arrow_back</i>
                        <label>@Package?.Title</label>
                    </div>
                    <label class="sep">/</label>
                    <label class="here">@(IsBrowsingSessions ? "Sessions" : PartySetup ? "Party game" : "New game")</label>
                </div>
            }

            @* A game's tabs - the Overview's the gallery and the newest update under it. Kept while
               setting up, just not shown, so the page is as it was left on the way back *@
            <PackageTabs @ref=GameTabs Package=@Package Portal=@Portal>
                <Overview>
                    <Media Package=@Package Loaded=@HasFullPackage Failed=@FetchFailed></Media>
                    <PackageChanges Package=@Package Embedded=@true />
                </Overview>
            </PackageTabs>
        </Tabs>
        <Left>
            <PackageInfoPanel Portal=@Portal Package="@Package" OnChangelogClicked="@(() => GameTabs?.OpenChanges())" OnReviewsClicked="@(() => GameTabs?.OpenReviews())" />

        </Left>

        <Content>
            <PortalTarget @ref=Portal></PortalTarget>

            @if ( Setup is not null )
            {
                <GameSetupView Setup=@Setup ReadOnly=@SetupReadOnly Notice=@SetupNotice Error=@SetupError />
            }
            else if ( IsSettingUp )
            {
                <div class="setup-loading">
                    <label>@(SetupError ?? "Loading game settings…")</label>
                </div>
            }
            else if ( IsBrowsingSessions )
            {
                @* Its servers and lobbies - the server browser's list, just this game's *@
                <div class="sessions">
                    <ServerList Config=@(new ServerListConfig( Package?.FullIdent )) ShowGameHeader=@false Virtual=@false />
                </div>
            }
        </Content>

        <Footer>
            <ActionBar Modal="@this" Package="@Package"></ActionBar>
        </Footer>
    </MegaCard>

</root>

@code
{
    public Package Package;
    public string PackageIdent { get; set; }
    public bool HasFullPackage { get; set; }

    /// <summary>
    /// The full package didn't come - the page is showing what was cached, which has no gallery.
    /// </summary>
    public bool FetchFailed { get; set; }

    public List<LobbyInformation> Lobbies = new();

    PortalTarget Portal = default;
    PackageTabs GameTabs = default;

    /// <summary>
    /// Looking through who's playing it, in the page's place like setting up a game - its servers and
    /// lobbies, and a way into each.
    /// </summary>
    internal bool IsBrowsingSessions { get; private set; }

    public void OpenSessions()
    {
        if ( IsSettingUp ) CloseSetup();

        IsBrowsingSessions = true;
        SetClass( "setting-up", true );
        StateHasChanged();
    }

    /// <summary>
    /// Back to the game's page.
    /// </summary>
    public void CloseSessions()
    {
        IsBrowsingSessions = false;
        SetClass( "setting-up", IsSettingUp );
        StateHasChanged();
    }

    /// <summary>
    /// Setting up a new game of it, in the page's place - null when it's just showing the game.
    /// </summary>
    public GameSetup Setup { get; private set; }

    internal bool IsSettingUp { get; private set; }
    int setupRequest;

    /// <summary>
    /// Load the full package before creating its game setup, including its map and custom settings.
    /// The optional callback receives the completed setup instead of launching a game.
    /// </summary>
    public async Task OpenSetup( Package package, Action<CreateGameResults> onComplete, string via = null, Panel source = null, CreateGameResults? initialSettings = null, bool partyActions = false, PartyDraft draft = null, string initialMap = null )
    {
        var request = ++setupRequest;
        var ident = (package ?? Package).FullIdent;
        var maxMembers = draft?.MaxMembers ?? (partyActions && PartyView.Exists ? PartyView.MaxMembers : 0);
        Setup = null;
        IsSettingUp = true;
        InitializePartySetup( partyActions, draft );
        SetClass( "setting-up", true );
        StateHasChanged();

        try
        {
            var full = await Package.FetchAsync( ident, false );

            // The player may have closed this setup or opened another while it was loading.
            if ( !IsValid || request != setupRequest ) return;
            if ( full is null ) throw new InvalidOperationException( "Couldn't load game settings. Cancel and try again." );

            // Picker results omit game settings and player limits. Defaults need the full package too.
            var settings = initialSettings ?? GameSetup.GetInitialSettings( full, maxMembers );
            if ( initialMap is not null ) settings.Map = initialMap;
            Setup = new GameSetup( full, onComplete, settings ) { Via = via, Source = source };
        }
        catch ( Exception e )
        {
            if ( !IsValid || request != setupRequest ) return;
            SetupError = e.Message;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Back to the game's page.
    /// </summary>
    public void CloseSetup()
    {
        setupRequest++;
        IsSettingUp = false;
        Setup = null;
        SetClass( "setting-up", false );
        StateHasChanged();
    }

    /// <summary>
    /// Return to the party when configuring its game, or back to the game page otherwise.
    /// </summary>
    public override bool Back()
    {
        if ( IsBrowsingSessions )
        {
            CloseSessions();
            return true;
        }

        if ( !IsSettingUp ) return false;

        CancelSetup();
        return true;
    }

    /// <summary>
    /// Start a standalone game with the chosen setup, or return it to the original caller.
    /// </summary>
    public async Task StartSetup()
    {
        if ( Setup is not { } setup || !CanStartSetup ) return;

        SetupBusy = true;
        SetupError = null;
        try
        {
            var results = setup.Finish();

            if ( setup.Via is not null )
                Discovery.Launching( setup.Package, setup.Via, setup.Source.IsValid() ? setup.Source : null );

            if ( partyActions )
            {
                if ( PartyView.IsMocking ) return;
                await MenuHelpers.StartConfiguredGame( setup.Package, results, PartyRoom.Current );
            }
            else
            {
                CloseModal( true );
                setup.OnComplete?.Invoke( results );
            }
        }
        catch ( Exception e )
        {
            LoadingScreen.IsVisible = false;
            if ( IsValid ) SetupError = e.Message;
            ModalSystem.Instance?.Notice( "Couldn't start game", e.Message, "error" );
        }
        finally
        {
            SetupBusy = false;
            if ( IsValid ) StateHasChanged();
        }
    }

    async Task RefreshLobbies()
    {
        var filters = new Dictionary<string, string> { { "game", PackageIdent } };
        Lobbies = await Networking.QueryLobbies( filters );

        StateHasChanged();
    }

    void OnLobbySelected ( LobbyInformation lobby )
    {
        MenuUtility.Connect( lobby.LobbyId );
        OrganizationModal.LastOpened?.CloseModal( true );
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PackageIdent is null)
            return;

        Discovery.PreviewOpened( "page", PackageIdent );

        // Get whatever package info we have - keeping the one it was opened with if there's none cached
        if ( Package.TryGetCached( PackageIdent, out var cached, true ) ) Package = cached;

        // Get Full Package info - keeping what we had if it doesn't come, so the page still has
        // something on it and can say what didn't load
        Package full = null;
        try
        {
            full = await Package.FetchAsync(PackageIdent, false);
        }
        catch ( Exception e )
        {
            Log.Warning( $"Couldn't fetch {PackageIdent}: {e.Message}" );
        }

        if ( full is not null ) Package = full;
        HasFullPackage = full is not null;
        FetchFailed = full is null;
        StateHasChanged();

        await RefreshLobbies();
    }

    public override void OnDeleted()
    {
        base.OnDeleted();
        Discovery.PreviewClosed( "page", PackageIdent );
    }

    protected override int BuildHash() => System.HashCode.Combine(Package, HasFullPackage, FetchFailed, Setup, SetupReadOnly, SetupNotice, SetupError, HashCode.Combine( IsSettingUp, IsBrowsingSessions ));
}
