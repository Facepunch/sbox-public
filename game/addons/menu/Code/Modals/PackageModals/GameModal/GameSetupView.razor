@namespace MenuProject.Modals.GameModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using MenuProject.Settings

@*
    Setting up a new game, in the game page's place - laid out like the settings page, with its rows
    (SettingsRow): the game (where it starts, its general settings), the server (its name, who can
    join, how many), then each group of the game's own settings. The game page's footer starts it
    (ActionBar); its trail goes back.
*@
@if ( Setup is null )
    return;

<root>

    @if ( !string.IsNullOrEmpty( Notice ) )
    {
        <div class="setup-notice"><icon>group</icon><label>@Notice</label></div>
    }
    @if ( !string.IsNullOrEmpty( Error ) )
    {
        <div class="setup-notice error"><icon>error</icon><label>@Error</label></div>
    }

    @if ( Setup.NeedsMap || Setup.ItemsIn( null ).Any() )
    {
        <div class="section">
            <div class="section-label"><icon>sports_esports</icon><label>Game</label></div>

            @* Drawn here rather than a SettingsRow - a picture of it, which picks another *@
            @if ( Setup.NeedsMap )
            {
                <div class="row map-row">
                    <div class="line">
                        <label class="name">Map</label>
                        <div class="control">
                            @if ( ReadOnly )
                            {
                                <label>@Setup.MapTitle</label>
                            }
                            else
                            {
                                <MapSelector Map=@Setup.Map GamePackage=@Setup.Package OnValueChanged=@OnMapChanged OnSelectorOpened=@OnMapSelectorOpened />
                            }
                        </div>
                    </div>
                </div>
            }

            @foreach ( var item in Setup.ItemsIn( null ) )
            {
                <SettingsRow @key=@item Item=@item ReadOnly=@ReadOnly />
            }
        </div>
    }

    @if ( Setup.IsMultiplayer )
    {
        <div class="section">
            <div class="section-label"><icon>dns</icon><label>Server</label></div>

            <SettingsRow Item=@Setup.ServerNameItem ReadOnly=@ReadOnly />
            <SettingsRow Item=@Setup.PrivacyItem ReadOnly=@ReadOnly />

            @if ( Setup.HasPlayerRange )
            {
                <SettingsRow Item=@Setup.PlayersItem ReadOnly=@ReadOnly />
            }
        </div>
    }

    @foreach ( var group in Setup.OtherGroups )
    {
        <div class="section">
            <div class="section-label"><icon>tune</icon><label>@group</label></div>

            @foreach ( var item in Setup.ItemsIn( group ) )
            {
                <SettingsRow @key=@item Item=@item ReadOnly=@ReadOnly />
            }
        </div>
    }

</root>

@code
{
    /// <summary>
    /// The local game settings displayed by this editor.
    /// </summary>
    [Parameter] public GameSetup Setup { get; set; }

    /// <summary>
    /// Show the settings as values without editable controls.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Explain how this setup relates to the player's party.
    /// </summary>
    [Parameter] public string Notice { get; set; }

    /// <summary>
    /// A problem applying or starting the setup.
    /// </summary>
    [Parameter] public string Error { get; set; }

    GameSetup selectingMapFor;

    void OnMapSelectorOpened()
    {
        selectingMapFor = Setup;
    }

    void OnMapChanged( string map )
    {
        if ( ReadOnly || !IsValid || selectingMapFor != Setup ) return;
        Setup.Map = map;
        StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine( Setup, Setup?.Map, Setup?.MapTitle, ReadOnly, Notice, Error );
}
