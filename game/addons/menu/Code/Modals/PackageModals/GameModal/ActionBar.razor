@namespace MenuProject.Modals.GameModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using Sandbox.Network
@using Sandbox.Modals
@using Sandbox.Services
@using Sandbox.DataModel
@using Sandbox.UI.Navigation
@using MenuProject.Modals.PackageModalComponents

<root>

    @* Setting up a new game - what it'll be at a glance, and the button that starts it *@
    @if ( Modal?.Setup is { } setup )
    {
        <div class="left setup-summary">
            @if ( setup.NeedsMap )
            {
                @* Its picture behind the glyph, fading out a way in - and another picked from it, like the map row's *@
                <div class="chip map" onclick=@( () => PickMap( setup ) )>
                    <div class="art" @ref="MapArt"></div>
                    <i>map</i>
                    <label>@setup.MapTitle</label>
                </div>
            }

            @if ( setup.IsMultiplayer )
            {
                <div class="chip">
                    <i>@setup.PrivacyIcon</i>
                    <label>@setup.PrivacyTitle</label>
                </div>

                @if ( setup.HasPlayerRange )
                {
                    <div class="chip">
                        <i>group</i>
                        <label>@setup.MaxPlayers players</label>
                    </div>
                }
            }
        </div>

        <div class="right">
            @if ( Modal.PartySetup )
            {
                <Button Text="#menu.common.cancel" onclick=@Modal.CancelSetup />
                @if ( !Modal.SetupReadOnly )
                {
                    <Button Icon="@(Modal.EditingPartyDraft ? "arrow_forward" : "save")" class="play" Text=@Modal.SaveSetupText Disabled=@(!Modal.CanApplySetup) onclick=@Modal.SavePartySetup />
                }
            }
            else if ( Modal.CanCreateParty )
            {
                <Button Icon="group_add" Text="#menu.games.create_party" Disabled=@(!Modal.CanApplySetup) onclick=@Modal.CreatePartyFromSetup />
            }
            @if ( !Modal.PartySetup )
            {
                <Button Icon="play_arrow" class="play" Text=@Modal.StartSetupText Disabled=@(!Modal.CanStartSetup) onclick=@Modal.StartSetup />
            }
        </div>
    }
    else if ( Modal?.IsSettingUp == true )
    {
        <div class="left"></div>
        <div class="right"><Button Text="#menu.common.cancel" onclick=@Modal.CancelSetup /></div>
    }
    else
    {

    <div class="left">
        @* Not until it's known whose they are - the backend's, or its workshop item's *@
        @if (Modal?.PageLoading == false)
        {
            <PackageReactions Package=@Package OnWorkshop=@Modal.OnWorkshop Workshop=@Modal.WorkshopItem OnHidden=@(() => Modal?.CloseModal( false )) />

            @* Subscribing, by its votes - they're on Steam too *@
            @if (Modal.OnWorkshop)
            {
                <WorkshopSubscribe Package=@Package />
            }
        }
    </div>

    <div class="right">

        @* On the right, by the play buttons - it's another way in *@
	    @* Not while they're up already *@
	    @if ( Modal?.IsBrowsingSessions == true )
	    {
	    }
	    else if ( IsDedicatedServerOnly )
	    {
		    <Button icon="list" Disabled=@(LobbyCount == 0 || !MenuHelpers.HasAuthority) onclick=@OpenLobbyList>@LobbyCount Servers</Button>
	    }
	    else if ( IsMultiplayerGame )
        {
			<Button icon="list" Disabled=@(LobbyCount == 0 || !MenuHelpers.HasAuthority) onclick=@OpenLobbyList>@LobbyCount Lobbies</Button>
        }

        @if (Modal.HasFullPackage)
        {
            if (NeedsMap())
            {
                @if (MapPackage is null)
                {
                    <Button icon="map" onclick=@SelectMap>#menu.games.select_map</Button>
                }
                else
                {
                    <Button icon="map" onclick=@SelectMap>@MapPackage.Title</Button>
                }
            }

            @if ( Package.Info.IsStreamerGame )
            {
                var text = Streamer.IsActive ? $"{Streamer.ViewerCount} Viewers" : "#menu.games.stream_setup";

                <Button Active=@Streamer.IsActive Text="@text" Icon="settings_input_antenna" class="streaming" @onclick="@(() => Game.Overlay.ShowServiceConnector())"></Button>
            }

            @if (IsVrOnly && !Application.IsVR)
            {
                <Button icon="panorama_photosphere" class="play disabled">#menu.games.vr_only</Button>
            }
            else
            {
	            @if ( IsDedicatedServerOnly )
	            {
					<Button icon="auto_awesome" class="play" Disabled=@(!MenuHelpers.HasAuthority) onclick=@OpenLobbyList>#menu.games.view_servers_label</Button>
	            }
	            else
	            {
		            @if (IsMultiplayerGame && !IsQuickPlayGame)
		            {
                        @* New and Join as one split pill, like the vote pair - two ways into the same game *@
                        <div class="play-split">
                            <Button Icon="play_arrow" class="play" Text="#menu.games.new_game" Disabled=@(!MenuHelpers.HasAuthority || !IsReady()) onclick=@OnPlay />
                            <div class="split"></div>
                            <Button icon="auto_awesome" class="join" Disabled=@(LobbyCount == 0 || !MenuHelpers.HasAuthority) onclick=@OnJoinGame Text="#menu.games.join_game"></Button>
                        </div>
		            }
		            else
		            {
                        <Button Icon="play_arrow" class="play" Text="#menu.games.play_game" Disabled=@(!MenuHelpers.HasAuthority || !IsReady()) onclick=@OnPlay />
		            }
	            }
            }
        }
        else
        {
            <Button Icon="play_arrow" class="play disabled">#menu.games.play_game</Button>
        }
    </div>
    }

</root>

@code
{
    [Parameter] public GameModal Modal {get;set;}
    [Parameter] public Package Package {get;set;}
    [Parameter] public Package MapPackage { get; set; }

    Panel MapArt;
    Texture _mapArt;

    void PickMap( GameSetup setup )
    {
        if ( Modal.SetupReadOnly ) return;
        Game.Overlay.ShowMapSelector( map =>
        {
            if ( IsValid && Modal.Setup == setup && !Modal.SetupReadOnly ) setup.Map = map;
        }, setup.Map );
    }

    public override void Tick()
    {
        base.Tick();

        // A texture rather than a url (a mounted scene's has none), so it's set here rather than in a style
        var art = Modal?.Setup?.MapThumb;
        if ( art == _mapArt || !MapArt.IsValid() ) return;

        _mapArt = art;
        MapArt.Style.SetBackgroundImage( art );
    }

    protected override int BuildHash() => System.HashCode.Combine(Package, HashCode.Combine( Modal?.HasFullPackage, Modal?.PageLoading, Modal?.OnWorkshop, Modal?.WorkshopItem ), IsVrOnly, IsMultiplayerGame, LobbyCount, MenuHelpers.HasAuthority, System.HashCode.Combine( Streamer.IsActive, Streamer.ViewerCount, Modal?.Setup, System.HashCode.Combine( Modal?.Setup?.MapTitle, Modal?.Setup?.MapThumb, Modal?.Setup?.Privacy, Modal?.Setup?.MaxPlayers ) ), HashCode.Combine( Modal?.SetupReadOnly, Modal?.CanApplySetup, Modal?.StartSetupText, Modal?.IsSettingUp, Modal?.IsBrowsingSessions ));

    bool IsVrOnly => Package.Info.IsVrOnly;
    bool IsMultiplayerGame => Package.Tags.Contains("multiplayer") || LobbyCount > 0 || Package.Info.MaxPlayers > 1;
    bool IsQuickPlayGame => Package.Info.IsQuickPlay;
    bool IsDedicatedServerOnly => Package.Info.IsDedicatedServerOnly;
    int LobbyCount => Modal?.Lobbies?.Count() ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        var map = Package.Info.DefaultMap;
        if ( !string.IsNullOrWhiteSpace(map ) )
        {
            MapPackage = await Package.FetchAsync(map, false);
        }
    }

    void OnPlay()
    {
		MenuHelpers.PlayGame( Package, MapPackage, "gamepage" );
    }

    async Task<bool> OnJoinGame()
    {
        // Your party isn't what it's made for - say so first, joining only if you want to anyway
        if ( !MenuHelpers.ConfirmPartyFit( Package, () => _ = JoinGame(), Modal?.OnWorkshop == true ? Modal.WorkshopItem : null ) )
            return false;

        return await JoinGame();
    }

    async Task<bool> JoinGame()
    {
        // The preview must still be open when the play action is recorded.
        Discovery.Launching( Package, "gamepage-join" );

        // Out of the way first - joining can hold things up, and the modal would freeze mid-close
        await MenuHelpers.PrepareForLoad( "#menu.games.finding_game", "#menu.games.please_wait_while_we_find_a_game_for_you_to_join" );

        bool success = await MenuUtility.TryJoinLobby(Package.FullIdent);
        if (success)
            return true;
            
        LoadingScreen.IsVisible = false;
        ModalSystem.Instance.Notice( "#menu.games.join_game_failed", "#menu.games.couldn_t_join_any_available_games", "search_off" );
        return false;
    }

    // Them in this window, in the page's place - not a list of its own over it
    void OpenLobbyList() => Modal?.OpenSessions();

    bool NeedsMap()
    {
        if (Package is null) return false;

        if ( Package.Info.UsesCreateGameModal )
            return false;

        if ( Package.Info.HasGameSettings )
            return false;

        if ( Package.Info.NeedsMap ) return true;

        // legacy
        var launchMode = Package.Info.LaunchMode;
        return string.Equals(launchMode, "launcher", StringComparison.OrdinalIgnoreCase);
    }

    bool IsReady()
    {
        if (NeedsMap() && MapPackage is null) return false;
        return true;
    }

    void SelectMap()
    {
        var mapTarget = Package.Info.MapTarget;

        Game.Overlay.ShowPackageSelector($"type:map sort:popular target:{mapTarget}", (pkg) =>
        {
            MapPackage = pkg;
            StateHasChanged();
        });
    }

    /// <summary>
    /// Refresh the localized privacy summary when translations change.
    /// </summary>
    public override void LanguageChanged()
    {
        base.LanguageChanged();
        StateHasChanged();
    }
}
