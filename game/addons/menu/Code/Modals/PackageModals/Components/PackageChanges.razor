@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using System.Collections.Immutable;

@* The Changes tab - a timeline, newest first. Each update is a card on a line down the left: its
   name, version and when, then what's in it by kind - added, improved, fixed, removed, known
   issues - each kind with its own colour. Kinds with nothing in them aren't shown at all.

   Embedded (on the Overview, under the gallery) it's just the newest card, and nothing at all for a
   game that's never published one. *@

<root class="@(Embedded ? "embedded" : "")">

    @if (!_loaded)
    {
        @* The shape of an update card while it loads - one on the Overview (only if the game's
           published any, so a game with none doesn't flash one), two on the Changes tab *@
        @if (!Embedded || Package?.LatestChangeLists.Length > 0)
        {
            <div class="timeline">
                @for (var i = 0; i < (Embedded ? 1 : 2); i++)
                {
                    <div class="update skeleton @(i == 0 ? "latest" : "")">
                        <div class="rail">
                            <div class="dot"></div>
                            <div class="line"></div>
                        </div>

                        <div class="card">
                            <div class="card-head">
                                <div class="bone title-bone"></div>
                                <div class="bone pill-bone"></div>
                            </div>
                            <div class="sections">
                                <div class="bone-section">
                                    <div class="bone heading-bone"></div>
                                    <div class="bone line-bone"></div>
                                    <div class="bone line-bone short"></div>
                                    <div class="bone line-bone shorter"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (_changeLists.Length == 0)
    {
        @if (!Embedded)
        {
            <div class="state">This package hasn't published any changelists.</div>
        }
    }
    else
    {
        <div class="timeline">
            @for (var i = 0; i < Shown; i++)
            {
                var change = _changeLists[i];
                var latest = i == 0;
                var last = i == Shown - 1;
                var hasTitle = !string.IsNullOrWhiteSpace(change.Title);
                var dateText = change.Created.LocalDateTime.ToString("d MMMM yyyy");

                <div class="update @(latest ? "latest" : "") @(last ? "last" : "")">

                    @* The line down the left, a dot for each update on it *@
                    <div class="rail">
                        <div class="dot"></div>
                        <div class="line"></div>
                    </div>

                    <div class="card">
                        <div class="card-head">
                            <div class="title-row">
                                <label class="update-name" tooltip="@(hasTitle ? change.Title : dateText)">@(hasTitle ? change.Title : dateText)</label>
                                @if (latest)
                                {
                                    <label class="latest-pill">Latest update</label>
                                }
                            </div>

                            @* How long ago, the date itself on hover - not the version number, which means
                               nothing to a player *@
                            <div class="meta-row">
                                <div class="ago" tooltip="@dateText"><i>schedule</i><label>@MenuHelpers.TimeAgo( change.Created )</label></div>
                            </div>
                        </div>

                        <div class="sections">
                            @if (change.Added.Length > 0) { <PackageChangeSection ClassName="add" Entries="@change.Added" Icon="add_circle" Title="Added" /> }
                            @if (change.Improved.Length > 0) { <PackageChangeSection ClassName="improve" Entries="@change.Improved" Icon="auto_awesome" Title="Improved" /> }
                            @if (change.Fixed.Length > 0) { <PackageChangeSection ClassName="fix" Entries="@change.Fixed" Icon="build" Title="Fixed" /> }
                            @if (change.Removed.Length > 0) { <PackageChangeSection ClassName="remove" Entries="@change.Removed" Icon="remove_circle" Title="Removed" /> }
                            @if (change.KnownIssues.Length > 0) { <PackageChangeSection ClassName="knownissue" Entries="@change.KnownIssues" Icon="warning" Title="Known Issues" /> }
                        </div>
                    </div>

                </div>
            }
        </div>
    }
</root>

@code
{
    [Parameter] public Package Package { get; set; }

    /// <summary>
    /// Just the newest, no scrolling of its own - for the Overview.
    /// </summary>
    [Parameter] public bool Embedded { get; set; }


    int Shown => Embedded ? Math.Min( _changeLists.Length, 1 ) : _changeLists.Length;

    ImmutableArray<Package.ChangeList> _changeLists = ImmutableArray<Package.ChangeList>.Empty;
    bool _loaded;

    protected override int BuildHash() => System.HashCode.Combine(Package, _loaded, _changeLists.Length, Embedded);

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _changeLists = ImmutableArray<Package.ChangeList>.Empty;
        StateHasChanged();

        if (Package is null)
            return;

        _changeLists = await Package.GetChangeListsAsync();
        _loaded = true;
        StateHasChanged();
    }
}
