@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;

@*
    The column beside a game's page, laid out like Steam's: the capsule, the name, what it is in a
    line or two, then the facts as label and value - how it's reviewed, its latest update, when it
    came out, who made it, how many play it. Achievements under that, and the tags at the
    bottom.
*@

<root>

    @* What it is - stays put at the top; everything under it scrolls *@
    <div class="panel-top">
        <div class="media-wrapper">
            @* A workshop item's thumbnail is square - all of it shows, at the frame's height, rather than cropped to its width *@
            @if (Loading)
            {
                <div class="panel-media bone"></div>
            }
            else
            {
                <div class="panel-media @(OnWorkshop ? "fit-height" : "")" style="background-image: url(@(OnWorkshop ? Workshop?.Thumb ?? Package.Thumb : Package.ThumbWide ?? Package.Thumb))"></div>
            }
        </div>

        <div class="panel-header">
            <label class="game-title">@(Workshop?.Title ?? Package.Title)</label>

            @* On the workshop its description's on the Overview - the summary's the backend's *@
            @if (!Loading && !OnWorkshop && !string.IsNullOrWhiteSpace(Package.Summary))
            {
                <label class="game-summary">@Package.Summary</label>
            }
        </div>

        @* How it's played - on your own, together, against each other - up where you can't miss it,
           with how many it's for. Green when your party's what it's made for, orange when it isn't (the
           why's for the popup when you go to play), plain when the game doesn't say. Nothing when it
           says nothing at all *@
        @if (!Loading && PlayerModes.For(Package, OnWorkshop ? Workshop : null) is { Label: { } modeLabel } modes)
        {
            var fit = modes.FitFor( PlayerModes.PartySize );

            <div class="play-mode @FitClass( fit.Fit )">
                <div class="mode-icon"><i>@(fit.Fit == PlayerModes.FitKind.Poor ? "group_off" : modes.Icon)</i></div>
                <div class="mode-text">
                    <label class="mode-label">@modeLabel</label>
                    <label class="mode-hint">@ModeHint( modes )</label>
                </div>
            </div>
        }
    </div>

    <div class="panel-scroll">
    <div class="panel-sections">

        @* Label on the left, value on the right - one per line. On the workshop, the facts are its item's. Bones
           until it's known which *@
        @if (Loading)
        {
            <div class="facts">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="fact">
                        <div class="bone key-bone"></div>
                        <div class="bone value-bone"></div>
                    </div>
                }
            </div>
        }
        else if (OnWorkshop)
        {
            <div class="facts">
                <div class="fact">
                    <label class="key">#menu.workshop.rating</label>
                    <div class="value">
                        @if (Workshop is { } votes)
                        {
                            var total = votes.VotesUp + votes.VotesDown;
                            <label class="rating @RatingClass( total, VoteScore( votes ) )">@(total > 0 ? RatingText( total, VoteScore( votes ) ) : "#menu.workshop.no_votes_yet")</label>
                            @if (total > 0)
                            {
                                <label class="muted">(@total.ToString("N0"))</label>
                            }
                        }
                    </div>
                </div>

                @if (Workshop is { } item)
                {
                    <div class="fact clickable" @onclick="@(() => OnChangelogClicked?.Invoke())">
                        <label class="key">#menu.games.updated</label>
                        <div class="value"><label>@MenuHelpers.TimeAgo( item.Updated )</label></div>
                    </div>

                    <div class="fact">
                        <label class="key">#menu.games.released</label>
                        <div class="value"><label>@item.Created.ToLocalTime().ToString("d MMM yyyy")</label></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.OwnerName))
                    {
                        <div class="fact">
                            <label class="key">#menu.games.creator</label>
                            <div class="value">
                                <img class="org-thumb" src="avatar:@item.OwnerId" />
                                <label class="creator-name" tooltip="@item.OwnerName">@item.OwnerName</label>
                            </div>
                        </div>
                    }

                    <div class="fact">
                        <label class="key">#menu.workshop.subscribers</label>
                        <div class="value">
                            <div class="stat" tooltip="#menu.workshop.subscribers_tooltip">
                                <i>group</i>
                                <label>@item.Subscriptions.ToMetric()</label>
                            </div>
                        </div>
                    </div>

                    @if (item.Size > 0)
                    {
                        <div class="fact">
                            <label class="key">#menu.workshop.file_size</label>
                            <div class="value">
                                <div class="stat">
                                    <i>storage</i>
                                    <label>@MenuHelpers.FormatSize( item.Size )</label>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
        <div class="facts">
            @if (ShowReviews)
            {
                <div class="fact @(Package.Reviews.Total > 0 ? "clickable" : "")" @onclick="@(() => { if ( Package.Reviews.Total > 0 ) OnReviewsClicked?.Invoke(); })">
                    <label class="key">#menu.games.reviews</label>
                    <div class="value">
                        <label class="rating @RatingClass( Package )">@RatingText( Package )</label>
                        @if (Package.Reviews.Total > 0)
                        {
                            <label class="muted">(@Package.Reviews.Total.ToString("N0"))</label>
                        }
                    </div>
                </div>
            }

            @* The update itself is under the gallery on the Overview - here, just when, and a way to
               the Changes tab if there's a changelog *@
            <div class="fact @(LatestChange is not null ? "clickable" : "")" @onclick="@(() => { if ( LatestChange is not null ) OnChangelogClicked?.Invoke(); })">
                <label class="key">#menu.games.updated</label>
                <div class="value"><label>@MenuHelpers.TimeAgo( Package.Updated )</label></div>
            </div>

            @if (Package.Created != default)
            {
                <div class="fact">
                    <label class="key">#menu.games.released</label>
                    <div class="value"><label>@Package.Created.ToLocalTime().ToString("d MMM yyyy")</label></div>
                </div>
            }

            @if (Package.Org != null)
            {
                <div class="fact clickable" @onclick=@OrgClicked>
                    <label class="key">#menu.games.creator</label>
                    <div class="value">
                        <img class="org-thumb" src="@Package.Org.Thumb" />
                        <label class="link creator-name" tooltip="@Package.Org.Title">@Package.Org.Title</label>
                    </div>
                </div>
            }

            <div class="fact">
                <label class="key">#menu.games.players</label>
                <div class="value">
                    <div class="stat" tooltip="#menu.games.players_all_time">
                        <i>group</i>
                        <label>@Package.Usage.Total.Users.ToMetric()</label>
                    </div>
                </div>
            </div>
        </div>
        }

        @* You and it - your time, against everyone's, and what you've got to show for it. Once you've played it.
           The backend's numbers, so not on the workshop *@
        @if (!Loading && !OnWorkshop && Package.Interaction.Used)
        {
            <PackageYourRecord Package=@Package />
        }

        @if (!Loading && achList is not null)
        {
            <PortalButton Portal=@Portal>
                <Button>
                    <Card class="achievements-card">
                        <ChildContent>
                            <PackageAchievementSummary Package="@Package" Header=@true />
                        </ChildContent>
                    </Card>
                </Button>
                <Content>
                    <AchievementList Package="@Package"></AchievementList>
                </Content>
            </PortalButton>
        }

        @* Last of all, at the very bottom - the backend's tags, a workshop item's only say what it is *@
        @if (!Loading && !OnWorkshop && Package.Tags?.Length > 0)
        {
            <Card class="tags-card">
                <ChildContent>
                    <label class="section-label">#menu.games.tags</label>
                    <div class="tag-list">
                        @foreach (var tag in Package.Tags)
                        {
                            <div class="tag">@tag</div>
                        }
                    </div>
                </ChildContent>
            </Card>
        }

    </div>
    </div>

</root>

@code
{
	[Parameter] public Package Package { get; set; }
	[Parameter] public PortalTarget Portal { get; set;  }

	/// <summary>Called when the latest update is clicked - opens the Changes tab.</summary>
	[Parameter] public Action OnChangelogClicked { get; set; }

	/// <summary>Called when the reviews row is clicked - opens the Reviews tab.</summary>
	[Parameter] public Action OnReviewsClicked { get; set; }


	/// <summary>How it's reviewed, first of the facts - not in the pause menu.</summary>
	[Parameter] public bool ShowReviews { get; set; } = true;

	/// <summary>
	/// What the Steam Workshop says about it, for a package on the workshop - its facts come from that instead of
	/// the backend. Null while it's being asked.
	/// </summary>
	[Parameter] public WorkshopItemDetails Workshop { get; set; }

	/// <summary>
	/// Still working out what it says - whether it's the backend's or its workshop item's. Bones in the meantime.
	/// </summary>
	[Parameter] public bool Loading { get; set; }

	/// <summary>
	/// Say what the Steam Workshop says, not the backend - the game page, for a package on the workshop. The backend's
	/// parts go.
	/// </summary>
	[Parameter] public bool OnWorkshop { get; set; }

	/// <summary>
	/// How much of its Steam votes are up, 0 to 100 - its rating's score, like a review score
	/// </summary>
	static float VoteScore( WorkshopItemDetails item )
	{
		var total = item.VotesUp + item.VotesDown;
		return total > 0 ? item.VotesUp * 100f / total : 0;
	}

	AchievementCollection achList;

	/// <summary>
	/// The mode's own sentence, and how many can play when the full package says - "Team up with
	/// friends · up to 8 players".
	/// </summary>
	/// <summary>
	/// What it's like, and how many it's for - what it's made for when it says, the lobby's limit if not.
	/// </summary>
	string ModeHint( MenuProject.PlayerModes modes )
	{
		if ( modes.PlayersText is { } players ) return $"{modes.Hint} · {players}";

		var max = modes.MaxPlayers > 0 ? modes.MaxPlayers : Package?.Info.MaxPlayers ?? 0;
		return modes.Multiplayer && max > 1 ? $"{modes.Hint} · up to {max} players" : modes.Hint;
	}

	static string FitClass( MenuProject.PlayerModes.FitKind fit ) => fit switch
	{
		MenuProject.PlayerModes.FitKind.Good => "fits",
		MenuProject.PlayerModes.FitKind.Poor => "mismatch",
		_ => ""
	};

	Package.ChangeListSummary? LatestChange => Package?.LatestChangeLists is { Length: > 0 } lists
		? lists.OrderByDescending( x => x.Created ).First()
		: null;

	/// <summary>
	/// Steam's words for a review score - how positive, and how sure (how many reviews) it is.
	/// Under ten reviews there's not enough to say. The pause menu's Overview says it too.
	/// </summary>
	public static string RatingText( Package package ) => RatingText( package.Reviews.Total, package.Reviews.Score );

	/// <inheritdoc cref="RatingText(Package)"/>
	static string RatingText( int total, float score )
	{
		if ( total <= 0 ) return "#menu.games.no_reviews_yet";
		if ( total < 10 ) return $"{total} review{(total == 1 ? "" : "s")}";

		if ( score >= 80 )
		{
			if ( score >= 95 && total >= 500 ) return "#menu.games.overwhelmingly_positive";
			return total >= 50 ? "#menu.games.very_positive" : "#menu.games.positive";
		}

		if ( score >= 70 ) return "#menu.games.mostly_positive";
		if ( score >= 40 ) return "#menu.games.mixed";
		if ( score >= 20 ) return "#menu.games.mostly_negative";
		if ( total >= 500 ) return "#menu.games.overwhelmingly_negative";
		return total >= 50 ? "#menu.games.very_negative" : "#menu.games.negative";
	}

	/// <summary>
	/// "positive", "mixed" or "negative" for colouring <see cref="RatingText"/> - "none" under ten reviews.
	/// </summary>
	public static string RatingClass( Package package ) => RatingClass( package.Reviews.Total, package.Reviews.Score );

	/// <inheritdoc cref="RatingClass(Package)"/>
	static string RatingClass( int total, float score )
	{
		if ( total < 10 ) return "none";

		if ( score >= 70 ) return "positive";
		if ( score >= 40 ) return "mixed";
		return "negative";
	}

	// The party's size too - the play mode card goes green or orange with it, while the page is open
	protected override int BuildHash() => System.HashCode.Combine(Package, Package?.Interaction.Used, ShowReviews, PlayerModes.PartySize, Workshop, OnWorkshop, Loading);

	protected override async Task OnParametersSetAsync()
	{
		achList = await Package.GetAchievements();
		if (!achList.All.Any()) achList = default;
		if (achList is not null) StateHasChanged();
	}

    void OrgClicked()
    {
        if (Package?.Org != null)
            Game.Overlay.ShowOrganizationModal(Package.Org);
    }

	/// <summary>
	/// Rebuild composed text when translations change.
	/// </summary>
	public override void LanguageChanged()
	{
		base.LanguageChanged();
		StateHasChanged();
	}
}
