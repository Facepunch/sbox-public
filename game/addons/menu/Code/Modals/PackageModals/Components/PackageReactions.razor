@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using System;
@using Sandbox.Services

@*
    What you think of a game, one tap each, as split pills - like and dislike, favourite, then
    reviewing it on its own, hide, and nominating it while there's a jam it's in. The game page's footer, and the pause
    menu's.
*@
<root>

    @* On the workshop the votes are its item's, on Steam - and that's all there is, the rest are the backend's *@
    @if ( OnWorkshop )
    {
        <div class="group">
            <div class="pill @( WorkshopVote == true ? "active" : "" )" onclick=@( () => _ = VoteOnWorkshop( true ) ) tooltip="#menu.workshop.vote_up">
                <icon>thumb_up</icon>
                <label>@WorkshopVotesUp.ToMetric()</label>
            </div>
            <div class="pill @( WorkshopVote == false ? "active" : "" )" onclick=@( () => _ = VoteOnWorkshop( false ) ) tooltip="#menu.workshop.vote_down">
                <icon>thumb_down</icon>
                <label>@WorkshopVotesDown.ToMetric()</label>
            </div>
        </div>
    }
    else
    {
    <div class="group">
        <div class="pill @( Liked ? "active" : "" )" onclick=@( () => _ = Vote( true ) ) tooltip="#menu.games.like">
            <icon>thumb_up</icon>
            <label>@Package.VotesUp.ToMetric()</label>
        </div>
        <div class="pill @( Disliked ? "active" : "" )" onclick=@( () => _ = Vote( false ) ) tooltip="#menu.games.dislike">
            <icon>thumb_down</icon>
            <label>@Package.VotesDown.ToMetric()</label>
        </div>
    </div>

    <div class="group">
        <div class="pill fav @( Package.Interaction.Favourite ? "active" : "" )" onclick=@( () => _ = ToggleFavourite() ) tooltip="@( Package.Interaction.Favourite ? "#menu.games.remove_from_favourites_text" : "#menu.games.add_to_favourites_text" )">
            <icon>@( Package.Interaction.Favourite ? "favorite" : "favorite_border" )</icon>
            <label>@Package.Favourited.ToMetric()</label>
        </div>
    </div>

    @* Writing one's a thing of its own, not a tap like the rest - a pill to itself *@
    @if ( ShowReviews )
    {
        <div class="group">
            <div class="pill" onclick=@( () => Game.Overlay.ShowReviewModal( Package ) ) tooltip="@ReviewTooltip">
                <icon>rate_review</icon>
                @if ( ReviewText is { } text )
                {
                    <label>@text</label>
                }
            </div>
        </div>
    }

    @if ( OnHidden is not null )
    {
        <div class="group">
            @* Hidden already - opened anyway, from a link or a friend - so it's the way to show it again *@
            @if ( MenuUtility.Hidden.Contains( Package ) )
            {
                <div class="pill active" onclick=@( () => _ = Unhide() ) tooltip="@UnhideTooltip">
                    <icon>visibility</icon>
                    <label>#menu.common.unhide</label>
                </div>
            }
            else
            {
                <div class="pill" onclick=@( () => _ = Hide() ) tooltip="@( Package.TypeName == "map" ? "#menu.games.hide_this_map" : "#menu.games.hide_this_game" )">
                    <icon>block</icon>
                </div>
            }
        </div>
    }

    @if ( ShowJam )
    {
        <div class="group jam">
            <div class="pill nominate @( _nominated ? "on" : "" ) @( _jamBusy ? "busy" : "" ) @( CanToggleNomination ? "" : "locked" )" onclick=@( () => _ = ToggleNomination() ) tooltip="@JamTooltip">
                <icon>@( _nominated ? "check" : CanToggleNomination ? "emoji_events" : "lock" )</icon>
                <label>@( _nominated ? "#menu.games.nominated" : "#menu.games.nominate" )</label>
            </div>
        </div>
    }
    }

</root>

@code
{
    [Parameter] public Package Package { get; set; }

    /// <summary>
    /// Once it's been hidden - the game page closes. No hide pill without it: hiding the game you're
    /// in makes no sense.
    /// </summary>
    [Parameter] public Action OnHidden { get; set; }

    /// <summary>
    /// The review pill.
    /// </summary>
    [Parameter] public bool ShowReviews { get; set; } = true;

    /// <summary>
    /// The review pill says the score - or, off, it's just its glyph ("#menu.games.write_a_review" on hover), for
    /// where the score's said already (the pause menu's game, in its reviews line).
    /// </summary>
    [Parameter] public bool ShowReviewScore { get; set; } = true;

    /// <summary>
    /// What the Steam Workshop says about it, for a package on the workshop - its votes are its item's. Null while it's being asked.
    /// </summary>
    [Parameter] public WorkshopItemDetails Workshop { get; set; }

    protected override int BuildHash() => HashCode.Combine( Package, Package?.Interaction.Rating, Package?.Interaction.Favourite, Package?.VotesUp, Package?.VotesDown, Package?.Favourited, Package?.Reviews.Total, HashCode.Combine( ShowJam, _nominated, _jamBusy, OnHidden is null, ShowReviews, ShowReviewScore, MenuUtility.Hidden.Revision, HashCode.Combine( Workshop, WorkshopVote, _workshopVoted, OnWorkshop ) ) );

    /// <summary>
    /// Say what the Steam Workshop says, not the backend - the game page, for a package on the workshop. The backend's
    /// parts go.
    /// </summary>
    [Parameter] public bool OnWorkshop { get; set; }

    //
    // Its workshop item's votes, on Steam
    //

    /// <summary>
    /// How we've voted on its item - true up, false down, null not at all (or not asked yet)
    /// </summary>
    bool? WorkshopVote;

    /// <summary>
    /// How we'd voted when the page asked Steam - so ours can be moved between the counts when it changes
    /// </summary>
    bool? _workshopVoted;

    ulong _voteAskedFor;
    bool _voting;

    int WorkshopVotesUp => VoteCount( Workshop?.VotesUp ?? 0, true );
    int WorkshopVotesDown => VoteCount( Workshop?.VotesDown ?? 0, false );

    /// <summary>
    /// One side's count with our vote in it. Steam's counts lag behind its votes (and can be its cached ones), so ours
    /// mightn't be in them yet - it's only taken back out of a side that has one to take, then put where it is now.
    /// </summary>
    int VoteCount( int steam, bool up )
    {
        var others = _workshopVoted == up && steam > 0 ? steam - 1 : steam;
        return others + (WorkshopVote == up ? 1 : 0);
    }

    protected override async Task OnParametersSetAsync()
    {
        if ( Workshop is not { } item || item.Id == _voteAskedFor ) return;

        _voteAskedFor = item.Id;
        var vote = await MenuUtility.GetWorkshopVoteAsync( item.Id );

        // Moved on to another item while we asked
        if ( !this.IsValid() || Workshop?.Id != item.Id ) return;

        WorkshopVote = _workshopVoted = vote;
        StateHasChanged();
    }

    async Task VoteOnWorkshop( bool up )
    {
        if ( Workshop is not { } item || _voting || WorkshopVote == up ) return;

        _voting = true;
        var was = WorkshopVote;
        WorkshopVote = up;
        StateHasChanged();

        var taken = await MenuUtility.VoteOnWorkshopAsync( item.Id, up );
        _voting = false;

        if ( !this.IsValid() ) return;

        if ( !taken )
        {
            WorkshopVote = was;
            MenuOverlay.Instance?.BottomRight?.Queue( new MenuProject.Toast { Title = "#menu.workshop.vote_failed", Icon = "thumbs_up_down" } );
        }

        StateHasChanged();
    }

    string ReviewText => !ShowReviewScore ? null : Package.Reviews.Total > 0 ? Package.Reviews.Score.ToString( "0\\%" ) : "#menu.games.review";
    string ReviewTooltip => ShowReviewScore && Package.Reviews.Total > 0 ? $"{Package.Reviews.Score:N0}% from {Package.Reviews.Total} reviews. Write yours" : "#menu.games.write_a_review";

    // Rating: 0 like, 1 dislike, null unrated
    bool Liked => Package.Interaction.Rating == 0;
    bool Disliked => Package.Interaction.Rating == 1;

    async Task Vote( bool up )
    {
        await Package.SetVoteAsync( up );
        if ( this.IsValid() ) StateHasChanged();
    }

    async Task ToggleFavourite()
    {
        await Package.SetFavouriteAsync( !Package.Interaction.Favourite );
        if ( this.IsValid() ) StateHasChanged();
    }

    async Task Hide()
    {
        if ( await MenuHelpers.HidePackage( this, Package ) )
            OnHidden?.Invoke();
    }

    /// <summary>
    /// Hidden as part of its creator rather than on its own - showing it again means showing all of theirs.
    /// </summary>
    bool HiddenByOrganization => !MenuUtility.Hidden.Packages.Contains( Package.FullIdent ) && MenuUtility.Hidden.IsOrganizationHidden( Package.Org?.Ident );

    string UnhideTooltip => HiddenByOrganization
        ? $"Everything by {Package.Org?.Title} is hidden - show it all again"
        : "#menu.games.you_ve_hidden_this_show_it_again";

    async Task Unhide()
    {
        if ( !HiddenByOrganization )
        {
            await MenuHelpers.UnhidePackage( Package );
        }
        else
        {
            var shown = await MenuUtility.Hidden.SetOrganizationHidden( Package.Org?.Ident, false );
            MenuOverlay.Instance?.BottomRight?.Queue( new MenuProject.Toast
            {
                Title = shown ? $"Everything by {Package.Org?.Title} is back" : $"Couldn't unhide {Package.Org?.Title} right now",
                Icon = "visibility"
            } );
        }

        if ( this.IsValid() ) StateHasChanged();
    }

    //
    // The jam - nominating an entry while nominations are open
    //

    Jam _jam;
    JamEntryStatus _entry;
    bool _nominated;
    bool _jamBusy;

    bool ShowJam => _jam is not null && _entry.IsEntry;
    bool CanToggleNomination => _nominated || _entry.CanNominate;
    string JamTooltip => $"{_jam?.Title} entry. " + (_nominated ? Language.GetPhrase( "menu.games.you_nominated_it_for_the_jam" ) : CanToggleNomination ? Language.GetPhrase( "menu.games.liked_it_nominate_it_for_the_jam" ) : _entry.Reason);

    protected override void OnAfterTreeRender( bool firstTime )
    {
        base.OnAfterTreeRender( firstTime );

        // Jams are the backend's - not for a package on the workshop
        if ( firstTime && Package?.TypeName == "game" && !OnWorkshop )
            _ = LoadJam();
    }

    async Task LoadJam()
    {
        var jam = await Jam.GetActive();
        if ( !this.IsValid() ) return;
        if ( jam is null || !jam.CommunityVoting || !jam.HasStarted || jam.Now >= jam.NominationsEnd ) return;

        var entry = await jam.GetEntryStatusAsync( Package );
        if ( !this.IsValid() ) return;
        if ( entry is not { IsEntry: true } status ) return;

        _jam = jam;
        _entry = status;
        _nominated = status.Nominated;
        StateHasChanged();
    }

    async Task ToggleNomination()
    {
        if ( _jamBusy || !ShowJam || !CanToggleNomination ) return;

        _jamBusy = true;
        StateHasChanged();

        var removing = _nominated;
        _nominated = !removing;
        string reason;

        try
        {
            reason = removing ? await _jam.WithdrawNominationAsync( Package ) : await _jam.NominateAsync( Package );
        }
        catch ( Exception e )
        {
            Log.Warning( e, $"Nominate {Package.FullIdent} failed" );
            reason = "#menu.games.couldn_t_reach_the_jam_right_now";
        }

        if ( !this.IsValid() ) return;

        _jamBusy = false;

        if ( reason is not null )
        {
            _nominated = removing;
            MenuOverlay.Instance?.BottomRight?.Queue( new MenuProject.Toast() { Title = reason, Icon = "how_to_vote" } );
        }

        StateHasChanged();
    }

    /// <summary>
    /// Rebuild composed text when translations change.
    /// </summary>
    public override void LanguageChanged()
    {
        base.LanguageChanged();
        StateHasChanged();
    }
}
