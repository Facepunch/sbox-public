@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using System;

@*
    You and this game, on its page - how long you've played it, when you started and when you were last
    on, as label and value like its facts over the gallery's side. All three whether you have or not, so
    it's always as tall - "Never" and dashes before you've played it.
*@
<root>

    <div class="fact">
        <label class="key">Played</label>
        <label class="value @(Package.Interaction.Used ? "" : "none")">@(Package.Interaction.Used ? MenuHelpers.PlayTime( Played ) : "Never")</label>
    </div>

    <div class="fact">
        <label class="key">First played</label>
        <label class="value @(Package.Interaction.FirstUsed is null ? "none" : "")">@(Package.Interaction.FirstUsed is { } first ? first.ToLocalTime().ToString( "d MMM yyyy" ) : "–")</label>
    </div>

    <div class="fact">
        <label class="key">Last played</label>
        <label class="value @(Package.Interaction.LastUsed is null ? "none" : "")">@(Package.Interaction.LastUsed is { } last ? MenuHelpers.TimeAgo( last ) : "–")</label>
    </div>

</root>

@code
{
    [Parameter] public Package Package { get; set; }

    TimeSpan Played => TimeSpan.FromSeconds( Package.Interaction.Seconds );

    protected override int BuildHash() => HashCode.Combine( Package, Package?.Interaction.Seconds, Package?.Interaction.LastUsed, Package?.Interaction.Used );
}
