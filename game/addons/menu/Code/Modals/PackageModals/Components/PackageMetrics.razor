@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;

@*
    Up on the tabs' line, at the right end - reporting it. Its numbers are on its Overview.
*@
<root>

    <MetricButton Interactive style="margin-top: 30px;" Tooltip="#menu.games.report_abuse" Icon="flag" Value="report" @onclick="@( () => Game.Overlay.ShowReportModal( Package.FullIdent ) )" />

</root>

@code
{
    public Package Package {get;set;}

    protected override int BuildHash() => System.HashCode.Combine(Package);
}
