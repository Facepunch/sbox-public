@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;
@using Menu;
@using System;
@using Sandbox.Network

<root>

    <MetricButton Interactive 
        Active="@Package.Interaction.Favourite"
        @onclick="@ToggleFavourite"
        Tooltip="#tooltip.packagemetrics.favourited" 
        Icon="favorite" 
        Value="@Package.Favourited.ToMetric()" />

    <MetricButton Interactive 
        Active="@( Package.Interaction.Rating == 0 )"
        @onclick="@VoteUp"
        Tooltip="#tooltip.packagemetrics.thumbs_up"
        Icon="thumb_up" 
        Value="@Package.VotesUp.ToMetric()" />

    <MetricButton Interactive 
        Active="@( Package.Interaction.Rating == 1 )" 
         @onclick="@VoteDown"
        Tooltip="#tooltip.packagemetrics.thumbs_down" 
        Icon="thumb_down" 
        Value="@Package.VotesDown.ToMetric()" />

    <MetricButton 
        Tooltip="@Language.GetPhrase( "tooltip.packagemetrics.reviews", new() { { "score", Package.Reviews.Score.ToString("N0") }, { "total", Package.Reviews.Total } } )"
        Icon="reviews" 
        Value="@Package.Reviews.Score.ToString( "0\\%" )" />

    <MetricButton Tooltip="#tooltip.packagemetrics.total_players" Icon="sports_kabaddi" Value="@Package.Usage.Total.Users.ToMetric()" />
    <MetricButton Tooltip="#tooltip.packagemetrics.total_sessions" Icon="calendar_month" Value="@Package.Usage.Total.Sessions.ToMetric()" />

    <MetricButton Tooltip="#tooltip.packagemetrics.last_updated" Icon="update" Value="@((DateTime.UtcNow - Package.Updated ).Humanize( 1 ))" />

    <MetricButton Interactive style="margin-top: 30px;" Tooltip="#tooltip.packagemetrics.report_abuse" Icon="flag" Value="#packagemetrics.report" @onclick="@( () => Game.Overlay.ShowReportModal( Package.FullIdent ) )" />

</root>

@code
{
    public Package Package {get;set;}
    protected override int BuildHash() => System.HashCode.Combine(Package, Package.Interaction);

    async void VoteUp()
    {
        await Package.SetVoteAsync(true);
        StateHasChanged();
    }

    async void VoteDown()
    {
        await Package.SetVoteAsync(false);
        StateHasChanged();
    }

    async void ToggleFavourite()
    {
        await Package.SetFavouriteAsync(!Package.Interaction.Favourite);
        StateHasChanged();
    }
}
