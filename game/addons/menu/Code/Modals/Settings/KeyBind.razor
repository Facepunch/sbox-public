@using Sandbox
@using Sandbox.UI
@inherits Panel

@namespace MenuProject.Settings

@* A bind as keys on a keyboard - each key a keycap with its name, held-together ones joined by a +. Waiting for a press
   when it's being changed, and a quiet dash when there's nothing on it. *@
<root class="@(Rebinding ? "rebinding" : "") @(!string.IsNullOrEmpty(TargetKey) ? "with-highlight" : "")" tooltip="Click to change · Right-click to clear">
    @{
        var str = MenuUtility.Input.GetBind( BindGroup, Action.Name, Slot, out var isDefault );

        // First slot should always be assigned
        if ( str == null && Slot == 0 )
        {
            str = Action.KeyboardCode;
            isDefault = true;
        }
    }

    @if ( Rebinding )
    {
        <label class="listening">Press a key…</label>
    }
    else if ( !string.IsNullOrEmpty( str ) )
    {
        var keys = GetGlyphKeys( str ).ToList();
        @for ( int i = 0; i < keys.Count; i++ )
        {
            <div class="cap"><label>@KeyName( keys[i] )</label></div>
            @if ( i < keys.Count - 1 )
            {
                <label class="plus">+</label>
            }
        }
    }
    else
    {
        <label class="unset">—</label>
    }
</root>

@code {
    [Parameter]
    public InputAction Action { get; set; }

    [Parameter]
    public string BindGroup { get; set; }

    [Parameter]
    public int Slot { get; set; }

    private bool Rebinding { get; set; }
    private string TargetKey { get; set; }

    /// Utility method to split the A + X + F string into a container
    public IEnumerable<string> GetGlyphKeys( string input )
    {
        if ( string.IsNullOrEmpty( input ) )
            yield break;

        var keys = input.Split( '+', StringSplitOptions.RemoveEmptyEntries );
        foreach ( var key in keys )
        {
            yield return key.Trim();
        }
    }

    /// <summary>
    /// A key as it's printed on the keyboard, or as games name a mouse button - "W", "Shift", "Left Mouse"
    /// </summary>
    static string KeyName( string key )
    {
        var k = key.Trim().ToLowerInvariant();

        return k switch
        {
            "mouse1" or "mouse_left" => "Left Mouse",
            "mouse2" or "mouse_right" => "Right Mouse",
            "mouse3" or "mouse_middle" => "Middle Mouse",
            "mouse4" => "Mouse 4",
            "mouse5" => "Mouse 5",
            "mwheelup" => "Wheel Up",
            "mwheeldown" => "Wheel Down",
            "escape" => "Esc",
            "ctrl" or "lctrl" or "rctrl" or "control" => "Ctrl",
            "shift" or "lshift" or "rshift" => "Shift",
            "alt" or "lalt" or "ralt" => "Alt",
            "capslock" => "Caps Lock",
            "backspace" => "Backspace",
            "uparrow" or "up" => "↑",
            "downarrow" or "down" => "↓",
            "leftarrow" or "left" => "←",
            "rightarrow" or "right" => "→",
            _ when k.Length == 1 => k.ToUpperInvariant(),
            _ => char.ToUpperInvariant( k[0] ) + k[1..]
        };
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( TargetKey, Rebinding );
    }

    protected override void OnMouseUp( MousePanelEvent e )
    {
        if ( e.MouseButton == MouseButtons.Left )
        {
            Rebinding = true;
            TargetKey = null;
            StateHasChanged();

            MenuUtility.Input.TrapButtons( (buttons) =>
            {
                if ( buttons.Length == 0 )
                {
                    Cancel();
                    return;
                }

                TargetKey = string.Join( " + ", buttons.OrderBy( x => x ) );
                Apply();
            });
        }

        if ( e.MouseButton == MouseButtons.Right )
        {
            MenuUtility.Input.SetBind( BindGroup, Action.Name, null, Slot );
            TargetKey = null;
            CreateEvent( "onchange" );
            StateHasChanged();
        }
    }

    public void Apply()
    {
        if ( string.IsNullOrEmpty( TargetKey ) )
            return;

        MenuUtility.Input.SetBind( BindGroup, Action.Name, TargetKey, Slot );

        TargetKey = null;
        Rebinding = false;

        CreateEvent( "onchange" );
        StateHasChanged();
    }

    public void Cancel()
    {
        Rebinding = false;
        TargetKey = null;
        CreateEvent( "onchange" );
        StateHasChanged();
    }
}
