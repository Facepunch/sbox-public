@using Sandbox.UI;
@using Sandbox;
@using Sandbox.Engine.Settings;
@namespace MenuProject.Settings
@inherits Panel
@page "/settings/video"

<root class="page-inner">

    <div class="page-content">

        <h2><i>camera</i>#settings.video.modes</h2>

        <row>
            <div class="is-label">#settings.video.video_mode</div>
            @{
                var c = Sandbox.Game.IsEditor ? "disabled" : "";
                c = $"glass with-grow with-click {c}";
                <ButtonGroup class="glass with-grow" ButtonClass="@c" Value:bind=@VideoMode Options=@VideoModeOptions></ButtonGroup>
            }
        </row>
        
        <row class="with-gaps">
            <div class="is-label">#settings.video.resolution</div>
            @{
                var c2 = Sandbox.Game.IsEditor ? "disabled" : "";
                c2 = $"glass with-grow {c2}";
                <DropDown class="@c2" Value:bind=@Resolution BuildOptions=@GetResolutionOptions></DropDown>
            }
        </row>

        <row class="with-gaps">
            <div class="is-label">#settings.video.vsync</div>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@VSyncOptions Value:bind=@VSync></ButtonGroup>
        </row>

        <h2><i>speed</i>#settings.video.framerate</h2>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.game</cell>
            <SliderControl class="glass with-grow" Value:bind=@FrameRateLimit Min="@(0)" Max="@(500)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
        </row>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.menu</cell>
            <SliderControl class="glass with-grow" Value:bind=@MenuFrameRateLimit Min="@(0)" Max="@(500)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
        </row>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.inactive</cell>
            <SliderControl class="glass with-grow" Value:bind=@InactiveFrameRateLimit Min="@(0)" Max="@(500)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
        </row>

        <h2><i>brush</i>#settings.video.quality</h2>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.anti_aliasing</cell>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@AntiAliasingOptions Value:bind=@AntiAliasing></ButtonGroup>
        </row>

        @if ( !HasEffectiveAntiAliasing )
        {
            <row class="setting-warning">
                <i>warning</i>
                <span>#settings.video.anti_aliasing.description</span>
            </row>
        }

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.texture_detail</cell>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@TextureDetailOptions Value:bind=@TextureDetail></ButtonGroup>
        </row>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.volumetric_fog</cell>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@VolumetricFogQualityOptions Value:bind=@VolumetricFogQuality></ButtonGroup>
        </row>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.post_processing</cell>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@PostProcessOptions Value:bind=@PostProcessQuality></ButtonGroup>
        </row>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.shadows</cell>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@ShadowQualityOptions Value:bind=@ShadowQuality></ButtonGroup>
        </row>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.motion_blur_strength</cell>
            <SliderControl class="glass with-grow" Value:bind=@MotionBlurScale Min="@(0.0f)" Max="@(1.0f)" Step="@(0.01f)" ShowTextEntry="@true"></SliderControl>
        </row>

        <h2><i>auto_awesome</i>#settings.video.upscaling</h2>

        <row class="with-gaps">
            <cell class="glass with-padding is-label">#settings.video.upscaler</cell>
            <ButtonGroup class="glass with-grow" ButtonClass="glass with-grow with-click" Options=@UpscalerModeOptions Value:bind=@UpscalerMode></ButtonGroup>
        </row>

        @if ( UpscalerMode == Sandbox.Engine.Settings.UpscalerMode.Stretch )
        {
            <row class="with-gaps">
                <cell class="glass with-padding is-label">#settings.video.render_quality</cell>
                <SliderControl class="glass with-grow" Value:bind=@UpscalerRenderScalePercent Min="@(40)" Max="@(100)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
            </row>
        }
        else if ( UpscalerMode == Sandbox.Engine.Settings.UpscalerMode.FSR1 )
        {
            <row class="with-gaps">
                <cell class="glass with-padding is-label">#settings.video.render_quality</cell>
                <SliderControl class="glass with-grow" Value:bind=@UpscalerRenderScalePercent Min="@(50)" Max="@(100)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
            </row>
            <row class="with-gaps">
                <cell class="glass with-padding is-label">#settings.video.sharpness</cell>
                <SliderControl class="glass with-grow" Value:bind=@Fsr1SharpnessPercent Min="@(0)" Max="@(100)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
            </row>
        }
        else if ( UpscalerMode == Sandbox.Engine.Settings.UpscalerMode.FSR3 )
        {
            <row class="upscaler-warning">
                <i>warning</i>
                <span>#settings.video.fsr3_warning</span>
            </row>
            <row class="with-gaps">
                <cell class="glass with-padding is-label">#settings.video.quality_preset</cell>
                <DropDown class="glass with-grow" Value:bind=@Fsr3UpscalerQuality Options=@UpscalerQualityOptions></DropDown>
            </row>
            <row class="with-gaps">
                <cell class="glass with-padding is-label">#settings.video.sharpness</cell>
                <SliderControl class="glass with-grow" Value:bind=@Fsr3SharpnessPercent Min="@(0)" Max="@(100)" Step="@(1)" ShowTextEntry="@true"></SliderControl>
            </row>
        }
        else if ( UpscalerMode == Sandbox.Engine.Settings.UpscalerMode.DLSS )
        {
            <row class="upscaler-warning">
                <i>warning</i>
                <span>#settings.video.dlss_warning</span>
            </row>
            <row class="with-gaps">
                <cell class="glass with-padding is-label">#settings.video.quality_preset</cell>
                <DropDown class="glass with-grow" Value:bind=@DlssQuality Options=@DlssQualityOptions></DropDown>
            </row>
        }
    </div>

     <SettingsFooter OnCancel=@OnCancel OnRestore=@OnRestore OnApply=@OnApply></SettingsFooter>

</root>


@code
{
    public string VideoMode { get; set; }
    public string Resolution { get; set; }
    public MultisampleAmount AntiAliasing { get; set; }
    public bool VSync { get; set; }
    public TextureQuality TextureDetail { get; set; }
    public VolumetricFogQuality VolumetricFogQuality { get; set; }
    public PostProcessQuality PostProcessQuality { get; set; }
    public ShadowQuality ShadowQuality { get; set; }
    public float MotionBlurScale { get; set; }
    public int FrameRateLimit { get; set; }
    public int MenuFrameRateLimit { get; set; }
    public int InactiveFrameRateLimit { get; set; }

    public Sandbox.Engine.Settings.UpscalerMode UpscalerMode { get; set; }
    public Sandbox.Engine.Settings.Fsr3UpscalerQuality Fsr3UpscalerQuality { get; set; }
    public Sandbox.Engine.Settings.DlssQuality DlssQuality { get; set; }
    public int UpscalerRenderScalePercent { get; set; }
    public int Fsr1SharpnessPercent { get; set; }
    public int Fsr3SharpnessPercent { get; set; }

    // Every upscaler renders to a non-MSAA target, so the dropdown value is only what actually
    // ships when no upscaler is selected.
    bool HasEffectiveAntiAliasing => AntiAliasing != MultisampleAmount.MultisampleNone
                                  && UpscalerMode == Sandbox.Engine.Settings.UpscalerMode.Off;

    // DLSS is only offered when the graphics device reports support for it (NVIDIA hardware).
    List<Option> UpscalerModeOptions = BuildUpscalerModeOptions();

    static List<Option> BuildUpscalerModeOptions()
    {
        var options = new List<Option>()
        {
            new Option("#settings.video.off",          Sandbox.Engine.Settings.UpscalerMode.Off),
            new Option("#settings.video.stretch",      Sandbox.Engine.Settings.UpscalerMode.Stretch),
            new Option("FSR",          Sandbox.Engine.Settings.UpscalerMode.FSR1),
            new Option("FSR3 (TAA)",   Sandbox.Engine.Settings.UpscalerMode.FSR3),
        };

        if ( Sandbox.Engine.Settings.RenderSettings.IsUpscalerModeSupported( Sandbox.Engine.Settings.UpscalerMode.DLSS ) )
            options.Add( new Option("DLSS", Sandbox.Engine.Settings.UpscalerMode.DLSS) );

        return options;
    }

    List<Option> UpscalerQualityOptions = new List<Option>()
    {
        new Option("#settings.video.option_native",              Sandbox.Engine.Settings.Fsr3UpscalerQuality.Native),
        new Option("#settings.video.option_quality",             Sandbox.Engine.Settings.Fsr3UpscalerQuality.Quality),
        new Option("#settings.video.option_balanced",            Sandbox.Engine.Settings.Fsr3UpscalerQuality.Balanced),
        new Option("#settings.video.option_performance",         Sandbox.Engine.Settings.Fsr3UpscalerQuality.Performance),
        new Option("#settings.video.option_ultra_performance",   Sandbox.Engine.Settings.Fsr3UpscalerQuality.UltraPerformance),
    };

    List<Option> DlssQualityOptions = new List<Option>()
    {
        new Option("DLAA",                Sandbox.Engine.Settings.DlssQuality.DLAA),
        new Option("#settings.video.option_quality",             Sandbox.Engine.Settings.DlssQuality.Quality),
        new Option("#settings.video.option_balanced",            Sandbox.Engine.Settings.DlssQuality.Balanced),
        new Option("#settings.video.option_performance",         Sandbox.Engine.Settings.DlssQuality.Performance),
        new Option("#settings.video.option_ultra_performance",   Sandbox.Engine.Settings.DlssQuality.UltraPerformance),
    };

    List<Option> VideoModeOptions = new List<Option>()
    {
        new Option("#settings.video.windowed", "web_asset", "window"),
        new Option("#settings.video.borderless", "fullscreen", "borderless"),
        new Option("#settings.video.exclusive", "monitor", "exclusive"),
    };

    List<Option> AntiAliasingOptions = new List<Option>()
    {
        new Option("#settings.video.none", MultisampleAmount.MultisampleNone),
        new Option("2x", MultisampleAmount.Multisample2x),
        new Option("4x", MultisampleAmount.Multisample4x),
        new Option("8x", MultisampleAmount.Multisample8x),
    };

    List<Option> VSyncOptions = [new("#settings.off", false), new("#settings.on", true)];

    List<Option> TextureDetailOptions = [new("#settings.low", Sandbox.Engine.Settings.TextureQuality.Low), new("#settings.medium", Sandbox.Engine.Settings.TextureQuality.Medium), new("#settings.high", Sandbox.Engine.Settings.TextureQuality.High)];
    List<Option> VolumetricFogQualityOptions = [new("#settings.low", VolumetricFogQuality.Low), new("#settings.medium", VolumetricFogQuality.Medium), new("#settings.high", VolumetricFogQuality.High)];
    List<Option> PostProcessOptions = [new("#settings.low", PostProcessQuality.Low), new("#settings.medium", PostProcessQuality.Medium), new("#settings.high", PostProcessQuality.High)];
    List<Option> ShadowQualityOptions = [new("#settings.low", ShadowQuality.Low), new("#settings.medium", ShadowQuality.Medium), new("#settings.high", ShadowQuality.High)];

    static List<Option> _resolutionOptions = [];
    public static List<Option> ResolutionOptions
    {
        get
        {
            if ( _resolutionOptions.Count == 0 )
                FetchResolutions();

            return _resolutionOptions;
        }
    }

    /// <summary>
    /// Fetches available resolutions from DXGI, can create stutters.
    /// </summary>
    public static void FetchResolutions()
    {
        var options = new List<Option>();
        var smallestAspect = 1.5f;

        var displayModes = MenuUtility.RenderSettings.DisplayModes( false )
                                        .Where( x => x.Width >= 1280 ) // Fuck small screen sizes
                                        .Where( x => ((float)x.Width / (float)x.Height) >= smallestAspect ); // fuck small aspect ratios

        foreach ( var res in displayModes.GroupBy( x => $"{x.Width}x{x.Height}" ) )
        {
            options.Add( new Option( res.Key, res.Key ) );
        }

        _resolutionOptions = options;
    }

    List<Option> GetResolutionOptions() => ResolutionOptions;

    protected override void OnAfterTreeRender(bool firstTime)
    {
        base.OnAfterTreeRender(firstTime);

        if (!firstTime)
            return;

        ReadSettings();
    }

    public void ReadSettings()
    {
        VideoMode = "window";
        if (MenuUtility.RenderSettings.Borderless) VideoMode = "borderless";
        if (MenuUtility.RenderSettings.Fullscreen) VideoMode = "exclusive";

        Resolution = $"{MenuUtility.RenderSettings.ResolutionWidth}x{MenuUtility.RenderSettings.ResolutionHeight}";
        VSync = MenuUtility.RenderSettings.VSync;
        AntiAliasing = MenuUtility.RenderSettings.AntiAliasQuality;

        TextureDetail = MenuUtility.RenderSettings.TextureQuality;
        VolumetricFogQuality = MenuUtility.RenderSettings.VolumetricFogQuality;
        PostProcessQuality = MenuUtility.RenderSettings.PostProcessQuality;
        ShadowQuality = MenuUtility.RenderSettings.ShadowQuality;
        MotionBlurScale = MenuUtility.RenderSettings.MotionBlurScale;

        FrameRateLimit = MenuUtility.RenderSettings.MaxFrameRate;
        MenuFrameRateLimit = MenuUtility.RenderSettings.MaxFrameRateMenu;
        InactiveFrameRateLimit = MenuUtility.RenderSettings.MaxFrameRateInactive;

        UpscalerMode = MenuUtility.RenderSettings.UpscalerMode;
        Fsr3UpscalerQuality = MenuUtility.RenderSettings.Fsr3UpscalerQuality;
        DlssQuality = MenuUtility.RenderSettings.DlssQuality;
        UpscalerRenderScalePercent = (int)MathF.Round( MenuUtility.RenderSettings.UpscalerRenderScale * 100f );
        Fsr1SharpnessPercent = (int)MathF.Round( MenuUtility.RenderSettings.Fsr1Sharpness * 100f );
        Fsr3SharpnessPercent = (int)MathF.Round( MenuUtility.RenderSettings.Fsr3Sharpness * 100f );
    }

    public void OnRestore()
    {
        MenuUtility.RenderSettings.ResetVideoConfig();
    }

    public void OnCancel()
    {
        ReadSettings();
    }

    public void OnApply()
    {
        if (!Game.IsEditor)
        {
            switch (VideoMode)
            {
                case "window":
                    {
                        MenuUtility.RenderSettings.Fullscreen = false;
                        MenuUtility.RenderSettings.Borderless = false;
                        break;
                    }

                case "borderless":
                    {
                        MenuUtility.RenderSettings.Fullscreen = false;
                        MenuUtility.RenderSettings.Borderless = true;
                        break;
                    }

                case "exclusive":
                    {
                        MenuUtility.RenderSettings.Fullscreen = true;
                        MenuUtility.RenderSettings.Borderless = false;
                        break;
                    }
            }

            if (VideoMode != "borderless")
            {
                var parts = Resolution.Split("x", 2).Select(x => x.ToInt()).ToArray();
                MenuUtility.RenderSettings.ResolutionWidth = parts[0];
                MenuUtility.RenderSettings.ResolutionHeight = parts[1];
            }
        }

        MenuUtility.RenderSettings.VSync = VSync;
        MenuUtility.RenderSettings.AntiAliasQuality = AntiAliasing;

        MenuUtility.RenderSettings.TextureQuality = TextureDetail;
        MenuUtility.RenderSettings.VolumetricFogQuality = VolumetricFogQuality;
        MenuUtility.RenderSettings.PostProcessQuality = PostProcessQuality;
        MenuUtility.RenderSettings.ShadowQuality = ShadowQuality;
        MenuUtility.RenderSettings.MotionBlurScale = MotionBlurScale;

        MenuUtility.RenderSettings.MaxFrameRate = FrameRateLimit;
        MenuUtility.RenderSettings.MaxFrameRateMenu = MenuFrameRateLimit;
        MenuUtility.RenderSettings.MaxFrameRateInactive = InactiveFrameRateLimit;

        MenuUtility.RenderSettings.UpscalerMode = UpscalerMode;
        MenuUtility.RenderSettings.Fsr3UpscalerQuality = Fsr3UpscalerQuality;
        MenuUtility.RenderSettings.DlssQuality = DlssQuality;
        MenuUtility.RenderSettings.UpscalerRenderScale = UpscalerRenderScalePercent / 100f;
        MenuUtility.RenderSettings.Fsr1Sharpness = Fsr1SharpnessPercent / 100f;
        MenuUtility.RenderSettings.Fsr3Sharpness = Fsr3SharpnessPercent / 100f;

        MenuUtility.RenderSettings.Apply();
    }
}
