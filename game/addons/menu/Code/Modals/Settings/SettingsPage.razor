@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@page "/settings"
@namespace MenuProject.Settings
@inherits NavigationHost


<root>

    <div class="tabs">
        <Button class="clicky uplight" href="/settings/video" icon="tv">#settings.video</Button>
        <Button class="clicky uplight" href="/settings/input" Icon="mouse">#settings.input</Button>
        <Button class="clicky uplight" href="/settings/keybinds" Icon="keyboard">#settings.keybinds</Button>
        <Button class="clicky uplight" href="/settings/audio" Icon="music_note">#settings.sound</Button>
        <Button class="clicky uplight" href="/settings/game" Icon="language">#settings.game</Button>
        <Button class="clicky uplight" href="/settings/storage" Icon="sd_card">#settings.storage</Button>
        <Button class="clicky uplight" href="/settings/developer" Icon="build">#settings.developer</Button>
        <Button class="clicky uplight" href="/settings/about" Icon="info">#settings.about</Button>
    </div>

    <div class="body">
        <div class="grow navigator-canvas" slot="navigator-canvas" style="width: 100%; height: 100%;"></div>
    </div>
</root>

@code
{
    public SettingsPage()
    {
        DefaultUrl = "/settings/video";
    }
}
