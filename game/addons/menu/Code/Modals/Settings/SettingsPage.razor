@using Sandbox
@using Sandbox.UI
@using System
@page "/settings"
@namespace MenuProject.Settings
@inherits Panel
@implements Sandbox.UI.Navigation.INavigatorPage

<root class="root">
	<SettingsView @ref=View StartCategory=@Category />
</root>

@code
{
	/// <summary>From the url, eg /settings?Category=keybinds. Set by the navigator, so settable.</summary>
	public string Category { get; set; }

	SettingsView View { get; set; }

	// The navigator keeps this panel alive between visits, so what it shows can be stale.
	public void OnNavigationOpen()
	{
		View?.Catalog.Revert();
		View?.Invalidate();
	}

	protected override int BuildHash() => HashCode.Combine( Category );
}
