@namespace MenuProject.Modals
@inherits MenuProject.Modals.BaseModal
@using MenuProject.Settings
@using Sandbox
@using Sandbox.UI

@* Full bleed rather than a dialog: no menu to navigate to while a game is running. *@
<root>

	<div class="inner">

		<div class="topbar">
			<i>settings</i>
			<label class="title">Settings</label>
			<div class="grow"></div>
			<Button class="close" Icon="close" onclick=@( () => CloseModal( true ) )>Close</Button>
		</div>

		<SettingsView StartCategory=@Category />

	</div>

</root>

@code
{
	public string Category { get; set; }

	public SettingsModal( string category = "" )
	{
		Category = category;
	}
}
