@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@namespace MenuProject.Settings
@inherits Panel

<root class="page-inner">
	<div class="page-content">
		<div class="storage-content">
			<div class="storage-overview">
				<div class="storage-overview-heading">
					<div class="storage-drive"><i>storage</i></div>
					<div class="storage-overview-title">
						<label class="storage-heading">#menu.settings.downloaded_content</label>
						<label class="storage-secondary">#menu.settings.kept_on_this_device_so_your_games_load_faster</label>
					</div>
					<div class="storage-total">
						<label class="storage-value">@(HasSnapshot ? FormatSize( Size ) : "#menu.settings.calculating")</label>
						<label class="storage-secondary">@(HasSnapshot ? "#menu.settings.used_by_downloads" : "#menu.settings.reading_your_cache")</label>
					</div>
				</div>

				<div class="storage-usage-bar">
					@foreach ( var entry in SizeBreakdown.OrderByDescending( x => x.Value ) )
					{
						<div class="storage-segment file-type-@Slug( entry.Key )" style="flex-grow: @entry.Value;" title="@($"{TypeTitle( entry.Key )}: {FormatSize( entry.Value )}")"></div>
					}
				</div>
				<div class="storage-overview-footer">
					<label class="storage-secondary">@(IsRefreshing ? $"Scanning… {ScannedFiles:N0} files" : $"{Files:N0} cached files")</label>
					<Button class="storage-refresh" Disabled=@Busy onclick=@TryRefresh>#menu.common.refresh</Button>
				</div>
			</div>

			@if ( !string.IsNullOrEmpty( ErrorMessage ) )
			{
				<div class="storage-error"><i>error_outline</i><label>@ErrorMessage</label></div>
			}

			@if ( HasSnapshot )
			{
				<div class="storage-section">
					<label class="storage-section-title">#menu.settings.recommendations</label>
					<div class="storage-group storage-cleanup">
						<div class="storage-recommendation">
							<div class="storage-cleanup-icon"><i>@(OldSize > 0 ? "auto_delete" : "check_circle")</i></div>
							<div class="storage-recommendation-copy">
								<label class="storage-heading">@(OldSize > 0 ? "#menu.settings.remove_unused_downloads" : "#menu.settings.you_re_up_to_date")</label>
								<label class="storage-secondary">@(OldSize > 0 ? $"Free up to {FormatSize( OldSize )}. These files haven't been accessed in {DaysAgo} days." : $"All cached content has been accessed in the last {DaysAgo} days.")</label>
							</div>
							@if ( OldSize > 0 )
							{
								<Button class="storage-action" Disabled=@(!CanClear || ConfirmCleanup) onclick=@RequestCleanup>@(IsClearing ? "#menu.settings.removing" : "#menu.settings.remove")</Button>
							}
						</div>
						@if ( ConfirmCleanup )
						{
							<div class="storage-confirmation">
								<label class="storage-heading">Remove @FormatSize( OldSize ) of unused downloads?</label>
								<label class="storage-secondary">#menu.settings.your_saved_data_won_t_be_touched_games_may</label>
								<div class="storage-confirmation-actions">
									<Button class="storage-action" onclick=@CancelCleanup>#menu.common.cancel</Button>
									<Button class="storage-action storage-destructive" Disabled=@(!CanClear) onclick=@ClearUnused>#menu.settings.remove_downloads</Button>
								</div>
							</div>
						}
					</div>
					<label class="storage-footnote">#menu.settings.removed_content_downloads_again_when_you_need_it_saved</label>
				</div>

				<div class="storage-section">
					<div class="storage-section-heading">
						<label class="storage-section-title">#menu.settings.content_by_type</label>
						<label class="storage-secondary">#menu.settings.largest_first</label>
					</div>
					<div class="storage-group storage-rows">
						@foreach ( var entry in SizeBreakdown.OrderByDescending( x => x.Value ) )
						{
							<div class="storage-type-row">
								<div class="storage-type-icon file-type-@Slug( entry.Key )"><i>@TypeIcon( entry.Key )</i></div>
								<label class="storage-type-name">@TypeTitle( entry.Key )</label>
								<label class="storage-type-size">@FormatSize( entry.Value )</label>
							</div>
						}
						@if ( Files == 0 )
						{
							<div class="storage-empty">
								<label class="storage-heading">#menu.settings.no_downloaded_content</label>
								<label class="storage-secondary">#menu.settings.content_will_appear_here_as_you_play</label>
							</div>
						}
					</div>
					<label class="storage-footnote">#menu.settings.this_includes_downloaded_content_only_not_the_s_box</label>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	const int DaysAgo = 7;

	Dictionary<string, long> SizeBreakdown = new();
	bool IsRefreshing = true;
	bool IsClearing;
	bool HasSnapshot;
	bool ConfirmCleanup;
	long ScannedFiles;
	DateTime ScanCutoff;
	string ErrorMessage = "";
	long Files;
	long Size;
	long OldSize;
	bool Busy => IsRefreshing || IsClearing;
	bool CanClear => HasSnapshot && !Busy && OldSize > 0 && string.IsNullOrEmpty( ErrorMessage );

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		if ( firstTime ) _ = Refresh();
	}

	void RequestCleanup()
	{
		if ( !CanClear ) return;
		ConfirmCleanup = true;
		StateHasChanged();
	}

	void CancelCleanup()
	{
		ConfirmCleanup = false;
		StateHasChanged();
	}

	async Task ClearUnused()
	{
		if ( !CanClear || !ConfirmCleanup ) return;

		IsClearing = true;
		ConfirmCleanup = false;
		ErrorMessage = "";
		StateHasChanged();

		try
		{
			await MenuUtility.Storage.FlushAsync( ScanCutoff );
			await Refresh();
		}
		catch ( Exception e )
		{
			ErrorMessage = $"Couldn't remove unused files: {e.Message}";
		}
		finally
		{
			IsClearing = false;
			StateHasChanged();
		}
	}

	void TryRefresh()
	{
		if ( IsRefreshing || IsClearing ) return;
		_ = Refresh();
	}

	async Task Refresh()
	{
		IsRefreshing = true;
		ConfirmCleanup = false;
		ErrorMessage = "";
		ScannedFiles = 0;
		StateHasChanged();

		try
		{
			var cutoff = DateTime.Now.AddDays( -DaysAgo );
			var sw = System.Diagnostics.Stopwatch.StartNew();
			var breakdown = new Dictionary<string, long>();
			long files = 0, size = 0, oldSize = 0;

			foreach ( var entry in MenuUtility.Storage.GetStorageFiles() )
			{
				files++;
				size += entry.Size;
				if ( entry.LastAccessed < cutoff ) oldSize += entry.Size;

				var type = FileType( entry.Filename );
				breakdown[type] = breakdown.GetValueOrDefault( type ) + entry.Size;

				if ( sw.ElapsedMilliseconds < 16 ) continue;
				ScannedFiles = files;
				sw.Restart();
				await Task.DelayRealtime( 1 );
				StateHasChanged();
			}

			SizeBreakdown = breakdown;
			Files = files;
			Size = size;
			OldSize = oldSize;
			ScanCutoff = cutoff;
			HasSnapshot = true;
		}
		catch ( Exception e )
		{
			ErrorMessage = $"Couldn't read storage: {e.Message}";
		}
		finally
		{
			IsRefreshing = false;
			StateHasChanged();
		}
	}

	static string FileType( string filename ) => Path.GetExtension( filename ).ToLowerInvariant() switch
	{
		".vpk" => "Maps",
		".vtex" or ".vtex_c" => "Textures",
		".shader" or ".shader_c" => "Shaders",
		".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" => "Images",
		".mp4" or ".webm" => "Videos",
		".vmt" or ".vmat" or ".vmat_c" => "Materials",
		".vmdl" or ".vmdl_c" => "Models",
		".vsnd" or ".vsnd_c" or ".sound" or ".sound_c" => "Sounds",
		_ => "Other"
	};

	/// <summary>
	/// Localized display name for a stable cache bucket identifier.
	/// </summary>
	static string TypeTitle( string type ) => Language.GetPhrase( type switch
	{
		"Maps" => "menu.maps",
		"Textures" => "menu.settings.textures",
		"Shaders" => "menu.settings.shaders",
		"Images" => "menu.settings.images",
		"Videos" => "menu.settings.videos",
		"Materials" => "menu.settings.materials",
		"Models" => "menu.settings.models",
		"Sounds" => "menu.settings.sounds",
		"Other" => "menu.store.other",
		_ => type
	} );

	static string Slug( string value ) => value.ToLowerInvariant();

	static string FormatSize( long bytes ) => MenuHelpers.FormatSize( bytes );

	static string TypeIcon( string type ) => type switch
	{
		"Textures" => "texture",
		"Models" => "view_in_ar",
		"Sounds" => "music_note",
		"Maps" => "map",
		"Materials" => "palette",
		"Images" => "image",
		"Shaders" => "auto_awesome",
		"Videos" => "videocam",
		_ => "folder"
	};

	/// <summary>
	/// Rebuild composed text when translations change.
	/// </summary>
	public override void LanguageChanged()
	{
		base.LanguageChanged();
		StateHasChanged();
	}
}
