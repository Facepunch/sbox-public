@using Sandbox
@using Sandbox.UI
@using SboxMenu
@using System
@using MenuProject.Modals.PackageModalComponents
@inherits Panel

@*
    The game you're in, up top down the left of the pause menu (GameMenu), over its buttons - its
    name, big, what it is in a line, and the pills to like it, its art behind. How it's reviewed is a page of its own
    (PackagePage.Reviews), how long you've played it a card on its Game info (PauseOverview).
*@
<root>

    @* A screenshot of it behind, fading out down towards the buttons *@
    <div class="art" style="background-image: url( @GameArt );"></div>

    <div class="block about">
        @* Its whole page, the one the main menu opens *@
        <label class="name" onclick=@( () => Package.OpenModal() )>@Package.Title</label>

        @if ( !string.IsNullOrWhiteSpace( Package.Summary ) )
        {
            <label class="summary">@Package.Summary</label>
        }
    </div>

    <div class="block pills">
        <PackageReactions Package=@Package ShowReviewScore=@false />
    </div>

</root>

@code
{
    [Parameter] public Package Package { get; set; }

    /// <summary>
    /// A screenshot of it - a scene from the game, rather than its thumbnail's logo vying with the name
    /// over it. Without one, its wide thumbnail, then its thumbnail.
    /// </summary>
    string GameArt
    {
        get
        {
            var shot = Package?.Screenshots?.FirstOrDefault( x => !x.IsVideo && (!string.IsNullOrEmpty( x.Thumb ) || !string.IsNullOrEmpty( x.Url )) );
            if ( shot is not null )
                return !string.IsNullOrEmpty( shot.Thumb ) ? shot.GetThumbUrl( 1024, 576 ) : shot.Url;

            return !string.IsNullOrEmpty( Package?.ThumbWide ) ? Package.ThumbWide : Package?.Thumb;
        }
    }

    protected override int BuildHash() => HashCode.Combine( Package );
}
