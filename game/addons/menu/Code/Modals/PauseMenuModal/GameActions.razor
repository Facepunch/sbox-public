@using Sandbox
@using Sandbox.UI
@inherits Panel

@*
    The game's own buttons in the pause menu - its [PauseAction] methods - under its Game info
    (PauseOverview), in its order, under a heading - its middle on the screen's. Read off it every frame, so they follow the game.
    Not there at all for a game without any. Ours - another map, streaming, leaving - are down the
    left (GameMenu).
*@
<root class="@(Actions.Count == 0 ? "empty" : "")">

    <div class="eyebrow"><icon>sports_esports</icon><label>Actions</label></div>

    <div class="buttons">
        @foreach ( var action in Actions )
        {
            @* Its glyph, its name, and what it does under the name - its tooltip, said rather than hidden *@
            <div class="action @(action.IsEnabled ? "" : "disabled")" onclick=@( () => Press( action ) )>
                <i>@(action.Icon ?? "radio_button_unchecked")</i>
                <div class="text">
                    <label class="title">@action.Title</label>
                    @if ( !string.IsNullOrWhiteSpace( action.Tooltip ) )
                    {
                        <label class="description">@action.Tooltip</label>
                    }
                </div>
            </div>
        }
    </div>

</root>

@code
{
    readonly List<MenuUtility.PauseAction> Actions = new();
    int _actionsHash;

    public override void Tick()
    {
        base.Tick();

        PlaceOnScreenMiddle();

        MenuUtility.GetPauseActions( Actions );

        if ( _mockActions )
            AddMockActions( Actions );

        var hash = 0;
        foreach ( var a in Actions )
            hash = HashCode.Combine( hash, a.Title, a.Icon, a.Tooltip, a.IsEnabled );

        _actionsHash = hash;
    }

    float _top = -1;

    /// <summary>
    /// Its middle on the screen's - however far down the page starts - but never up over the cards
    /// across the top of the page.
    /// </summary>
    void PlaceOnScreenMiddle()
    {
        if ( Parent is null || Box.Rect.Height <= 0 ) return;

        var screen = FindRootPanel().Box.Rect;
        var top = screen.Center.y - Box.Rect.Height * 0.5f - Parent.Box.Rect.Top;

        if ( Parent.Children.FirstOrDefault( x => x.HasClass( "tiles" ) ) is { } tiles && tiles.Box.Rect.Height > 0 )
            top = MathF.Max( top, tiles.Box.Rect.Bottom - Parent.Box.Rect.Top + Gap * ScaleToScreen );

        top = MathF.Round( top * ScaleFromScreen );
        if ( MathF.Abs( top - _top ) < 0.5f ) return;

        _top = top;
        Style.Top = top;

        // Placed - it can be seen now, rather than showing up at the top for a frame first
        SetClass( "placed", true );
    }

    /// <summary>
    /// Clear air under the cards, when there isn't room for the screen's middle.
    /// </summary>
    const float Gap = 32;

    void Press( MenuUtility.PauseAction action )
    {
        if ( !action.IsEnabled ) return;

        action.Press?.Invoke();

        if ( action.DismissOnPress )
            Ancestors.OfType<PauseModal>().FirstOrDefault()?.Resume();
    }

    static bool _mockActions;

    /// <summary>
    /// <c>menu_mock_pause_actions</c> - a few made up game actions in the pause menu, to look at without a
    /// game that has any. Again to take them off.
    /// </summary>
    [MenuConCmd( "menu_mock_pause_actions", Help = "Toggle a few made up game actions in the pause menu" )]
    public static void MockActions()
    {
        _mockActions = !_mockActions;
    }

    static void AddMockActions( List<MenuUtility.PauseAction> actions )
    {
        actions.Add( new( "Vote map", "how_to_vote", "Pick the next map", true, true, () => Log.Info( "menu_mock_pause_actions: Vote map" ) ) );
        actions.Add( new( "Scoreboard", "leaderboard", null, true, false, () => Log.Info( "menu_mock_pause_actions: Scoreboard" ) ) );
        actions.Add( new( "Respawn", "restart_alt", "Can't respawn yet", false, true, () => Log.Info( "menu_mock_pause_actions: Respawn" ) ) );
    }

    protected override int BuildHash() => HashCode.Combine( _actionsHash, Actions.Count );
}
