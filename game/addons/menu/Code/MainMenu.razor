@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using Sandbox;
@using System;
@using SboxMenu;
@using MenuProject.Modals;
@inherits PanelComponent

<div class="mainmenu">

    <MenuShell DefaultUrl="/home" @ref="Navigator">
        <Overlay>
            <div class="overlay">
                <div class="overlay-container">
                    <OfflineMode />
                </div>
            </div>
        </Overlay>
    </MenuShell>
</div>

@code
{
    public NavigationHost Navigator { get; protected set; }

    public static MainMenu Instance { get; private set; }

    static bool _streamerPromptShown;

    override protected void OnEnabled()
    {
        base.OnEnabled();

        Instance = this;

        // Fetch resolutions now so opening the settings doesn't stutter later.
        MenuProject.Settings.SettingsCatalog.FetchResolutions();

        _ = ShowStartupModalsIfNeeded();
    }

    async Task ShowStartupModalsIfNeeded()
    {
        await Task.DelayRealtime(1500);

        await ShowStreamerModePromptIfNeeded();
    }

    async Task ShowStreamerModePromptIfNeeded()
    {
        if ( _streamerPromptShown ) return;
        if ( Preferences.StreamerMode ) return;

        // Only inform the user about Streamer Mode once, then remember it across startups.
        if ( Game.Cookies.Get<bool>( StreamerModePromptModal.CookieKey, false ) ) return;

        // Enumerating every process can take tens of ms, so keep it off the main thread.
        if ( !await RecordingSoftware.IsRunningAsync() ) return;

        _streamerPromptShown = true;
        Game.Cookies.Set( StreamerModePromptModal.CookieKey, true );

        var modal = new StreamerModePromptModal();
        modal.Parent = Panel;
    }

    override protected void OnUpdate()
    {
        SetClass( "is-vr", Application.IsVR );
        SetClass( "has-streamer-account", Sandbox.MenuEngine.Account.HasLinkedStreamerServices );
    }
}
