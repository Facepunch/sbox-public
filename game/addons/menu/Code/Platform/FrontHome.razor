@using System;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Modals;
@namespace MenuProject.Platform
@page "/platform/front"
@inherits Panel

@*
    The default front's menu, under the game's name. Starting a new game, or finding one to join, goes on to the
    next page (FrontPages).
*@
<root>

    @if ( PlatformMenu.HasGame )
    {
        <div class="nav">
            <div class="tier">
                @if ( !IsDedicatedServerOnly )
                {
                    <div class="item @(WhyNot is null ? "" : "disabled")" tooltip="@(WhyNot ?? "")" onclick=@Play><label>@PlayText</label></div>
                }

                @if ( IsMultiplayer && !IsQuickPlay )
                {
                    <div class="item" onclick=@FindMultiplayer><label>@(IsDedicatedServerOnly ? "Find a Server" : "Find Multiplayer Game")</label></div>
                }

                <div class="item" onclick=@( () => ModalSystem.Instance?.Settings() )><label>Options</label></div>
            </div>
        </div>
    }

</root>

@code
{
    static Package Current => PlatformMenu.Current;

    /// <summary>
    /// How it's played - from its Workshop item, so it's known before its package is in. A local project's from its
    /// package.
    /// </summary>
    static string LaunchMode => PlatformMenu.LaunchMode;

    static int MaxPlayers => PlatformMenu.MaxPlayers;

    static bool IsQuickPlay => string.Equals( LaunchMode, "quickplay", StringComparison.OrdinalIgnoreCase );

    static bool IsDedicatedServerOnly => PlatformMenu.IsDedicatedServerOnly;

    // Played on your own, as MenuHelpers.IsSingleplayer has it - no servers, whatever its launch mode says
    static bool IsSingleplayer => MaxPlayers <= 1 || Modes is { Solo: true, Multiplayer: false };

    static PlayerModes Modes => PlatformMenu.CurrentId != 0 ? PlayerModes.For( PlatformMenu.Details ) : PlayerModes.For( Current );

    static bool IsMultiplayer => !IsSingleplayer && (MaxPlayers > 1 || IsQuickPlay || IsDedicatedServerOnly);

    static string PlayText => IsMultiplayer && !IsQuickPlay ? "Start New Game" : "Play";

    /// <summary>
    /// Why it can't be played - and until its package is in, that it's still being got
    /// </summary>
    static string WhyNot => PlatformMenu.WhyCantStart() ?? (Current is not null ? null : PlatformMenu.PackageFailed ? "Couldn't load this game" : "Getting the game ready");

    /// <summary>
    /// Played the way it always is - but one with something to set up first is set up on the next page here, not in
    /// the game setup modal
    /// </summary>
    void Play()
    {
        if ( WhyNot is not null || Current is not { } game ) return;

        MenuHelpers.PlayGame( game, openSetup: _ => FrontPages.Of( this )?.Navigate( FrontPages.Create ) );
    }

    void FindMultiplayer() => FrontPages.Of( this )?.Navigate( FrontPages.Servers );

    protected override int BuildHash() => HashCode.Combine( Current, PlatformMenu.Details, PlatformMenu.HasGame, PlatformMenu.PackageFailed, WhyNot );
}
