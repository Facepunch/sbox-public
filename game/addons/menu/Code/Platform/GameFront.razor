@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Modals;
@namespace MenuProject.Platform
@inherits Panel

@*
    The default front for a game without a menu scene of its own, made from what the Workshop says about it: its
    name top left, and under it its pages - its menu, setting up a new game, picking its map, and its
    servers (FrontPages). On a page off its menu, its name fades away and the page takes its room. Paused in a game -
    any game - it's the pause menu: Resume, changing its map if it has that, the game's own pause actions, and Leave
    back to its menu.
*@
<root class="@(Paused ? "paused" : "") @(OffHome ? "paging" : "")">

    @if ( Shown is { } game )
    {
        <div class="header">
            <label class="title">@game.Title</label>
        </div>

        @if ( Paused && page == OnPlayers )
        {
            @* Its Players page - over the front as its other pages are, back to the pause menu from its bar *@
            <div class="pages">
                <div class="players-page navigator-body">
                    <MenuProject.Modals.PlayerList Back=@( () => { page = null; } ) />
                </div>
            </div>
        }
        else if ( Paused && page == OnMaps )
        {
            @* The map browser - pick one and the game loads again on it *@
            <div class="pages">
                <MapsPage class="navigator-body" Selected=@LaunchArguments.Map OnPicked=@ChangeMap Back=@( () => { page = null; } ) />
            </div>
        }
        else if ( Paused )
        {
            <div class="nav">
                <div class="tier">
                    <div class="item" onclick=@Resume><label>Resume</label></div>

                    @if ( CanChangeMap )
                    {
                        <div class="item" onclick=@( () => page = OnMaps )><label>Change Map</label></div>
                    }

                    @if ( ShowPlayers )
                    {
                        <div class="item" onclick=@( () => page = OnPlayers )><label>Players</label></div>
                    }
                </div>

                @if ( Actions.Count > 0 )
                {
                    <div class="tier">
                        @foreach ( var action in Actions )
                        {
                            <div class="item @(action.IsEnabled ? "" : "disabled")" tooltip="@(action.Tooltip ?? "")" onclick=@( () => Press( action ) )><label>@action.Title</label></div>
                        }
                    </div>
                }

                <div class="tier">
                    <div class="item" onclick=@( () => ModalSystem.Instance?.Settings() )><label>Options</label></div>
                    <div class="item leave" onclick=@Leave><label>Leave Game</label></div>
                </div>
            </div>
        }
        else
        {
            <FrontPages class="pages" @ref="Pages" />
        }
    }

</root>

@code
{
    [Parameter] public bool Paused { get; set; }

    [Parameter] public Action OnResume { get; set; }

    /// <summary>
    /// Paused, the game that's loaded - otherwise the platform's
    /// </summary>
    static Package Shown => PlatformMenu.Current ?? MenuUtility.GamePackage;

    /// <summary>
    /// In a networked game that doesn't hide its player list - as the old pause menu has it (PauseHome)
    /// </summary>
    static bool ShowPlayers => MenuProject.Modals.PlayerList.IsMocking || (Networking.IsActive && (Shown?.Info.ShowsPlayerList ?? true));

    FrontPages Pages;

    /// <summary>
    /// The host of the game that's loaded, with a say in what's played, in a game that has its map changed from here
    /// (its MapSettings' ShowChangeMap) - as the old pause menu has it (GameMenu)
    /// </summary>
    static bool CanChangeMap => (!Networking.IsActive || Networking.IsHost) && MenuHelpers.HasAuthority && (MenuUtility.GamePackage?.Info.ShowsChangeMap ?? false);

    const string OnPlayers = "players";
    const string OnMaps = "maps";

    /// <summary>
    /// Paused, the page it's on rather than the pause menu - null on that
    /// </summary>
    string page;

    public bool Back()
    {
        if ( Paused && page is not null )
        {
            page = null;
            return true;
        }

        return OffHome && Pages.GoBack();
    }

    public bool OffHome => (Paused && page is not null) || (Pages.IsValid() && Pages.OffHome);

    /// <summary>
    /// The game that's loaded, loaded again on <paramref name="map"/> - whoever's in it comes along
    /// </summary>
    void ChangeMap( string map )
    {
        if ( string.IsNullOrEmpty( map ) || !CanChangeMap ) return;

        LaunchArguments.Map = map;
        Game.Load( MenuUtility.GamePackage.FullIdent, true );

        Resume();
    }

    void Resume() => OnResume?.Invoke();

    readonly List<MenuUtility.PauseAction> Actions = new();
    int actionsHash;

    void Press( MenuUtility.PauseAction action )
    {
        if ( !action.IsEnabled ) return;

        action.Press?.Invoke();

        if ( action.DismissOnPress )
            Resume();
    }

    void Leave() => MenuHelpers.ConfirmLeave( () =>
    {
        Resume();
        Game.ReturnToMenu();
    } );

    public override void Tick()
    {
        base.Tick();

        // Back on the pause menu the next time it's paused - and the page gone if nobody's list is shown any more
        if ( !Paused || (page == OnPlayers && !ShowPlayers) || (page == OnMaps && !CanChangeMap) ) page = null;

        if ( !Paused ) return;

        MenuUtility.GetPauseActions( Actions );

        var hash = 0;
        foreach ( var a in Actions )
            hash = HashCode.Combine( hash, a.Title, a.Tooltip, a.IsEnabled );

        actionsHash = hash;
    }

    protected override int BuildHash() => HashCode.Combine( Paused, Shown, actionsHash, OffHome, ShowPlayers, page, CanChangeMap );
}
