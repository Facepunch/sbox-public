@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Modals;
@namespace MenuProject.Platform
@inherits Panel

@*
    The default front for a game without a menu scene of its own, made from what the Workshop says about it: its
    name top left, and under it its pages - its menu, setting up a new game, picking its map, and its
    servers (FrontPages). On a page off its menu, its name fades away and the page takes its room. Paused in a game -
    any game - it's the pause menu: Resume, changing its map if it has that, the game's own pause actions, and Leave
    back to its menu.
*@
<root class="@(Paused ? "paused" : "") @(OffHome ? "paging" : "")">
	<div class="inner" @ref="Inner">
    @if ( ShownTitle is { } title )
    {
        <div class="header">
            <label class="title @TitleSizes[titleSize]" @ref="TitleLabel">@title</label>
        </div>

        @if ( Paused && page == OnPlayers )
        {
            @* Its Players page - over the front as its other pages are, back to the pause menu from its bar *@
            <div class="pages">
                <div class="players-page navigator-body">
                    <MenuProject.Modals.PlayerList Back=@( () => { page = null; } ) />
                </div>
            </div>
        }
        else if ( Paused && page == OnMaps )
        {
            @* The map browser - pick one and the game loads again on it *@
            <div class="pages">
                <MapsPage class="navigator-body" Selected=@LaunchArguments.Map OnPicked=@ChangeMap Back=@( () => { page = null; } ) />
            </div>
        }
        else if ( Paused )
        {
            <div class="nav" @ref="PauseNav">
                <div class="tier">
                    <label class="item" onclick=@Resume>Resume</label>

                    @if ( CanChangeMap )
                    {
                        <label class="item" onclick=@( () => page = OnMaps )>Change Map</label>
                    }

                    @if ( ShowPlayers )
                    {
                        <label class="item" onclick=@( () => page = OnPlayers )>Players</label>
                    }
                </div>

                @if ( Actions.Count > 0 )
                {
                    <div class="tier">
                        @foreach ( var action in Actions )
                        {
                            <label class="item @(action.IsEnabled ? "" : "disabled")" tooltip="@(action.Tooltip ?? "")" onclick=@( () => Press( action ) )>@action.Title</label>
                        }
                    </div>
                }

                <div class="tier">
                    <label class="item" onclick=@( () => ModalSystem.Instance?.Settings() )>Settings</label>
                    <label class="item" onclick=@Leave>Leave Game</label>
                </div>
            </div>
        }
        else
        {
            <FrontPages class="pages" @ref="Pages" />
        }
    }
	</div>
</root>

@code
{
    [Parameter] public bool Paused { get; set; }

    [Parameter] public Action OnResume { get; set; }

    /// <summary>
    /// Paused, the game that's loaded - otherwise the platform's
    /// </summary>
    static Package Shown => PlatformMenu.Current ?? MenuUtility.GamePackage;

    /// <summary>
    /// Paused, the loaded game's name - otherwise the platform's (<see cref="PlatformMenu.Title"/>)
    /// </summary>
    string ShownTitle => Paused ? Shown?.Title : PlatformMenu.Title;

    /// <summary>
    /// In a networked game that doesn't hide its player list - as the old pause menu has it (PauseHome)
    /// </summary>
    static bool ShowPlayers => MenuProject.Modals.PlayerList.IsMocking || (Networking.IsActive && (Shown?.Info.ShowsPlayerList ?? true));

    FrontPages Pages;

    Panel Inner;
    Label TitleLabel;

    /// <summary>
    /// The pause menu scrolls when a game's own actions make it longer than there's room for - faded off where there's
    /// more of it
    /// </summary>
    Panel PauseNav;
    readonly ScrollFade pauseNavFade = new( 32 );

    /// <summary>
    /// The title's sizes, biggest first. The last wraps, so anything fits.
    /// </summary>
    static readonly string[] TitleSizes = ["", "long", "longer", "longest"];

    string fittedTitle;
    int titleSize;
    int titleSettling;

    /// <summary>
    /// Where a title starts from by its length - most are right first time, so there's nothing to see it settle
    /// </summary>
    static int TitleSizeFor( string title ) => title.Length switch
    {
        > 32 => 2,
        > 20 => 1,
        _ => 0
    };

    /// <summary>
    /// A size down for as long as the title runs past the front's right edge - how wide it is depends on its letters
    /// and how wide the screen is, not just how many there are
    /// </summary>
    void FitTitle()
    {
        var title = ShownTitle;
        if ( title != fittedTitle )
        {
            fittedTitle = title;
            titleSize = title is null ? 0 : TitleSizeFor( title );
            titleSettling = 2;
            return;
        }

        // Laid out at the size it's at before it's measured again
        if ( titleSettling > 0 ) { titleSettling--; return; }

        if ( titleSize >= TitleSizes.Length - 1 || !TitleLabel.IsValid() || !Inner.IsValid() ) return;
        if ( TitleLabel.Box.Rect.Right <= Inner.Box.Rect.Right - TitleEdge * ScaleToScreen ) return;

        titleSize++;
        titleSettling = 2;
    }

    /// <summary>
    /// The header's left edge ($front-inset in the stylesheet), kept clear on the right too
    /// </summary>
    const float TitleEdge = 48;

    /// <summary>
    /// The host of the game that's loaded, with a say in what's played, in a game that has its map changed from here
    /// (its MapSettings' ShowChangeMap) - as the old pause menu has it (GameMenu)
    /// </summary>
    static bool CanChangeMap => (!Networking.IsActive || Networking.IsHost) && MenuHelpers.HasAuthority && (MenuUtility.GamePackage?.Info.ShowsChangeMap ?? false);

    const string OnPlayers = "players";
    const string OnMaps = "maps";

    /// <summary>
    /// Paused, the page it's on rather than the pause menu - null on that
    /// </summary>
    string page;

    public bool Back()
    {
        if ( Paused && page is not null )
        {
            page = null;
            return true;
        }

        return OffHome && Pages.GoBack();
    }

    public bool OffHome => (Paused && page is not null) || (Pages.IsValid() && Pages.OffHome);

    /// <summary>
    /// The game that's loaded, loaded again on <paramref name="map"/> - whoever's in it comes along
    /// </summary>
    void ChangeMap( string map )
    {
        if ( string.IsNullOrEmpty( map ) || !CanChangeMap ) return;

        LaunchArguments.Map = map;
        Game.Load( MenuUtility.GamePackage.FullIdent, true );

        Resume();
    }

    void Resume() => OnResume?.Invoke();

    readonly List<MenuUtility.PauseAction> Actions = new();
    int actionsHash;

    void Press( MenuUtility.PauseAction action )
    {
        if ( !action.IsEnabled ) return;

        action.Press?.Invoke();

        if ( action.DismissOnPress )
            Resume();
    }

    /// <summary>
    /// Back to its menu - in the editor, out of play mode
    /// </summary>
    void Leave() => MenuHelpers.ConfirmLeave( () =>
    {
        Resume();

        if ( Application.IsEditor ) Game.Close();
        else Game.ReturnToMenu();
    } );

    public override void Tick()
    {
        base.Tick();

        FitTitle();

        if ( PauseNav.IsValid() ) pauseNavFade.Apply( PauseNav );

        // Back on the pause menu the next time it's paused - and the page gone if nobody's list is shown any more
        if ( !Paused || (page == OnPlayers && !ShowPlayers) || (page == OnMaps && !CanChangeMap) ) page = null;

        if ( !Paused ) return;

        MenuUtility.GetPauseActions( Actions );

        var hash = 0;
        foreach ( var a in Actions )
            hash = HashCode.Combine( hash, a.Title, a.Tooltip, a.IsEnabled );

        actionsHash = hash;
    }

    protected override int BuildHash() => HashCode.Combine( Paused, Shown, ShownTitle, actionsHash, OffHome, ShowPlayers, HashCode.Combine( page, CanChangeMap, titleSize ) );
}
