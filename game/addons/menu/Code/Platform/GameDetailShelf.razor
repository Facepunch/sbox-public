@using System;
@using System.Linq;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.UI;
@using MenuProject.Modals.PackageModalComponents;
@namespace MenuProject.Platform
@page "/shelf/details/{Kind}/{Ident}"
@inherits ShelfPage

@*
    A package's page, up out of the dock - a panel the shelf's full height, running down into the dock, laid out as
    Steam's store page is: the gallery beside its capsule and facts, a strip with how it's played and the way in, then
    what it says about itself beside you and it. A game's has all of that; anything else (a map) just what applies to
    it - no players, no way in, no time played.
*@
<root>

    <div class="panel" @ref="PanelBox">
        <PanelHead Back=@Back>
            <Heading>
                <div class="heading">
                    <div class="tile" style="@MenuHelpers.BackgroundImage( Thumb )">
                        @if ( string.IsNullOrEmpty( Thumb ) )
                        {
                            <i>@(IsGame ? "sports_esports" : IsMap ? "map" : "inventory_2")</i>
                        }
                    </div>
                    <label class="title @(Page is null ? "" : "parent")" onclick=@( () => ShowPage( null ) )>@Title</label>
                    @if ( WorkshopId != 0 )
                    {
                        <i class="favourite @(Favourited ? "on" : "")" onclick=@( () => PlatformMenu.SetFavourite( WorkshopId, !Favourited ) ) tooltip="@(Favourited ? "Remove from your favourites" : "Add to your favourites")">star</i>
                    }
                    @if ( Page is not null )
                    {
                        <label class="sep">/</label>
                        <label class="here">@(Page == "achievements" ? "Achievements" : "Changes")</label>
                    }
                </div>
            </Heading>
            <Tools>
                @if ( WorkshopItem is not null )
                {
                    <PackageReactions OnWorkshop=@true Workshop=@WorkshopItem />
                }

                @if ( WorkshopId != 0 )
                {
                    <div class="tool" onclick=@( () => MenuUtility.OpenUrl( $"steam://url/CommunityFilePage/{WorkshopId}" ) ) tooltip="Open on the Workshop"><i>open_in_new</i></div>
                }
            </Tools>
        </PanelHead>

        <div class="body" @ref="Body">
            @if ( PageLoading )
            {
                <div class="status"><Spinner /></div>
            }
            else if ( WorkshopItem is null && Local is null )
            {
                <div class="status">@(Kind == "map" ? "Couldn't find this map on the Workshop or in your local projects." : "Couldn't load this Workshop item.")</div>
            }
            else if ( Page == "achievements" )
            {
                <div class="page" @key=@("achievements")>
                    <AchievementList Package=@StatsPackage />
                </div>
            }
            else if ( Page == "changes" )
            {
                <div class="page" @key=@("changes")>
                    <WorkshopItemChanges @key=@WorkshopId WorkshopId=@WorkshopId />
                </div>
            }
            else
            {
                <div class="overview" @key=@("overview")>
                    <div class="hero">
                        <div class="gallery">
                            <Media @key=@Ident Package=@Local Workshop=@WorkshopItem />
                        </div>

                        <div class="info">
                            <div class="capsule" style="@MenuHelpers.BackgroundImage( Thumb )"></div>

                            <div class="title-block">
                                @* Each a fixed height, its label in the middle of it - the font's own line is far taller than its letters *@
                                <div class="line name-line @NameSize">
                                    <label class="name" tooltip="@Title">@Title</label>
                                </div>
                            </div>

                            @if ( !string.IsNullOrWhiteSpace( summary ) )
                            {
                                <label class="summary">@summary</label>
                            }

                            <div class="kv">
                                @if ( IsGame && WorkshopItem is { } item )
                                {
                                    <div class="kv-row">
                                        <label class="k">Subscribers</label>
                                        <label class="v">@item.Subscriptions.ToMetric()</label>
                                    </div>
                                }
                                @if ( Released is { } released )
                                {
                                    <div class="kv-row">
                                        <label class="k">Release date</label>
                                        <label class="v">@released.ToLocalTime().ToString( "d MMM, yyyy" )</label>
                                    </div>
                                }
                                @if ( WorkshopItem?.Updated is { } updated && updated != default )
                                {
                                    <div class="kv-row link" onclick=@( () => ShowPage( "changes" ) )>
                                        <label class="k">Updated</label>
                                        <label class="v link">@MenuHelpers.TimeAgo( updated )</label>
                                    </div>
                                }
                                @if ( Creator is { Length: > 0 } creator )
                                {
                                    <div class="kv-row">
                                        <label class="k">Creator</label>
                                        <label class="v link creator">@creator</label>
                                        @if ( MenuHelpers.IsVerified( WorkshopItem ) )
                                        {
                                            <i class="verified" tooltip="Verified by Facepunch">verified</i>
                                        }
                                    </div>
                                }
                                @if ( WorkshopItem is { Size: > 0 } sized )
                                {
                                    <div class="kv-row">
                                        <label class="k">Size</label>
                                        <label class="v">@MenuHelpers.FormatSize( sized.Size )</label>
                                    </div>
                                }
                            </div>

                            <div class="grow"></div>

                            @* One row, as many as fit and how many more - unfolded to all of them from that, and folded back again *@
                            @if ( TagList.Length > 0 )
                            {
                                <div class="tags @(tagsOpen ? "open" : "")" @ref="TagsBox">
                                    @for ( var i = 0; i < TagList.Length; i++ )
                                    {
                                        @if ( tagsOpen || measuringTags || i < tagsShown )
                                        {
                                            <div class="tag"><label>@TagList[i]</label></div>
                                        }
                                    }
                                    @if ( !tagsOpen && !measuringTags && tagsShown < TagList.Length )
                                    {
                                        <div class="tag more" onclick=@( () => tagsOpen = true ) tooltip="Show all its tags"><label>@($"+{TagList.Length - tagsShown} more")</label></div>
                                    }
                                    else if ( tagsOpen )
                                    {
                                        <div class="tag more" onclick=@( () => tagsOpen = false ) tooltip="Back to one row"><label>Show less</label></div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="play-strip @(ModeMismatch ? "mismatch" : "")">
                        @if ( IsGame && Modes is { IsUnknown: false } modes )
                        {
                            var fit = modes.FitFor( MenuProject.PlayerModes.PartySize );

                            <div class="mode @(ModeMismatch ? "mismatch" : "")">
                                <div class="mode-icon"><i>@modes.Icon</i></div>

                                <div class="mode-text">
                                    <label class="mode-title">@ModeTitle( modes )</label>

                                    @if ( ModeDetail is { Length: > 0 } detail )
                                    {
                                        <label class="mode-hint">@detail</label>
                                    }
                                </div>

                                @if ( MenuProject.PlayerModes.PartySize > 1 && fit.Fit != MenuProject.PlayerModes.FitKind.Unknown )
                                {
                                    <div class="mode-fit" tooltip="@(fit.Why ?? "Your party can play this")">
                                        <i>@(fit.Fit == MenuProject.PlayerModes.FitKind.Good ? "groups" : "group_off")</i>
                                    </div>
                                }
                            </div>
                        }

                        <div class="grow"></div>

                        @* Its buttons together, the one gap between them *@
                        <div class="strip-actions">
                            @if ( WorkshopId != 0 )
                            {
                                <div class="action subscribe @(Subscribed ? "on" : "")" onclick=@ToggleSubscribed tooltip="@(Subscribed ? "Unsubscribe" : "Kept installed and up to date")">
                                    <i>@(Subscribed ? "check" : "add")</i>
                                    <label>@(Subscribed ? "Subscribed" : "Subscribe")</label>
                                </div>
                            }

                            @* Only a game's switched to *@
                            @if ( IsGame && !IsCurrent && PlatformMenu.CanChangeGame )
                            {
                                <div class="action primary" onclick=@Switch>
                                    <i>@(Downloaded ? "check" : "download")</i>
                                    <label>@(Downloaded ? "Select" : "Download")</label>
                                </div>
                            }
                            else if ( IsGame )
                            {
                                <div class="action selected">
                                    <i>check</i>
                                    <label>Selected</label>
                                </div>
                            }
                        </div>
                    </div>

                    @if ( !PageLoading )
                    {
                        <div class="lower">
                            <div class="main">
                                <PackageAbout Package=@Local Workshop=@WorkshopItem />
                            </div>

                            <div class="side">
                                @if ( IsGame && StatsPackage is { IsRemote: true } )
                                {
                                    <div class="block">
                                        <label class="block-title">Your time</label>
                                        <div class="record">
                                            <div class="stat">
                                                <label class="value @(StatsPackage.Interaction.Used ? "" : "none")">@(StatsPackage.Interaction.Used ? MenuHelpers.PlayTime( TimeSpan.FromSeconds( StatsPackage.Interaction.Seconds ) ) : "Never")</label>
                                                <label class="caption">Played</label>
                                            </div>
                                            <div class="stat">
                                                <label class="value @(StatsPackage.Interaction.FirstUsed is null ? "none" : "")">@(StatsPackage.Interaction.FirstUsed is { } first ? first.ToLocalTime().ToString( "d MMM yyyy" ) : "–")</label>
                                                <label class="caption">First played</label>
                                            </div>
                                            <div class="stat">
                                                <label class="value @(StatsPackage.Interaction.LastUsed is null ? "none" : "")">@(StatsPackage.Interaction.LastUsed is { } last ? MenuHelpers.TimeAgo( last ) : "–")</label>
                                                <label class="caption">Last played</label>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if ( HasAchievements )
                                {
                                    <div class="block link achievements-link" onclick=@( () => ShowPage( "achievements" ) ) tooltip="See all achievements">
                                        <PackageAchievementSummary Package=@StatsPackage Header=@true />
                                    </div>
                                }

                                @if ( WorkshopId != 0 )
                                {
                                    <div class="block link" onclick=@( () => ShowPage( "changes" ) )>
                                        <div class="block-head">
                                            <label class="block-title">@(LatestChange is { } change ? $"Update {change.Time.ToLocalTime():d MMM yyyy}" : "Update notes")</label>
                                            <div class="grow"></div>
                                            @if ( LatestChange is { } dated )
                                            {
                                                <label class="when">@MenuHelpers.TimeAgo( dated.Time.UtcDateTime )</label>
                                            }
                                            <i class="chevron">chevron_right</i>
                                        </div>

                                        @foreach ( var line in ChangeLines )
                                        {
                                            <label class="update-line">@line</label>
                                        }
                                    </div>
                                }

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</root>

@code
{
    /// <summary>
    /// The kind of detail page requested by the menu.
    /// </summary>
    public string Kind { get; set; }

    /// <summary>
    /// The URL-encoded item ID, local map path, or game ident.
    /// </summary>
    public string Ident { get; set; }

    /// <summary>
    /// The page of it it opens on - "changes" or "achievements" - from its url's query (PlatformShelf.Game), taken when
    /// it's shown. Its overview without one.
    /// </summary>
    public string Show { get; set; }

    public override bool ToDock => true;
    public override bool ClicksThrough => true;

    public override void OnShelfShown() => Open();

    GamePageLoad load;
    Package StatsPackage;
    string summary;
    string previewIdent;
    WorkshopItemDetails WorkshopItem => load?.WorkshopItem;
    Package Local => Kind == "map" || load?.Local?.WorkshopId == 0 ? load?.Local : null;
    ulong WorkshopId => WorkshopItem?.Id ?? 0;

    string loadedIdent;
    Panel Body;

    WorkshopChangeNote? LatestChange;

    IEnumerable<string> ChangeLines => (LatestChange?.Text ?? "")
        .Split( '\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries )
        .Select( x => System.Text.RegularExpressions.Regex.Replace( x, @"\[[^\]]*\]", "" ).TrimStart( '-', '*', '•', ' ' ).Trim() )
        .Where( x => x.Length > 0 )
        .Take( 3 );

    /// <summary>
    /// A page of it in the body's place - "achievements" or "changes" - or null for its overview
    /// </summary>
    string Page => requestedPage switch
    {
        "changes" when WorkshopId == 0 => null,
        "achievements" when StatsPackage is null => null,
        _ => requestedPage
    };
    string requestedPage;

    void ShowPage( string page )
    {
        if ( requestedPage == page ) return;

        requestedPage = page;
        if ( Body.IsValid() ) Body.ScrollOffset = Vector2.Zero;
    }

    internal bool BackPage()
    {
        if ( Page is null ) return false;

        ShowPage( null );
        return true;
    }
    Panel PanelBox;

    bool PageLoading => load?.Loading ?? true;

    string Title => WorkshopItem?.Title ?? Local?.Title ?? "";

    string Thumb => WorkshopItem?.Thumb ?? Local?.Thumb;

    /// <summary>
    /// Its name a step smaller when it's long, so more of it fits on its one line - never smaller than that, cut short
    /// past it
    /// </summary>
    string NameSize => Title.Length switch
    {
        > 30 => "longer",
        > 18 => "long",
        _ => ""
    };

    string Creator => WorkshopItem?.OwnerName ?? Local?.Org?.Title;

    static readonly string[] WorkshopOwnTags = ["game", "map", "Singleplayer", "Multiplayer", "Co-op", "Versus"];

    IEnumerable<string> Tags => (WorkshopItem is not null
            ? (WorkshopItem?.Tags ?? []).Where( x => !WorkshopOwnTags.Contains( x, StringComparer.OrdinalIgnoreCase ) )
            : Local?.Tags ?? [])
        .Where( x => !string.IsNullOrWhiteSpace( x ) )
        .Select( x => char.ToUpperInvariant( x[0] ) + x[1..] )
        .Distinct( StringComparer.OrdinalIgnoreCase );

    string[] tagList = [];
    string tagListOf;

    string[] TagList
    {
        get
        {
            var key = $"{WorkshopId}|{Ident}";
            if ( key != tagListOf )
            {
                tagListOf = key;
                tagList = Tags.ToArray();
                tagsOpen = false;
                tagsMeasured = null;
            }

            return tagList;
        }
    }

    Panel TagsBox;
    bool tagsOpen;
    bool measuringTags;
    int tagsShown = int.MaxValue;
    string tagsMeasured;

    /// <summary>
    /// How many tags fit on the row with room for "+N more" - measured with them all laid out in a row, once for each set
    /// of tags and width it's at
    /// </summary>
    void FoldTags()
    {
        if ( tagsOpen || !TagsBox.IsValid() || TagList.Length == 0 ) return;

        var room = TagsBox.Box.Rect.Width;
        if ( room <= 0 ) return;

        var key = $"{tagListOf}|{room:0}";
        if ( key == tagsMeasured ) return;

        if ( !measuringTags )
        {
            measuringTags = true;
            StateHasChanged();
            return;
        }

        var tags = TagsBox.Children.Where( x => x.HasClass( "tag" ) ).ToList();
        if ( tags.Count != TagList.Length || tags.Any( x => x.Box.Rect.Width <= 0 ) ) return;

        var gap = 4 * TagsBox.ScaleToScreen;
        var more = 64 * TagsBox.ScaleToScreen;
        var used = 0f;
        var shown = 0;

        for ( var i = 0; i < tags.Count; i++ )
        {
            var need = used + (shown > 0 ? gap : 0) + tags[i].Box.Rect.Width;
            var last = i == tags.Count - 1;
            if ( need + (last ? 0 : gap + more) > room ) break;

            used = need;
            shown++;
        }

        tagsShown = shown;
        tagsMeasured = key;
        measuringTags = false;
        StateHasChanged();
    }

    DateTimeOffset? Released => (WorkshopItem?.Created ?? Local?.Created) is { } released && released != default ? released : null;

    MenuProject.PlayerModes? Modes => WorkshopItem is not null ? MenuProject.PlayerModes.For( WorkshopItem ) : MenuProject.PlayerModes.For( Local );

    static string ModeTitle( MenuProject.PlayerModes modes ) => modes is { Solo: true, Coop: true, Versus: true } ? "#menu.home.multiplayer" : modes.Label;

    /// <summary>
    /// A game - played, switched to. Anything else only shows what applies to it.
    /// </summary>
    bool IsGame => !IsMap && (WorkshopItem?.Tags.Contains( "game", StringComparer.OrdinalIgnoreCase ) ?? (Local?.TypeName == "game"));
    bool IsMap => WorkshopItem?.Tags.Contains( "map", StringComparer.OrdinalIgnoreCase ) ?? (Local?.TypeName == "map");

    bool ModeMismatch => IsGame && Modes is { IsUnknown: false } modes && modes.FitFor( MenuProject.PlayerModes.PartySize ).Fit == MenuProject.PlayerModes.FitKind.Poor;

    /// <summary>
    /// Nothing for a singleplayer game, which its title says all of.
    /// </summary>
    string ModeDetail
    {
        get
        {
            if ( Modes is not { Multiplayer: true } modes ) return null;

            var max = modes.MaxPlayers > 0 ? modes.MaxPlayers : Local?.Info.MaxPlayers ?? WorkshopItem?.GetMeta( "MaxPlayers", 0 ) ?? 0;
            var min = modes.RecommendedMin;
            var best = modes.RecommendedMax;

            // Made for fewer than a game holds - both, as they say different things
            if ( best > 0 && max > best ) return $"Best with {modes.PlayersText}  ·  Up to {max} in a game";

            // What it's made for is all a game holds - once. Its fewest only when that's more than one.
            if ( min > 1 ) return modes.PlayersText;
            if ( max > 1 ) return $"Up to {max} players";

            return modes.PlayersText;
        }
    }

    bool Subscribed => MenuUtility.IsSubscribed( WorkshopId );

    bool Downloaded => load?.Local is not null || MenuUtility.IsInstalled( WorkshopId );

    bool HasAchievements;

    bool Favourited => PlatformMenu.IsFavourite( WorkshopId );

    void ToggleSubscribed()
    {
        if ( Subscribed ) MenuUtility.Unsubscribe( WorkshopId );
        else MenuUtility.Subscribe( WorkshopId );
    }

    bool IsCurrent => IsGame && ((WorkshopId != 0 && WorkshopId == PlatformMenu.CurrentId) || PlatformMenu.IsCurrent( load?.Local ));

    void Open()
    {
        var show = Show is "changes" or "achievements" ? Show : null;
        Show = null;

        if ( string.IsNullOrEmpty( Ident ) ) return;

        // This game's already - just to the page asked for
        if ( Ident == loadedIdent )
        {
            if ( show is not null ) ShowPage( show );
            return;
        }

        if ( previewIdent is not null ) Discovery.PreviewClosed( "page", previewIdent );

        loadedIdent = Ident;
        requestedPage = show;
        LatestChange = null;
        HasAchievements = false;
        StatsPackage = null;
        previewIdent = null;
        summary = null;
        load = null;

        if ( Body.IsValid() ) Body.ScrollOffset = Vector2.Zero;

        _ = Load( Uri.UnescapeDataString( Ident ) );
    }

    async Task Load( string ident )
    {
        // A local project can open its page directly from Your Games.
        var start = Kind == "map" ? null : PlatformRoot.Instance?.ShownPackage;
        var current = load = new GamePageLoad( ident, start?.FullIdent == ident ? start : null, map: Kind == "map" );

        await current.Run();
        if ( !IsValid || current != load ) return;

        if ( Kind != "map" && !IsMap )
        {
            previewIdent = WorkshopItem?.KeyValues.GetValueOrDefault( "package" ) ?? current.Local?.FullIdent;
            Discovery.PreviewOpened( "page", previewIdent );
        }
        summary = WorkshopItem is null ? Local?.Summary : SummaryOf( WorkshopItem.Description );
        StateHasChanged();

        if ( WorkshopItem is null ) return;
        if ( IsGame && !string.IsNullOrEmpty( previewIdent ) ) _ = LoadStats( current, previewIdent );

        var notes = await PlatformMenu.FetchChangeNotesAsync( WorkshopId );
        if ( !IsValid || current != load ) return;

        LatestChange = notes?.Notes?.Count > 0 ? notes.Notes[0] : null;
        StateHasChanged();
    }

    static string SummaryOf( string description )
    {
        if ( string.IsNullOrWhiteSpace( description ) ) return null;

        var firstLine = description.TrimStart().Split( '\n', 2 )[0];
        var text = System.Text.RegularExpressions.Regex.Replace( firstLine, @"\[/?[\w*]+(?:=[^\]]*)?\]", "" ).Trim();
        return text.Length > 200 ? text[..200].TrimEnd() + "…" : text;
    }

    async Task LoadStats( GamePageLoad current, string ident )
    {
        var package = await Package.FetchAsync( ident, false );
        if ( !IsValid || current != load || package is null || package.WorkshopId != WorkshopId ) return;

        StatsPackage = package;
        StateHasChanged();

        var achievements = await package.GetAchievements();
        if ( !IsValid || current != load ) return;

        HasAchievements = achievements?.All.Any() ?? false;
        StateHasChanged();
    }

    void Back()
    {
        if ( BackPage() ) return;
        PlatformRoot.Instance?.Escape();
    }

    void Switch()
    {
        // By its Workshop item when it has one - switched to without waiting on its package
        if ( load?.Local is { } project ) PlatformRoot.Instance?.Picked( project );
        else if ( WorkshopItem is not null ) PlatformRoot.Instance?.Picked( WorkshopItem );
    }

    readonly ScrollFade bodyFade = new();

    protected override void TickShown()
    {
        bodyFade.Apply( Body );
        FoldTags();
    }

    public override void OnDeleted()
    {
        base.OnDeleted();
        if ( previewIdent is not null ) Discovery.PreviewClosed( "page", previewIdent );
    }

    protected override int ShownHash() => HashCode.Combine( StatsPackage, Local, WorkshopItem, PageLoading, WorkshopId, IsCurrent, HashCode.Combine( PlatformMenu.CanSwitch, Subscribed, Favourited, Page, LatestChange, Downloaded, HasAchievements, HashCode.Combine( tagsOpen, measuringTags, tagsShown ) ) );
}
