@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<root class="@StatusClass">mic</root>

@code{
    public string StatusClass
    {
        get
        {
            switch ( Microphone.Indicator )
            {
                case Microphone.IndicatorState.Capturing: return "active recording";
                case Microphone.IndicatorState.Open: return "active";
                default: return "inactive";
            }
        }
    }

    protected override int BuildHash() => System.HashCode.Combine( Microphone.Indicator );

}
