@using System;
@using System.Text.RegularExpressions;
@using Sandbox;
@using Sandbox.UI;
@using MenuProject;
@inherits Panel

@*
    Loading a game - its art full screen, what it is up in the corner, what's new in it bottom left,
    and how the load's going bottom right. The bar only comes in once there's a download with
    progress to report; the rest of the time it's just what's happening and a way out.
*@
<root>

    @if ( Background is { } background )
    {
        <div class="background" style="background-image: url( @background );"></div>
    }

    <div class="scrim"></div>

    @* What it is - top left, straight on the art *@
    @if ( Package is { } package )
    {
        <div class="corner">
            <div class="game">
                <div class="game-icon" style="background-image: url( @package.Thumb );"></div>
                <div class="game-text">
                    @* The name, and how many of its achievements you've got on the end of it *@
                    <div class="game-title-row">
                        <label class="game-title">@package.Title</label>
                        <LoadingAchievements Package=@package />
                    </div>
                    @if ( !string.IsNullOrWhiteSpace( package.Org?.Title ) )
                    {
                        <label class="game-org">@package.Org.Title</label>
                    }
                </div>
            </div>
        </div>
    }

    @* What's new in it bottom left, how the load's going bottom right *@
    <div class="footer">
        @* The latest post's headline and its summary *@
        @if ( Package?.LatestNewsPost is { } news && !string.IsNullOrWhiteSpace( news.Title ) )
        {
            <div class="news">
                <div class="news-eyebrow">
                    <div class="eyebrow"><icon>campaign</icon><label>Latest update</label></div>
                    <div class="ago"><icon>schedule</icon><label>@Ago( news.Created )</label></div>
                </div>
                <label class="news-title">@news.Title</label>
                @if ( !string.IsNullOrWhiteSpace( news.Summary ) )
                {
                    <label class="news-summary">@news.Summary</label>
                }
            </div>
        }
        <div class="grow"></div>

        <div class="progress card @(Completing ? "complete" : "") @(Compact ? "compact" : "")">
            @* Finished - a quick green wipe across the whole card, the bar filling it, behind everything *@
            @if ( Completing )
            {
                <div class="wipe"></div>
            }

            <div class="progress-head">
                @* What's happening, and under it in smaller type whatever the loader's saying. The
                   title's centred on its own, and moves up for the small print at most once a step -
                   see HeadDetail *@
                @{ var detail = HeadDetail; }
                <div class="head-text">
                    <label class="status-text">@StatusText</label>
                    @if ( detail is not null )
                    {
                        <label class="detail">@detail</label>
                    }
                </div>
                @if ( Completing )
                {
                    @* Pops in where the percentage was *@
                    <div class="done-badge"><icon>check</icon><label>Done</label></div>
                }
                else if ( Progress is { } head )
                {
                    <label class="percent">@($"{head.Fraction * 100:0}%")</label>
                }
            </div>

            @* Once there's been a download it stays put, showing the last one, and folds away in place
               when there's nothing to show - removed, it'd be moved below everything to fade out *@
            @if ( ShownProgress is { } bar )
            {
                var collapsed = Progress is null ? "collapsed" : "";

                @* A shine sweeping along it and a pulse through it, so it always looks hard at work *@
                <div class="track @collapsed">
                    <div class="fill" style="width: @(Percent( bar ))%;">
                        <div class="pulse"></div>
                        <div class="shine"></div>
                    </div>
                </div>

                @* Under the bar: how much is down riding along with the end of the fill, lit like it,
                   and the total sat at the far end - where the fill's headed *@
                @if ( bar.TotalSize > 0 )
                {
                    <div class="marker-row @collapsed">
                        @* How fast, at the start of the row - the total's at the other end *@
                        @if ( bar.Mbps > 0 )
                        {
                            <div class="stat speed"><icon>speed</icon><label class="num">@($"{bar.Mbps:0}")</label><label class="unit">Mbps</label></div>
                        }
                        <div class="stat done" style="left: @MarkerLeft( bar )%;">
                            <icon>download</icon>
                            <label>@SizeIn( bar.TotalSize * Math.Clamp( bar.Fraction, 0, 1 ), bar.TotalSize )</label>
                        </div>
                        <div class="stat total">
                            <label>@Size( bar.TotalSize )</label>
                        </div>
                    </div>
                }
            }

            <div class="progress-foot">
                <div class="grow"></div>
                <div class="cancel" onclick=@LoadingView.Cancel><icon>close</icon><label>Cancel</label></div>
            </div>
        </div>
    </div>

</root>

@code
{
    static Package Package => LoadingView.Package;

    /// <summary>
    /// A download under way - null the rest of the time. A finished one doesn't count: the engine
    /// keeps the last progress about until the whole load's done, and "1.1 GB of 1.1 GB" sat under
    /// "Loading X" is noise. Finishing gets its moment separately - see <see cref="Completing"/>.
    /// </summary>
    static LoadingProgress? LiveProgress => LoadingView.Progress is { Fraction: > 0 and < 1 } p ? p : null;

    /// <summary>
    /// The download to show - the live one, or the one that just finished, full, while it has its
    /// moment.
    /// </summary>
    LoadingProgress? Progress
    {
        get
        {
            if ( !Completing || _lastDownload is not { } last ) return LiveProgress;

            last.Fraction = 1;
            return last;
        }
    }

    /// <summary>
    /// The download the bar's showing - the one under way or just finished, or the last one while
    /// the bar folds itself away. Null until there's been one on this loading screen.
    /// </summary>
    LoadingProgress? ShownProgress => Progress ?? _lastShown;

    LoadingProgress? _lastShown;

    /// <summary>
    /// No download - the card's one line, the title with cancel beside it. Only a download opens it
    /// up; whether there's small print under the title doesn't, or it'd be forever opening and
    /// closing as the loader's messages come and go.
    /// </summary>
    bool Compact => Progress is null;

    /// <summary>
    /// Small print under the title - not while downloading, when it's all under the bar. The loader
    /// flicks it on and off many times a step (a file name, nothing, the next file name), so once
    /// there's been some it sticks, still saying the last thing, until the title changes - the title
    /// moves up for it at most once a step, rather than bouncing every time it comes and goes.
    /// </summary>
    string HeadDetail
    {
        get
        {
            if ( Progress is not null )
            {
                _detailFor = null;
                _stickyDetail = null;
                return null;
            }

            var status = StatusText;
            if ( status != _detailFor )
            {
                _detailFor = status;
                _stickyDetail = null;
            }

            if ( !string.IsNullOrWhiteSpace( DetailText ) )
                _stickyDetail = DetailText;

            return _stickyDetail;
        }
    }

    string _detailFor;
    string _stickyDetail;
    //
    // Finishing - the bar fills, flashes and says it's done for a moment, then folds away into
    // whatever comes next, rather than just vanishing the instant the numbers stop
    //

    /// <summary>
    /// How long a finished download stays up, celebrated, before it folds away.
    /// </summary>
    const float CompleteHold = 0.6f;

    LoadingProgress? _lastDownload;
    RealTimeSince _sinceComplete;

    /// <summary>
    /// A download's just finished, and it's having its moment.
    /// </summary>
    bool Completing { get; set; }

    void TickCompletion()
    {
        if ( !LoadingView.IsVisible )
        {
            Completing = false;
            _lastDownload = null;
            _lastShown = null;
            return;
        }

        // Whatever the bar last showed - held on to so it can fold away still showing it
        if ( Progress is { } shown )
            _lastShown = shown;

        if ( LiveProgress is { } live )
        {
            _lastDownload = live;
            Completing = false;
            return;
        }

        // It's gone - finished, if it got near enough the end (or the engine said so); if it dropped
        // out partway it was cancelled or fell over, and that's nothing to celebrate
        if ( _lastDownload is { } last && !Completing )
        {
            var finished = last.Fraction >= 0.9 || LoadingView.Progress is { Fraction: >= 1 };
            if ( !finished )
            {
                _lastDownload = null;
                return;
            }

            Completing = true;
            _sinceComplete = 0;
        }

        if ( Completing && _sinceComplete > CompleteHold )
        {
            Completing = false;
            _lastDownload = null;
        }
    }

    /// <summary>
    /// The game's own loading art, or failing that a shot of it.
    /// </summary>
    static string Background => !string.IsNullOrWhiteSpace( LoadingView.Media )
        ? LoadingView.Media
        : Package is { } package ? PackageArt.Background( package ) : null;

    /// <summary>
    /// What's happening - "Downloading Sandbox", "Loading Resources". Downloads name what they're
    /// fetching in quotes ("Downloading 'Sandbox'"), which reads better without them.
    /// </summary>
    string StatusText
    {
        get
        {
            // Finished - "Downloading 'Block Party'" becomes "Downloaded Block Party"
            var title = Completing && _lastDownload is { } last && !string.IsNullOrWhiteSpace( last.Title )
                ? last.Title.Replace( "Downloading", "Downloaded" )
                : !string.IsNullOrWhiteSpace( LoadingView.Title )
                    ? LoadingView.Title
                    : LoadingView.FirstTask ?? "Loading";

            return Regex.Replace( title, "'([^']+)'", "$1" );
        }
    }

    /// <summary>
    /// The small print - how much of how much at what speed while downloading, otherwise whatever
    /// the loader's saying about the file or task it's on.
    /// </summary>
    string DetailText
    {
        get
        {
            if ( Progress is { } p )
            {
                var parts = new List<string>();
                if ( p.TotalSize > 0 ) parts.Add( $"{Size( p.TotalSize * p.Fraction )} / {Size( p.TotalSize )}" );
                if ( p.Mbps > 0 ) parts.Add( $"{p.Mbps:0} Mbps" );
                return string.Join( " · ", parts );
            }

            if ( !string.IsNullOrWhiteSpace( LoadingView.Title ) )
                return LoadingView.Subtitle;

            return LoadingView.TaskCount > 1 ? $"and {LoadingView.TaskCount - 1} other tasks" : null;
        }
    }

    /// <summary>
    /// Where the downloaded amount's middle sits along the bar, as a percentage - on the end of the
    /// fill, but held clear of the speed at the start of the row and stopping just short of the total
    /// at the far end. In a 520 card the track's 476 wide: the speed ("104 Mbps" and its icon, ~70)
    /// plus a gap takes the first ~17%, the downloaded text (~62) is ~6.5% either side of its middle,
    /// and the total ("1.1 GB", right aligned) plus a gap takes the last ~11%. A total in megabytes
    /// ("570 MB") is wider, so it stops further short of it.
    /// </summary>
    const float MarkerMin = 24f;
    const float MarkerMaxGB = 84.5f;
    const float MarkerMaxMB = 80.5f;

    static string MarkerLeft( LoadingProgress p )
    {
        var max = p.TotalSize >= 1_000_000_000 ? MarkerMaxGB : MarkerMaxMB;
        var pct = Math.Clamp( p.Fraction * 100, MarkerMin, max );
        return pct.ToString( "0.#", System.Globalization.CultureInfo.InvariantCulture );
    }

    static string Percent( LoadingProgress p ) => (Math.Clamp( p.Fraction, 0, 1 ) * 100).ToString( "0.#", System.Globalization.CultureInfo.InvariantCulture );

    /// <summary>
    /// "420 MB", "1.2 GB" - as short as it goes.
    /// </summary>
    static string Size( double bytes )
    {
        if ( bytes >= 1_000_000_000 ) return $"{bytes / 1_000_000_000:0.#} GB";
        if ( bytes >= 1_000_000 ) return $"{bytes / 1_000_000:0} MB";
        return $"{bytes / 1_000:0} KB";
    }

    /// <summary>
    /// How much of <paramref name="total"/> is down, in the same unit the total's shown in - so a
    /// 1.1 GB download reads "0.51 GB", not "510 MB". Gigabytes get a second decimal, so it's seen
    /// going up rather than sitting on the same tenth for ages.
    /// </summary>
    static string SizeIn( double bytes, double total )
    {
        if ( total >= 1_000_000_000 ) return $"{bytes / 1_000_000_000:0.00} GB";
        if ( total >= 1_000_000 ) return $"{bytes / 1_000_000:0} MB";
        return $"{bytes / 1_000:0} KB";
    }

    static string Ago( DateTimeOffset when )
    {
        var span = DateTimeOffset.UtcNow - when;

        if ( span.TotalHours < 1 ) return "just now";
        if ( span.TotalDays < 1 ) return $"{(int)span.TotalHours}h ago";
        if ( span.TotalDays < 2 ) return "yesterday";
        if ( span.TotalDays < 30 ) return $"{(int)span.TotalDays} days ago";
        if ( span.TotalDays < 365 ) return $"{(int)(span.TotalDays / 30)} months ago";
        return when.ToLocalTime().ToString( "MMM yyyy" );
    }

    int _hash;

    protected override int BuildHash()
    {
        // Put away - it fades out still showing what it was, rather than emptying out under the fade
        // (the art fading on its own, the game and bar gone, the card shrinking) as the load's cleared
        if ( !LoadingView.IsVisible ) return _hash;

        // Settle whether a download's just finished before anything's drawn from it. Worked out after
        // (in Tick), the frame the download ends is drawn with no progress at all - the bar starts
        // folding away - and the next frame, now finished, starts a fresh one under it
        TickCompletion();

        return _hash = HashCode.Combine( StatusText, DetailText, Background, Package?.FullIdent, Progress?.Fraction, LoadingView.TaskCount, HashCode.Combine( Completing, Compact ) );
    }

    public override void Tick()
    {
        SetClass( "visible", LoadingView.IsVisible );
        TickCompletion();
    }

}
