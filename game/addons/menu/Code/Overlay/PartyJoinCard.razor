@using Sandbox;
@using Sandbox.Menu;
@using Sandbox.UI;
@namespace MenuProject
@inherits Panel

<root class="@(Visible ? "visible" : "")">
	<div class="heading"><i>group</i><label>@Title</label></div>
	<div class="game">
		@if ( !string.IsNullOrWhiteSpace( GameThumbnail ) )
		{
			<div class="thumbnail" style="background-image: url( @GameThumbnail );"></div>
		}
		<label>@GameTitle</label>
	</div>
	@if ( Busy && HostProgress is { } host )
	{
		<div class="progress-label"><label>#partyjoincard.host_download</label><label>@($"{host.Percent:0}%")</label></div>
		<div class="progress-track"><div class="progress-fill host" style="width: @(Percent(host))%;"></div></div>
	}
	@if ( Busy && Progress is { } download )
	{
		<div class="progress-label"><label>#partyjoincard.your_download</label><label>@($"{download.Percent:0}%")</label></div>
		<div class="progress-track"><div class="progress-fill" style="width: @(Percent(download))%;"></div></div>
		@if ( download.Mbps > 0 )
		{
			<label class="detail">@($"{download.Mbps:0.0} Mbps · {download.CalculateETA().ToRemainingTimeString()}")</label>
		}
	}
	<label class="detail">@Detail</label>
	<div class="actions">
		@if ( Stage is PartyRoom.JoinStage.Failed or PartyRoom.JoinStage.Cancelled )
		{
			<Button class="retry" onclick=@Retry>#partyjoincard.retry</Button>
		}
		@if ( Busy )
		{
			<Button onclick=@Cancel>#partyjoincard.cancel_join</Button>
		}
		else
		{
			<Button onclick=@Dismiss>#partyjoincard.dismiss</Button>
		}
		<Button onclick=@Leave>#partyjoincard.leave</Button>
	</div>
</root>

@code
{
	[Parameter] public PartyRoom.JoinStage Stage { get; set; }
	[Parameter] public LoadingProgress? Progress { get; set; }
	[Parameter] public LoadingProgress? HostProgress { get; set; }
	[Parameter] public string GameTitle { get; set; }
	[Parameter] public string GameThumbnail { get; set; }
	[Parameter] public string Error { get; set; }
	[Parameter] public bool IsFollower { get; set; }
	[Parameter] public int SessionId { get; set; }
	[Parameter] public Action RetryRequested { get; set; }
	[Parameter] public Action CancelRequested { get; set; }
	[Parameter] public Action LeaveRequested { get; set; }
	bool Busy => Stage is PartyRoom.JoinStage.Downloading or PartyRoom.JoinStage.WaitingForHost or PartyRoom.JoinStage.Connecting;
	bool Visible => IsFollower && Stage is not (PartyRoom.JoinStage.None or PartyRoom.JoinStage.Connected) && Dismissed != Identity;
	int Identity => HashCode.Combine( SessionId, Stage );
	int? Dismissed;
	int LastIdentity;
	string Title => Stage switch
	{
		PartyRoom.JoinStage.Downloading => Language.GetPhrase( "partyjoincard.title_downloading" ),
		PartyRoom.JoinStage.WaitingForHost => Language.GetPhrase( "partyjoincard.title_waiting" ),
		PartyRoom.JoinStage.Connecting => Language.GetPhrase( "partyjoincard.title_connecting" ),
		PartyRoom.JoinStage.Failed => Language.GetPhrase( "partyjoincard.title_failed" ),
		PartyRoom.JoinStage.Cancelled => Language.GetPhrase( "partyjoincard.title_cancelled" ),
		PartyRoom.JoinStage.Unavailable => Language.GetPhrase( "partyjoincard.title_unavailable" ),
		_ => Language.GetPhrase( "partyjoincard.title" )
	};
	string Detail => Stage switch
	{
		PartyRoom.JoinStage.Downloading => Language.GetPhrase( Progress is null ? "partyjoincard.detail_fetching" : "partyjoincard.detail_downloading" ),
		PartyRoom.JoinStage.WaitingForHost => Language.GetPhrase( "partyjoincard.detail_waiting" ),
		PartyRoom.JoinStage.Connecting => Language.GetPhrase( "partyjoincard.detail_connecting" ),
		PartyRoom.JoinStage.Failed => Error,
		PartyRoom.JoinStage.Cancelled => Language.GetPhrase( "partyjoincard.detail_cancelled" ),
		PartyRoom.JoinStage.Unavailable => Language.GetPhrase( "partyjoincard.detail_unavailable" ),
		_ => ""
	};
	static string Percent( LoadingProgress progress ) => (Math.Clamp( progress.Fraction, 0, 1 ) * 100).ToString( "0.0", System.Globalization.CultureInfo.InvariantCulture );
	void Retry() { Dismissed = null; RetryRequested?.Invoke(); }
	void Cancel() => CancelRequested?.Invoke();
	void Dismiss() { Dismissed = Identity; }
	void Leave() => LeaveRequested?.Invoke();
	protected override int BuildHash() => HashCode.Combine( Identity, Dismissed, GameTitle, Progress, HostProgress, Detail, IsFollower, GameThumbnail );
	public override void Tick()
	{
		if ( LastIdentity != Identity ) Dismissed = null;
		LastIdentity = Identity;
	}
}
