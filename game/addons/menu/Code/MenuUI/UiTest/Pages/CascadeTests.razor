@namespace MenuProject.UiTest
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Title( "Cascade" )]
@attribute [Description( "Which rule wins, what inherits, and which selectors match" )]
@attribute [Icon( "layers" )]
@attribute [Order( 50 )]

@*
    Every case here is self marking: green is the right answer, red is the wrong rule winning,
    grey is "shouldn't have matched". The rules live in this page's stylesheet - the caption is
    the pair being tested, not something applied to the sample.
*@

<root>

    <p>
        Green is correct. Red means the wrong rule won. Grey means a selector matched something it
        shouldn't have, or didn't match something it should.
    </p>

    <h2>Specificity</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule=".one { red }  .one.two { green }" Note="Two classes beat one.">
            <ChildContent><div class="probe one two"></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule="#idwin { green }  .a.b.c { red }" Note="An id beats any number of classes.">
            <ChildContent><div id="idwin" class="probe a b c"></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".dupe { red }  .dupe { green }" Note="Same specificity, so the later rule wins.">
            <ChildContent><div class="probe dupe"></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".inline { red }  style=&quot;green&quot;" Note="An inline style beats a stylesheet rule.">
            <ChildContent><div class="probe inline" style="background-color: #3fc76a"></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".ctx .deep { green }  .deep { red }" Note="A descendant selector is more specific than the class on its own.">
            <ChildContent><div class="ctx"><div class="probe deep"></div></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule="div.elem { green }  .elem { red }" Note="An element plus a class beats the class alone.">
            <ChildContent><div class="probe elem"></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Combinators</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule=".par &gt; .kid { green }" Note="Left is a direct child and goes green. Right is a grandchild and must stay grey.">
            <ChildContent>
                <div class="row">
                    <div class="par"><div class="probe small kid"></div></div>
                    <div class="par"><div class="wrap"><div class="probe small kid"></div></div></div>
                </div>
            </ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".par-flat &gt; .kid-flat { green }  (rule not nested)" Note="The same child combinator written outside the page's block. If this is green and the one before it isn't, nesting is what breaks it.">
            <ChildContent>
                <div class="row">
                    <div class="par-flat"><div class="probe small kid-flat"></div></div>
                    <div class="par-flat"><div class="wrap"><div class="probe small kid-flat"></div></div></div>
                </div>
            </ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".sib + .sib { green }" Note="Adjacent sibling: only the second one.">
            <ChildContent><div class="row"><div class="probe small sib"></div><div class="probe small sib"></div><div class="probe small"></div></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".gen ~ .after { green }" Note="General sibling: every later sibling, not just the next.">
            <ChildContent><div class="row"><div class="probe small gen"></div><div class="probe small after"></div><div class="probe small after"></div></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".anc .desc { green }" Note="Descendant at any depth.">
            <ChildContent><div class="anc"><div class="wrap"><div class="probe deep-desc desc"></div></div></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Pseudo-classes</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule=".nth:nth-child(2) { green }" Note="Middle one only.">
            <ChildContent><div class="row"><div class="probe small nth"></div><div class="probe small nth"></div><div class="probe small nth"></div></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".fc:first-child { green }  .fc:last-child { green }" Note="Ends green, middle grey.">
            <ChildContent><div class="row"><div class="probe small fc"></div><div class="probe small fc"></div><div class="probe small fc"></div></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".n:not(.skip) { green }" Note="The one carrying .skip must stay grey.">
            <ChildContent><div class="row"><div class="probe small n"></div><div class="probe small n skip"></div></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".host:has(.needle) { green }" Note="Left holds a .needle, right doesn't.">
            <ChildContent>
                <div class="row">
                    <div class="probe small host"><div class="needle"></div></div>
                    <div class="probe small host"></div>
                </div>
            </ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".star * { green }" Note="Universal selector reaches both children.">
            <ChildContent><div class="star row"><div class="probe small"></div><div class="probe small"></div></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Inheritance</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule=".inh { color: green; background-color: #23262e }" Note="Colour inherits to the label, background doesn't - the label must not be a green block.">
            <ChildContent><div class="inh"><label>Inherited</label></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".inh-size { font-size: 22px }" Note="Font size inherits, so the label is 22px without being told.">
            <ChildContent><div class="inh-size"><label>Inherited</label></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".inh-over { font-size: 22px }  label { font-size: 11px }" Note="The label's own rule beats what it inherits.">
            <ChildContent><div class="inh-over"><label class="own-size">Own size</label></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Bad input</h2>

    <p>
        The web drops a declaration it can't parse and keeps the rest of the rule. Anything else
        here means one typo can take out a whole panel.
    </p>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule=".bad-prop { not-a-property: 5px; green }" Note="The unknown declaration is dropped, the good one still applies.">
            <ChildContent><div class="probe bad-prop"></div></ChildContent>
        </UiTestCase>

        <UiTestCase Setup="@Frame" Rule=".bad-value { background-color: nonsense; green }" Note="Same again with a value that doesn't parse.">
            <ChildContent><div class="probe bad-value"></div></ChildContent>
        </UiTestCase>
    </div>

</root>

@code
{
    const string Frame = "width: 120px; height: 100px";
}
