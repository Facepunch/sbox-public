@namespace MenuProject.UiTest
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Title( "Transitions" )]
@attribute [Description( "Easing, timing, interruption, and what can be interpolated" )]
@attribute [Icon( "animation" )]
@attribute [Order( 55 )]

@*
    A transition needs something to change, so the page toggles a class on everything on a timer
    rather than waiting for a mouse. Watch it run instead of reading a still.
*@

<root>

    <p>
        Everything on this page toggles on a timer. Compare a pair by watching them move together:
        an easing that's wrong is obvious next to one that isn't, and a property that can't
        interpolate jumps instead of sliding.
    </p>

    <h2>Easing</h2>

    <div class="cases">
        <UiTestCase Setup="@Track" Rule="transition: left 1s linear" Note="Constant speed - the reference for the rest.">
            <ChildContent><div class="dot linear"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s ease" Note="Web default: slow start, fast middle, slow end.">
            <ChildContent><div class="dot ease"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s ease-in" Note="Starts slowly, arrives fast.">
            <ChildContent><div class="dot ease-in"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s ease-out" Note="Leaves fast, settles slowly.">
            <ChildContent><div class="dot ease-out"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s ease-in-out" Note="Symmetric.">
            <ChildContent><div class="dot ease-in-out"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s cubic-bezier( 0.5, -0.5, 0.5, 1.5 )" Note="Overshoots both ends - values outside 0..1 must not be clamped away.">
            <ChildContent><div class="dot bezier"></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Timing</h2>

    <div class="cases">
        <UiTestCase Setup="@Track" Rule="transition: left 0.25s linear" Note="Short.">
            <ChildContent><div class="dot fast"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 2s linear" Note="Longer than the toggle, so it never arrives before being sent back - it should reverse from where it is, not jump.">
            <ChildContent><div class="dot slow"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s linear 0.5s" Note="Half a second of nothing, then it moves.">
            <ChildContent><div class="dot delayed"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: left 1s linear, background-color 0.25s linear" Note="Two properties, two durations - the colour is done long before the move.">
            <ChildContent><div class="dot two-props"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Track" Rule="transition: none" Note="Snaps. Anything smooth here is a transition leaking in from elsewhere.">
            <ChildContent><div class="dot none"></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>What interpolates</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule="transition: background-color 1s linear" Note="Colour, and whether it goes through a muddy midpoint.">
            <ChildContent><div class="swatch colour"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: opacity 1s linear" Note="Opacity.">
            <ChildContent><div class="swatch fade"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: transform 1s linear" Note="Transform: scale and rotate together.">
            <ChildContent><div class="swatch xform"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: border-radius 1s linear" Note="Square to circle.">
            <ChildContent><div class="swatch radius"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: all 1s linear  ( 0 -> border-radius: 20px )" Note="From no radius at all. Both axes must animate together, not snap one and slide the other.">
            <ChildContent><div class="swatch radius-from-none"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: filter 1s linear" Note="Filter: blur in and out.">
            <ChildContent><div class="swatch filtered"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: box-shadow 1s linear" Note="Shadow blur and spread.">
            <ChildContent><div class="swatch shadowed"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: width 1s linear  ( 40% -> 120px )" Note="Mixed units. The web can't interpolate these either - it should snap once, not flicker.">
            <ChildContent><div class="swatch mixed-units"></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="transition: background-image 1s linear" Note="Gradients don't interpolate on the web - a hard swap is correct.">
            <ChildContent><div class="swatch grad"></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Intro and outro</h2>

    <p>
        A panel that gets created and destroyed on the same timer, so :intro and :outro both run.
        The outro has to hold the panel alive long enough to finish.
    </p>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule=":intro { opacity: 0 }  :outro { opacity: 0 }" Note="Fades in, holds, fades out.">
            <ChildContent>
                @if ( on )
                {
                    <div class="mounted"></div>
                }
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule=":intro { transform: scale( 0.5 ) }  :outro { transform: scale( 1.4 ) }" Note="Scales in and out.">
            <ChildContent>
                @if ( on )
                {
                    <div class="mounted scaled"></div>
                }
            </ChildContent>
        </UiTestCase>
    </div>

</root>

@code
{
    const string Track = "width: 140px; height: 60px";
    const string Frame = "width: 120px; height: 100px";

    /// <summary>How long each half of the cycle lasts.</summary>
    public const float ToggleSeconds = 1.6f;

    RealTimeUntil timeUntilToggle = ToggleSeconds;
    bool on;

    // The class goes on the page, not on each sample: a sample lives in a UiTestCase's child
    // content, and that only rebuilds when the case's own hash changes - which it never does.
    // Through the cascade it needs no rebuild at all.
    public override void Tick()
    {
        base.Tick();

        if ( !IsVisible ) return;

        if ( timeUntilToggle <= 0 )
        {
            timeUntilToggle = ToggleSeconds;
            on = !on;

            SetClass( "on", on );
            StateHasChanged();
        }
    }

    protected override int BuildHash() => System.HashCode.Combine( on );
}
