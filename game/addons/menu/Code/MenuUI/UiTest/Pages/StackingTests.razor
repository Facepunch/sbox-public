@namespace MenuProject.UiTest
@inherits UiTestPage

@using Sandbox;
@using Sandbox.UI;

@attribute [Title( "Stacking" )]
@attribute [Description( "Positioning, z-index and what draws on top" )]
@attribute [Icon( "flip_to_front" )]
@attribute [Order( 70 )]

@*
    Paint order is ours, not Yoga's, so it's worth pinning. Each case stacks three squares -
    red, green, blue - and says which should end up on top.
*@

<root>

    <h2>What absolute positions against</h2>

    <p>
        Like the web: the nearest positioned ancestor, not the parent. This catches people out
        constantly, including me, twice, while building this section.
    </p>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule="parent { position: relative }  child { position: absolute; left: 0 }" Note="Anchored to the inner box, so it sits in its corner.">
            <ChildContent>
                <div class="outer"><div class="inner positioned"><div class="dot red at-origin"></div></div></div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="parent { }  child { position: absolute; left: 0 }" Note="The inner box isn't positioned, so the dot escapes to the outer one's corner.">
            <ChildContent>
                <div class="outer positioned"><div class="inner"><div class="dot red at-origin"></div></div></div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="position: absolute; right: 0; bottom: 0" Note="Anchored to the far corner.">
            <ChildContent><div class="outer positioned"><div class="dot green at-far"></div></div></ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="position: absolute; left: 0; right: 0; top: 0; bottom: 0" Note="All four sides pin it to fill the box.">
            <ChildContent><div class="outer positioned"><div class="dot blue stretched"></div></div></ChildContent>
        </UiTestCase>
    </div>

    <h2>Order without z-index</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule="three siblings, no z-index" Note="Document order: blue is last, so blue is on top.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="dot red p1"></div><div class="dot green p2"></div><div class="dot blue p3"></div>
                </div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="a child overlapping its parent's border" Note="Children paint over their parent's background and border.">
            <ChildContent>
                <div class="outer positioned bordered"><div class="dot red over-edge"></div></div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="outline vs a child" Note="On the web an outline is painted above the element's own background but below its children.">
            <ChildContent>
                <div class="outer positioned outlined"><div class="dot green over-edge"></div></div>
            </ChildContent>
        </UiTestCase>
    </div>

    <h2>z-index</h2>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule="red { z-index: 3 }  green { 2 }  blue { 1 }" Note="Reversed against document order, so red is on top.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="dot red p1 z3"></div><div class="dot green p2 z2"></div><div class="dot blue p3 z1"></div>
                </div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="green { z-index: -1 }" Note="A negative index puts it behind its siblings, and on the web behind the parent's background too.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="dot red p1"></div><div class="dot green p2 zneg"></div><div class="dot blue p3"></div>
                </div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="equal z-index" Note="Ties fall back to document order, so blue wins.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="dot red p1 z2"></div><div class="dot green p2 z2"></div><div class="dot blue p3 z2"></div>
                </div>
            </ChildContent>
        </UiTestCase>
    </div>

    <h2>Stacking contexts</h2>

    <p>
        On the web, opacity below 1, a transform and a filter each start a new stacking context -
        so a child's z-index can no longer lift it above things outside that subtree. Whether we
        do the same is the question.
    </p>

    <div class="cases">
        <UiTestCase Setup="@Frame" Rule="group { opacity: 0.99 }  child { z-index: 99 }" Note="The child must not escape the group. If it lands above the blue square, we don't make a context.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="group faded"><div class="dot red p1 z99"></div></div>
                    <div class="dot blue p3"></div>
                </div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="group { transform: scale( 1 ) }  child { z-index: 99 }" Note="Same again with a transform.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="group scaled"><div class="dot red p1 z99"></div></div>
                    <div class="dot blue p3"></div>
                </div>
            </ChildContent>
        </UiTestCase>
        <UiTestCase Setup="@Frame" Rule="group { filter: blur( 0 ) }  child { z-index: 99 }" Note="And with a filter.">
            <ChildContent>
                <div class="outer positioned">
                    <div class="group filtered"><div class="dot red p1 z99"></div></div>
                    <div class="dot blue p3"></div>
                </div>
            </ChildContent>
        </UiTestCase>
    </div>

</root>

@code
{
    const string Frame = "width: 120px; height: 110px";
}
