@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Services;
@inherits Panel

@if ( Target is null )
    return;

<div class="art clicky" style="@ArtStyle" @onclick="@OpenDetails" @onrightclick="@OpenMenu">

    <div class="art-scrim" />

    @if ( PlayingNowText is not null )
    {
        <div class="live">
            <div class="dot" />
            <label>@PlayingNowText</label>
        </div>
    }

</div>

<div class="meta-row clicky" @onclick="@OpenDetails" @onrightclick="@OpenMenu">

    <div class="titles">
        <label class="section-label">Continue playing</label>
        <label class="game-title">@Target.Title</label>
        <label class="meta">@MetaLine</label>
    </div>

    <div class="grow" />

    <icon class="chevron">chevron_right</icon>

</div>

@code
{
    [Parameter] public Sandbox.Services.Feed[] Activity { get; set; }

    /// <summary>Their most recently played game.</summary>
    Package Target { get; set; }

    AchievementOverview Achievements { get; set; }

    string KeyArt => FrontPage.KeyArt( Target );

    string ArtStyle => KeyArt is null ? null : $"background-image: url({KeyArt})";

    /// <summary>"6 friends this week · 4d played · 22% complete", minus any part we lack.</summary>
    string MetaLine => string.Join( " · ", new[] { FriendsText, PlaytimeText, CompletionText }.Where( x => x is not null ) );

    string CompletionText
    {
        get
        {
            if ( Achievements is null || Achievements.Total <= 0 ) return null;

            return $"{(int)(Achievements.Unlocked * 100f / Achievements.Total)}% complete";
        }
    }

    string PlaytimeText
    {
        get
        {
            var seconds = Target.Interaction.Seconds;
            if ( seconds < 60 ) return null;

            return $"{TimeSpan.FromSeconds( seconds ).Humanize( true )} played";
        }
    }

    string PlayingNowText
    {
        get
        {
            var now = Target.Usage.UsersNow;

            return now > 0 ? $"{now:N0} playing" : null;
        }
    }

    string FriendsText
    {
        get
        {
            var count = FrontPage.FriendsThisWeek( Activity, Target );
            if ( count <= 0 ) return null;

            return count == 1 ? "1 friend this week" : $"{count} friends this week";
        }
    }

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( !firstTime )
            return;

        _ = Load();
    }

    async Task Load()
    {
        var found = await Package.FindAsync( "type:game sort:used", 1, 0, default );

        Target = found?.Packages?.FirstOrDefault();
        StateHasChanged();

        if ( Target is null )
            return;

        // Not part of the package payload, so match it up from the player's overview list.
        var overviews = await MenuUtility.GetAchievementOverviews( 20 );

        Achievements = overviews?.FirstOrDefault( x =>
            string.Equals( x.Package?.FullIdent, Target.FullIdent, StringComparison.OrdinalIgnoreCase ) );

        StateHasChanged();
    }

    void OpenDetails()
    {
        Target?.OpenModal();
    }

    void OpenMenu()
    {
        if ( Target is null )
            return;

        MenuHelpers.OpenPackageMenu( this, Target );
    }

    protected override int BuildHash() => HashCode.Combine( Target?.FullIdent, Achievements?.Unlocked, Activity?.Length );
}
