@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using Sandbox.Services;
@inherits Panel

<div class="zone-rule" />

<div class="head">
    <label class="section-label">Try these games</label>
    <div class="grow" />
    <label class="browse clicky" @onclick="@BrowseAll">Browse all ›</label>
</div>

@foreach ( var suggestion in Suggestions )
{
    var package = suggestion.Package;

    <div class="game clicky" @onclick="@(() => package.OpenModal())" @onrightclick="@(() => MenuHelpers.OpenPackageMenu( this, package ))">

        <div class="thumb">
            @if ( !string.IsNullOrEmpty( package.Thumb ) )
            {
                <img src="@package.Thumb" />
            }
        </div>

        <div class="game-text">
            <label class="game-title">@package.Title</label>
            <label class="game-sub">@( Reason( suggestion ) )</label>
        </div>

        <icon class="chevron">chevron_right</icon>

    </div>
}

@code
{
    [Parameter] public Sandbox.Services.Feed[] Activity { get; set; }

    class Suggestion
    {
        public Package Package;
        public bool FromFriends;
    }

    List<Suggestion> Suggestions { get; set; } = new();

    const int SuggestionCount = 2;

    /// <summary>
    /// Why this game is here. Evaluated per render, so it upgrades to the named-friend reason
    /// once the activity feed arrives.
    /// </summary>
    string Reason( Suggestion suggestion )
    {
        var friend = FrontPage.LatestFriendIn( Activity, suggestion.Package );
        if ( friend is not null )
            return $"{friend} played this";

        if ( suggestion.FromFriends )
            return "Popular with your friends";

        if ( suggestion.Package.Created > DateTimeOffset.UtcNow.AddDays( -7 ) )
            return "New this week";

        return "Featured by Facepunch";
    }

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( !firstTime )
            return;

        _ = Load();
    }

    async Task Load()
    {
        var picked = new List<Suggestion>();

        var friends = await Package.FindAsync( "type:game sort:friends", SuggestionCount, 0, default );

        foreach ( var package in friends?.Packages ?? Array.Empty<Package>() )
        {
            picked.Add( new Suggestion { Package = package, FromFriends = true } );
        }

        // Nobody you know is playing anything - fall back to the spotlight list.
        if ( picked.Count < SuggestionCount )
        {
            var spotlight = await Package.FindAsync( "type:game in:facepunch.spotlight sort:random", SuggestionCount + 2, 0, default );

            foreach ( var package in spotlight?.Packages ?? Array.Empty<Package>() )
            {
                if ( picked.Count >= SuggestionCount ) break;
                if ( picked.Any( x => x.Package.FullIdent == package.FullIdent ) ) continue;

                picked.Add( new Suggestion { Package = package, FromFriends = false } );
            }
        }

        Suggestions = picked;
        StateHasChanged();
    }

    void BrowseAll()
    {
        this.Navigate( "/games" );
    }

    protected override int BuildHash() => HashCode.Combine( Suggestions.Count, Suggestions.FirstOrDefault()?.Package?.FullIdent, Activity?.Length );
}
