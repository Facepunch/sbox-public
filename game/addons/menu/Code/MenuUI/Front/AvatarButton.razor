@using System;
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<root>

    <div class="info">
        <label class="eyebrow">Welcome back,</label>
        <label class="name">@Sandbox.Utility.Steam.PersonaName</label>
    </div>

    <div class="edit clicky" tooltip="Edit your avatar" @onclick="@OpenAvatarScene">
        <icon>emoji_people</icon>
        <label>Edit</label>
    </div>

    @if ( StatsLoaded )
    {
        <div class="stats">
            <div class="stat">
                <label class="stat-label">Achievements</label>
                <div class="stat-value">
                    <icon class="trophy">emoji_events</icon>
                    <label>@AchievementsUnlocked.ToString( "N0" )</label>
                </div>
            </div>

            <div class="grow" />

            <div class="stat right">
                <label class="stat-label">Points</label>
                <div class="stat-value">
                    <icon class="points">stars</icon>
                    <label>@AchievementScore.ToString( "N0" )</label>
                </div>
            </div>
        </div>
    }

</root>

@code
{
    ScenePanel scenePanel;

    /// <summary>
    /// Their lifetime unlock count, from the player overview.
    /// </summary>
    long AchievementsUnlocked { get; set; }

    /// <summary>
    /// Their lifetime gamercore, which we already have from the login.
    /// </summary>
    int AchievementScore { get; set; }
    bool StatsLoaded { get; set; }

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( !firstTime )
            return;

        // The scss doubles this panel's size then scales it back down by half,
        // so the scene renders at 2x and the downscale anti-aliases it.
        scenePanel = AddChild<ScenePanel>( "render" );
        _ = BuildScene( scenePanel.RenderScene );

        _ = LoadStats();
    }

    async Task LoadStats()
    {
        Sandbox.Services.Players.Overview overview;

        try
        {
            overview = await Sandbox.Services.Players.Overview.Get( Sandbox.Utility.Steam.SteamId );
        }
        catch ( Exception )
        {
            // Offline, or the backend is having a moment - just leave the stats hidden.
            return;
        }

        if ( overview is null )
            return;

        AchievementsUnlocked = overview.Achievements;
        AchievementScore = Sandbox.Services.Players.Profile.Local.Score;
        StatsLoaded = true;

        StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine( StatsLoaded, AchievementsUnlocked, AchievementScore );

    /// <summary>
    /// A tiny portrait scene - camera, sun and the local player's dressed avatar.
    /// The camera looks straight down the model's line so he stands centred in the card.
    /// </summary>
    static async Task BuildScene( Scene scene )
    {
        using ( scene.Push() )
        {
            var cameraObject = new GameObject( true, "Camera" );
            var camera = cameraObject.AddComponent<CameraComponent>();
            camera.BackgroundColor = Color.Transparent;
            camera.FieldOfView = 32;
            camera.ZNear = 1;
            camera.ZFar = 512;

            var sunObject = new GameObject( true, "Sun" );
            sunObject.WorldRotation = Rotation.From( 50, 150, 0 );

            var sun = sunObject.AddComponent<DirectionalLight>();
            sun.LightColor = new Color( 1.0f, 0.96f, 0.9f ) * 1.6f;
            sun.SkyColor = new Color( 0.35f, 0.38f, 0.45f );

            var bodyObject = new GameObject( true, "Body" );
            bodyObject.WorldRotation = Rotation.FromYaw( -25 );

            var clothing = ClothingContainer.CreateFromLocalUser();

            var body = bodyObject.AddComponent<SkinnedModelRenderer>();
            body.Model = Model.Load( clothing.PrefersHuman
                ? "models/citizen_human/citizen_human_male.vmdl"
                : "models/citizen/citizen.vmdl" );

            // The hands-on-hips pose the garage character used.
            body.Set( "special_idle_states", 1 );

            // Properties land after the component wakes, so kick the dresser manually.
            var dresser = bodyObject.AddComponent<Dresser>();
            dresser.Source = Dresser.ClothingSource.LocalUser;
            dresser.BodyTarget = body;
            await dresser.Apply();

            var h = dresser.ManualHeight.Remap( 0, 1, 0.8f, 1.2f, true );
            cameraObject.WorldPosition = new Vector3(133, 0, 48 * h );
            cameraObject.WorldRotation = Rotation.FromYaw(180);
        }
    }

    public override void Tick()
    {
        base.Tick();
        UpdateSpin();
        UpdateEyes();
    }

    /// <summary>
    /// Degrees of yaw per pixel of drag.
    /// </summary>
    const float DragDegreesPerPixel = 0.6f;

    /// <summary>
    /// How quickly a flick dies off once released. Higher stops sooner.
    /// </summary>
    const float SpinFriction = 3.5f;

    float _yaw = -25f;
    float _yawVelocity;
    float _lastDragX;
    bool _dragging;

    /// <summary>
    /// Degrees of spin added per wheel notch.
    /// </summary>
    const float WheelDegreesPerNotch = 140f;

    public override void OnMouseWheel( Vector2 value )
    {
        // Each notch gives him a shove, and a run of them stacks into a proper spin.
        _yawVelocity += value.y * WheelDegreesPerNotch;
    }

    protected override void OnMouseDown( MousePanelEvent e )
    {
        base.OnMouseDown( e );

        if ( e.MouseButton != MouseButtons.Left )
            return;

        // The edit button is a button - leave its clicks alone.
        if ( e.Target is Panel target && target.AncestorsAndSelf.Any( x => x.HasClass( "edit" ) ) )
            return;

        _dragging = true;
        _lastDragX = MousePosition.x;
        _yawVelocity = 0f;
    }

    /// <summary>
    /// Drag to turn him. While held, yaw follows the cursor and we keep a running estimate of how
    /// fast it's moving; on release he carries on with that speed and coasts to a stop.
    /// </summary>
    void UpdateSpin()
    {
        if ( scenePanel is null || !scenePanel.RenderScene.IsValid() )
            return;

        var renderer = scenePanel.RenderScene.GetAllComponents<SkinnedModelRenderer>().FirstOrDefault();
        if ( !renderer.IsValid() )
            return;

        var dt = MathF.Max( RealTime.Delta, 0.001f );

        if ( _dragging && !HasActive )
            _dragging = false;

        if ( _dragging )
        {
            var x = MousePosition.x;
            var deltaYaw = (x - _lastDragX) * DragDegreesPerPixel;
            _lastDragX = x;

            _yaw += deltaYaw;

            // Blend toward the instantaneous speed so a jittery frame doesn't set the fling.
            _yawVelocity = _yawVelocity.LerpTo( deltaYaw / dt, 0.5f );
        }
        else
        {
            _yaw += _yawVelocity * dt;
            _yawVelocity *= MathF.Exp( -SpinFriction * dt );

            if ( MathF.Abs( _yawVelocity ) < 0.5f )
                _yawVelocity = 0f;
        }

        renderer.GameObject.WorldRotation = Rotation.FromYaw( _yaw );
    }

    Vector3 _eyeDirection;
    float _eyeWeight;

    /// <summary>
    /// While hovered, the character's eyes follow the cursor.
    /// </summary>
    void UpdateEyes()
    {
        if ( scenePanel is null || !scenePanel.RenderScene.IsValid() )
            return;

        var renderer = scenePanel.RenderScene.GetAllComponents<SkinnedModelRenderer>().FirstOrDefault();
        if ( !renderer.IsValid() )
            return;

        var rect = Box.Rect;
        var camera = scenePanel.RenderScene.Camera;

        if ( rect.Width <= 0 || rect.Height <= 0 || !camera.IsValid() )
            return;

        var eyes = renderer.GetAttachment( "eyes" )?.Position ?? renderer.WorldPosition + Vector3.Up * 60;

        // Default to watching the viewer - that's also what hover eases in from.
        var wantDirection = (camera.WorldPosition - eyes).Normal;
        var wantWeight = 0f;

        if ( HasHovered )
        {
            // Cursor in card space, centered: -0.5 .. 0.5 on both axes.
            var u = MousePosition.x / rect.Width - 0.5f;
            var v = MousePosition.y / rect.Height - 0.5f;

            var dist = camera.WorldPosition.Distance( eyes );
            var halfWidth = dist * MathF.Tan( camera.FieldOfView.DegreeToRadian() * 0.5f );
            var halfHeight = halfWidth * (rect.Height / rect.Width);

            // Cast through the cursor pixel, but put the look target only a third of the
            // way out from the camera. That keeps it well in front of his face - a target
            // at his own depth swings wildly when the cursor is near his eyes - and
            // pulling it toward the viewer damps the glance to something subtle.
            var ray = camera.WorldRotation.Forward * dist
                + camera.WorldRotation.Right * (u * 2f * halfWidth)
                + camera.WorldRotation.Up * (-v * 2f * halfHeight);

            var target = camera.WorldPosition + ray.Normal * (dist * 0.9f);

            wantDirection = (target - eyes).Normal;
            wantWeight = 1f;
        }

        if ( _eyeDirection.IsNearZeroLength )
            _eyeDirection = wantDirection;

        // Ease toward the target so glances read as movement, not snapping.
        _eyeDirection = Vector3.Lerp( _eyeDirection, wantDirection, RealTime.Delta * 8f ).Normal;
        _eyeWeight = _eyeWeight.LerpTo( wantWeight, RealTime.Delta * 6f );

        renderer.SetLookDirection( "aim_eyes", _eyeDirection, _eyeWeight );
    }

    void OpenAvatarScene()
    {
        var options = new SceneLoadOptions();
        options.ShowLoadingScreen = false;
        options.SetScene( "/scenes/avatar.scene" );

        Game.ActiveScene.Load( options );
    }
}
