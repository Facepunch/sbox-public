@using System;
@using Sandbox;
@using Sandbox.UI;
@using MenuProject.MenuUI.Front;
@inherits Panel

<root>

    @* A scene behind your citizen, softened back so they stand out from it *@
    <div class="backdrop"></div>

    @* A soft light behind their head and shoulders, so dark hair doesn't sink into the backdrop *@
    <div class="glow"></div>

    @* Your citizen, centre stage and fading out towards their feet - spin them round, and they watch the cursor *@
    <div class="citizen-stage">
        <CitizenPreview class="portrait" LocalUser="@true" Interactive="@true" FieldOfView="@(32f)" CameraDistance="@(95f)" HeadOffset="@(-13f)" />
    </div>

    @* Name on the left, edit on the right, along the bottom *@
    <div class="footer">
        <div class="info">
            <label class="eyebrow">Welcome back</label>
            <label class="name">@Sandbox.Utility.Steam.PersonaName</label>
        </div>

        <div class="edit clicky" tooltip="Edit your avatar" @onclick="@OpenAvatarScene">
            <icon>edit</icon>
            <label>Edit</label>
        </div>
    </div>

</root>

@code
{
    void OpenAvatarScene()
    {
        var options = new SceneLoadOptions();
        options.ShowLoadingScreen = false;
        options.SetScene( "/scenes/avatar.scene" );

        Game.ActiveScene.Load( options );
    }
}
