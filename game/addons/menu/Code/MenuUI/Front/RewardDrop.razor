@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<div class="zone-rule" />

<div class="head">
    <label class="section-label">Reward drop</label>
    <div class="grow" />
    @if ( ShowRefresh )
    {
        <icon class="refresh clicky @( IsRefreshing ? "busy" : "" )" tooltip="Refresh" @onclick="@Refresh">refresh</icon>
    }
</div>

@if ( Window is null )
{
    <label class="loading">Loading…</label>
}
else
{
    @foreach ( var facet in Window.Facets )
    {
        var segments = Segments( facet );
        var filled = Filled( facet );

        <div class="objective">

            <div class="objective-head">
                <label class="objective-title">@facet.Title</label>
                <div class="grow" />
                <label class="objective-status @( facet.Met ? "done" : "" )">@( Status( facet ) )</label>
            </div>

            <div class="pips @( IsActive( facet ) ? "active" : "" )">
                @for ( int i = 0; i < segments; i++ )
                {
                    <div class="pip @( i < filled ? "on" : "" )" />
                }
            </div>

        </div>
    }

    <div class="open clicky @( CanOpen ? "" : "locked" )" @onclick="@OpenReward">
        <icon>@( CanOpen ? "redeem" : "lock" )</icon>
        <label>Open reward · @MetCount of @TotalCount done</label>
    </div>
}

@code
{
    RewardState State { get; set; }

    /// <summary>Only one window exists today.</summary>
    RewardWindow Window => State?.Windows.FirstOrDefault();

    bool CanOpen => Window is not null && (Window.IsEligible || State.Pending is not null);

    int MetCount => Window?.Facets.Count( x => x.Met ) ?? 0;
    int TotalCount => Window?.Facets.Length ?? 0;

    /// <summary>"Done" once met, otherwise the raw progress - "5/6".</summary>
    static string Status( RewardFacet facet )
    {
        if ( facet.Met ) return "Done";

        return $"{(int)facet.Current}/{(int)facet.Required}";
    }

    /// <summary>The first unmet objective - the only one drawn at full accent strength.</summary>
    bool IsActive( RewardFacet facet )
    {
        return ReferenceEquals( facet, Window?.Facets.FirstOrDefault( x => !x.Met ) );
    }

    /// <summary>One pip per unit required, matching the dots on the website's rewards page.</summary>
    static int Segments( RewardFacet facet ) => Math.Max( 1, (int)Math.Ceiling( facet.Required ) );

    static int Filled( RewardFacet facet ) => Math.Clamp( (int)Math.Floor( facet.Current ), 0, Segments( facet ) );

    bool IsRefreshing { get; set; }

    RealTimeSince _sinceRefresh = 100;

    /// <summary>Hidden for 10 seconds after each press.</summary>
    bool ShowRefresh => _sinceRefresh > 10f;

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( !firstTime )
            return;

        _ = Load();
    }

    async Task Load()
    {
        IsRefreshing = true;
        StateHasChanged();

        State = await MenuUtility.Rewards.GetRewards();

        IsRefreshing = false;
        StateHasChanged();
    }

    void Refresh()
    {
        if ( !ShowRefresh )
            return;

        _sinceRefresh = 0;
        _ = Load();
    }

    void OpenReward()
    {
        if ( !CanOpen )
            return;

        SceneTransition.Load( "/scenes/reward-unbox.scene" );
    }

    protected override int BuildHash() => HashCode.Combine( State, MetCount, CanOpen, IsRefreshing, ShowRefresh );
}
