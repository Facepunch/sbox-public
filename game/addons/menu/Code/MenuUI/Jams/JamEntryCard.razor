@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using System;
@namespace MenuProject.MenuUI.Jams
@inherits Panel

<root>
    <MenuProject.UI.PackageCard Package=@Package Clicked=@( () => OnSelected?.Invoke( Package ) ) RightClicked=@( () => OnMenu?.Invoke( Package ) ) />

    @if ( CanNominate && NeedsPlay )
    {
        <div class="nominate play" onclick=@( () => MenuHelpers.LaunchGame( Package.FullIdent ) ) tooltip="@( $"Play for at least {MinPlayText} to nominate" )">
            <icon>play_arrow</icon>
            <label>Play</label>
        </div>
    }
    else if ( CanNominate )
    {
        <div class="nominate @( IsNominated ? "on" : "" ) @( _busy ? "busy" : "" )" onclick=@( () => _ = Toggle() )>
            <icon>@( IsNominated ? "check" : "how_to_vote" )</icon>
            <label>@( IsNominated ? "Nominated" : "Nominate" )</label>
        </div>
    }
</root>

@code
{
    [Parameter] public Jam Jam { get; set; }
    [Parameter] public Package Package { get; set; }
    [Parameter] public bool CanNominate { get; set; }
    [Parameter] public bool Nominated { get; set; }
    [Parameter] public Action<Package> OnSelected { get; set; }
    [Parameter] public Action<Package> OnMenu { get; set; }

    bool? _override;
    bool _lastNominated;
    bool _busy;

    bool IsNominated => _override ?? Nominated;

    // Mirrors the backend's play-time gate so the card doesn't offer a refused nomination
    bool NeedsPlay => !IsNominated && Jam is not null && Package is not null && Package.Interaction.Seconds < Jam.MinPlaySeconds;

    string MinPlayText => TimeSpan.FromSeconds( Jam.MinPlaySeconds ).Humanize( 1 );

    protected override void OnParametersSet()
    {
        if ( Nominated == _lastNominated ) return;

        _lastNominated = Nominated;
        _override = null;
    }

    async Task Toggle()
    {
        if ( _busy || Jam is null || Package is null ) return;

        _busy = true;
        StateHasChanged();

        var removing = IsNominated;
        _override = !removing;
        string reason;

        try
        {
            reason = removing ? await Jam.WithdrawNominationAsync( Package ) : await Jam.NominateAsync( Package );
        }
        catch ( Exception e )
        {
            Log.Warning( e, $"Nominate {Package.FullIdent} failed" );
            reason = "Couldn't reach the jam right now.";
        }

        if ( !this.IsValid() ) return;

        _busy = false;

        if ( reason is not null )
        {
            _override = removing;
            MenuOverlay.Instance?.BottomRight?.Queue( new Toast() { Title = reason, Icon = "how_to_vote" } );
        }

        StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine( Package?.FullIdent, CanNominate, IsNominated, _busy, NeedsPlay );
}
