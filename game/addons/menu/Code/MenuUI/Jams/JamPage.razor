@using MenuProject.MenuUI.ContentBlock
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@namespace MenuProject.MenuUI.Jams

@page "/jam"
@inherits Panel
@implements Sandbox.UI.Navigation.INavigatorPage

<root class="root">
	<Page>
		<Body>
			<div class="jam-body">

				@if ( Jam is null )
				{
					<div class="jam-empty">
						<icon>@( IsLoading ? "hourglass_empty" : "emoji_events" )</icon>
						<label class="title">@( IsLoading ? Language.GetPhrase( "jampage.checking" ) : Language.GetPhrase( "jampage.no_jam" ) )</label>
						<label class="hint">@( IsLoading ? Language.GetPhrase( "jampage.one_moment" ) : Language.GetPhrase( "jampage.no_jam_hint" ) )</label>
					</div>
				}
				else
				{
					<div class="bar">
						@if ( Jam.IsLive )
						{
							<div class="live"><div class="pip"></div><label>#jampage.live</label></div>
						}

						<label class="strong">@Jam.Title</label>
						<div class="sep"></div>
						<label>@PhaseText</label>

						@if ( Jam.HasStarted && Jam.Now < Jam.Deadline )
						{
							<div class="sep"></div>
							<label>@Language.GetPhrase( "jampage.entries_close", new() { { "date", JamFormat.Day( Jam.Deadline ) } } )</label>
						}

						@if ( Jam.CommunityVoting && Jam.Now < Jam.NominationsEnd )
						{
							<div class="sep"></div>
							<label>@Language.GetPhrase( "jampage.nominate_until", new() { { "date", JamFormat.Day( Jam.NominationsEnd ) } } )</label>
						}

						@if ( CountdownTarget is DateTimeOffset target )
						{
							<JamCountdown class="countdown" Jam=@Jam Label=@CountdownLabel Target=@target />
						}
					</div>

					<div class="columns">
						<div class="main">

							<label class="kicker">@( ShowTheme ? Language.GetPhrase( "jampage.theme" ) : Language.GetPhrase( "jampage.game_jam" ) )</label>
							<label class="headline">@Headline</label>
							<label class="sub">@Jam.Description</label>
							<label class="blurb">@Blurb</label>

							<div class="actions">
								@if ( Jam.AcceptingEntries )
								{
									<div class="action" onclick=@EnterGame>
										<icon>touch_app</icon>
										<label>#jampage.enter_game</label>
									</div>
								}

								<div class="action secondary" onclick=@OpenWebsite>
									<icon>open_in_new</icon>
									<label>#jampage.jam_page</label>
								</div>
							</div>

							@foreach ( var category in Jam.Categories )
							{
								<div class="sec">
									<div class="sec-label">
										<label class="eyebrow">#jampage.prizes</label>
										<label class="name">@category.Title</label>
									</div>

									<div class="prize">
										<label class="prize-icon">@category.Icon</label>

										<div class="prize-body">
											<label class="prize-title">@PrizeTitle( category )</label>

											@if ( !string.IsNullOrWhiteSpace( category.Description ) )
											{
												<label class="prize-hint">@category.Description</label>
											}
										</div>

										<div class="places">
											@if ( category.Places.Length > 0 )
											{
												@for ( var i = 0; i < category.Places.Length; i++ )
												{
													<div class="place @( i == 0 ? "first" : "" )">
														<label class="amount">@category.Places[i]</label>
														<label class="ordinal">@JamFormat.Ordinal( i + 1 )</label>
													</div>
												}
											}
											else if ( !string.IsNullOrWhiteSpace( category.Prize ) )
											{
												<div class="place first">
													<label class="amount">@category.Prize</label>
													<label class="ordinal">#jampage.prize</label>
												</div>
											}
										</div>
									</div>
								</div>
							}

							<div class="sec grow">
								<div class="sec-label">
									<label class="eyebrow">#jampage.entries</label>
									<label class="name">@EntriesText</label>
								</div>

								@if ( !Jam.HasStarted )
								{
									<div class="jam-empty small">
										<icon>lock_clock</icon>
										<label class="title">@Language.GetPhrase( "jampage.theme_drops", new() { { "date", JamFormat.Day( Jam.Starts ) } } )</label>
										<label class="hint">#jampage.entries_open_hint</label>
									</div>
								}
								else
								{
									<div class="entries">
										<MenuProject.UI.PackageList ShowFilters="@false" Query=@Jam.Query Take=@( 200 ) ItemSize=@( new Vector2( 260, 236 ) )>
											<Item Context="package">
												<JamEntryCard Jam=@Jam Package=@package CanNominate=@CanNominate Nominated=@Nominated.Contains( package.FullIdent ) OnSelected=@Selected OnMenu=@Menu />
											</Item>
										</MenuProject.UI.PackageList>
									</div>
								}
							</div>

						</div>

						<JamSpine Jam=@Jam />
					</div>
				}

			</div>
		</Body>
	</Page>
</root>

@code
{
	Jam Jam { get; set; }

	bool IsLoading { get; set; }

	HashSet<string> Nominated { get; set; } = new( StringComparer.OrdinalIgnoreCase );

	bool ShowTheme => Jam.HasStarted && !string.IsNullOrWhiteSpace( Jam.Theme );

	string Headline => ShowTheme ? Jam.Theme : Jam.Title;

	bool CanNominate => CanNominateIn( Jam );

	static bool CanNominateIn( Jam jam ) => jam is not null && jam.CommunityVoting && jam.HasStarted && jam.Now < jam.NominationsEnd;

	string PhaseText
	{
		get
		{
			if ( !Jam.HasStarted )
				return Language.GetPhrase( "jampage.starts", new() { { "date", JamFormat.Day( Jam.Starts ) } } );

			var step = Jam.CurrentStepIndex >= 0 ? Jam.Timeline[Jam.CurrentStepIndex] : null;
			var next = Jam.NextStep;

			if ( step is null || next is null )
				return JamFormat.PhaseName( Jam.CurrentPhase ) ?? Jam.CurrentPhase.ToString();

			var total = Math.Max( 1, (int)Math.Round( (next.At - step.At).TotalDays ) );
			var into = Math.Clamp( (Jam.Now.UtcDateTime.Date - step.At.UtcDateTime.Date).Days + 1, 1, total );

			return Language.GetPhrase( "jampage.phase_day", new() { { "step", JamFormat.PhaseName( step ) }, { "into", into.ToString( "00" ) }, { "total", total.ToString( "00" ) } } );
		}
	}

	DateTimeOffset? CountdownTarget
	{
		get
		{
			if ( !Jam.HasStarted ) return Jam.Starts;
			if ( Jam.Now < Jam.Deadline ) return Jam.Deadline;
			if ( Jam.CommunityVoting && Jam.Now < Jam.NominationsEnd ) return Jam.NominationsEnd;

			return Jam.NextStep?.At;
		}
	}

	string CountdownLabel
	{
		get
		{
			if ( !Jam.HasStarted ) return Language.GetPhrase( "jampage.starts_in" );
			if ( Jam.Now < Jam.Deadline ) return Language.GetPhrase( "jampage.entries_close_in" );
			if ( Jam.CommunityVoting && Jam.Now < Jam.NominationsEnd ) return Language.GetPhrase( "jampage.nominations_lock_in" );

			return Language.GetPhrase( "jampage.step_in", new() { { "step", JamFormat.PhaseName( Jam.NextStep ) } } );
		}
	}

	string Blurb
	{
		get
		{
			if ( !Jam.HasStarted )
				return Language.GetPhrase( Jam.CommunityVoting ? "jampage.blurb_secret_nominate" : "jampage.blurb_secret" );

			if ( CanNominate )
				return Language.GetPhrase( "jampage.blurb_nominate" );

			if ( Jam.CommunityVoting )
				return Language.GetPhrase( "jampage.blurb_closed" );

			return Language.GetPhrase( "jampage.blurb_play" );
		}
	}

	string EntriesText => Jam.EntryCount switch
	{
		0 => Language.GetPhrase( Jam.HasStarted ? "jampage.entries_none" : "jampage.entries_not_open" ),
		1 => Language.GetPhrase( "jampage.entries_one" ),
		_ => Language.GetPhrase( "jampage.entries_plural", new() { { "count", Jam.EntryCount } } ),
	};

	static string PrizeTitle( Jam.Category category )
	{
		if ( category.Places.Length > 1 && !string.IsNullOrWhiteSpace( category.Prize ) )
			return Language.GetPhrase( "jampage.prize_across", new() { { "prize", category.Prize }, { "count", category.Places.Length }, { "word", NumberWord( category.Places.Length ) } } );

		return category.Prize ?? category.Title;
	}

	static string NumberWord( int n ) => n switch
	{
		2 => "two", 3 => "three", 4 => "four", 5 => "five", 6 => "six", 7 => "seven", 8 => "eight", 9 => "nine", 10 => "ten",
		_ => n.ToString(),
	};

	void Sandbox.UI.Navigation.INavigatorPage.OnNavigationOpen()
	{
		_ = Load();
	}

	async Task Load()
	{
		if ( IsLoading ) return;

		IsLoading = true;
		StateHasChanged();

		var jam = await Jam.GetActive();
		if ( !this.IsValid() ) return;

		if ( CanNominateIn( jam ) )
		{
			Nominated = await jam.GetMyNominationsAsync();
			if ( !this.IsValid() ) return;
		}

		Jam = jam;
		IsLoading = false;
		StateHasChanged();
	}

	void EnterGame()
	{
		MenuUtility.OpenUrl( $"{Jam.Url}/submit" );
	}

	void OpenWebsite()
	{
		MenuUtility.OpenUrl( Jam.Url );
	}

	void Selected( Package package )
	{
		ContentBlocks.OnLaunch( package );
	}

	void Menu( Package package )
	{
		ContentBlocks.OnMenu( this, package );
	}

	protected override int BuildHash() => HashCode.Combine( Jam?.Ident, Jam?.CurrentPhase, Jam?.EntryCount, IsLoading, Nominated.Count, Jam?.Now.Hour );
}
