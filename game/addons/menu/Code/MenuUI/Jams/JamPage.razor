@using MenuProject.MenuUI.Components
@using MenuProject.MenuUI.ContentBlock
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@namespace MenuProject.MenuUI.Jams

@page "/jam"
@inherits Panel
@implements Sandbox.UI.Navigation.INavigatorPage

<root class="root">
	<Page>
		<Body>
			@if ( Jam is null )
			{
				<div class="columns">
					<div class="jam-empty">
						@if ( IsLoading )
						{
							<Spinner />
						}
						else
						{
							<icon>emoji_events</icon>
						}
						<label class="title">@( IsLoading ? "Checking for a jam" : "No jam right now" )</label>
						<label class="hint">@( IsLoading ? "One moment." : "Nothing is running at the moment. Check back later." )</label>
					</div>
				</div>
			}
			else if ( Horizontal )
			{
				<div class="columns">

					<div class="stack">

						<div class="hero">

							<div class="hero-row">

								<div class="intro">
									<div class="head">
										<h2><WithIcon Icon="emoji_events" Text=@Jam.Title></WithIcon></h2>

										@if ( Jam.IsLive )
										{
											<div class="live-pill"><div class="pip"></div><label>Live</label></div>
										}
									</div>

									<div class="theme">
										<label class="kicker">@( ShowTheme ? "Theme" : "Game jam" )</label>
										<label class="headline">@Headline</label>
									</div>

									<p>@Jam.Description</p>
									<label class="blurb">@Blurb</label>
								</div>

								<div class="side">

									@foreach ( var category in Jam.Categories )
									{
										<div class="prizes">
											<div class="prize-head">
												<label class="prize-icon">@category.Icon</label>
												<label class="section-label">@( $"{category.Title} · {PrizeTitle( category )}" )</label>
											</div>

											@if ( category.Places.Length > 0 )
											{
												<div class="places">
													@for ( var i = 0; i < category.Places.Length; i++ )
													{
														<div class="place @( i == 0 ? "first" : "" )">
															<label class="amount">@category.Places[i]</label>
															<label class="ordinal">@JamFormat.Ordinal( i + 1 )</label>
														</div>
													}
												</div>
											}
											else if ( !string.IsNullOrWhiteSpace( category.Prize ) )
											{
												<div class="places">
													<div class="place first">
														<label class="amount">@category.Prize</label>
														<label class="ordinal">Prize</label>
													</div>
												</div>
											}

											@if ( !string.IsNullOrWhiteSpace( category.Description ) )
											{
												<label class="prize-hint">@category.Description</label>
											}
										</div>
									}

									<div class="actions">
										@if ( Jam.AcceptingEntries )
										{
											<div class="action" onclick=@EnterGame>
												<icon>touch_app</icon>
												<label>Enter your game</label>
											</div>
										}

										<div class="action secondary" onclick=@OpenWebsite>
											<icon>open_in_new</icon>
											<label>Jam page</label>
										</div>
									</div>
								</div>

							</div>

						</div>

						<div class="list">

							<div class="section-head">
								<label class="title">Entries</label>
								<label class="description">@EntriesText</label>
							</div>

							@if ( !Jam.HasStarted )
							{
								<div class="jam-empty">
									<icon>lock_clock</icon>
									<label class="title">Theme drops @JamFormat.Day( Jam.Starts )</label>
									<label class="hint">Entries open the moment it does.</label>
								</div>
							}
							else
							{
								<div class="entries">
									<MenuProject.UI.PackageList ShowFilters="@false" Query=@Jam.Query Take=@( 200 )>
										<Item Context="package">
											<MenuProject.UI.PackageCard Package=@package Clicked=@( () => Selected( package ) ) RightClicked=@( () => Menu( package ) ) />
										</Item>
									</MenuProject.UI.PackageList>
								</div>
							}

						</div>

					</div>

					<div class="schedule">

						@if ( CountdownTarget is DateTimeOffset target )
						{
							<JamCountdown class="countdown" Jam=@Jam Label=@CountdownLabel Target=@target />
						}

						<JamSpine Jam=@Jam />

					</div>

				</div>
			}
			else
			{
				<div class="columns">

					<div class="aside">

						<div class="head">
							<h2><WithIcon Icon="emoji_events" Text=@Jam.Title></WithIcon></h2>

							@if ( Jam.IsLive )
							{
								<div class="live-pill"><div class="pip"></div><label>Live</label></div>
							}
						</div>

						<div class="theme">
							<label class="kicker">@( ShowTheme ? "Theme" : "Game jam" )</label>
							<label class="headline">@Headline</label>
						</div>

						<p>@Jam.Description</p>
						<label class="blurb">@Blurb</label>

						<div class="actions">
							@if ( Jam.AcceptingEntries )
							{
								<div class="action" onclick=@EnterGame>
									<icon>touch_app</icon>
									<label>Enter your game</label>
								</div>
							}

							<div class="action secondary" onclick=@OpenWebsite>
								<icon>open_in_new</icon>
								<label>Jam page</label>
							</div>
						</div>

						@foreach ( var category in Jam.Categories )
						{
							<div class="block">
								<label class="section-label">@( $"Prizes · {category.Title}" )</label>

								<div class="prize">
									<label class="prize-icon">@category.Icon</label>

									<div class="prize-body">
										<label class="prize-title">@PrizeTitle( category )</label>

										@if ( !string.IsNullOrWhiteSpace( category.Description ) )
										{
											<label class="prize-hint">@category.Description</label>
										}
									</div>
								</div>

								@if ( category.Places.Length > 0 )
								{
									<div class="places">
										@for ( var i = 0; i < category.Places.Length; i++ )
										{
											<div class="place @( i == 0 ? "first" : "" )">
												<label class="ordinal">@JamFormat.Ordinal( i + 1 )</label>
												<label class="amount">@category.Places[i]</label>
											</div>
										}
									</div>
								}
								else if ( !string.IsNullOrWhiteSpace( category.Prize ) )
								{
									<div class="places">
										<div class="place first">
											<label class="ordinal">Prize</label>
											<label class="amount">@category.Prize</label>
										</div>
									</div>
								}
							</div>
						}

					</div>

					<div class="list">

						<div class="section-head">
							<label class="title">Entries</label>
							<label class="description">@EntriesText</label>
						</div>

						@if ( !Jam.HasStarted )
						{
							<div class="jam-empty">
								<icon>lock_clock</icon>
								<label class="title">Theme drops @JamFormat.Day( Jam.Starts )</label>
								<label class="hint">Entries open the moment it does.</label>
							</div>
						}
						else
						{
							<div class="entries">
								<MenuProject.UI.PackageList ShowFilters="@false" Query=@Jam.Query Take=@( 200 )>
									<Item Context="package">
										<MenuProject.UI.PackageCard Package=@package Clicked=@( () => Selected( package ) ) RightClicked=@( () => Menu( package ) ) />
									</Item>
								</MenuProject.UI.PackageList>
							</div>
						}

					</div>

					<div class="schedule">

						@if ( CountdownTarget is DateTimeOffset target )
						{
							<JamCountdown class="countdown" Jam=@Jam Label=@CountdownLabel Target=@target />
						}

						<JamSpine Jam=@Jam />

					</div>

				</div>
			}
		</Body>
	</Page>
</root>

@code
{
	Jam Jam { get; set; }

	bool IsLoading { get; set; }

	/// <summary>
	/// Info in a card across the top of the entries, rather than in a column beside them.
	/// </summary>
	static bool Horizontal = true;

	bool ShowTheme => Jam.HasStarted && !string.IsNullOrWhiteSpace( Jam.Theme );

	string Headline => ShowTheme ? Jam.Theme : Jam.Title;

	bool CanNominate => CanNominateIn( Jam );

	static bool CanNominateIn( Jam jam ) => jam is not null && jam.CommunityVoting && jam.HasStarted && jam.Now < jam.NominationsEnd;

	DateTimeOffset? CountdownTarget
	{
		get
		{
			if ( !Jam.HasStarted ) return Jam.Starts;
			if ( Jam.Now < Jam.Deadline ) return Jam.Deadline;
			if ( Jam.CommunityVoting && Jam.Now < Jam.NominationsEnd ) return Jam.NominationsEnd;

			return Jam.NextStep?.At;
		}
	}

	string CountdownLabel
	{
		get
		{
			if ( !Jam.HasStarted ) return "Starts in";
			if ( Jam.Now < Jam.Deadline ) return "Entries close in";
			if ( Jam.CommunityVoting && Jam.Now < Jam.NominationsEnd ) return "Nominations lock in";

			return $"{Jam.NextStep?.Name} in";
		}
	}

	string Blurb
	{
		get
		{
			if ( !Jam.HasStarted )
				return Jam.CommunityVoting
					? "The theme is a secret until the jam starts. Once it does, play the entries and nominate the ones you rate."
					: "The theme is a secret until the jam starts.";

			if ( CanNominate )
				return "Play the entries as they land and nominate the ones you rate. Nominations decide who makes the finals.";

			if ( Jam.CommunityVoting )
				return "Nominations are closed. The finalists go head to head.";

			return "Play the entries.";
		}
	}

	string EntriesText => Jam.EntryCount switch
	{
		0 => Jam.HasStarted ? "none yet" : "not open yet",
		1 => "There is only 1 so far",
		_ => $"There are {Jam.EntryCount} entries so far",
	};

	static string PrizeTitle( Jam.Category category )
	{
		if ( category.Places.Length > 1 && !string.IsNullOrWhiteSpace( category.Prize ) )
			return $"{category.Prize} across {NumberWord( category.Places.Length )} places";

		return category.Prize ?? category.Title;
	}

	static string NumberWord( int n ) => n switch
	{
		2 => "two", 3 => "three", 4 => "four", 5 => "five", 6 => "six", 7 => "seven", 8 => "eight", 9 => "nine", 10 => "ten",
		_ => n.ToString(),
	};

	void Sandbox.UI.Navigation.INavigatorPage.OnNavigationOpen()
	{
		_ = Load();
	}

	async Task Load()
	{
		if ( IsLoading ) return;

		IsLoading = true;
		StateHasChanged();

		var jam = await Jam.GetActive();
		if ( !this.IsValid() ) return;

		Jam = jam;
		IsLoading = false;
		StateHasChanged();
	}

	void EnterGame()
	{
		MenuUtility.OpenUrl( $"{Jam.Url}/submit" );
	}

	void OpenWebsite()
	{
		MenuUtility.OpenUrl( Jam.Url );
	}

	void Selected( Package package )
	{
		ContentBlocks.OnLaunch( package );
	}

	void Menu( Package package )
	{
		ContentBlocks.OnMenu( this, package );
	}

	protected override int BuildHash() => HashCode.Combine( Jam?.Ident, Jam?.CurrentPhase, Jam?.EntryCount, IsLoading, Horizontal, Jam?.Now.Hour );
}
