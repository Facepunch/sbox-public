@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System;
@using System.Linq;
@namespace MenuProject.MenuUI.Jams
@page "/jam"
@inherits Panel
@implements INavigatorPage

<root class="root">
	<Page>
		<Body>
			@if ( Jam is null )
			{
				<div class="columns">
					<div class="jam-empty">
						@if ( IsLoading )
						{
							<Spinner />
						}
						else
						{
							<icon>emoji_events</icon>
						}
						<label class="title">@(IsLoading ? "Checking for a jam" : "No jam right now")</label>
						<label class="hint">@(IsLoading ? "One moment." : "Nothing is running at the moment. Check back later.")</label>
					</div>
				</div>
			}
			else
			{
				@switch ( CurrentPhase )
				{
					case Jam.Phase.Upcoming:
					case Jam.Phase.Teased:
						<Phase00Upcoming Jam=@Jam />
						break;
					case Jam.Phase.Building:
						<Phase01Building Jam=@Jam />
						break;
					case Jam.Phase.Judging:
						<Phase02Judging Jam=@Jam />
						break;
					case Jam.Phase.Nominations:
						<Phase03Nominations Jam=@Jam />
						break;
					case Jam.Phase.Finals:
						<Phase04Finals Jam=@Jam />
						break;
					case Jam.Phase.GrandFinal:
						<Phase05GrandFinal Jam=@Jam />
						break;
					case Jam.Phase.Crowned:
						<Phase06Crowned Jam=@Jam />
						break;
				}
			}
		</Body>
	</Page>
	@if ( Jam.IsEditorPreview && Jam is not null )
	{
		<JamPreviewHelper Jam=@Jam />
	}
</root>

@code
{
	GameJamSystem Voting => GameJamSystem.For( this );
	Jam Jam => Voting?.ActiveJam;
	bool IsLoading => Voting?.IsLoading == true;
	Jam.Phase? PreviousPhase;
	string PreviousJam;
	Sandbox.JamFinalistCategory[] PreviousCategories;

	/// <summary>
	/// Announces phase changes to players who stay on the page as a deadline passes.
	/// </summary>
	public override void Tick()
	{
		base.Tick();
		if ( Jam is null )
		{
			PreviousJam = null;
			PreviousPhase = null;
			PreviousCategories = null;
			return;
		}

		if ( IsVisible && PreviousJam == Jam.Ident )
		{
			var phaseChanged = PreviousPhase.HasValue && PreviousPhase != CurrentPhase;
			// Round announcements already explain transitions within community finals.
			var roundTransition = Jam.CommunityVoting && PreviousPhase >= Jam.Phase.Finals
				&& CurrentPhase is Jam.Phase.Finals or Jam.Phase.GrandFinal;

			if ( phaseChanged && !roundTransition ) AnnouncePhase();
			AnnounceRounds();
		}

		PreviousCategories = IsVisible ? Voting.Finalists : null;
		PreviousJam = Jam.Ident;
		PreviousPhase = CurrentPhase;
	}

	void AnnouncePhase()
	{
		var title = CurrentPhase switch
		{
			Jam.Phase.Finals => "The knockout begins",
			Jam.Phase.GrandFinal => WaitingForFinal ? "The grand finalists are confirmed" : "It's time for the grand final",
			Jam.Phase.Crowned => "The results are in",
			_ => Jam.CurrentStepIndex >= 0 ? $"{Jam.Timeline[Jam.CurrentStepIndex].Name} begins" : "The jam is coming"
		};
		var detail = CurrentPhase switch
		{
			Jam.Phase.Finals => "Meet the contenders. Every round starts fresh.",
			Jam.Phase.GrandFinal => WaitingForFinal ? "Play the final pair before voting reopens." : "The final showdown is here.",
			Jam.Phase.Crowned => "Meet the winners of this jam.",
			_ => "The next stage is now open."
		};
		MenuOverlay.Instance?.BottomRight?.Queue( new MenuProject.Toast()
		{
			Title = title,
			Message = detail,
			Icon = "emoji_events"
		} );
	}

	void AnnounceRounds()
	{
		foreach ( var current in Voting.Finalists ?? [] )
		{
			var previous = PreviousCategories?.FirstOrDefault( x => x.Id == current.Id );
			if ( previous is null || ReferenceEquals( previous, current ) ) continue;

			var eliminated = current.Nominees.Where( x => x.EliminatedRound.HasValue
				&& previous.Nominees.Any( p => p.PackageIdent == x.PackageIdent && !p.EliminatedRound.HasValue ) ).ToArray();
			var opened = current.IsVotingAt( Jam.Now )
				&& (!previous.VotingOpen || current.Round > previous.Round);
			if ( eliminated.Length == 0 && !opened ) continue;

			var title = eliminated.Length == 1 ? $"{Package.GetCachedTitle( eliminated[0].PackageIdent )} is knocked out"
				: eliminated.Length > 1 ? $"{eliminated.Length} games are knocked out"
				: current.GrandFinal ? "The grand final is open" : $"Round {current.Round} is open";
			var detail = current.Decided ? "The final result is confirmed."
				: opened ? current.GrandFinal ? "Pick your winner." : $"{current.Contenders.Count} remain. Choose your favourite again."
				: "Voting is closed. Waiting for the next round.";
			MenuOverlay.Instance?.BottomRight?.Queue( new MenuProject.Toast()
			{
				Title = title,
				Message = detail,
				Icon = "emoji_events"
			}, duration: 5 );
		}
	}

	Jam.Phase CurrentPhase => Voting?.Phase ?? Jam.Phase.Upcoming;
	bool WaitingForFinal => Voting?.Finalists?.Any( x => x.GrandFinal && JamVotingPresentation.Waiting( x ) ) == true;

	void INavigatorPage.OnNavigationOpen() => Voting?.Refresh();

	protected override int BuildHash() => HashCode.Combine( Jam, CurrentPhase, Jam?.EntryCount, IsLoading, Jam.IsEditorPreview );
}
