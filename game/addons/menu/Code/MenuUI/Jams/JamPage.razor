@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System;
@namespace MenuProject.MenuUI.Jams
@page "/jam"
@inherits Panel
@implements INavigatorPage

<root class="root">
	<Page>
		<Body>
			@if ( Jam is null )
			{
				<div class="columns">
					<div class="jam-empty">
						@if ( IsLoading )
						{
							<Spinner />
						}
						else
						{
							<icon>emoji_events</icon>
						}
						<label class="title">@(IsLoading ? "Checking for a jam" : "No jam right now")</label>
						<label class="hint">@(IsLoading ? "One moment." : "Nothing is running at the moment. Check back later.")</label>
					</div>
				</div>
			}
			else
			{
				@switch ( CurrentPhase )
				{
					case Jam.Phase.Upcoming:
					case Jam.Phase.Teased:
						<Phase00Upcoming Jam=@Jam />
						break;
					case Jam.Phase.Building:
						<Phase01Building Jam=@Jam />
						break;
					case Jam.Phase.Judging:
						<Phase02Judging Jam=@Jam />
						break;
					case Jam.Phase.Nominations:
						<Phase03Nominations Jam=@Jam />
						break;
					case Jam.Phase.Finals:
						<Phase04Finals Jam=@Jam />
						break;
					case Jam.Phase.GrandFinal:
						<Phase05GrandFinal Jam=@Jam />
						break;
					case Jam.Phase.Crowned:
						<Phase06Crowned Jam=@Jam />
						break;
				}
			}
		</Body>
	</Page>
</root>

@code
{
	GameJamSystem Voting => GameJamSystem.Get( Scene );
	Jam Jam => Voting?.ActiveJam;
	bool IsLoading => Voting?.IsLoading == true;

	// The timeline follows the jam's preview clock and advances without reopening the page.
	Jam.Phase CurrentPhase
	{
		get
		{
			if ( Jam is null ) return Jam.Phase.Upcoming;

			// The schedule can remain on nominations between lock and the first round.
			// Show the reveal in that gap, while the voting snapshot owns the slate and round status.
			if ( Jam.CommunityVoting && Jam.Now >= Jam.NominationsEnd && Jam.Now < Jam.FinalsStart )
				return Jam.Phase.Finals;

			var index = Jam.CurrentStepIndex;
			return index >= 0 ? Jam.Timeline[index].Phase : Jam.CurrentPhase;
		}
	}

	void INavigatorPage.OnNavigationOpen() => Voting?.Refresh();

	protected override int BuildHash() => HashCode.Combine( Jam, CurrentPhase, Jam?.EntryCount, IsLoading );
}