@namespace MenuProject.MenuUI.Jams
@inherits JamPhasePanel

<root class="jam-phase">
	<JamPhaseLayout Jam=@Jam Blurb=@EntryGuidance CountdownTarget=@CountdownTarget CountdownLabel=@CountdownLabel>
		<Content>
			<JamEntries Jam=@Jam />
		</Content>
	</JamPhaseLayout>
</root>

@code
{
	bool NominationsOpen => Jam.CommunityVoting && Jam.Now < Jam.NominationsEnd;

	System.DateTimeOffset? CountdownTarget => NominationsOpen ? Jam.NominationsEnd : Jam.NextStep?.At;

	string CountdownLabel => NominationsOpen ? "Nominations lock in" : $"{Jam.NextStep?.Name} in";
}
