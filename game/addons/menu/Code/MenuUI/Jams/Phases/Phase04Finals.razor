@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using MenuProject.MenuUI.ContentBlock;
@namespace MenuProject.MenuUI.Jams
@inherits JamPhasePanel
@implements IBackendListener

<root class="jam-phase">
	<JamPhaseLayout Jam=@Jam Blurb="Nominations are closed. Play the finalists and explore every entry from the jam." CountdownTarget=@CountdownTarget CountdownLabel=@CountdownLabel CountdownStatus=@CountdownStatus>
		<Content>
			<div class="finalist-browser">
				<div class="view-tabs">
					<Button Text="Finalists" Active=@(!ShowAllEntries) onclick=@(() => ShowAllEntries = false) />
					<Button Text=@($"All entries ({Jam.EntryCount:N0})") Active=@ShowAllEntries onclick=@(() => ShowAllEntries = true) />
				</div>

				@if ( ShowAllEntries )
				{
					<JamEntries Jam=@Jam />
				}
				else
				{
					<div class="finalist-scroll">
						<div class="section-head">
							<label class="title">Finalists</label>
							<label class="description">The confirmed slate, in seed order. Play them before you pick your favourite.</label>
						</div>

						@if ( Error is not null )
						{
							<div class="load-error">
								<label>@Error</label>
								<Button Text="Retry" onclick=@RequestRefresh />
							</div>
						}

						@if ( Categories is null )
						{
							@if ( Error is null )
							{
								<Spinner />
							}
						}
						else if ( Categories.Length == 0 )
						{
							<EmptyState Icon="emoji_events" Title="No community finalists" Subtitle="You can still play every game in All entries." />
						}
						else
						{
							@if ( Categories.Length > 1 )
							{
								<div class="category-tabs">
									@foreach ( var category in Categories )
									{
										<Button Text=@($"{category.Title} ({category.Nominees.Count})") Active=@(CategoryId == category.Id) onclick=@(() => CategoryId = category.Id) />
									}
								</div>
							}

							@if ( Category is not null )
							{
								@if ( Category.Nominees.Count == 0 )
								{
									<EmptyState Icon="emoji_events" Title="No finalists confirmed" Subtitle="The confirmed slate will appear here when it is available." />
								}
								else
								{
									<div class="finalist-grid">
										@foreach ( var finalist in Category.Nominees )
										{
											var package = GetPackage( finalist.PackageIdent );
											<div class="finalist">
												<div class="artwork">
													@if ( package is not null )
													{
														<MenuProject.UI.PackageCard Package=@package Clicked=@(() => Play( package )) RightClicked=@(() => OpenMenu( package )) />
													}
													else
													{
														<div class="missing-package">
															<icon>videogame_asset_off</icon>
															<label>@(Loading ? "Loading game…" : "Game unavailable")</label>
														</div>
													}
													<label class="seed">Seed #@finalist.Seed</label>
												</div>
												<div class="game-actions">
													<Button class="play" Icon="play_arrow" Text="Play" Disabled=@(package is null) onclick=@(() => Play( package )) />
													@if ( !Category.VotingOpen && !Category.Decided )
													{
														<Button class="locked" Icon="lock" Text="Vote" Disabled=@true />
													}
													@if ( finalist.EliminatedRound is int round )
													{
														<label class="eliminated">Eliminated in round @round</label>
													}
												</div>
											</div>
										}
									</div>
								}

								<div class="voting-status">
									<icon>@(Category.VotingOpen ? "how_to_vote" : "lock_clock")</icon>
									<div>
										<label class="status-title">@StatusTitle</label>
										<label class="description">@StatusDescription</label>
									</div>
								</div>
							}
						}
					</div>
				}
			</div>
		</Content>
	</JamPhaseLayout>
</root>

@code
{
	JamFinalistCategory[] Categories;
	int CategoryId;
	bool ShowAllEntries;
	bool Loading;
	bool RefreshRequested = true;
	string Error;
	string LoadedIdent;
	int PreviewDays;
	RealTimeUntil NextRefresh;
	DateTimeOffset? RefreshedDeadline;
	readonly Dictionary<string, Package> Packages = new( StringComparer.OrdinalIgnoreCase );

	JamFinalistCategory Category => Categories?.FirstOrDefault( x => x.Id == CategoryId );
	DateTimeOffset? CountdownTarget => Category?.VotingOpen == true ? Category.RoundEnds : Category?.NextRoundOpens;
	string CountdownLabel => Category?.VotingOpen == true ? $"Round {Category.Round} ends in"
		: Category?.Nominees.Any( x => x.EliminatedRound.HasValue ) == true ? "Next round opens in" : "First round opens in";
	string CountdownStatus => CountdownTarget is DateTimeOffset target && target <= Jam.Now
		? Category?.VotingOpen == true ? "Counting votes" : "Opening soon" : null;
	string StatusTitle => Category?.Decided == true ? "Category decided"
		: Category?.VotingOpen == true ? CountdownStatus ?? $"Round {Category.Round} is open"
		: CountdownTarget is DateTimeOffset target && target <= Jam.Now ? "Waiting for the round to open"
		: "Voting hasn’t opened yet";
	string StatusDescription => Category?.VotingOpen == true ? "Each round starts fresh. One vote per category."
		: Category?.ClosedReason ?? "Each round starts fresh. Nominations do not carry over.";

	protected override void OnParametersSet()
	{
		if ( LoadedIdent == Jam?.Ident && PreviewDays == Jam.PreviewDays ) return;

		LoadedIdent = Jam?.Ident;
		PreviewDays = Jam.PreviewDays;
		Categories = null;
		CategoryId = 0;
		Error = null;
		Packages.Clear();
		RefreshedDeadline = null;
		RequestRefresh();
	}

	/// <summary>
	/// Refreshes while visible and reconciles a reached deadline without opening voting locally.
	/// </summary>
	public override void Tick()
	{
		base.Tick();
		if ( !IsVisible || Jam is null ) return;

		if ( PreviewDays != Jam.PreviewDays ) OnParametersSet();

		if ( CountdownTarget is DateTimeOffset deadline && Jam.Now >= deadline && RefreshedDeadline != deadline )
		{
			RefreshedDeadline = deadline;
			RequestRefresh();
		}

		if ( !Loading && (RefreshRequested || NextRefresh <= 0) ) _ = RefreshAsync();
	}

	protected override void OnVisibilityChanged()
	{
		base.OnVisibilityChanged();
		if ( IsVisible ) RequestRefresh();
	}

	/// <summary>
	/// Reconciles round transitions or withdrawals missed while disconnected.
	/// </summary>
	public void OnBackendConnected() => RequestRefresh();

	void RequestRefresh() => RefreshRequested = true;

	async Task RefreshAsync()
	{
		Loading = true;
		RefreshRequested = false;
		var jam = Jam;
		var days = PreviewDays;

		try
		{
			var categories = await jam.GetFinalistsAsync();
			if ( !IsCurrent( jam, days ) ) return;

			Categories = categories;
			if ( !Categories.Any( x => x.Id == CategoryId ) ) CategoryId = Categories.FirstOrDefault()?.Id ?? 0;
			Error = null;
			StateHasChanged();

			var idents = categories.SelectMany( x => x.Nominees ).Select( x => x.PackageIdent )
				.Where( x => !string.IsNullOrEmpty( x ) && !Packages.ContainsKey( x ) ).Distinct( StringComparer.OrdinalIgnoreCase );
			await Task.WhenAll( idents.Select( ident => LoadPackage( jam, days, ident ) ) );
		}
		catch ( Exception e )
		{
			if ( !IsCurrent( jam, days ) ) return;

			Log.Warning( $"Couldn't refresh jam finalists ({e.Message})" );
			Error = Categories is null ? "Couldn't load finalists. You can still browse all entries."
				: "Couldn't refresh finalists. Showing the last confirmed slate.";
		}
		finally
		{
			Loading = false;
			NextRefresh = 20;
			if ( this.IsValid() ) StateHasChanged();
		}
	}

	async Task LoadPackage( Jam jam, int days, string ident )
	{
		try
		{
			var package = await Package.FetchAsync( ident, false );
			if ( IsCurrent( jam, days ) && package is not null ) Packages[ident] = package;
		}
		catch ( Exception e )
		{
			// Keep its seed visible and retry on refresh; one unavailable game must not hide the slate.
			Log.Warning( $"Couldn't load finalist {ident} ({e.Message})" );
		}
	}

	bool IsCurrent( Jam jam, int days ) => this.IsValid() && Jam?.Ident == jam.Ident && Jam.PreviewDays == days;

	Package GetPackage( string ident ) => ident is null ? null : Packages.GetValueOrDefault( ident );

	void Play( Package package )
	{
		if ( package is not null ) ContentBlocks.OnLaunch( package );
	}

	void OpenMenu( Package package ) => ContentBlocks.OnMenu( this, package );

	protected override int BuildHash() => HashCode.Combine( base.BuildHash(), Categories, CategoryId, ShowAllEntries, Loading, Error, StatusTitle );
}
