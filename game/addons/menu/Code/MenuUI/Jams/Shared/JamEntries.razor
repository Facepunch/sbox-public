@using System.Globalization;
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@namespace MenuProject.MenuUI.Jams
@inherits Panel

<root>
	<div class="section-head">
		<label class="title">#menu.jam.entries</label>
		<label class="description">@EntriesText</label>
	</div>

	@if ( Locked )
	{
		<div class="jam-empty">
			<icon>lock_clock</icon>
			<label class="title">Theme drops @Jam.Starts.UtcDateTime.ToString( "ddd d MMM", CultureInfo.InvariantCulture )</label>
			<label class="hint">#menu.jam.entries_open_the_moment_it_does</label>
		</div>
	}
	else
	{
		<div class="entries">
			<JamEntryBrowser Jam=@Jam />
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The jam whose entry count and browser are displayed.
	/// </summary>
	[Parameter] public Jam Jam { get; set; }

	/// <summary>
	/// Shows the pre-start placeholder instead of loading the entry browser.
	/// </summary>
	[Parameter] public bool Locked { get; set; }

	string EntriesText => Jam.EntryCount switch
	{
		0 => Jam.HasStarted ? "#menu.jam.none_yet" : "#menu.jam.not_open_yet",
		1 => "#menu.jam.1_so_far",
		_ => $"{Jam.EntryCount:N0} so far",
	};

	protected override int BuildHash() => System.HashCode.Combine( Jam, Jam.EntryCount, Locked );
}
