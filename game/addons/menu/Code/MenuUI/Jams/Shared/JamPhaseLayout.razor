@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@using System;
@namespace MenuProject.MenuUI.Jams
@inherits Panel

<root>
	<div class="stack">
		<JamHeader Jam=@Jam Blurb=@Blurb BlurbLead=@BlurbLead PhaseTitle=@PhaseTitle PhaseSubtitle=@PhaseSubtitle />
		@Content
	</div>
	<JamSchedule Jam=@Jam CountdownTarget=@CountdownTarget CountdownLabel=@CountdownLabel CountdownStatus=@CountdownStatus StandingsContent=@StandingsContent />
</root>

@code
{
	/// <summary>
	/// The jam whose shared header and schedule are displayed.
	/// </summary>
	[Parameter] public Jam Jam { get; set; }

	/// <summary>
	/// Guidance supplied by the current phase.
	/// </summary>
	[Parameter] public string Blurb { get; set; }

	/// <summary>
	/// Optional highlighted status before the header guidance.
	/// </summary>
	[Parameter] public string BlurbLead { get; set; }

	/// <summary>
	/// Optional phase headline to feature in the title card instead of the theme.
	/// </summary>
	[Parameter] public string PhaseTitle { get; set; }

	/// <summary>
	/// Round context displayed alongside the theme above the phase headline.
	/// </summary>
	[Parameter] public string PhaseSubtitle { get; set; }

	/// <summary>
	/// The next phase deadline, or null when there is no countdown.
	/// </summary>
	[Parameter] public DateTimeOffset? CountdownTarget { get; set; }

	/// <summary>
	/// Describes the deadline shown above the schedule.
	/// </summary>
	[Parameter] public string CountdownLabel { get; set; }

	/// <summary>
	/// Optional status to display in place of the clock while waiting for a server transition.
	/// </summary>
	[Parameter] public string CountdownStatus { get; set; }

	/// <summary>
	/// Phase-specific standings above the schedule, replacing nomination standings.
	/// </summary>
	[Parameter] public RenderFragment StandingsContent { get; set; }

	/// <summary>
	/// The current phase's main content, below the shared header.
	/// </summary>
	[Parameter] public RenderFragment Content { get; set; }
}
