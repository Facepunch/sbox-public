@using MenuProject.MenuUI.Components
@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@namespace MenuProject.MenuUI.Jams
@inherits Panel

<root>
	<div class="hero-row">
		<div class="intro">
			<div class="head">
				<h2><WithIcon Icon="emoji_events" Text=@Jam.Title /></h2>
				@if ( Jam.IsLive )
				{
					<div class="live-pill"><div class="pip"></div><label>Live</label></div>
				}
				@if ( PhaseTitle is not null )
				{
					<label class="kicker">@($"{(ShowTheme ? Jam.Theme : Jam.Title)} · {PhaseSubtitle}")</label>
				}
			</div>
			<label class="headline">@(PhaseTitle ?? (ShowTheme ? Jam.Theme : Jam.Title))</label>
			<div class="blurb">
				@if ( !string.IsNullOrEmpty( BlurbLead ) )
				{
					<label class="blurb-lead">@BlurbLead</label>
				}
				<label>@(Blurb ?? Jam.Description)</label>
			</div>
		</div>
		<div class="side">
			@foreach ( var category in Jam.Categories )
			{
				<JamPrizes Category=@category />
			}
		</div>
		@if ( Jam.AcceptingEntries )
		{
			<Button class="action" Icon="touch_app" Text="Enter your game" onclick=@EnterGame />
		}
	</div>
</root>

@code
{
	/// <summary>
	/// The jam's title, theme, prizes and entry link.
	/// </summary>
	[Parameter] public Jam Jam { get; set; }

	/// <summary>
	/// Guidance supplied by the current phase.
	/// </summary>
	[Parameter] public string Blurb { get; set; }

	/// <summary>
	/// Optional highlighted status before the phase guidance.
	/// </summary>
	[Parameter] public string BlurbLead { get; set; }

	/// <summary>
	/// Optional phase headline. The theme remains visible as the kicker above it.
	/// </summary>
	[Parameter] public string PhaseTitle { get; set; }

	/// <summary>
	/// Round context displayed with the theme when a phase headline is supplied.
	/// </summary>
	[Parameter] public string PhaseSubtitle { get; set; }

	bool ShowTheme => Jam.HasStarted && !string.IsNullOrWhiteSpace( Jam.Theme );

	void EnterGame() => MenuUtility.OpenUrl( $"{Jam.Url}/submit" );

	protected override int BuildHash() => System.HashCode.Combine( Jam, ShowTheme, Jam.AcceptingEntries, Blurb, BlurbLead, PhaseTitle, PhaseSubtitle );
}
