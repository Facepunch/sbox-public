@using Sandbox;
@using Sandbox.Services;
@using Sandbox.UI;
@namespace MenuProject.MenuUI.Jams
@inherits Panel

<root>
	<div class="prize-head">
		<label class="prize-icon">@Category.Icon</label>
		<label class="section-label">@($"{Category.Title} · Prize pool")</label>
	</div>

	@if ( !string.IsNullOrWhiteSpace( Category.Prize ) )
	{
		<label class="amount">@Category.Prize</label>
	}

</root>

@code
{
	/// <summary>
	/// The category's headline prize pool.
	/// </summary>
	[Parameter] public Jam.Category Category { get; set; }
}
