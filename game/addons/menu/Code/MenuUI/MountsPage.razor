@using MenuProject.MenuUI.Components
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.Mounting;
@using Sandbox.UI;
@using Sandbox.UI.Mounts;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@page "/mounts"
@inherits Panel

@* Not using Page's Left slot - this page lays out its own two columns so the explainer card
   and the list share the same gutter. *@
<root class="root">
	<Page>
		<Body>
			<div class="columns">

				<div class="aside">

					<h2><WithIcon Icon="extension" Text="#menu.mounts.what_s_a_mount"></WithIcon></h2>
					<p>#menu.mounts.a_mount_lets_s_box_use_the_content_of</p>

					<div class="block">
						<label class="section-label">#menu.mounts.how_it_works</label>

						<div class="step">
							<icon>shopping_cart</icon>
							<label>#menu.mounts.own_the_game_on_steam_and_install_it_s_box_finds_it_through_your_library</label>
						</div>

						<div class="step">
							<icon>toggle_on</icon>
							<label>#menu.mounts.turn_it_on_here_it_stays_on_until_you_turn_it_off_again</label>
						</div>

						<div class="step">
							<icon>folder_open</icon>
							<label>#menu.mounts.its_content_shows_up_in_the_asset_browser_and</label>
						</div>
					</div>

					<div class="block">
						<label class="section-label">#menu.mounts.worth_knowing</label>

						<div class="note">
							<icon>group</icon>
							<label>#menu.mounts.in_multiplayer_everyone_needs_the_game_installed_and_mounted</label>
						</div>

						<div class="note">
							<icon>memory</icon>
							<label>#menu.mounts.turning_a_mount_off_releases_everything_it_loaded_so</label>
						</div>

						<div class="note">
							<icon>code</icon>
							<label>#menu.mounts.mounts_are_part_of_the_engine_and_anyone_can</label>
						</div>

						<label class="docs-link" onclick=@OpenDocs>#menu.mounts.read_more_about_mounts</label>
					</div>

				</div>

				<div class="list">

					@if ( !Mounts.Any() )
					{
						<div class="empty">
							<icon>extension_off</icon>
							<label class="title">#menu.mounts.no_mounts_installed</label>
							<label class="hint">#menu.mounts.mounts_ship_with_the_engine_if_this_list_is</label>
						</div>
					}

					@if ( Installed.Any() )
					{
						<div class="section-head">
							<label class="title">#menu.mounts.installed</label>
							<label class="count">@Installed.Count() games</label>
						</div>

						<div class="grid">
							@foreach ( var mount in Installed )
							{
								<MountCard Mount="@mount"></MountCard>
							}
						</div>
					}

					@if ( Owned.Any() )
					{
						<div class="section-head quiet">
							<label class="title">#menu.mounts.in_your_library</label>
							<label class="count">@Owned.Count() games to install</label>
						</div>

						<div class="grid">
							@foreach ( var mount in Owned )
							{
								<MountCard Mount="@mount"></MountCard>
							}
						</div>
					}

					@if ( Unowned.Any() )
					{
						<div class="section-head quiet">
							<label class="title">#menu.mounts.not_owned</label>
							<label class="count">@Unowned.Count() games</label>
						</div>

						<div class="grid">
							@foreach ( var mount in Unowned )
							{
								<MountCard Mount="@mount"></MountCard>
							}
						</div>
					}

				</div>

			</div>
		</Body>
	</Page>
</root>

@code
{
	const string DocsUrl = "https://sbox.game/dev/doc/game-mounts/";

	List<BaseGameMount> mounts;

	/// <summary>
	/// Every mount, cached - which mounts exist only changes when an assembly loads, and the
	/// page rebuilds its hash from this list every frame.
	/// </summary>
	List<BaseGameMount> Mounts => mounts ??= BaseGameMount.All.ToList();

	// Three rungs, because the action differs at each: toggle it, install it, buy it. Owned and
	// not installed used to sit with the unowned ones and get sent to a store page, which is a
	// dead end for a game that's already yours.
	//
	// IsOwned is a native Steam call, so these are only walked while rendering - never from
	// BuildHash, which runs every frame.
	IEnumerable<BaseGameMount> Installed => Mounts.Where( x => x.IsInstalled );
	IEnumerable<BaseGameMount> Owned => Mounts.Where( x => !x.IsInstalled && x.IsOwned );
	IEnumerable<BaseGameMount> Unowned => Mounts.Where( x => !x.IsInstalled && !x.IsOwned );

	void OpenDocs()
	{
		MenuUtility.OpenUrl( DocsUrl );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		foreach ( var mount in Mounts )
		{
			hash.Add( mount.IsInstalled );
			hash.Add( mount.IsMounted );
		}

		return hash.ToHashCode();
	}
}
