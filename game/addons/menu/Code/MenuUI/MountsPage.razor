@using MenuProject.MenuUI.Components
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.Mounting;
@using Sandbox.UI;
@using Sandbox.UI.Mounts;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@page "/mounts"
@inherits Panel

@* Deliberately not using Page's Left slot - that sidebar is a full-height scrolling slab, right
   for a long filter column but mostly empty under a fixed block of prose. This page lays out its
   own two columns so the explainer card can hug its text. *@
<root class="root">
	<Page>
		<Body>
			<div class="columns">

				<div class="aside">

					<h2><WithIcon Icon="extension" Text="#mountspage.title"></WithIcon></h2>
					<p>#mountspage.intro</p>

					<div class="block">
						<label class="section-label">#mountspage.how_it_works</label>

						<div class="step">
							<icon>shopping_cart</icon>
							<label>#mountspage.step1</label>
						</div>

						<div class="step">
							<icon>toggle_on</icon>
							<label>#mountspage.step2</label>
						</div>

						<div class="step">
							<icon>folder_open</icon>
							<label>#mountspage.step3</label>
						</div>
					</div>

					<div class="block">
						<label class="section-label">#mountspage.worth_knowing</label>

						<div class="note">
							<icon>group</icon>
							<label>#mountspage.note1</label>
						</div>

						<div class="note">
							<icon>memory</icon>
							<label>#mountspage.note2</label>
						</div>

						<div class="note">
							<icon>code</icon>
							<label>#mountspage.note3</label>
						</div>

						<label class="docs-link" onclick=@OpenDocs>#mountspage.read_more</label>
					</div>

				</div>

				<div class="list">

					@if ( !Mounts.Any() )
					{
						<div class="empty">
							<icon>extension_off</icon>
							<label class="title">#mountspage.empty_title</label>
							<label class="hint">#mountspage.empty_hint</label>
						</div>
					}

					@if ( Installed.Any() )
					{
						<div class="section-head">
							<label class="title">#mountspage.installed</label>
							<label class="count">@Language.GetPhrase( Installed.Count() == 1 ? "mountspage.installed_one" : "mountspage.installed_plural", new(){ { "count", Installed.Count() } } )</label>
						</div>

						<div class="grid">
							@foreach ( var mount in Installed )
							{
								<MountCard Mount="@mount"></MountCard>
							}
						</div>
					}

					@if ( Owned.Any() )
					{
						<div class="section-head quiet">
							<label class="title">#mountspage.in_library</label>
							<label class="count">@Language.GetPhrase( Owned.Count() == 1 ? "mountspage.install_one" : "mountspage.install_plural", new(){ { "count", Owned.Count() } } )</label>
						</div>

						<div class="grid">
							@foreach ( var mount in Owned )
							{
								<MountCard Mount="@mount"></MountCard>
							}
						</div>
					}

					@if ( Unowned.Any() )
					{
						<div class="section-head quiet">
							<label class="title">#mountspage.not_owned</label>
							<label class="count">@Language.GetPhrase( Unowned.Count() == 1 ? "mountspage.not_owned_one" : "mountspage.not_owned_plural", new(){ { "count", Unowned.Count() } } )</label>
						</div>

						<div class="grid">
							@foreach ( var mount in Unowned )
							{
								<MountCard Mount="@mount"></MountCard>
							}
						</div>
					}

				</div>

			</div>
		</Body>
	</Page>
</root>

@code
{
	const string DocsUrl = "https://sbox.game/dev/doc/game-mounts/";

	List<BaseGameMount> mounts;

	/// <summary>
	/// Every mount, cached - which mounts exist only changes when an assembly loads, and the
	/// page rebuilds its hash from this list every frame.
	/// </summary>
	List<BaseGameMount> Mounts => mounts ??= BaseGameMount.All.ToList();

	// Three rungs, because the action differs at each: toggle it, install it, buy it. Owned and
	// not installed used to sit with the unowned ones and get sent to a store page, which is a
	// dead end for a game that's already yours.
	//
	// IsOwned is a native Steam call, so these are only walked while rendering - never from
	// BuildHash, which runs every frame.
	IEnumerable<BaseGameMount> Installed => Mounts.Where( x => x.IsInstalled );
	IEnumerable<BaseGameMount> Owned => Mounts.Where( x => !x.IsInstalled && x.IsOwned );
	IEnumerable<BaseGameMount> Unowned => Mounts.Where( x => !x.IsInstalled && !x.IsOwned );

	void OpenDocs()
	{
		MenuUtility.OpenUrl( DocsUrl );
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		foreach ( var mount in Mounts )
		{
			hash.Add( mount.IsInstalled );
			hash.Add( mount.IsMounted );
		}

		return hash.ToHashCode();
	}
}
