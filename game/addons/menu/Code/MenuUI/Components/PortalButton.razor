@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;

<root class="@( IsActivePortalUser ? "active" : "" )">@Button</root>

@code
{
    [Parameter] public RenderFragment Button { get; set; }
    [Parameter] public RenderFragment Content { get; set; }
    [Parameter] public PortalTarget Portal { get; set; }
    [Parameter] public bool StartActive { get; set; }

    /// <summary>
    /// Which one it is, for whoever made a row of them to find it again.
    /// </summary>
    [Parameter] public string Name { get; set; }

    // Ours is the one showing - by who put it there, not the content, which is a new fragment each redraw
    bool IsActivePortalUser => Portal is not null && Portal.Source == this;

    protected override void OnMouseDown(MousePanelEvent e)
    {
        ActivatePage();
    }

    protected override void OnParametersSet()
    {
        if (Portal is null) return;

        // Showing already - keep what it shows up to date with the redraw
        if (IsActivePortalUser)
        {
            Portal.Content = Content;
            return;
        }

        // First, until something's been shown - not every redraw, or it'd take the page back from
        // whichever tab's been picked since
        if (StartActive && Portal.Source is null)
        {
            ActivatePage();
        }
    }

    protected override void OnAfterTreeRender(bool firstTime)
    {
        // We need to tell the portal to update when we redraw
        // because the contents of Page probably changed
        if (IsActivePortalUser)
        {
            Portal?.StateHasChanged();
        }
    }

    public void ActivatePage()
    {
        if (Portal is not null)
        {
            Portal.Source = this;
            Portal.Content = Content;
            StateHasChanged();

            Portal.StateHasChanged();
        }
    }
}
