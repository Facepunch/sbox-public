@namespace Sandbox.UI
@inherits Sandbox.UI.Panel

<root class="videopanel">

    @if (Controls)
    {
        <VideoControls VideoPlayer="@videoPlayer"></VideoControls>
    }

</root>

@code 
{
	string _source;

	public string Source 
	{ 
		get => _source; 

		set
		{
			if (_source == value) return;

			_source = value;

			videoPlayer.Play( FileSystem.Mounted, Source );
		}
	}

	public bool Repeat
	{
		set
		{
			videoPlayer.Repeat = value;
		}
	}

	public bool Controls { get; set; } = true;

	Sandbox.VideoPlayer videoPlayer;

	/// <summary>
	/// Held while the video is making noise, to turn the menu music down under it.
	/// </summary>
	IDisposable musicDuck;

	public VideoPanel()
	{
		videoPlayer = new VideoPlayer();

		// TODO: Let the user decide how audio is played
		// videoPlayer.OnAudioReady = () => videoPlayer.PlayAudio();

		Repeat = true;
		Style.AspectRatio = 16.0f / 9.0f;
	}

	protected override void OnClick(MousePanelEvent e)
	{
		base.OnClick(e);

		if ( Controls )
		{
			videoPlayer.TogglePause();
			e.StopPropagation();
		}
	}

    public override void OnDeleted()
    {
        musicDuck?.Dispose();
        musicDuck = null;

        videoPlayer?.Dispose();
        videoPlayer = null;
    }

    public override void Tick()
    {
        base.Tick();

        // Try to match the aspect ratio of the video
        if (videoPlayer.Width > 4 && videoPlayer.Height > 4)
        {
            Style.AspectRatio = (float)videoPlayer.Width / (float)videoPlayer.Height;
        }

        UpdateMusicDuck();

        videoPlayer.Present();
        var tex = videoPlayer?.Texture;
        Style.SetBackgroundImage(tex);
    }

    /// <summary>
    /// Two things talking at once is a mess, so silence the music while we're playing sound.
    /// It carries on where it left off when the video stops.
    /// </summary>
    void UpdateMusicDuck()
    {
        var wantsDuck = videoPlayer.HasAudio && !videoPlayer.Muted && !videoPlayer.IsPaused && videoPlayer.Audio.Volume > 0;

        if (wantsDuck)
        {
            musicDuck ??= Game.Music.Duck(1.0f, 0.5f);
        }
        else
        {
            musicDuck?.Dispose();
            musicDuck = null;
        }
    }

}
