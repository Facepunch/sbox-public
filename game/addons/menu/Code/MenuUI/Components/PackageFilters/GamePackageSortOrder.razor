@using System;
@using Sandbox;
@using Sandbox.UI;
@using System.Threading
@namespace MenuProject.UI

@{
    var current = Orders.FirstOrDefault(x => x.Name == Value);
}

<root>

    @foreach (var entry in Orders)
    {
        <Button Active="@(current == entry)" tooltip="@entry.Title" Icon=@entry.Icon onmousedown=@(() => SwitchTo(entry))></Button>
    }

</root>

@code
{
    /// <summary>
    /// The selected game sort order or personal favourites filter.
    /// </summary>
    public string Value { get; set; }

    /// <summary>
    /// The sorts there are, and the favourites filter - a handful, each its own glyph, so they fit a row. The Games
    /// page's and the package picker's.
    /// </summary>
    public static readonly Package.SortOrder[] Orders =
    [
        new() { Icon = "favorite", Name = "quality", Title = "#menu.games.most_loved_label" },
        new() { Icon = "today", Name = "rankday", Title = "#menu.games.popular_today_label" },
        new() { Icon = "calendar_month", Name = "rankmonth", Title = "#menu.games.popular_month" },
        new() { Icon = "trending_up", Name = "trending", Title = "#menu.games.trending" },
        new() { Icon = "new_releases", Name = "newest", Title = "#menu.games.newest" },
        new() { Icon = "schedule", Name = "updated", Title = "#menu.games.updated" },
        new() { Icon = "diamond", Name = "hiddengem", Title = "#menu.games.hidden_gems_label" },
        new() { Icon = "bookmarks", Name = "favourite", Title = "#menu.games.your_favourites_label" },
    ];

    void SwitchTo(Package.SortOrder entry)
    {
        Value = entry.Name;
        StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine(Value);

}
