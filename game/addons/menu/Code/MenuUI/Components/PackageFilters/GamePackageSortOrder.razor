@using System;
@using Sandbox;
@using Sandbox.UI;
@using System.Threading
@namespace MenuProject.UI

@{
    var current = orders.FirstOrDefault(x => x.Name == Value);
}

<root>

    @foreach (var entry in orders)
    {
        <Button Active="@(current == entry)" tooltip="@entry.Title" Icon=@entry.Icon onmousedown=@(() => SwitchTo(entry))></Button>
    }

</root>

@code
{
    /// <summary>
    /// The selected game sort order or personal favourites filter.
    /// </summary>
    public string Value { get; set; }

    List<Package.SortOrder> orders = new();

    /// <summary>
    /// Creates the available game sort and favourites options.
    /// </summary>
    public GamePackageSortOrder()
    {
        orders.Add(new Package.SortOrder { Icon = "favorite", Name = "quality", Title = "#menu.games.most_loved_label" });
        orders.Add(new Package.SortOrder { Icon = "today", Name = "rankday", Title = "#menu.games.popular_today_label" });
        orders.Add(new Package.SortOrder { Icon = "calendar_month", Name = "rankmonth", Title = "#menu.games.popular_month" });
        orders.Add(new Package.SortOrder { Icon = "trending_up", Name = "trending", Title = "#menu.games.trending" });
        orders.Add(new Package.SortOrder { Icon = "new_releases", Name = "newest", Title = "#menu.games.newest" });
        orders.Add(new Package.SortOrder { Icon = "schedule", Name = "updated", Title = "#menu.games.updated" });
        orders.Add(new Package.SortOrder { Icon = "diamond", Name = "hiddengem", Title = "#menu.games.hidden_gems_label" });
        orders.Add(new Package.SortOrder { Icon = "bookmarks", Name = "favourite", Title = "#menu.games.your_favourites_label" });
    }

    void SwitchTo(Package.SortOrder entry)
    {
        Value = entry.Name;
        StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine(Value);

}
