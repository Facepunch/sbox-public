@namespace SboxMenu
@using Sandbox;
@using Sandbox.UI;
@using SboxMenu;
@using System;
@using MenuProject.Modals.PackageModalComponents;
@inherits Panel

<root class="megacard @(Fill ? "fills-page" : "")">

    <div class="body-outer">

        @if (Tabs is not null || Metrics is not null)
        {
            <div class="tabs">
                @Tabs
                @if (Metrics is not null)
                {
                    <div class="metrics">@Metrics</div>
                }
            </div>
        }

        <div class="body">

            <div class="row @(HideLeft ? "no-left" : "")">

                <div class="content">@Content</div>

                <div class="left">

                    @if (Icon is not null)
                    {
                        <div class="icon" style="background-image: url( @Icon );"></div>
                    }

                    @Left

                </div>

            </div>

            @if (Footer is not null)
            {
                <div class="footer">@Footer</div>
            }

        </div>
    </div>

</root>

@code
{
    [Parameter] public string Icon { get; set; }
    [Parameter] public RenderFragment Left { get; set; }
    [Parameter] public RenderFragment Footer { get; set; }
    [Parameter] public RenderFragment Tabs { get; set; }
    [Parameter] public RenderFragment Metrics { get; set; }
    [Parameter] public RenderFragment Content { get; set; }

    /// <summary>
    /// Filling whatever it's in, rather than a card in the middle of the screen - the pause menu's
    /// game page, where it's a page beside the rail rather than a modal.
    /// </summary>
    [Parameter] public bool Fill { get; set; }

    /// <summary>
    /// The info column out of the way, the page taking its room - kept, just not shown, so it's
    /// straight back when it's wanted.
    /// </summary>
    [Parameter] public bool HideLeft { get; set; }

    public override void Tick()
    {
        base.Tick();

        // Centred, unless the party deck's up in the bottom right - then lifted clear of it
        SetClass( "clear-deck", !Fill && MenuProject.PartyDeck.Current is not null );
    }
}
