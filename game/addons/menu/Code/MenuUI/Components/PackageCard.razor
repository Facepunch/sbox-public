@using Sandbox;
@using Sandbox.UI;
@using System.Globalization
@namespace MenuProject.UI
@inherits Panel

<root class=@BuildClass() @onrightclick=@OnCardRightClicked onclick=@OnCardClicked>
    <div class="image" style="background-image: url(@(Image() ?? "/ui/sbox-logo-square.svg"))">
        @* Static art stays underneath while the video spins up. *@
        @if ( ShowVideo() && !string.IsNullOrEmpty( Package?.VideoThumb ) )
        {
            <div class="package-video" style="background-image: url(@VideoUrl())" />
        }

        @if ( Package != null && Package.Flair.IsEmpty == false)
        {
            <MenuProject.UI.PackageFlairBar Flair="@Package.Flair" />
        }

        @* Overlaid on the art as a pull quote - the mark is its own label so it can be set big. *@
        @if ( ShowSummary && !string.IsNullOrWhiteSpace( Package?.Summary ) )
        {
            <div class="package-summary">
                <label class="quote-mark">“</label>
                <label class="quote-text">@Package.Summary</label>
            </div>
        }
    </div>

    <column>
        <label class="medium package-title">
            @(Package?.Title ?? "Invalid Package")
        </label>

        @if (Package == null)
        {
            <row>
                <label class="eyebrow">
                    We couldn't find that package.
                </label>
            </row>
        }
        else
        {
            <row class="package-meta">
                <div class="package-stat">
                    <icon class="eyebrow">thumb_up</icon>
                    <label class="eyebrow">@VotePercentage()</label>
                </div>

                @if ( Package.Usage.UsersNow > 0 )
                {
                    <div class="package-stat live">
                        <div class="live-dot" />
                        <label class="eyebrow">@Compact( Package.Usage.UsersNow ) playing</label>
                    </div>
                }
                else
                {
                    <div class="package-stat">
                        <icon class="eyebrow">group</icon>
                        <label class="eyebrow">@Compact( Package.Usage.Total.Users )</label>
                    </div>
                }

                <div class="grow" />
            </row>
        }
    </column>
</root>

@code {
    public enum SizeType
    {
        Default,
        Small,
        Wide,
        Tall,
        List
    }

    // The CDN publishes these beside each other. VideoThumb points at thumb, a 256p 200k clip.
    // Each step up is both bigger and less compressed (low is CRF 42, medium/high are 38), so
    // Auto picks on rendered size but never drops to a tier that's soft at any size.
    public enum VideoQuality
    {
        Auto,
        Thumb,
        Low,
        Medium,
        High
    }

    // Plain statics, not [ConVar]s - only [MenuConVar] registers in the menu, and that lives in
    // Sandbox.Menu which this addon can't reference. Menu VideoThumbConVars exposes them.
    public static bool VideoThumbs { get; set; } = true;
    public static int VideoThumbsPerShelf { get; set; } = 2;
    public static int VideoThumbsPerGrid { get; set; } = 6;
    public static float VideoThumbsSeconds { get; set; } = 10f;
	const float VideoActivationDelay = 0.3f;
	bool showVideo;
	float? videoRequestedAt;

	bool WantsVideo() => HasHovered || (VideoThumbs && (Rotation is null || Rotation.IsPlaying( this )));
	bool ShowVideo() => showVideo;

	public override void Tick()
	{
		base.Tick();

		if ( !WantsVideo() )
		{
			videoRequestedAt = null;

			if ( showVideo )
			{
				showVideo = false;
				StateHasChanged();
			}

			return;
		}

		videoRequestedAt ??= RealTime.Now;

		if ( !showVideo && RealTime.Now - videoRequestedAt.Value >= VideoActivationDelay )
		{
			showVideo = true;
			StateHasChanged();
		}
	}

    string VideoUrl()
    {
        var url = Package?.VideoThumb;
        var quality = Quality == VideoQuality.Auto ? PickQuality() : Quality;

        if ( quality == VideoQuality.Thumb || string.IsNullOrEmpty( url ) )
            return url;

        var variant = quality.ToString().ToLowerInvariant();

        return url
            .Replace( "thumb.webm", $"{variant}.webm" )
            .Replace( "thumb.mp4", $"{variant}.mp4" );
    }

    // Box.Rect is in real screen pixels, so this already accounts for the root panel scaling
    // itself by screen height. Zero before first layout - assume a card, not a list row.
    VideoQuality PickQuality()
    {
        var width = Box.Rect.Width;

        if ( width <= 0 ) return VideoQuality.Medium;
        if ( width < 160 ) return VideoQuality.Low;
        if ( width < 900 ) return VideoQuality.Medium;

        return VideoQuality.High;
    }

    [Parameter] public Package Package { get; set; }
    [Parameter] public SizeType Size { get; set; }

    /// <summary>
    /// Takes turns with the other cards sharing it, so only a few play at once.
    /// </summary>
    [Parameter] public CardVideoRotation Rotation { get; set; }

    [Parameter] public VideoQuality Quality { get; set; } = VideoQuality.Auto;

    CardVideoRotation registered;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if ( registered == Rotation )
            return;

        registered?.Unregister( this );
        registered = Rotation;
        registered?.Register( this );
    }

    public override void OnDeleted()
    {
        base.OnDeleted();

        registered?.Unregister( this );
        registered = null;
    }

    /// <summary>
    /// Show the package's summary as a quote over the art. Off by default - most cards are too small for it.
    /// </summary>
    [Parameter] public bool ShowSummary { get; set; }

    /// <summary>
    /// Called when the card is clicked
    /// </summary>
    [Parameter] public Action Clicked { get; set; }

    /// <summary>
    /// Called when the card is right clicked
    /// </summary>
    [Parameter] public Action RightClicked { get; set; }

    void OnCardClicked() => Clicked?.Invoke();
    void OnCardRightClicked() => RightClicked?.Invoke();

    string BuildClass() => $"package-card {Size.ToString().ToLower()}";

    string VotePercentage()
    {
        if (Package == null) return "Unrated";
        if (Package.VotesUp == 0 && Package.VotesDown == 0) return "Unrated";
        return $"{(int)(Package.VotesUp * 100f / (Package.VotesUp + Package.VotesDown))}%";
    }

    /// <summary>Shortens large player counts - "1.2K" rather than "1204".</summary>
    static string Compact( long n )
    {
        if ( n >= 1_000_000 ) return $"{n / 1_000_000f:0.#}M";
        if ( n >= 1_000 ) return $"{n / 1_000f:0.#}K";

        return n.ToString();
    }

    string Image() => Size switch
    {
        SizeType.Tall => Package?.ThumbTall,
        SizeType.Wide => Package?.ThumbWide,
        SizeType.Small => Package?.Thumb,
        SizeType.List => Package?.Thumb,
        _ => Package?.ThumbWide
    };

    // ShowVideo mounts the video layer, so hover/convar changes have to re-render.
    protected override int BuildHash() => System.HashCode.Combine(Package?.FullIdent, Package?.Usage.UsersNow, Package?.Flair.Length, ShowVideo(), ShowSummary, VideoUrl());
}
