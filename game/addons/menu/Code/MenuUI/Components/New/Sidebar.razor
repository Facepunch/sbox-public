@using MenuProject
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using Sandbox;
@using System;
@using System.Linq;
@namespace Sandbox.UI
@inherits Panel

<root>

    @* Mid-game, the mark's place is the game you're in - a tab of its own, its icon, for its page in
       the pause menu, lit like any other entry when you're on it. Off it, out in the menu's own pages,
       it calls you back - glowing, pulsing, "Back to game" under it - so it's plain you're still in a game *@
    @if ( Game.InGame && InGamePackage is { } game )
    {
        <div class="game-tab @(OnGamePage ? "active" : "calling")" tooltip="@(OnGamePage ? game.Title : $"Back to {game.Title}")" onclick=@( () => this.Navigate( GamePageUrl ) )>
            <div class="game-icon" style="background-image: url( @game.Thumb );"></div>
            @* Always there, so going back to the game can slide it up into the icon rather than drop it *@
            <label class="back">Back to game</label>
        </div>
    }
    else
    {
        @* Double click the mark for the UI test section. Deliberately undiscoverable. *@
        <Logo />
    }

    <div class="nav">

        <Button Href="/home" Icon="home">#menu.home</Button>
        <Button Href="/games/all?Sort=trending&Filter=" Icon="sports_esports">Games</Button>
        <Button Href="/multiplayer" Icon="forum">Multiplayer</Button>
        <Button Href="/mounts" Icon="extension">Mounts</Button>
        @* Not for an account under a week old - nothing's for sale to it yet *@
        @if ( MenuHelpers.ShowMicrotransactions )
        {
            <Button Href="/itemstore" Icon="shopping_cart">#menu.store</Button>
        }

        @if ( jam is not null )
        {
            <RailButton Href="/jam" Icon="emoji_events" Text="Jam" Glow="@JamLive" Sub="@JamCountdown" />
        }
    </div>

    <div class="grow" />

    @* The two personal pages. Both carry a badge, so both are RailButtons. *@
    <div class="nav">
        @* Nothing waiting means nothing to go and look at, so the entry isn't there at all. *@
        @if ( ShowInbox )
        {
            <RailButton Href="@InboxUrl" Icon="notifications" Text="Inbox" Badge="@NotificationBadge" />
        }

        @* Not a page - it pops up beside the entry, like the friends list does off the party deck.
           Not mid-game either: opening a drop loads the unboxing scene, which would pull you out of it. *@
        @if ( !Game.InGame )
        {
            <RailButton @ref="RewardsButton" OnPress="@OpenRewards" Active="@RewardsOpen" Icon="redeem" Text="Rewards" Badge="@RewardBadge" BadgeClass="reward" Progress="@RewardProgress" />
        }

        <Button Href="/settings" Icon="settings">Settings</Button>
        @* Out of s&box - mid-game too. Leaving just the game you're in is on its page, in the pause menu *@
        <Button @onmouseup=@Quit class="quit" Icon="power_settings_new">Quit</Button>
    </div>

</root>

@code {
    const string InboxUrl = "/notifications";

    /// <summary>The game the pause menu's for, when it's up - first on the rail.</summary>
    static Package InGamePackage => MenuProject.Modals.PauseMenuModal.PauseModal.CurrentGame;

    const string GamePageUrl = MenuProject.Modals.PauseMenuModal.PauseHome.Url;

    bool OnGamePage => this.GetNavigator()?.CurrentUrl == GamePageUrl;

    // Both counts come off the backend, so they're polled rather than watched. The pages
    // themselves fetch their own copy - this only feeds the badges.
    const float PollSeconds = 60 * 5;

    static bool badgesStale;

    int notificationCount;
    RealTimeUntil timeUntilNotificationPoll = 0;

    RewardState rewardState;
    RealTimeUntil timeUntilRewardPoll = 0;

    Sandbox.Services.Jam jam;
    RealTimeUntil timeUntilJamPoll = 0;

    RailButton RewardsButton;

    /// <summary>Lit while the drop popup is up, since there's no page for it to match against.</summary>
    bool RewardsOpen => ModalSystem.Instance?.IsOpen<MenuProject.Modals.RewardsModal>() ?? false;

    void OpenRewards()
    {
        ModalSystem.Instance?.Rewards( RewardsButton );
    }

    /// <summary>
    /// Marks the badges as out of date, so the rail re-reads them on its next tick. The
    /// inbox marks notifications read as you look at them, which the rail can't see.
    /// </summary>
    public static void InvalidateBadges()
    {
        badgesStale = true;
    }

    /// <summary>
    /// The inbox is only offered when something's waiting - except while you're reading it,
    /// since opening the page marks everything read and the entry would vanish under you.
    /// </summary>
    bool ShowInbox => notificationCount > 0 || this.GetNavigator()?.CurrentUrl == InboxUrl;

    /// <summary>Unread notifications, capped so a big number can't widen the badge off the rail.</summary>
    string NotificationBadge => notificationCount switch
    {
        <= 0 => null,
        > 99 => "99+",
        _ => notificationCount.ToString()
    };

    /// <summary>A pip when there's a drop waiting - the bar covers everything short of that.</summary>
    string RewardBadge => RewardReady ? "!" : null;

    RewardWindow RewardWindow => rewardState?.Windows.FirstOrDefault();

    bool RewardReady => RewardWindow is not null && (RewardWindow.IsEligible || rewardState.Pending is not null);

    /// <summary>How far the drop has come. Null while there's nothing being tracked, so no bar.</summary>
    float? RewardProgress => RewardWindow is null ? null : (RewardReady ? 1f : RewardWindow.Progress);

    /// <summary>Lit while the jam is live - entries open, or being judged and voted on.</summary>
    bool JamLive => jam is { IsLive: true };

    /// <summary>
    /// What the jam is counting down to, short enough for the rail: the start, then the
    /// deadline, then the nomination lock, then whatever step is next. Ticks once under a day.
    /// </summary>
    string JamCountdown
    {
        get
        {
            if ( jam is null ) return null;

            var target = !jam.HasStarted ? jam.Starts
                : jam.Now < jam.Deadline ? jam.Deadline
                : jam.CommunityVoting && jam.Now < jam.NominationsEnd ? jam.NominationsEnd
                : jam.NextStep?.At;

            if ( target is not DateTimeOffset at || at <= jam.Now ) return null;

            // Clock style. Days go in front once there are any, and seconds drop off to keep it short.
            var left = at - jam.Now;
            if ( left.TotalDays >= 1 ) return $"{left.Days}d {left.Hours:00}:{left.Minutes:00}";

            return $"{left.Hours:00}:{left.Minutes:00}:{left.Seconds:00}";
        }
    }

    public override void Tick()
    {
        base.Tick();

        if ( !IsVisible )
            return;

        if ( badgesStale )
        {
            badgesStale = false;
            timeUntilNotificationPoll = 0;
            timeUntilRewardPoll = 0;
            timeUntilJamPoll = 0;
        }

        if ( timeUntilNotificationPoll <= 0 )
        {
            timeUntilNotificationPoll = PollSeconds;
            _ = UpdateNotificationCount();
        }

        if ( timeUntilRewardPoll <= 0 )
        {
            timeUntilRewardPoll = PollSeconds;
            _ = UpdateRewards();
        }

        if ( timeUntilJamPoll <= 0 )
        {
            timeUntilJamPoll = PollSeconds;
            _ = UpdateJam();
        }
    }

    async Task UpdateNotificationCount()
    {
        notificationCount = await MenuUtility.GetNotificationCount();
        StateHasChanged();
    }

    async Task UpdateRewards()
    {
        rewardState = await MenuUtility.Rewards.GetRewards();
        StateHasChanged();
    }

    async Task UpdateJam()
    {
        jam = await Sandbox.Services.Jam.GetActive();
        StateHasChanged();
    }

    /// <summary>
    /// Out to the desktop - it asks first.
    /// </summary>
    void Quit()
    {
        ModalSystem.Instance?.Open( new MenuProject.Modals.QuestionModal
        {
            Color = Color.Parse( "#ff5d6a" ) ?? Color.Red,
            Title = "Quit to Desktop?",
            Message = "Are you sure you want to close s&box?",
            ConfirmText = "Quit to Desktop",
            ConfirmIcon = "power_settings_new",
            OnConfirm = () => ConsoleSystem.Run( "quit" )
        } );
    }

    protected override int BuildHash() => HashCode.Combine( ShowInbox, NotificationBadge, RewardBadge, RewardProgress, RewardsOpen, jam?.Ident, JamLive, HashCode.Combine( JamCountdown, Game.InGame, InGamePackage, OnGamePage, MenuHelpers.ShowMicrotransactions ) );
}
