@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox.UI
@inherits Panel

<root class="clicky" onclick=@OpenNewsUrl>

    @* The art is the card - copy sits on it, nothing above it. *@
    <div class="hero" style="@HeroStyle" />

    <div class="news-overlay">
        <label class="news-when">@NewsWhen</label>
        <label class="news-title">@NewsTitle</label>
    </div>

</root>

@code {
    public string NewsTitle { get; set; } = "Loading...";
    public string NewsWhen { get; set; } = "";
    public string NewsUrl { get; set; } = "#";
    public string NewsImage { get; set; }

    string HeroStyle => string.IsNullOrEmpty( NewsImage ) ? null : $"background-image: url({NewsImage})";

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( !firstTime )
            return;

        _ = GetLatestNews();
    }

    public async Task GetLatestNews()
    {
        var p = await Package.Fetch( "facepunch/news", false );
        if ( p is null ) return;

        var news = p.LatestNewsPost;

        NewsTitle = news.Title;
        NewsWhen = news.Created.LocalDateTime.ToRelativeTimeString();
        NewsImage = news.Media;
        NewsUrl = news.Url;

        StateHasChanged();
    }

    private void OpenNewsUrl()
    {
        MenuUtility.OpenUrl( $"https://sbox.game{NewsUrl}" );
    }

    protected override int BuildHash() => System.HashCode.Combine( NewsTitle, NewsWhen, NewsImage );
}
