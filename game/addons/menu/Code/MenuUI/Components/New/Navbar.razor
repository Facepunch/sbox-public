@using MenuProject
@using MenuProject.MenuUI.Components.Notifications
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using Sandbox;
@using System;
@namespace Sandbox.UI
@inherits Panel

<root class="@ComputedClass">
    <div class="inner">

        <div class="links">
            <Logo Href="/home" />

            <separator class="vertical" />

            @*
            <Button Href="/hub" Icon="hub">#menu.hub</Button>
            *@

            <Button Tooltip="#tooltip.menu.find_games" Href="/games/dash" Icon="diamond">#menu.discover</Button>
            <Button Href="/games" Icon="sports_esports">#menu.games</Button>
            <Button Href="/maps/all" Icon="map">#menu.maps</Button>
            <Button Href="/multiplayer" Icon="view_list">#menu.multiplayer</Button>
        </div>
        
        <div class="right">
            <Button @onmouseup=@OpenAvatarScene Icon="emoji_people">#menu.avatar</Button>

            <span class="store-wrapper">
                <FeaturedStoreItem />
                <Button Href="/itemstore" class="unread" Icon="store">#menu.store</Button>
            </span>

            <separator class="vertical" />

            <NotificationButton Tooltip="#tooltip.menu.notifications" />
            <Button Tooltip="#tooltip.menu.favourited_games" Href="/games/group?Query=type:game sort:favourite&title=Favourite Games&Icon=💖" icon="favorite"></Button>
			<Sandbox.UI.Mounts.MountButton Tooltip="#tooltip.menu.mounted_games" />
			<Button @onmouseup=@Settings Tooltip="#tooltip.menu.settings" Icon="settings"/>

			<Button onmouseup="@Quit" class="close" Tooltip="#tooltip.menu.quit" Icon="power_settings_new" />
        </div>

    </div>

    <MainSearchBar />
</root>

@code {
    public string ComputedClass => (this.GetNavigator()?.CurrentUrlMatches("/home") ?? false) ? "clear" : "";

    void Settings()
    {
        Game.Overlay.ShowSettingsModal();
    }

    void Quit()
    {
        ConsoleSystem.Run("quit");
    }

    void OpenAvatarScene()
    {
        var options = new SceneLoadOptions();
        options.ShowLoadingScreen = false;
        options.SetScene("/scenes/avatar.scene");

        Game.ActiveScene.Load(options);
    }

    protected override int BuildHash() => HashCode.Combine(ComputedClass);
}
