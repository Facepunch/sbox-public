@inherits Sandbox.UI.Panel
@using Sandbox;
@using Sandbox.UI;
@namespace Menu

@if (package == null)
	return;

<ListCard Title=@package.Title Image=@package.Thumb>
    <Bottom>
        <label class="eyebrow">@Lobby.Name</label>

        <div class="grow" />

        <badge>
            <icon class="eyebrow">person</icon>
            <label class="eyebrow">@($"{Lobby.Members} / {Lobby.MaxMembers}")</label>
        </badge>
    </Bottom>
</ListCard>

@code
{
	[Parameter]
	public Sandbox.Network.LobbyInformation Lobby { get; set; }

	Package package;

	override protected async Task OnParametersSetAsync()
	{
		Style.Display = DisplayMode.None;
		package = await Package.Fetch(Lobby.Game, true);

		Style.Display = DisplayMode.Flex;
		StateHasChanged();
	}

	protected override void OnClick( MousePanelEvent e )
	{
		Networking.Connect(Lobby.LobbyId);
	}

	protected override void OnRightClick(MousePanelEvent e)
	{
		OpenContextMenu();
	}

	void OpenContextMenu()
	{
		var menu = MenuPanel.Open(this);

		menu.AddOption("play_arrow", "#menu.lobby.joingame", () => Networking.Connect(Lobby.LobbyId) );

		menu.AddSpacer();
		menu.AddOption("info", "#menu.lobby.viewgame", () => Game.Overlay.ShowGameModal(package.FullIdent));
		menu.AddOption("corporate_fare", "#menu.lobby.viewcreator", () => Game.Overlay.ShowOrganizationModal(package.Org));
		menu.AddOption("star", "#menu.lobby.rategame", () => Game.Overlay.ShowReviewModal(package));
	}
}
