@namespace MenuProject.Modals.PackageModalComponents
@inherits Panel
@using Sandbox;
@using Sandbox.UI;

<root>
    @Content
</root>

@code
{
    RenderFragment _content;

    public RenderFragment Content 
    {
        get => _content;
        set
        {
            if (_content == value) return;

            _content = value;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The tab that put what's showing here - which one's open, where the content itself is a new
    /// fragment each redraw and can't be compared.
    /// </summary>
    public PortalButton Source { get; set; }
}
