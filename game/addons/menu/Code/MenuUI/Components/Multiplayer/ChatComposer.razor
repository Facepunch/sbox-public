@namespace MenuProject.MenuUI.Components.Multiplayer
@using Sandbox;
@using Chat = MenuProject.Multiplayer.GlobalChatService;
@inherits Panel

<root>
	<div class="chat-composer">
		<TextEntry @ref="input" Value:bind=@Chat.Draft MaxLength=@(400) Placeholder="#menu.multiplayer.say_hello" onsubmit=@Submit />
		<Button Icon="send" disabled=@(!Chat.CanSend) onclick=@Submit tooltip="#menu.multiplayer.send_message" />
	</div>
	<div class="chat-actions">
		@if ( PartyRoom.Current is not null )
		{
			<label>@PartyRoom.Current.MemberCount in your party</label>
			@if ( PartyRoom.Current.Owner.IsMe )
			{
				<Button Icon="campaign" disabled=@(!Chat.CanInviteParty) onclick=@Chat.InviteParty tooltip="#menu.multiplayer.post_an_invitation_so_anyone_in_global_chat_can_join">#menu.multiplayer.post_party_invite</Button>
			}
		}
	</div>
</root>
