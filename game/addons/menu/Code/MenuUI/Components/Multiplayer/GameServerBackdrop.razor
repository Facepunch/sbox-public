@using Sandbox;

<root style="@(string.IsNullOrEmpty( background ) ? "" : $"background-image: url( '{background}' );")">
	<div class="art-shade" />
</root>

@code
{
	/// <summary>
	/// Selected game whose screenshot should appear behind the server browser.
	/// </summary>
	[Parameter] public string GameIdent { get; set; }

	string loadedIdent;
	string background;

	protected override async Task OnParametersSetAsync()
	{
		if ( loadedIdent == GameIdent ) return;

		loadedIdent = GameIdent;
		background = null;

		if ( string.IsNullOrEmpty( GameIdent ) || !GameIdent.Contains( '.' ) || GameIdent.StartsWith( "local." ) ) return;

		var ident = GameIdent;
		// Full package details include screenshots; the list's partial fetch does not.
		var package = await Package.FetchAsync( ident, false );

		if ( IsValid && !IsDeleting && ident == GameIdent && (package?.Public ?? false) )
		{
			background = PackageArt.Background( package );
		}
	}

	protected override int BuildHash() => System.HashCode.Combine( GameIdent, background );
}
