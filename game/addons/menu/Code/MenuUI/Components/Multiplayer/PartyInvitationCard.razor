@namespace MenuProject.MenuUI.Components.Multiplayer
@inherits Panel

<root>
	<div class="invitation-summary">
		<label class="invitation-name">@(Invitation?.Name ?? "#menu.party.party_invitation")</label>
		<label class="invitation-details">@(string.IsNullOrWhiteSpace( Invitation?.GameTitle ) ? "#menu.party.deciding_together" : Invitation.GameTitle)</label>
		@if ( Invitation is { Available: true } invitation )
		{
			<label class="invitation-details">@($"{invitation.Members}/{invitation.Capacity} players · {(invitation.IsFull ? "Party full" : invitation.IsPlaying ? "In game" : "Looking for players")}")</label>
		}
		else
		{
			<label class="invitation-details">@(Invitation is null ? "#menu.party.checking_party" : "#menu.party.party_unavailable_ended_or_could_not_be_reached")</label>
		}
	</div>
	<Button class="primary" disabled=@JoinDisabled onclick=@Join tooltip=@JoinTooltip>@(IsCurrentParty ? "#menu.party.your_party" : "#menu.party.join_party")</Button>
</root>
