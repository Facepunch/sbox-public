@using System;
@using System.Linq;
@using System.Threading;
@using Sandbox;
@using Sandbox.UI;
@using MenuProject;
@using MenuProject.MenuUI.Front;
@inherits Popup
@namespace MenuProject.MenuUI.Popups

@*
    What you get clicking a person anywhere in the menu - who they are, what they're up to, and what
    you can do about it: the likely thing up front, the rest underneath.
*@
<root>
	<div class="hero">
		@* The game they're in, faded in behind their citizen - like the party card does. A blueprint if
		   they're in the editor making one. *@
		@if ( Friend.IsPlayingThisGame && InEditor )
		{
			<div class="editor-art"></div>
		}
		else if ( PlayingNow && !string.IsNullOrWhiteSpace( GameArt ) )
		{
			<div class="game-art" style="background-image: url( @GameArt );"></div>
		}
		else if ( !PlayingNow )
		{
			@* Not in anything right now - the same scene your own card has *@
			<div class="backdrop"></div>
		}

		@* Already stood in their pose - watching them strike it every time the card opens looks odd.
		   Framed tighter than the front page's, on their head - head and shoulders, in the same place in
		   the card however tall they are. *@
		<CitizenPreview AvatarJson="@AvatarJson" PlayIntro="@false" FieldOfView="@(22f)" CameraDistance="@(120f)" CameraHeight="@(57f)" HeadOffset="@(-9f)" Yaw="@(-30f)" />

		<div class="who">
			<div class="avatar" style="background-image: url( avatar:@Friend.Id )"></div>
			<label class="display-name">@Friend.Name</label>
			<div class="state @StateClass">
				<div class="dot"></div>
				<label>@StateText</label>
			</div>
		</div>
	</div>

	@* The same box as yours on the front page - hides itself if their profile's private *@
	<ProfileStats @ref="Stats" SteamId="@((long)Friend.Id)" />

	@if ( PlayingNow )
	{
		<div class="playing">
			<label class="section-label">Playing now</label>
			<div class="game @(HasGamePage ? "clickable" : "")" onmousedown=@OpenGame>
				<div class="thumb" style="background-image: url( @GameThumb );"></div>
				<div class="game-info">
					<label class="game-title">@GameTitle</label>
					<label class="game-detail">@GameDetail</label>
				</div>
			</div>

			@if ( FriendsHere.Count > 0 )
			{
				<div class="friends-here">
					<div class="faces">
						@foreach ( var other in FriendsHere.Take( 3 ) )
						{
							<div class="face" tooltip="@other.Name" style="background-image: url( avatar:@other.Id )"></div>
						}
					</div>
					<label>@(FriendsHere.Count == 1 ? "1 other friend playing" : $"{FriendsHere.Count} other friends playing")</label>
				</div>
			}
		</div>
	}
	else if ( !_profileLoaded )
	{
		@* Still finding out what they were last in - hold the space for it *@
		<div class="playing loading">
			<label class="section-label quiet">Recently played</label>
			<div class="game">
				<div class="thumb skeleton"></div>
				<div class="game-info">
					<div class="skeleton line title"></div>
					<div class="skeleton line meta"></div>
				</div>
			</div>
		</div>
	}
	else if ( RecentGame is { } recent )
	{
		@* Not in anything right now - what they were last in *@
		<div class="playing">
			<label class="section-label quiet">Recently played</label>
			<div class="game clickable" onmousedown=@( () => OpenPackage( recent.Package ) )>
				<div class="thumb" style="background-image: url( @recent.Package.Thumb );"></div>
				<div class="game-info">
					<label class="game-title">@recent.Package.Title</label>
					<div class="game-meta">
						@foreach ( var part in MetaParts( recent ) )
						{
							<div class="meta-part"><icon>@part.Icon</icon><label>@part.Text</label></div>
						}
					</div>
				</div>
			</div>
		</div>
	}


	@{ var extras = Extras(); }

	<div class="actions">
		<div class="action-row">
			@if ( CanJoin )
			{
				<div class="button primary" onmousedown=@Join><icon>sports_esports</icon><label>Join game</label></div>
			}
			else if ( IsMe )
			{
				@* Nothing to do to yourself but look *@
			}
			else if ( CanInviteToGame )
			{
				@* Mid-game, into the game you're in - before the party, that's what you're here for *@
				@if ( _gameInvited )
				{
					<div class="button done"><icon>check</icon><label>Game invite sent</label></div>
				}
				else
				{
					<div class="button primary" onmousedown=@InviteToGame><icon>sports_esports</icon><label>Invite to game</label></div>
				}
			}
			else if ( InMyParty )
			{
				<div class="button done"><icon>check</icon><label>In your party</label></div>
			}
			else if ( Invited )
			{
				<div class="button done"><icon>check</icon><label>Invite sent</label></div>
			}
			else if ( MenuUtility.CanInviteToParty( Friend ) )
			{
				<div class="button primary" onmousedown=@Invite><icon>group_add</icon><label>Invite to party</label></div>
			}

			<div class="button" onmousedown=@ViewProfile><label>View profile</label><icon>open_in_new</icon></div>

			@* Sharing the row when it's got room for them *@
			@if ( !SplitRows )
			{
				@foreach ( var extra in extras )
				{
					<div class="button @(extra.Danger ? "danger" : "")" tooltip=@extra.Tooltip onmousedown=@extra.Click><icon>@extra.Icon</icon><label>@extra.Label</label></div>
				}
			}
		</div>

		@* The less common stuff underneath, when there's too much for one row *@
		@if ( SplitRows )
		{
			<div class="action-row secondary">
				@foreach ( var extra in extras )
				{
					<div class="button @(extra.Danger ? "danger" : "")" tooltip=@extra.Tooltip onmousedown=@extra.Click><icon>@extra.Icon</icon><label>@extra.Label</label></div>
				}
			</div>
		}
	</div>
</root>

@code
{
	public Friend Friend { get; set; }

	/// <summary>
	/// Open the user menu from a clicked name or avatar, replacing any existing popup.
	/// </summary>
	public static void ShowFromClick( PanelEvent e, Friend friend )
	{
		e.StopPropagation();
		Popup.CloseAll();
		Show( e.This, friend, PositionMode.AboveCenter, 8 );
	}

	/// <summary>
	/// Open a card for this person beside <paramref name="source"/>.
	/// </summary>
	public static FriendCard Show( Panel source, Friend friend, PositionMode mode = PositionMode.Left, float offset = 18 )
	{
		var card = new FriendCard { Friend = friend };
		card.SetPositioning( source, mode, offset );

		return card;
	}

	/// <summary>
	/// Keep avatar cards on screen, flipping below the avatar when there isn't room above it.
	/// Use the measured size so loading profile details can't push the card outside the viewport.
	/// </summary>
	public override void OnLayout( ref Rect layoutRect )
	{
		if ( Position != PositionMode.AboveCenter || !PopupSource.IsValid() )
		{
			base.OnLayout( ref layoutRect );
			return;
		}

		var bounds = FindRootPanel().Box.Rect;
		var anchor = PopupSource.Box.Rect;
		var margin = 12 * ScaleToScreen;
		var gap = PopupSourceOffset * PopupSource.ScaleToScreen;
		var above = anchor.Top - bounds.Top - margin - gap;
		var below = bounds.Bottom - margin - anchor.Bottom - gap;
		var top = above < layoutRect.Height && below > above
			? anchor.Bottom + gap
			: anchor.Top - gap - layoutRect.Height;

		layoutRect.Position = new Vector2(
			Math.Clamp( anchor.Center.x - layoutRect.Width * 0.5f, bounds.Left + margin,
				Math.Max( bounds.Left + margin, bounds.Right - margin - layoutRect.Width ) ),
			Math.Clamp( top, bounds.Top + margin,
				Math.Max( bounds.Top + margin, bounds.Bottom - margin - layoutRect.Height ) ) );
	}

	//
	// How they're dressed - private profiles don't share it. Their numbers are ProfileStats' job.
	//

	string AvatarJson;

	//
	// What they've been playing, for when they're not playing anything now
	//

	Sandbox.Services.Players.Overview.PlayedGame _recent;

	/// <summary>
	/// The last thing they played - only worth showing when they're not in something right now.
	/// </summary>
	Sandbox.Services.Players.Overview.PlayedGame RecentGame => PlayingNow || _recent?.Package is null ? null : _recent;

	record MetaPart( string Icon, string Text );

	/// <summary>
	/// Hours in it, achievements unlocked, when they last played - whichever we know, as small as it goes.
	/// </summary>
	static List<MetaPart> MetaParts( Sandbox.Services.Players.Overview.PlayedGame game )
	{
		var parts = new List<MetaPart>();

		if ( game.SecondsPlayed > 0 )
			parts.Add( new MetaPart( "schedule", TimePlayed( game.SecondsPlayed ) ) );

		if ( game.Achievements > 0 )
			parts.Add( new MetaPart( "emoji_events", game.Achievements.ToString( "N0" ) ) );

		if ( game.LastPlayed != default )
			parts.Add( new MetaPart( "history", Ago( game.LastPlayed ) ) );

		return parts;
	}

	/// <summary>
	/// "34h", "45m" - hours once there are any.
	/// </summary>
	static string TimePlayed( long seconds )
	{
		var span = TimeSpan.FromSeconds( seconds );
		if ( span.TotalHours >= 1 ) return $"{(int)span.TotalHours:N0}h";
		return $"{Math.Max( 1, (int)span.TotalMinutes )}m";
	}

	/// <summary>
	/// "just now", "5m ago", "3h ago", "2d ago", "3w ago", then the date.
	/// </summary>
	static string Ago( DateTimeOffset when )
	{
		var span = DateTimeOffset.UtcNow - when;

		if ( span.TotalMinutes < 1 ) return "just now";
		if ( span.TotalHours < 1 ) return $"{(int)span.TotalMinutes}m ago";
		if ( span.TotalDays < 1 ) return $"{(int)span.TotalHours}h ago";
		if ( span.TotalDays < 7 ) return $"{(int)span.TotalDays}d ago";
		if ( span.TotalDays < 60 ) return $"{(int)(span.TotalDays / 7)}w ago";
		return when.ToLocalTime().ToString( "d MMM yyyy" );
	}

	void OpenPackage( Package package )
	{
		Discovery.Clicked( new DiscoveryContext { Surface = "friendcard" }, package );
		package?.OpenModal();
		Delete();
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( !firstTime ) return;

		_ = LoadProfile();
		_ = LoadGame();
	}

	/// <summary>
	/// Heard back about their profile - got it, it's private, or it failed. The placeholders go either way.
	/// </summary>
	bool _profileLoaded;

	ProfileStats Stats;

	/// <summary>
	/// Stops waiting on their overview - when the stats box has already found out their profile's private
	/// (the request for it can hang rather than fail), when the card closes, or when it's taking too long.
	/// </summary>
	CancellationTokenSource _profileCancel;

	/// <summary>
	/// Longest we'll show placeholders for before giving up on it.
	/// </summary>
	const float ProfileTimeout = 8f;

	/// <summary>
	/// Constrain avatar cards to the viewport and stop loading profiles known to be private.
	/// </summary>
	public override void Tick()
	{
		base.Tick();

		if ( Position == PositionMode.AboveCenter )
		{
			var size = FindRootPanel().Box.Rect.Size * ScaleFromScreen;
			Style.MaxWidth = Math.Max( 0, size.x - 24 );
			Style.MaxHeight = Math.Max( 0, size.y - 24 );
		}

		// The stats box asks about the same player and knows first when nothing's coming - no point
		// waiting on our own request to find out the hard way
		if ( !_profileLoaded && Stats.IsValid() && Stats.NothingComing )
			_profileCancel?.Cancel();
	}

	public override void OnDeleted()
	{
		_profileCancel?.Cancel();
		base.OnDeleted();
	}

	async Task LoadProfile()
	{
		_profileCancel = new CancellationTokenSource();
		_profileCancel.CancelAfter( TimeSpan.FromSeconds( ProfileTimeout ) );

		try
		{
			var request = Sandbox.Services.Players.Overview.Get( Friend.Id );

			// Giving up only stops us waiting - the request carries on, and when it fails (a 404 for a private
			// profile) someone has to look at that, or it's reported as unobserved
			_ = request.ContinueWith( t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted | TaskContinuationOptions.ExecuteSynchronously );

			var overview = await request.WaitAsync( _profileCancel.Token );
			if ( !this.IsValid() || overview is null ) return;

			AvatarJson = overview.AvatarJson;

			// What they played last - with the details if the backend has them, just the game if not
			_recent = overview.RecentlyPlayed.FirstOrDefault()
				?? (overview.LatestPlayed is { } latest ? new Sandbox.Services.Players.Overview.PlayedGame { Package = latest } : null);

		}
		catch ( Exception )
		{
			// Private, offline, taking too long, or the card closed - it still works without it
		}
		finally
		{
			_profileLoaded = true;

			if ( this.IsValid() )
				StateHasChanged();
		}
	}

	//
	// What they're doing
	//

	bool IsMe => Friend.IsMe;

	string GameIdent => Friend.GetRichPresence( "gamename" );

	bool InEditor => Friend.GetRichPresence( "in_editor" ) == "1";

	bool InMenu
	{
		get
		{
			var title = Friend.GetRichPresence( "gametitle" );
			return string.IsNullOrWhiteSpace( title ) || title == "menu";
		}
	}

	bool PlayingNow => Friend.IsPlayingThisGame && !InMenu && !InEditor;

	bool Joinable => !string.IsNullOrWhiteSpace( Friend.GetRichPresence( "connect" ) );

	bool CanJoin => !IsMe && PlayingNow && Joinable && MenuHelpers.HasAuthority;

	// Through PartyView, so the party mocks look the same here as on the deck and the friends list
	bool InMyParty => PartyView.Exists && PartyView.Members.Any( x => x.Id == Friend.Id );

	/// <summary>
	/// We lead the party they're in, so we can hand it over or kick them.
	/// </summary>
	bool CanManage => !IsMe && InMyParty && PartyView.OwnerIsMe;

	record ExtraAction( string Icon, string Label, Action Click, bool Danger = false, string Tooltip = null );

	/// <summary>
	/// The less common buttons - add friend, make leader, kick, leave.
	/// </summary>
	List<ExtraAction> Extras()
	{
		var extras = new List<ExtraAction>();

		if ( !IsMe && !Friend.IsFriend ) extras.Add( new( "person_add", "Add friend", AddFriend ) );

		if ( CanManage )
		{
			extras.Add( new( "shield", "Promote", MakeLeader, Tooltip: "Make leader of party" ) );
			extras.Add( new( "person_remove", "Kick", Kick, true ) );
		}

		if ( IsMe && PartyView.Exists ) extras.Add( new( "logout", "Leave party", LeaveParty, true ) );

		return extras;
	}

	int MainCount => 1 + (CanJoin || (!IsMe && (CanInviteToGame || InMyParty || Invited || MenuUtility.CanInviteToParty( Friend ))) ? 1 : 0);

	/// <summary>
	/// Two buttons fit a row with their labels - past that, the extras get a row of their own.
	/// </summary>
	bool SplitRows => MainCount + Extras().Count > 2;

	string StateText
	{
		get
		{
			if ( IsMe ) return "That's you";

			if ( Friend.IsPlayingThisGame )
			{
				if ( InEditor ) return "In the editor";
				if ( InMenu ) return "In main menu";
				return "In game";
			}

			if ( !Friend.IsOnline ) return "Offline";
			if ( Friend.IsPlayingAGame ) return "Playing another game";
			if ( Friend.IsAway || Friend.IsSnoozing ) return "Away";
			if ( Friend.IsBusy ) return "Busy";
			return "Online";
		}
	}

	string StateClass
	{
		get
		{
			if ( IsMe || Friend.IsPlayingThisGame ) return "ingame";
			if ( !Friend.IsOnline ) return "offline";
			if ( Friend.IsAway || Friend.IsBusy || Friend.IsSnoozing ) return "away";
			return "online";
		}
	}

	string GameThumb;
	string GameTitle;
	string GameArt;
	bool HasGamePage => !string.IsNullOrWhiteSpace( GameIdent );

	string GameDetail
	{
		get
		{
			var map = Friend.GetRichPresence( "map" );
			var size = Friend.GetRichPresence( "steam_player_group_size" ).ToInt( 0 );
			var players = size > 1 ? $"{size} players" : null;

			var parts = new[] { string.IsNullOrWhiteSpace( map ) ? null : map, players, Joinable ? "Joinable" : null }
				.Where( x => x is not null );

			var detail = string.Join( " · ", parts );
			return string.IsNullOrWhiteSpace( detail ) ? "Playing" : detail;
		}
	}

	async Task LoadGame()
	{
		GameTitle = Friend.GetRichPresence( "gametitle" );
		if ( !PlayingNow || !HasGamePage ) return;

		try
		{
			// Full details, not partial - the screenshots only come with those
			var package = await Package.FetchAsync( GameIdent, false );
			if ( !this.IsValid() || package is null ) return;

			GameThumb = package.Thumb;
			GameTitle = package.Title;
			GameArt = PackageArt.Background( package );
			StateHasChanged();
		}
		catch ( Exception )
		{
			// Keep the title from their rich presence
		}
	}

	/// <summary>
	/// Your other friends in the same game - same server if we can tell, otherwise the same game.
	/// </summary>
	List<Friend> FriendsHere
	{
		get
		{
			if ( !PlayingNow ) return new();

			var connect = Friend.GetRichPresence( "connect" );
			var ident = GameIdent;

			return MenuUtility.Friends
				.Where( x => !x.IsMe && x.Id != Friend.Id && x.IsPlayingThisGame )
				.Where( x => !string.IsNullOrWhiteSpace( connect )
					? x.GetRichPresence( "connect" ) == connect
					: x.GetRichPresence( "gamename" ) == ident )
				.ToList();
		}
	}

	//
	// What you can do about it
	//

	// Waiting on an invite we sent them - the same as the deck and the friends list show
	bool Invited => PartyInvites.IsPending( Friend.Id );

	void Join()
	{
		if ( !CanJoin ) return;

		MenuUtility.JoinFriendGame( Friend );
		Delete();
	}

	/// <summary>
	/// In a game others can join - one with a way in for them (its connect presence) - and this isn't you.
	/// </summary>
	bool CanInviteToGame => !IsMe && Game.InGame && !string.IsNullOrWhiteSpace( new Friend( Game.SteamId ).GetRichPresence( "connect" ) );

	bool _gameInvited;

	/// <summary>
	/// Into the game you're in - a Steam invite, with its way in.
	/// </summary>
	void InviteToGame()
	{
		if ( !CanInviteToGame ) return;

		_gameInvited = MenuUtility.InviteFriendGame( Friend );
		StateHasChanged();
	}

	async Task Invite()
	{
		// Makes the party if there isn't one, and doesn't send anything real while it's mocked
		await PartyInvites.Invite( Friend.Id );
		StateHasChanged();
	}

	/// <summary>
	/// Their Steam profile - this card's their s&box one.
	/// </summary>
	void ViewProfile()
	{
		Friend.OpenInOverlay();
		Delete();
	}

	void AddFriend()
	{
		Friend.OpenAddFriendOverlay();
		Delete();
	}

	void MakeLeader()
	{
		if ( PartyView.IsMocking ) Log.Info( $"party mock: would make {Friend.Name} leader" );
		else PartyRoom.Current?.SetOwner( Friend.Id );

		Delete();
	}

	void Kick()
	{
		if ( PartyView.IsMocking ) Log.Info( $"party mock: would kick {Friend.Name}" );
		else PartyRoom.Current?.Kick( Friend.Id );

		Delete();
	}

	void LeaveParty()
	{
		PartyView.Leave();
		Delete();
	}

	async void OpenGame()
	{
		if ( !HasGamePage ) return;

		if ( !Package.TryGetCached( GameIdent, out var package ) )
			package = await Package.Fetch( GameIdent, false );

		Discovery.Clicked( new DiscoveryContext { Surface = "friendcard" }, package );
		package?.OpenModal();
		Delete();
	}

	protected override int BuildHash() => HashCode.Combine( Friend, AvatarJson, GameThumb, HashCode.Combine( GameTitle, GameArt, _recent, _profileLoaded ), Invited, InMyParty, HashCode.Combine( StateText, CanManage, CanInviteToGame, _gameInvited ) );
}
