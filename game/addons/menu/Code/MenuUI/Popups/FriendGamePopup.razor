@using System;
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

@if (Package is not null )
{
    <root class="clicky" onmousedown="@( () => Package.OpenModal() )">
        <label>@Language.GetPhrase( "friendgamepopup.playing", new() { { "title", Package.Title } } )</label>
    </root>
}
else
{
    <root>
        <label>@Language.GetPhrase( "friendgamepopup.playing", new() { { "title", Package.Title } } )</label>
    </root>
}

@code
{
    public string Ident { get; set; }
    public string Title { get; set; }

    Package Package;

    protected override async Task OnParametersSetAsync()
    {
        Package = await Package.FetchAsync( Ident, true );
    }
}
