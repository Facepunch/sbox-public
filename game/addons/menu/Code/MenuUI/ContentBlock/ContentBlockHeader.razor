@using Sandbox;
@using Sandbox.UI;
@using MenuProject.UI;
@inherits Panel

<root class="content-block-header @( IsJam ? "jam" : "" )">
    <row>
        @if ( HasQuery )
        {
            <a href=@url>
                <label class="heading icon">@Icon</label>
                <label class="heading">@Group.Title</label>
                <label class="heading icon chevron">chevron_right</label>
            </a>
        }
        else
        {
            @* No link, so no chevron either. *@
            <label class="heading icon">@Icon</label>
            <label class="heading">@Group.Title</label>
        }
    </row>
</root>

@code
{
    [Parameter]
    public Package.ListResult.Grouping Group { get; set; }

    // No query means the link would land on an unrelated list.
    bool HasQuery => !string.IsNullOrEmpty( Group?.QueryString );

    bool IsJam => MenuHelpers.IsJamQuery( Group?.QueryString );

    string Icon => IsJam ? "emoji_events" : Group.Icon;

    string url => IsJam ? "/jam" : $"/games/group?Query={Group.QueryString}&title={Group.Title}&icon={Group.Icon}";

    protected override int BuildHash() => System.HashCode.Combine( Group?.Title, Group?.Icon, HasQuery, IsJam );
}
