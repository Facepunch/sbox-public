@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<root class="@RootClass" style="border-color: @( CountInCart > 0 ? Item.RarityColor : Item.RarityColorAlpha( 0.25f ) )">

    <div class="art-wrap" style="background-image: @Item.RarityWash( 0.4f )">
        <div class="art" style="background-image: url( @Item.BestIconUrl )"></div>

        <div class="tags">
            @if ( Item.LeavingText is string leaving )
            {
                <label class="tag leaving @( Item.IsLeavingSoon ? "soon" : "" )">@leaving</label>
            }
            @if ( Item.IsOnSale )
            {
                <label class="tag sale">-@(Item.DiscountPercent)%</label>
            }
        </div>

        @if ( Owned > 0 )
        {
            <label class="owned-pill">@( Owned > 1 ? $"Own {Owned}" : "Owned" )</label>
        }
    </div>

    <div class="body">
        <label class="name">@Item.Name</label>
        <label class="rarity" style="color: @Item.RarityColor">@RarityLine</label>

        <div class="buy">
            <div class="price">
                <label class="now">@Item.Price</label>
                @if ( Item.IsOnSale )
                {
                    <label class="was">was @Item.BasePrice</label>
                }
            </div>

            @if ( CountInCart > 0 )
            {
                <div class="adder">
                    <div class="step" @onclick="@RemoveFromCart"><icon>remove</icon></div>
                    <TextEntry class="count" Numeric="@true" NumberFormat="0" MinValue="@(0f)" MaxValue="@((float)ShoppingCart.MaxPerItem)"
                               Value="@CountInCart.ToString()" OnTextEdited="@OnCountEdited" onblur="@( ( PanelEvent e ) => OnCountBlur( e ) )" tooltip="Type how many you want"></TextEntry>
                    <div class="step" @onclick="@AddToCart"><icon>add</icon></div>
                </div>
            }
            else
            {
                <div class="add" @onclick="@AddToCart">
                    <icon>add_shopping_cart</icon>
                    <label>Add</label>
                </div>
            }
        </div>
    </div>

</root>

@code
{
    public Sandbox.Services.Inventory.ItemDefinition Item { get; set; }
    public ShoppingCart Cart { get; set; }

    void AddToCart() => Cart.AddToCart( Item );
    void RemoveFromCart() => Cart.RemoveFromCart( Item );

    // Typed counts apply as you type, but an empty or zero box waits until you click away -
    // otherwise backspacing to retype would drop the item and swap the stepper for "Add".
    void OnCountEdited( string text )
    {
        if ( int.TryParse( text, out var n ) && n >= 1 )
            Cart.SetCount( Item, n );
    }

    void OnCountBlur( PanelEvent e )
    {
        if ( e.This is not TextEntry entry ) return;

        if ( !int.TryParse( entry.Value, out var n ) || n < 1 )
            Cart.RemoveAllFromCart( Item );
    }

    int CountInCart => Cart.Count( Item );
    int Owned => Sandbox.Services.Inventory.Items.Count( x => x.DefinitionId == Item.Id );

    string RootClass => (CountInCart > 0 ? "in-cart " : "") + (Owned > 0 ? "owned " : "") + (Item.IsOnSale ? "on-sale" : "");

    string RarityLine => Item.RarityGrade == ItemRarity.None
        ? Item.CategoryLabel
        : $"{Item.RarityGrade} · {Item.CategoryLabel}";

    protected override int BuildHash() => HashCode.Combine( Item.Id, CountInCart, Owned );
}
