@using MenuProject.MenuUI.Components
@using MenuProject.MenuUI.Components.Notifications
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System;
@using System.Collections.Generic;
@using System.Linq;

@page "/notifications"
@inherits Panel
@implements Sandbox.UI.Navigation.INavigatorPage

@* Same shape as the mounts page - an explainer card that hugs its text on the left, the
   list taking whatever's left. Page's Left slot is a full-height slab, which is wrong for
   a fixed block of prose. *@
<root class="root">
	<Page>
		<Body>
			<div class="inbox-body">

				<div class="inbox-aside">

					<h2><WithIcon Icon="notifications" Text="#notificationspage.title"></WithIcon></h2>
					<p>#notificationspage.intro</p>

					<div class="block">
						<label class="section-label">#notificationspage.how_it_works</label>

						<div class="step">
							<icon>cloud</icon>
							<label>#notificationspage.step1</label>
						</div>

						<div class="step">
							<icon>open_in_new</icon>
							<label>#notificationspage.step2</label>
						</div>

						<div class="step">
							<icon>mark_email_read</icon>
							<label>#notificationspage.step3</label>
						</div>
					</div>

					<div class="block">
						<label class="section-label">#notificationspage.worth_knowing</label>

						<div class="note">
							<icon>history</icon>
							<label>@Language.GetPhrase( "notificationspage.note1", new() { { "count", FetchCount } } )</label>
						</div>

						<div class="note">
							<icon>cloud_off</icon>
							<label>#notificationspage.note2</label>
						</div>

						<label class="docs-link" onclick=@OpenSite>#notificationspage.open_site</label>
					</div>

				</div>

				<div class="inbox-list">

					<div class="section-head">
						<label class="title">#notificationspage.notifications</label>
						<label class="count">@CountText</label>
						<div class="grow" />

						<div class="refresh @( IsLoading ? "busy" : "" )" onclick=@Refresh>
							<icon>refresh</icon>
							<label>@Language.GetPhrase( IsLoading ? "notificationspage.loading" : "notificationspage.refresh" )</label>
						</div>
					</div>

					@if ( notices is null )
					{
						<div class="inbox-empty">
							<icon>@( IsLoading ? "hourglass_empty" : "cloud_off" )</icon>
							<label class="title">@Language.GetPhrase( IsLoading ? "notificationspage.fetching" : "notificationspage.offline" )</label>
							<label class="hint">@Language.GetPhrase( IsLoading)? "notificationspage.one_moment" : "notificationspage.offline_hint" )</label>
						</div>
					}
					else if ( notices.Length == 0 )
					{
						<div class="inbox-empty">
							<icon>done_all</icon>
							<label class="title">#notificationspage.empty_title</label>
							<label class="hint">#notificationspage.empty_hint</label>
						</div>
					}

					@* Unread stays its own band for this visit, even though opening the page marks
					   it read - otherwise the new stuff is lost in everything else. *@
					@if ( Unread.Any() )
					{
						<div class="section-head">
							<label class="title">#notificationspage.new_group</label>
							<label class="count">@Language.GetPhrase( "notificationspage.since_last", new() { { "count", Unread.Count() } } )</label>
						</div>

						@foreach ( var notice in Unread )
						{
							<NotificationCard Notice="@notice"></NotificationCard>
						}
					}

					@if ( Earlier.Any() )
					{
						<div class="section-head quiet">
							<label class="title">#notificationspage.earlier</label>
							<label class="count">@Language.GetPhrase( "notificationspage.already_seen", new() { { "count", Earlier.Count() } } )</label>
						</div>

						@foreach ( var notice in Earlier )
						{
							<NotificationCard Notice="@notice"></NotificationCard>
						}
					}

				</div>

			</div>
		</Body>
	</Page>
</root>

@code
{
	/// <summary>How many the backend hands back. The rest stay on the site.</summary>
	const int FetchCount = 20;

	Sandbox.Services.Notification[] notices;

	bool IsLoading { get; set; }

	IEnumerable<Sandbox.Services.Notification> All => notices ?? Enumerable.Empty<Sandbox.Services.Notification>();

	IEnumerable<Sandbox.Services.Notification> Unread => All.Where( x => x.Read is null );
	IEnumerable<Sandbox.Services.Notification> Earlier => All.Where( x => x.Read is not null );

	string CountText
	{
		get
		{
			if ( notices is null ) return "";

			var unread = Unread.Count();
			if ( unread > 0 ) return Language.GetPhrase( "notificationspage.unread_new", new() { { "count", unread } } );

			return Language.GetPhrase( "notificationspage.total", new() { { "count", notices.Length } } );
		}
	}

	// The navigator caches pages, so a second visit gets the same panel back - fetch on
	// every open rather than only the first render, or the list is however old the last
	// visit left it.
	void Sandbox.UI.Navigation.INavigatorPage.OnNavigationOpen()
	{
		_ = Load();
	}

	void Refresh()
	{
		_ = Load();
	}

	async Task Load()
	{
		if ( IsLoading ) return;

		IsLoading = true;
		StateHasChanged();

		notices = await MenuUtility.GetNotifications( FetchCount );

		if ( !this.IsValid() ) return;

		IsLoading = false;
		StateHasChanged();

		if ( !All.Any( x => x.Read is null ) )
			return;

		// Marks them read on the backend only - the rows keep the state they arrived with, so
		// what's new stays legible while you're looking at it.
		await MenuUtility.MarkNotificationsRead();
		Sidebar.InvalidateBadges();
	}

	void OpenSite()
	{
		MenuUtility.OpenUrl( "https://sbox.game" );
	}

	protected override int BuildHash() => HashCode.Combine( notices, IsLoading, Unread.Count() );
}
