@using MenuProject.MenuUI.Components
@using MenuProject.MenuUI.ContentBlock
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.UI;
@using MenuProject.UI;
@using Sandbox.UI.Navigation
@page "/games/all"
@inherits Panel

<root class="root">

    <Page>

        <Left>

            <div class="flex-column flex-gap-32">

                @* Where the games come from - everything there is, or the ones you're subscribed to on the workshop *@
                <div class="flex-column flex-gap-8 sources">
                    <h2><WithIcon Icon="source" Text="#menu.games.source"></WithIcon></h2>
                    <Button class="source" Active=@(source == GameSource.Browse) Icon="business_center" Text="#menu.games.browse" onclick=@(() => SelectSource( GameSource.Browse )) />
                    <Button class="source" Active=@(source == GameSource.Subscribed) Icon="check_circle" Text="#menu.workshop.subscribed" tooltip="#menu.workshop.subscribed_games_tooltip" onclick=@(() => SelectSource( GameSource.Subscribed )) />
                </div>

                @* Sorting and filtering's the backend's search - the workshop's are just what you're subscribed to *@
                @if (!IsWorkshopSource)
                {
                    <div class="flex-column flex-gap-16">
                        <GamePackageSortOrder Value:bind="@filterOrder"></GamePackageSortOrder>
                    </div>
                }

                <TextEntry @ref="SearchEntry" placeholder="#menu.home.search_games" OnTextEdited=@OnSearchEdited></TextEntry>

                @if (!IsWorkshopSource && Result?.Properties is not null && Result.Properties.Length > 0)
                {
                    <div class="flex-column flex-gap-16">

                        <PackagePropertyFilter Result=@Result Selected="@SelectedTags"></PackagePropertyFilter>
                    </div>
                }

                @if (!IsWorkshopSource && Result?.Facets is not null)
                {
                    foreach (var facet in Result.Facets)
                    {
                        <div class="flex-column flex-gap-8">
                            <h2><WithIcon Icon="@facet.Entries.FirstOrDefault()?.Icon" Text="@facet.Title"></WithIcon></h2>
                            <PackageCategoryFilter Result=@Result Selected="@SelectedCategory" Facet="@facet"></PackageCategoryFilter>
                        </div>
                    }
                }

                @if (!IsWorkshopSource)
                {
                    <div class="flex-column flex-gap-16">
                        <h2><WithIcon Icon="tag" Text="#menu.home.tags"></WithIcon></h2>
                        <PackageTagFilter Result=@Result Selected="@SelectedTags"></PackageTagFilter>
                    </div>
                }

            </div>

        </Left>

        <Body>
            @if (IsWorkshopSource && workshopPackages is { Length: 0 })
            {
                <div class="no-games">
                    <label>#menu.workshop.no_subscribed_games</label>
                </div>
            }
            else
            {
                <MenuProject.UI.PackageList @ref=PackageList Surface="search" ShowFilters="@false" Query=@($"type:game sort:{filterOrder} {Filter} {GetQuery()}") Packages=@(IsWorkshopSource ? workshopPackages ?? Array.Empty<Package>() : null) ShowSubscribe=@IsWorkshopSource OnSelected=@Selected OnMenu=@Menu Take=@(200)></MenuProject.UI.PackageList>
            }
        </Body>
    </Page>
</root>

@code {

    [Parameter]
    public string Query 
    { 
        get => field; 
        set
        {
            NeedsSetQuery = true;
            field = value;
        }
    }

    // When navigating in from the games landing page (GamesBrowse), the chosen
    // category supplies an initial sort order and any extra query tokens (tags
    // etc). The sidebar stays fully usable on top of these.
    //
    // The navigator caches this page by url-without-query and re-applies query
    // params via SetProperty (not OnParametersSet) when you navigate back to it,
    // so the sort has to be seeded from the setter to update on every visit.
    [Parameter]
    public string Sort
    {
        get => field;
        set
        {
            field = value;
            // Reset to the default when a category specifies no sort, otherwise
            // the previous category's sort would carry over on re-navigation.
            filterOrder = string.IsNullOrEmpty( value ) ? "quality" : value;
        }
    }

    [Parameter] public string Filter { get; set; }

    string filterOrder = "quality";

    TextEntry SearchEntry = default;
    string debouncedSearch = "";
    bool searchPending = false;
    RealTimeSince timeSinceSearchEdited;

    List<string> SelectedTags = new();
    Dictionary<string, string> SelectedCategory = new();

    MenuProject.UI.PackageList PackageList = default;

    /// <summary>
    /// Where the games come from - the backend's search, or the workshop items you're subscribed to
    /// </summary>
    enum GameSource
    {
        Browse,
        Subscribed
    }

    GameSource source;

    bool IsWorkshopSource => source != GameSource.Browse;

    /// <summary>
    /// The games you're subscribed to on the workshop, for <see cref="GameSource.Subscribed"/> - and what they were found
    /// for, so they're found again when that changes. Null while they're being found.
    /// </summary>
    Package[] workshopPackages;
    string workshopPackagesFor;

    void SelectSource( GameSource value )
    {
        if ( source == value ) return;

        source = value;
        workshopPackages = null;
        workshopPackagesFor = null;
        StateHasChanged();
    }

    async void RefreshWorkshopPackages()
    {
        var key = $"{source}|{debouncedSearch}";
        if ( key == workshopPackagesFor ) return;

        workshopPackagesFor = key;
        workshopPackages = null;

        Package[] packages;

        try
        {
            packages = await MenuUtility.FindWorkshopPackagesAsync( debouncedSearch, true, ["game"] );
        }
        catch ( Exception e )
        {
            Log.Warning( e, $"Couldn't list workshop games ({e.Message})" );
            packages = [];
        }

        // Something else was asked for while we were finding these
        if ( key != workshopPackagesFor ) return;

        workshopPackages = packages;
        StateHasChanged();
    }

    Package.FindResult Result => PackageList?.Result;

    public GamesPage()
    {
        // Default to showing VR games in VR mode
        if (Application.IsVR)
        {
            SelectedTags.Add("vr");
        }
    }

    void OnSearchEdited( string text )
    {
        searchPending = true;
        timeSinceSearchEdited = 0;
    }

    private bool NeedsSetQuery = false;
    public override void Tick()
    {
        if (NeedsSetQuery && IsVisible && SearchEntry.IsValid())
        {
            SearchEntry.Text = Query;
            debouncedSearch = Query ?? "";
            NeedsSetQuery = false;
        }

        if (searchPending && timeSinceSearchEdited >= 0.3f)
        {
            searchPending = false;
            debouncedSearch = SearchEntry?.Text ?? "";
            StateHasChanged();
        }

        // Found again when the source or the search changes
        if ( IsWorkshopSource )
            RefreshWorkshopPackages();
    }

    void OnOrderChanged(string value)
    {
        filterOrder = value;
    }

    string GetQuery()
    {
        string tagString = debouncedSearch;
        foreach (var tag in SelectedTags)
        {
            tagString += $" +{tag}";
        }

        foreach (var cat in SelectedCategory)
        {
            tagString += $" {cat.Key}:{cat.Value}";
        }

        return tagString;
    }

    protected override int BuildHash()
    {
        return System.HashCode.Combine(Result, GetQuery(), filterOrder, NeedsSetQuery, Query, Filter, source, workshopPackages);
    }

    void Selected(Package package)
    {
        ContentBlocks.OnLaunch(package);
    }

    void Menu(Package package)
    {
        ContentBlocks.OnMenu(this, package);
    }
}
