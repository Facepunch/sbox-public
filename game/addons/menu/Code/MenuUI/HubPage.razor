@inherits Sandbox.UI.Panel
@page "/hub"
@using MenuProject.MenuUI.Components.New
@using MenuProject.MenuUI.Front
@using MenuProject.MenuUI.Front.Feed
@using MenuProject.MenuUI.Layout
@using Sandbox;
@using Sandbox.UI;

<root class="root">
    <Page>

        <Body>

            <div class="blocks">

                <div class="block">

                    <label class="medium">#hubpage.recommended</label>

                    <HorizontalGameList Icon="group" Title="#hubpage.friends_played" Query="type:game sort:friends" Limit=@(5) />
                    <HorizontalGameList Icon="history" Title="#hubpage.jump_back" Query="type:game sort:used" Limit=@(5) />
                    <HorizontalGameList Icon="favorite" Title="#hubpage.favourites" Query="type:game sort:favourites" Limit=@(5) />

                    <row>
                        <label class="medium">#hubpage.friend_activity</label>
                    </row>
                    <PlayerFeed></PlayerFeed>
                </div>

            </div>

        </Body>

        <Left>
            <column style="gap: 12px;">
                <row>
                    <label class="medium">#hubpage.your_achievements</label>
                </row>
                <AchievementDeck></AchievementDeck>
            </column>
        </Left>
    </Page>


</root>
