@using System;
@using Sandbox;
@using Sandbox.UI;
@inherits Popup
@namespace MenuProject

<root>

	<div class="header">
		<i>celebration</i>
		<h2>@Heading</h2>
		<div class="grow" />
		<div class="count">
			<icon>person</icon>
			<label>@( Party?.MemberCount ?? 1 ) / @( Party?.MaxMembers ?? PartyDeck.MAX_MEMBERS )</label>
		</div>
	</div>

	<div class="footer">
		<div class="leave @( Party is null ? "locked" : "" )" onmousedown=@Leave>
			<icon>logout</icon>
			<label>Leave party</label>
		</div>
	</div>

</root>

@code
{
	PartyRoom Party => PartyRoom.Current;

	public PartyDeck PartyDeck { get; set; }

	string Heading => Party is null || Party.Owner.IsMe ? "Your Party" : $"{Party.Owner.Name}'s Party";

	protected override int BuildHash() => System.HashCode.Combine( Party, Party?.MemberCount, Party?.Owner );

	public void Leave()
	{
		if ( Party is null ) return;

		Party.Leave();
		Delete();
	}
}
