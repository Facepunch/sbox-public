@using Sandbox;
@using Sandbox.UI;
@using MenuProject.Modals;
@namespace MenuProject
@inherits Panel

<root class="@(Draft?.Creating == true ? "creating" : "")">
	@* A new party's - who it's for, picked before it's made *@
	@if ( Draft is not null )
	{
		<div class="privacy-choice">
			<div class="option @(Draft.IsPublic ? "picked" : "")" onclick=@( () => SetPublic( true ) )>
				<icon>public</icon>
				<div class="about">
					<label class="title">Open party</label>
				</div>
			</div>
			<div class="option @(Draft.IsPublic ? "" : "picked")" onclick=@( () => SetPublic( false ) )>
				<icon>group</icon>
				<div class="about">
					<label class="title">Friends only</label>
				</div>
			</div>
		</div>
	}

	<div class="settings-row">
		<label class="field-title">#menu.party.name</label>
		@if ( CanEdit )
		{
			<TextEntry Value=@Name OnTextEdited=@EditName MaxLength=@PartyRoom.MaxNameLength Placeholder="#menu.party.name_your_party" onsubmit=@SaveName onblur=@SaveName disabled=@(Draft?.Creating == true) />
		}
		else
		{
			<label class="party-name">@PartyView.Name</label>
		}
	</div>

	<div class="settings-row">
		<label class="field-title">#menu.party.max_members</label>
		@if ( CanEdit )
		{
			<SliderControl Value=@((float)MaxMembers) OnValueChanged=@SetMaxMembers Min=@((float)Math.Max( 1, MemberCount )) Max=@((float)PartyDeck.MAX_MEMBERS) Step=@(1f) ShowTextEntry=@true />
		}
		else
		{
			<label>@MaxMembers</label>
		}
	</div>

	@* On the platform menu the party plays the game you're on - picked with the game switcher, not here *@
	@if ( !PartyDeck.OnPlatform )
	{
		<div class="game-row">
			<Button class="game-choice" Text="@(HasGame ? SelectedGameTitle : CanEdit ? "#menu.party.choose_game" : "#menu.party.no_game_selected")" IconTexture=@GameThumbnail Icon="@(GameBusy ? "hourglass_empty" : "sports_esports")" disabled=@(!CanEdit || GameBusy) onclick=@ChooseGame tooltip="@(CanEdit ? "#menu.party.choose_game" : SelectedGameTitle)" />
			@if ( HasGame && CanEdit )
			{
				<Button class="game-action" disabled=@GameBusy onclick=@ClearGame tooltip="#menu.party.clear_game_choice" Icon="close" />
			}
		</div>
	}

	@if ( !PartyDeck.OnPlatform && CanShowGameSettings )
	{
		<div class="game-setup-summary">
			@if ( GameSummary is { } summary )
			{
				@if ( summary.NeedsMap )
				{
					<div><icon>map</icon><label>@summary.MapTitle</label></div>
				}
				<div><icon>@summary.PrivacyIcon</icon><label>@($"{summary.PrivacyTitle} · {summary.MaxPlayers} server slots")</label></div>
			}
			else
			{
				<label>#menu.party.game_setup_hasn_t_been_saved_yet</label>
			}
			<Button class="configure-game" Icon="tune" Text="@(CanEdit ? "#menu.party.configure_game" : "#menu.party.view_game_setup")" disabled=@(Draft?.Creating == true) onclick=@ConfigureGame />
		</div>
	}

	@if ( GameTooSmall )
	{
		<label class="settings-error">@($"This game only supports {SelectedPackage.Info.MaxPlayers} players.")</label>
	}

	@if ( !string.IsNullOrEmpty( Error ) )
	{
		<label class="settings-error">@Error</label>
	}
	@if ( Draft is not null )
	{
		<Button class="create-party" disabled=@(!CanCreate) onclick=@CreateParty Text="@(Draft.Creating ? "#menu.party.creating" : "#menu.party.create")" />
	}
</root>

@code
{
	string Name = PartyView.Name;
	string Error;

	bool CanSave => Draft is null && CanEdit && !string.IsNullOrWhiteSpace( Name ) && Name.Trim() != PartyView.Name;

	void SetPublic( bool isPublic )
	{
		if ( Draft is null || !CanEdit ) return;
		Draft.IsPublic = isPublic;
	}

	void EditName( string name )
	{
		Name = name;
		if ( Draft is not null ) Draft.Name = name;
		Error = null;
	}

	void SaveName()
	{
		if ( !CanSave ) return;

		try
		{
			PartyView.Rename( Name );
			Name = PartyView.Name;
			Error = null;
		}
		catch ( Exception e )
		{
			Error = e.Message;
		}
	}

	protected override int BuildHash() => HashCode.Combine( Name, Error, PartyView.Name, CanEdit, Draft, Draft?.Creating, Draft?.IsPublic, HashCode.Combine( MaxMembers, MemberCount, SelectedGameIdent, SelectedGameTitle, SelectedPackage, GameBusy, GameSummary, GameSummary?.MapTitle ) );

	/// <summary>
	/// Refresh the localized privacy summary when translations change.
	/// </summary>
	public override void LanguageChanged()
	{
		base.LanguageChanged();
		StateHasChanged();
	}
}
