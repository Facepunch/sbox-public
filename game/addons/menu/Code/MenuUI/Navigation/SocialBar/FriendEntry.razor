@using System;
@using MenuProject.MenuUI.Popups
@using MenuProject;
@using Sandbox;
@using Sandbox.UI;

@namespace MenuProject.Social

<root class="@CssClasses" onclick=@ShowFriendPopup>
	<div class="avatar round" style="background-image: url( avatar:@Friend.Id )" />
	<div class="info">
		<label class="name">@Friend.Name</label>
		<label class="status">@StateString.Substring(0, Math.Min(StateString.Length, 36))</label>
	</div>
	<div class="actions">
		@if ( Joinable )
		{
			<div class="action join" onclick=@JoinGame><label>#friendentry.join</label></div>
		}
		else if ( IsGenuinelyFull )
		{
			<div class="action deny"><label>#friendentry.full</label></div>
		}

		@if ( CanInviteToParty )
		{
			<div class="action" onclick=@InviteToParty><label>#friendentry.invite</label></div>
		}
	</div>
</root>

@code
{
    [Parameter]
    public Friend Friend { get; set; }

    public bool Joinable => !string.IsNullOrEmpty(Friend.GetRichPresence("connect"));

    /// <summary>
    /// Only show "Full" if this is genuinely a multiplayer game (MaxPlayers > 1) that the friend
    /// isn't joinable for - not just because it's a singleplayer game or some other reason.
    /// </summary>
    public bool IsGenuinelyFull
    {
        get
        {
            if ( !Friend.IsPlayingThisGame ) return false;
            if ( Joinable ) return false;

            var gameIdent = Friend.GetRichPresence("gamename");
            if ( string.IsNullOrEmpty(gameIdent) ) return false;
            if ( !Package.TryGetCached(gameIdent, out var package) ) return false;

            return package.Info.MaxPlayers > 1;
        }
    }

    public bool CanInviteToParty => MenuUtility.CanInviteToParty(Friend);

    public string CssClasses
    {	
        get
        {
            if (Friend.IsPlayingThisGame) return "ingame";
            if (Friend.IsAway || Friend.IsBusy || Friend.IsSnoozing) return "online away";
            if (!Friend.IsOnline) return "offline";
            return "online";
        }
    }

    public string StateString
    {
        get
        {
            if (Friend.IsPlayingThisGame)
            {
                var game = Friend.GetRichPresence("gametitle");
                var map = Friend.GetRichPresence("map");

                // Steam clears gametitle while the friend is in the main menu.
                if (string.IsNullOrWhiteSpace(game) || game == "menu") return Language.GetPhrase( "friendentry.main_menu" );
                if (string.IsNullOrWhiteSpace(map)) return Language.GetPhrase( "friendentry.unknown_map", new() { { "gametitle", game } } );
                return Language.GetPhrase( "friendentry.playing", new() { { "gametitle", game }, { "maptitle", map } } );
            }

            if (Friend.IsPlayingAGame) return Language.GetPhrase( "friendentry.playing_other" );
            if (Friend.IsAway) return Language.GetPhrase( "friendentry.away" );
            if (Friend.IsBusy) return Language.GetPhrase( "friendentry.busy" );
            if (Friend.IsSnoozing) return Language.GetPhrase( "friendentry.snooze" );
            if (Friend.IsOnline) return Language.GetPhrase( "friendentry.online" );
            return Language.GetPhrase( "friendentry.offline" );
        }
    }

    [Event("friend.change")]
    public void SteamFriends_OnPersonaStateChange(Friend friend)
    {
        if (Friend.Id != friend.Id) return;
        Friend = friend;
        StateHasChanged();
    }

    public void JoinGame()
    {
        MenuUtility.JoinFriendGame(Friend);
    }

    async Task InviteToParty()
    {
        await PartyDeck.EnsureLobbyExists();
        MenuUtility.InviteToParty(Friend.Id);
    }

    void ShowFriendPopup()
    {
        FriendPopup.Show(this, Friend, Popup.PositionMode.Right, 28.0f);
    }
}
