@namespace Sandbox.UI.Dev.Stats
@inherits Panel

<root class="statbox">
	@{
		var hostStats = Networking.HostStats;
	}
	
	<title>@MenuHelpers.Localize( "developermode", "hoststats.host_stats" )</title>
	
	<StatValue Value="@hostStats.Fps.ToString()" Title=@MenuHelpers.Localize( "developermode", "hoststats.fps" )></StatValue>
	<StatValue Value="@( (hostStats.InBytesPerSecond / 1024f).ToString( "0.00" ) )" Title=@MenuHelpers.Localize( "developermode", "hoststats.bytesin" )></StatValue>
	<StatValue Value="@( (hostStats.OutBytesPerSecond / 1024f).ToString( "0.00" ) )" Title=@MenuHelpers.Localize( "developermode", "hoststats.bytesout" )></StatValue>
</root>


@code
{
    protected override int BuildHash() => HashCode.Combine( DateTime.UtcNow.Second );
}
