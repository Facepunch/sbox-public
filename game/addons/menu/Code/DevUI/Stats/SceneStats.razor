@namespace Sandbox.UI.Dev.Stats
@inherits Panel

<root class="statbox"> 

    <title>@Language.GetPhrase("developermode.scenestats.scene_stats")</title>

    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.Animation.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.animation")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.Audio.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.audio")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.Physics.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.physics")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.Particles.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.particles")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.Render.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.render")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.Update.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.update")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.Timings.GcPause.AverageMs( 200 ).ToString( "0.00 ms" )" Title=@Language.GetPhrase("developermode.scenestats.gcpause")></StatValue>

</root>


@code
{
    protected override int BuildHash() => HashCode.Combine(DateTime.UtcNow.Millisecond);
}
