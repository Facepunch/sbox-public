@namespace Sandbox.UI.Dev.Stats
@inherits Panel

<root class="statbox"> 

    <title>@Language.GetPhrase("developermode.performancestats.performance")</title>

    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.LastSecond.FrameMin.ToString( "0 ms" )" Title=@Language.GetPhrase("developermode.performancestats.min")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.LastSecond.FrameMax.ToString( "0 ms" )" Title=@Language.GetPhrase("developermode.performancestats.max")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.PerformanceStats.LastSecond.FrameAvg.ToString( "0 ms" )" Title=@Language.GetPhrase("developermode.performancestats.avg")></StatValue>

</root>


@code
{
    protected override int BuildHash() => HashCode.Combine( Sandbox.Diagnostics.PerformanceStats.LastSecond );
}
