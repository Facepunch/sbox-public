@namespace Sandbox.UI.Dev.Stats
@inherits Panel

<root class="statbox"> 

    <title>@MenuHelpers.Localize( "developermode", "renderstats.render_stats" )</title>

    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.ShadowMaps.ToMetric()" Title=@MenuHelpers.Localize( "developermode", "renderstats.shadow_maps" )></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.UnshadowedLightsInView.ToMetric()" Title=@MenuHelpers.Localize( "developermode", "renderstats.unshadowed_lights" )></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.ShadowedLightsInView.ToMetric()" Title=@MenuHelpers.Localize( "developermode", "renderstats.shadowed_lights" )></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.DrawCalls.ToMetric()" Title=@MenuHelpers.Localize( "developermode", "renderstats.draw_calls" )></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.TrianglesRendered.ToMetric()" Title=@MenuHelpers.Localize( "developermode", "renderstats.triangles_rendered" )></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.ObjectsRendered.ToMetric()" Title=@MenuHelpers.Localize( "developermode", "renderstats.objects_rendered" )></StatValue>

</root>


@code
{
    protected override int BuildHash() => HashCode.Combine(Sandbox.Diagnostics.PerformanceStats.LastSecond);
}
