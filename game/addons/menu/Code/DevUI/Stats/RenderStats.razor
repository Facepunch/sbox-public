@namespace Sandbox.UI.Dev.Stats
@inherits Panel

<root class="statbox"> 

    <title>@Language.GetPhrase("developermode.renderstats.render_stats")</title>

    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.ShadowMaps.ToMetric()" Title=@Language.GetPhrase("developermode.renderstats.shadow_maps")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.UnshadowedLightsInView.ToMetric()" Title=@Language.GetPhrase("developermode.renderstats.unshadowed_lights")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.ShadowedLightsInView.ToMetric()" Title=@Language.GetPhrase("developermode.renderstats.shadowed_lights")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.DrawCalls.ToMetric()" Title=@Language.GetPhrase("developermode.renderstats.draw_calls")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.TrianglesRendered.ToMetric()" Title=@Language.GetPhrase("developermode.renderstats.triangles_rendered")></StatValue>
    <StatValue Value="@Sandbox.Diagnostics.FrameStats.Current.ObjectsRendered.ToMetric()" Title=@Language.GetPhrase("developermode.renderstats.objects_rendered")></StatValue>

</root>


@code
{
    protected override int BuildHash() => HashCode.Combine(Sandbox.Diagnostics.PerformanceStats.LastSecond);
}
