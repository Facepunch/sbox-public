@namespace Sandbox.UI.Dev
@inherits Panel

<root id="DeveloperMode"> 

    <div class="left">
        <ConvarToggle Title="#developermode.profiler" ConVar="overlay_profile"></ConvarToggle>
        <ConvarCycle Title="#developermode.frame_stats" ConVar="overlay_frame" Values="0,1,2,3" Labels=@LocalizedLabel( "Off,Basic,Detailed,All" )></ConvarCycle>
        <ConvarToggle Title="#developermode.allocations" ConVar="overlay_alloc"></ConvarToggle>
        <ConvarToggle Title="#developermode.audio" ConVar="overlay_audio"></ConvarToggle>
        <ConvarToggle Title="#developermode.network_graph" ConVar="overlay_network_graph"></ConvarToggle>
        <ConvarToggle Title="#developermode.network_messages" ConVar="overlay_network_calls"></ConvarToggle>
		<ConvarToggle Title="#developermode.postprocess_stack" ConVar="overlay_pp"></ConvarToggle>
		<ConvarToggle Title="#developermode.gpu_profiler" ConVar="overlay_gpu"></ConvarToggle>
		<ConvarToggle Title="#developermode.resources" ConVar="overlay_resources"></ConvarToggle>
        <ConvarToggle Title="#developermode.physics_debug" ConVar="physics_debug_draw"></ConvarToggle>
        <ConvarToggle Title="#developermode.console_output" ConVar="consoleoverlay" On="True" Off="False"></ConvarToggle>
        <RenderModeSelect></RenderModeSelect>
    </div>

    <div class="center">
        <Console @ref="Console"></Console>
    </div>

    <div class="right">
        <StatsContainer></StatsContainer>
    </div>

</root>


@code
{
    public Console Console { get; set; }

    public static bool Open { get; protected set; }

    bool wasOpen;

    private string LocalizedLabel( string labels ){
        if ( string.IsNullOrEmpty( labels ) )
            return labels;

        var parts = labels.Split( ',' );
        for ( int i = 0; i < parts.Length; i++ )
        {
            string normalizedOriginal = "developermode.frame_stats." + parts[i].Replace( " ", "" ).Replace( "#", "" );
            string localizedText = Language.GetPhrase( normalizedOriginal );
            if( localizedText == normalizedOriginal )
                continue;

            parts[i] = localizedText;
        }

        return string.Join( ",", parts );
    }

    public override void Tick()
    {
        base.Tick();

        if ( Open != wasOpen )
        {
            wasOpen = Open;

            if ( Open )
                Console?.Input?.Focus();
            else
                Console?.Input?.Blur();

            FindRootPanel()?.SetClass( "developermode", Open );
            MenuUtility.SkipAllTransitions();
        }

        SetClass("open", Open);
    }

    public override Panel FindPopupPanel() => this;

    [MenuConCmd("con_toggle")]
    static void ToggleConsole()
    {
        Open = !Open;
    }
}
