@using Sandbox
@using Sandbox.UI
@using System
@namespace MenuProject.Settings
@inherits Panel

<root class="@RootClass" onmouseover=@( () => View?.SetFocused( Item ) )>

	<div class="line">

		<div class="title">
			<label class="name">@Item.Title</label>

			@if ( Item.Kind != SettingKind.Dropdown )
			{
				@Flag
			}
		</div>

		<div class="control">
			@if ( ReadOnly )
			{
				<label class="readonly-value">@ReadOnlyValue</label>
			}
			else if ( Item.Kind == SettingKind.Action )
			{
				<Button class="action" onclick=@( () => Item.Invoke?.Invoke() )>@Item.ActionLabel</Button>
			}
			else if ( Item.Kind == SettingKind.Slider )
			{
				<SliderControl Value:bind=@Item.FloatValue Min=@Item.Min Max=@Item.Max Step=@Item.Step NumberFormat=@Item.NumberFormat ShowTextEntry=@true></SliderControl>
			}
			else if ( Item.Kind == SettingKind.Custom )
			{
				<div class="custom" @ref="CustomHost"></div>
			}
			else if ( Item.Kind == SettingKind.Dropdown )
			{
				<DropDown Value:bind=@Item.Value BuildOptions=@( () => Item.CurrentOptions )></DropDown>
				@Flag
			}
			else
			{
				<ButtonGroup Value:bind=@Item.Value Options=@Item.CurrentOptions></ButtonGroup>
			}
		</div>

	</div>

</root>

@code
{
	[Parameter] public SettingItem Item { get; set; }
	[Parameter] public SettingsView View { get; set; }

	/// <summary>
	/// Show the current value without creating editable controls.
	/// </summary>
	[Parameter] public bool ReadOnly { get; set; }

	/// <summary>The search that turned this row up.</summary>
	[Parameter] public string Highlight { get; set; }

	Panel CustomHost;
	Panel customControl;
	SettingItem customItem;

	string Disabled => Item?.Disabled;

	/// <summary>
	/// A lock when it's locked, a warning when there's something to watch for - what, in the detail (and its tooltip,
	/// where there's no detail). In a dropdown, by its chevron; after the name otherwise.
	/// </summary>
	RenderFragment Flag => Disabled is not null ? @<i class="flag locked" tooltip=@Disabled>lock</i>
		: Warning is not null ? @<i class="flag warn" tooltip=@Warning>warning</i>
		: null;
	string Warning => Item?.Warning?.Invoke();

	string ReadOnlyValue
	{
		get
		{
			var value = Item.Value?.ToString();
			return Item.CurrentOptions?.FirstOrDefault( x => string.Equals( x.Value?.ToString(), value, StringComparison.OrdinalIgnoreCase ) )?.Title ?? value;
		}
	}

	string RootClass
	{
		get
		{
			var classes = $"row kind-{Item?.Kind.ToString().ToLowerInvariant()}";

			if ( Disabled is not null ) classes += " disabled";
			if ( !string.IsNullOrEmpty( Highlight ) ) classes += " matched";

			return classes;
		}
	}

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( ReadOnly || Item.Kind != SettingKind.Custom || !CustomHost.IsValid() )
		{
			customControl?.Delete( true );
			customControl = null;
			return;
		}

		if ( customControl.IsValid() && customItem == Item && customControl.Parent == CustomHost ) return;

		// Rebind when the row gets a different setting or becomes editable again.
		customControl?.Delete( true );
		customItem = Item;
		customControl = Item.CreateControl?.Invoke( Item );
		if ( customControl is not null ) customControl.Parent = CustomHost;
	}

	// A class rather than a rebuild, so dragging a slider outside its row doesn't tear it out.
	public override void Tick()
	{
		base.Tick();

		SetClass( "focused", View?.Focused == Item );
	}

	protected override int BuildHash() => HashCode.Combine( Item, Disabled, Warning, View?.Revision, ReadOnly, ReadOnly ? Item?.Value : null );
}
