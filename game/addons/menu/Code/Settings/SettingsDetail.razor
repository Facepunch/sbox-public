@using Sandbox
@using Sandbox.UI
@using System
@namespace MenuProject.Settings
@inherits Panel

<root class="detail">

	@if ( Item is not null )
	{
		<label class="title">@Localize( $"settings.{Item.Id}.title", Item.Title )</label>

		@if ( Item.Section is not null )
		{
			<label class="meta">@Localize( "settings.section." + Item.Section.Replace( " ", "_" ), Item.Section )</label>
		}

		<label class="body">@Localize( $"settings.{Item.Id}.desc", Item.Description )</label>
	}
	else
	{
		<div class="hint">
			<i>info</i>
			<label>#settings.detail.hint</label>
		</div>
	}

</root>

@code
{
	[Parameter] public SettingsView View { get; set; }

	SettingItem Item => View?.Described;

	string Localize( string key, string originalText )
	{
		string localizedText = Language.GetPhrase( key );
		return localizedText == key ? originalText : localizedText;
	}

	protected override int BuildHash() => HashCode.Combine( Item?.Id );
}
