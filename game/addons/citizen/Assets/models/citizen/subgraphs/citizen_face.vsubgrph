				{
					_class = "CCommentAnimNode"
					m_sName = "Facial pose composition"
					m_vecPosition = [ -960.0, -976.0 ]
					m_nNodeID =
					{
						m_id = 2100100010
					}
					m_sNote = ""
					m_commentText = "Resting expression + fidget delta -> expression override -> facial masks -> character-specific blinking -> voice/lipsync mask.\n\nExpressions_Default and Eyes_Open contain absolute bone poses. Replace the eyelid channels with the open-eye mask; do not add these absolute poses together. Fidgets subtract bindPose before addition; Eyes_Blink_delta is already additive.\n\nBody pose comes from the selected holdtype. Masks control which bones and morphs are replaced. Preserve mask names, reset/timing flags and the bindPose sequence timer."
					m_size = [ 1136.0, 368.0 ]
					m_color = [ 0, 50, 100, 255 ]
				}
			},
		]
