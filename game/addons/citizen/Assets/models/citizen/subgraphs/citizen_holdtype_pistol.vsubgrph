				}
				value =
				{
					_class = "CCommentAnimNode"
					m_sName = "Additive pelvis: why?"
					m_vecPosition = [ -160.0, -544.0 ]
					m_nNodeID =
					{
						m_id = 268537372
					}
					m_sNote = ""
					m_commentText = "Because \"Actions\" are always animated against the standing pose, if they take control of the pelvis normally, you would suddenly stand up while reloading. Instead, we grab the pelvis separately and turn it into an additive component."
					m_size = [ 544.0, 160.0 ]
					m_color = [ 100, 0, 50, 255 ]
				}
