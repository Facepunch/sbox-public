					m_nNodeID =
					{
						m_id = 1415703014
					}
					m_sNote = "Our \"Single Frame\" nodes here set a tag to inform another SM whether they have the left foot or the right foot forward. It's important for this info to be present; other parts of the graph may make use of it, e.g. the airborne state."
					m_commentText = "(Click to read.)"
					m_size = [ 144.0, 64.0 ]
