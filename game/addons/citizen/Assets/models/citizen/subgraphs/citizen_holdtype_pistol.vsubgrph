				value =
				{
					_class = "CCommentAnimNode"
					m_sName = "Why place Aim Matrices here?"
					m_vecPosition = [ -160.0, 128.0 ]
					m_nNodeID =
					{
						m_id = 1258492145
					}
					m_sNote = ""
					m_commentText = "Unless they're first-in-line, Aim Matrix nodes are purely additive, meaning that if they were placed after the [Weightlist Compositing] section, they would be added against \"the wrong pose.\" And they would strongly deviate from their intended look, to the point of extreme jankiness when looking straight up or down."
					m_size = [ 288.0, 464.0 ]
					m_color = [ 100, 0, 50, 255 ]
				}
			},
