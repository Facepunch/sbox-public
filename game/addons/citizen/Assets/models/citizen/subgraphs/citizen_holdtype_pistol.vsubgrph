					m_vecPosition = [ -2448.0, -320.0 ]
					m_nNodeID =
					{
						m_id = 115918505
					}
					m_sNote = "The Blend 1D nodes here blend between the \"Standing\" pose and a \"Moving\" pose based on move_groundspeed. In the case of these poses right next to here specifically, the pistol goes a little bit down when moving. With the right damping settings, the transition back up is delayed a little bit as well, which produces a nice effect."
					m_commentText = "(Click to read.)"
