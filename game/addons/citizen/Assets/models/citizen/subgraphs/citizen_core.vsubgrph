					m_vecPosition = [ -1056.0, -560.0 ]
					m_nNodeID =
					{
						m_id = 2100000064
					}
					m_sNote = ""
					m_commentText = "Shared by citizen, human male and human female. Edit animation behavior here; the entry graphs retain their parameter defaults and preview settings.\n\n01 prepares absolute holdtype poses and additive center/pelvis offsets. 02 -> 03 -> 04 builds movement; height scaling then feeds the eight shared compositors. 05 applies holdtype actions and selects the result. Facial animation feeds 06 and the final pose.\n\nDouble-click a subgraph to edit that system. Preserve pose/delta contracts, masks, tag handling, resets, transition timing and stage order. Authoring reference notes are below."
					m_size = [ 1152.0, 400.0 ]
					m_color = [ 0, 50, 100, 255 ]
				}
