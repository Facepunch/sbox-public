					m_vecPosition = [ 1088.0, 672.0 ]
					m_nNodeID =
					{
						m_id = 2101988243
					}
					m_sNote = ""
					m_commentText = "The 'skid_x' & 'skid_y' float values can be used to portray 'skidding' — the act of drifting to a stop. In our case, they're also used to show leaning while moving around.\n\nThe 'skid' float value is unused, but you can drive it yourself if you wish; it'll make the body and feet shake."
					m_size = [ 544.0, 288.0 ]
					m_color = [ 125, 75, 125, 255 ]
