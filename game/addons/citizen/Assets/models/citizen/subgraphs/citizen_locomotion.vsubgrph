					_class = "CCommentAnimNode"
					m_sName = "2D Blends - Locomotion"
					m_vecPosition = [ 0.0, 0.0 ]
					m_nNodeID =
					{
						m_id = 2037676333
					}
					m_sNote = ""
					m_commentText = "These 2D Blends hold the directional movement animations in a non-normalized way, that is to say, not limited to a range of -1.0 to 1.0; instead, the values actually match the root speed (as seen in ModelDoc!)\n\nIMPORTANT: all movement anims are made to start at a precise point in the cycle: the starting point of the loop, frame 0, is set to be when the left foot passes the planted right foot."
					m_size = [ 416.0, 384.0 ]
					m_color = [ 125, 75, 125, 255 ]
				}
