@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    <SpawnMenuToolbar>
        <Body><TextEntry @ref="SearchBox" class="menu-input" Placeholder="#spawnmenu.common.search" Value:bind=@Sidebar.Filter HasClearButton /></Body>
    </SpawnMenuToolbar>
</root>

@code
{
    internal UIGroupedList Sidebar { get; init; }

    TextEntry SearchBox;

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( firstTime ) SearchBox.Focus();
    }
}
