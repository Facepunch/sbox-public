@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root class="@(Item.Kind == SpawnlistItemKind.Title ? "title-item" : "divider-item") @(Editing ? "editing" : "")">
    <SpawnlistDragHandle class="edit-only" Item=@Item />

    @if ( Item.Kind == SpawnlistItemKind.Title )
    {
        @if ( Editing )
        {
            <TextEntry @ref=TitleEntry Value=@Item.Title Placeholder="#spawnmenu.spawnlist.title_placeholder" onblur=@SaveTitle />
        }
        else
        {
            <Label class="section-title" Tokenize=@false Text=@Item.Title />
        }
    }
    else
    {
        <div class="divider-line"></div>
    }
</root>

@code
{
    /// <summary>
    /// Enables inline title editing and drag handles for writable lists in edit mode.
    /// </summary>
    [Parameter] public bool Editing { get; set; }

    [Parameter] public SpawnlistItem Item { get; set; }
    [Parameter] public Action<Guid, string> OnRename { get; set; }
    [Parameter] public Action<Guid> OnRemove { get; set; }

    TextEntry TitleEntry;

    void SaveTitle()
    {
        if ( !Editing || !TitleEntry.IsValid() ) return;

        var title = TitleEntry.Text.Trim();
        if ( title.Length == 0 )
        {
            TitleEntry.Text = Item.Title;
            return;
        }

        if ( title != Item.Title ) OnRename?.Invoke( Item.Id, title );
    }

    protected override void OnMouseDown( MousePanelEvent e )
    {
        if ( e.MouseButton != MouseButtons.Right || !Editing )
        {
            base.OnMouseDown( e );
            return;
        }

        var menu = new Sandbox.UI.Menu();
        menu.AddOption( "#spawnmenu.spawnlist.remove_item", "delete", () => OnRemove?.Invoke( Item.Id ) );
        e.StopPropagation();

        menu.Open( this, Popup.PositionMode.UnderMouse );
    }
}
