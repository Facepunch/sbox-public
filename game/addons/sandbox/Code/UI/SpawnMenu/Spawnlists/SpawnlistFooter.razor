@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>

<UIButton Icon="add" Text="#spawnmenu.spawnlist.new_button" @onclick=@CreateSpawnlist></UIButton>

</root>

@code
{
    void CreateSpawnlist()
    {
        SpawnlistData.Create( Game.Language.GetPhrase( "spawnmenu.spawnlist.untitled" ), out var entry );
        Ancestors.OfType<SpawnlistsPage>().FirstOrDefault()?.EditSpawnlist( entry );
    }
}
