@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@implements IUtilityTab
@attribute [Icon( "build" )]
@attribute [Title( "#spawnmenu.tab.tools" )]
@attribute [Order( -100 )]

<root class="tab">

    <UIGroupedList Groups=@GetGroups() Selected=@(CurrentMode?.GetType()) OnSelect=@OnSelectTool>
        <Header>
            <div class="tool-shortcuts">
                @foreach ( var type in ToolbarTools )
                {
                    var tool = Game.TypeLibrary.GetType( type );
                    <Button class="tool-shortcut" Icon=@tool.Icon Tooltip=@tool.Title Active=@(CurrentMode?.GetType() == type) @onclick=@(() => SwitchMode( tool )) />
                }
            </div>
        </Header>
    </UIGroupedList>

    @{
        var mode = CurrentMode;
        var hasToolSettings = mode is not null and not SelectTool && HasSettings( mode );
    }
    <UISettingsPane class="@(mode is DuplicatorTool ? "dupe-inspector" : null)" Title=@GetTitle() Revision=@BuildHash() PresetMode=@(hasToolSettings ? mode : null)>
        <HeaderActions>
            @if ( mode is DuplicatorTool duplicator )
            {
                <UIButton Icon="save" Text="#spawnmenu.dupes.save_button" Disabled=@(!CanSaveDupe( duplicator )) @onclick=@(() => SaveDupe( duplicator )) />
            }
        </HeaderActions>
        <Body>
        @if ( mode is SelectTool )
        {
            <GameObjectInspector />
        }
        else if ( mode is DuplicatorTool dupeTool )
        {
            <DupesLocal Tool=@dupeTool @ref=LocalDupes />
        }
        else if ( mode is not null )
        {
            @if ( hasToolSettings )
            {
                <UISheet PropertyFilter="@UISheet.PropertiesAndButtons" Target="@mode"></UISheet>
            }
            else
            {
                <div class="note">#spawnmenu.tools.no_settings</div>
            }
        }
        else
        {
            <div class="note">#spawnmenu.tools.none_selected_hint</div>
        }
        </Body>
    </UISettingsPane>

</root>

@code
{
    [SkipHotload]
    static readonly Type[] ToolbarTools = [typeof( SelectTool ), typeof( WireTool ), typeof( DuplicatorTool ), typeof( RemoverTool )];

    ToolMode CurrentMode => Player.FindLocalPlayer()?.GetWeapon<Toolgun>()?.GetCurrentMode();

    int SelectionCount => CurrentMode is SelectTool ? Scene.Get<SpawnMenuHost>()?.SelectedObjects.Count ?? 0 : 0;

    DupesLocal LocalDupes;

    static bool CanSaveDupe( ToolMode mode ) => mode is DuplicatorTool { Active: true } duplicator && !string.IsNullOrWhiteSpace( duplicator.CopiedJson );

    void SaveDupe( DuplicatorTool duplicator )
    {
        if ( !CanSaveDupe( duplicator ) ) return;

        duplicator.Save();
        LocalDupes?.StateHasChanged();
    }

    protected override int BuildHash()
    {
        var mode = CurrentMode;
        return HashCode.Combine( mode, CanSaveDupe( mode ), SelectionCount, Game.Language.SelectedCode );
    }

    /// <summary>
    /// Whether the sheet would have a single row for this tool.
    /// </summary>
    public static bool HasSettings( ToolMode mode ) => Game.TypeLibrary.GetSerializedObject( mode ).Any( UISheet.PropertiesAndButtons );

    /// <summary>
    /// Groups the remaining tools and sorts them by their displayed names.
    /// </summary>
    List<UIGroupedList.ListGroup> GetGroups()
    {
        return Game.TypeLibrary.GetTypes<ToolMode>()
            .Where( x => !x.IsAbstract && !x.HasAttribute<HiddenToolMode>() && !ToolbarTools.Contains( x.TargetType ) )
            .GroupBy( x => x.Group )
            .OrderBy( x => LocalizedText.Resolve( x.Key ), StringComparer.CurrentCultureIgnoreCase )
            .Select( group => new UIGroupedList.ListGroup( group.Key, group
                .OrderBy( x => LocalizedText.Resolve( x.Title ), StringComparer.CurrentCultureIgnoreCase )
                .Select( x => new UIGroupedList.ListItem( x.Title, x.TargetType ) )
                .ToList() ) )
            .ToList();
    }

    string GetTitle()
    {
        if ( SelectionCount > 1 )
            return Game.Language.GetPhrase( "tool.select.selection_title", new() { { "count", SelectionCount } } );

        return CurrentMode?.Name ?? Game.Language.GetPhrase( "spawnmenu.tools.none_selected" );
    }

    void OnSelectTool( object value )
    {
        var type = Game.TypeLibrary.GetTypes<ToolMode>().FirstOrDefault( x => x.TargetType == (value as Type) );
        if ( type is not null ) SwitchMode( type );
    }

    void SwitchMode(TypeDescription t)
    {
        var localPlayer = Player.FindLocalPlayer();
        if ( localPlayer == null ) return;

        var inventory = localPlayer.GetComponent<PlayerInventory>();
        if ( !inventory.IsValid() ) return;

        inventory.SetToolMode( t.ClassName );
    }

    protected override void OnVisibilityChanged()
    {
        if ( !IsVisible )
        {
            CurrentMode?.SaveCookies();
        }
    }
}
