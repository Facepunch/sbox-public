@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    @if ( Content.Thumbnail is { } thumbnail )
    {
        <Image Texture=@thumbnail />
    }
    else
    {
        <IconPanel Text="content_copy" />
    }
</root>

@code
{
    /// <summary>
    /// The local dupe displayed by this card.
    /// </summary>
    public Storage.Entry Content;

    /// <summary>
    /// Refreshes the local list after this dupe is deleted.
    /// </summary>
    [Parameter] public Action OnDupeDeleted { get; set; }

    protected override void OnMouseDown( MousePanelEvent e )
    {
        if ( e.MouseButton == MouseButtons.Right )
        {
            var menu = new Sandbox.UI.Menu();

            menu.AddOption( "#spawnmenu.dupes.publish_to_workshop", "publish", Publish );

            SpawnlistData.PopulateContextMenu( menu, this, new SpawnlistItem
            {
                Ident = SpawnlistItem.MakeIdent( "dupe", Content.Id.ToString(), "local" ),
                Title = Content.GetMeta<string>( "name" ) ?? Game.Language.GetPhrase( "ui.dupe.untitled" ),
                Icon = null,
            }, allowCreateSpawnlist: false );

            menu.AddSeparator();
            menu.AddOption( "#spawnmenu.common.delete", "delete", () =>
            {
                Content.Delete();
                OnDupeDeleted?.Invoke();
            } );

            menu.Open( this, Popup.PositionMode.UnderMouse );
            return;
        }

        base.OnMouseDown( e );
    }

    void Publish()
    {
        var options = SandboxWorkshop.PublishOptions<DupeCategory>(
            Game.Language.GetPhrase( "spawnmenu.dupes.publish_title" ),
            SandboxWorkshop.DupeFilters(),
            Game.Language.GetPhrase( "spawnmenu.dupes.publish_category" ) );

        options.AddCategory<DupeMovement>( "Movement", Game.Language.GetPhrase( "spawnmenu.dupes.publish_movement" ) );
        Content.Publish( options );
    }
}
