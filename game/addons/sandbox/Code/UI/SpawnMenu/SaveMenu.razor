@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits Panel

<root>
    <SpawnMenuContent>
        <Header>
            <SpawnMenuToolbar>
                <Left>
                    <UIButton Icon="save" Text="#spawnmenu.saves.save_button" @onclick="@(() => WriteSave())" />
                </Left>
            </SpawnMenuToolbar>
        </Header>
        <Body>
            <div class="save-list">
                @if ( !SaveFiles.Any() )
                {
                    <SpawnMenuEmptyState Icon="save" Title="#spawnmenu.saves.empty" />
                }
                @foreach ( var save in SaveFiles )
                {
                    var s = save;
                    <div class="save-card @(!s.IsCompatible ? "outdated" : "")"
                         @onclick="@(() => LoadSave( s ))"
                         @onmousedown="@((PanelEvent e) => OnCardMouseDown( s, e ))">
                        <div class="save-preview save-detail">
                            @if ( s.Thumbnail != null )
                            {
                                <Image class="save-thumb" Texture="@s.Thumbnail" />
                            }
                            else
                            {
                                <IconPanel class="save-preview-placeholder" Text="image" />
                            }
                        </div>
                        <div class="save-info">
                            <label class="save-name save-detail">@s.DisplayName</label>
                            <div class="save-meta">
                                @if ( !string.IsNullOrEmpty( s.Timestamp ) )
                                {
                                    <label class="save-timestamp save-detail">@s.Timestamp</label>
                                }
                                @if ( !s.IsCompatible )
                                {
                                    <label class="save-outdated-badge">#spawnmenu.saves.outdated_badge</label>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </Body>
    </SpawnMenuContent>
</root>

@code
{
    List<SaveFileEntry> SaveFiles = new();

    record SaveFileEntry( string FileName, string DisplayName, string Timestamp, Texture Thumbnail, bool IsCompatible );
    static string SavesPath => "saves";
    static string ThumbnailPath( string fileName ) => $"{SavesPath}/{System.IO.Path.ChangeExtension( fileName, "thumb.png" )}";

    protected override void OnAfterTreeRender ( bool firstTime )
    {
        if ( firstTime )
        {
            RefreshSaveList();
        }
    }

    void RefreshSaveList()
    {
        SaveFiles.Clear();

        if ( !FileSystem.Data.DirectoryExists( SavesPath ) )
        {
            FileSystem.Data.CreateDirectory( SavesPath );
        }

        foreach ( var file in FileSystem.Data.FindFile( SavesPath, "*.sav" ) )
        {
            var filePath = $"{SavesPath}/{file}";
            var displayName = file;
            string timestamp = null;
            Texture thumbnail = null;

            var metadata = SaveSystem.GetFileMetadata( filePath );
            if ( metadata != null )
            {
                if ( metadata.TryGetValue( "Title", out var name ) )
                    displayName = name;
                if ( metadata.TryGetValue( "Timestamp", out var ts ) )
                    timestamp = ts;
            }

            var isCompatible = SaveSystem.GetFileSaveVersion( filePath ) == SaveSystem.SaveVersion;

            var thumbPath = ThumbnailPath( file );
            if ( FileSystem.Data.FileExists( thumbPath ) )
            {
                // An overwrite can change the image at the same path.
                using var bitmap = Bitmap.CreateFromBytes( FileSystem.Data.ReadAllBytes( thumbPath ).ToArray() );
                // The list keeps a texture for every save. Keep the full-resolution screenshot on disk for publishing.
                using var small = bitmap is { Width: > 320 }
                    ? bitmap.Resize( 320, Math.Max( 1, 320 * bitmap.Height / bitmap.Width ) )
                    : null;
                thumbnail = (small ?? bitmap)?.ToTexture( false );
            }

            SaveFiles.Add( new SaveFileEntry( file, displayName, timestamp, thumbnail, isCompatible ) );
        }

        StateHasChanged();
    }

    void OnCardMouseDown( SaveFileEntry save, PanelEvent e )
    {
        if ( !Networking.IsHost ) return;

        if ( e is MousePanelEvent { MouseButton: MouseButtons.Right } me )
        {
            me.StopPropagation();

            var menu = new Sandbox.UI.Menu();
            menu.AddOption( "#spawnmenu.saves.load_context", "download", () => LoadSave( save ) );
            menu.AddOption( "#spawnmenu.saves.overwrite", "save", () => WriteSave( save ) );
            if ( save.IsCompatible )
            {
                menu.AddOption( "#spawnmenu.dupes.publish_to_workshop", "publish", () => _ = PublishSave( save ) );
            }

            menu.AddOption( "#spawnmenu.saves.delete_context", "delete", () => DeleteSave( save.FileName ) );

            menu.Open( this, Popup.PositionMode.UnderMouse );
        }
    }

    void LoadSave( SaveFileEntry save )
    {
        if ( !save.IsCompatible )
        {
            var message = Game.Language.GetPhrase( "spawnmenu.saves.incompatible_message", new() { { "name", save.DisplayName.HtmlEncode() } } );
            Notices.AddNotice( "error", message );
            return;
        }

        _ = SavesPage.Load( this, system => system.Load( $"{SavesPath}/{save.FileName}" ) );
    }

    void WriteSave( SaveFileEntry existing = null )
    {
        if ( !Networking.IsHost ) return;

        var now = DateTime.Now;
        var fileName = existing?.FileName ?? $"{now:yyyy-MM-dd-HH-mm-ss}-{Guid.NewGuid():N}.sav";
        var title = existing?.DisplayName ?? Game.Language.GetPhrase( "spawnmenu.saves.default_name", new() { { "time", now.ToString( "yyyy-MM-dd HH:mm" ) } } );

        var system = SaveSystem.Current;
        system.SetMetadata( "Timestamp", now.ToString( "yyyy-MM-dd HH:mm:ss" ) );
        system.SetMetadata( "Title", title );
        if ( !system.Save( $"{SavesPath}/{fileName}" ) ) return;

        var thumbPath = ThumbnailPath( fileName );
        var camera = Game.ActiveScene?.Camera;
        if ( camera.IsValid() )
        {
            using var bitmap = SandboxWorkshop.CreatePreview();
            camera.RenderToBitmap( bitmap, renderUI: false );
            FileSystem.Data.WriteAllBytes( thumbPath, bitmap.ToPng() );
        }
        else if ( FileSystem.Data.FileExists( thumbPath ) )
        {
            FileSystem.Data.DeleteFile( thumbPath );
        }

        RefreshSaveList();
    }

    static Storage.Entry FindPublication( string fileName )
    {
        return Storage.GetAll( "save" ).FirstOrDefault( x => x.GetMeta<string>( "filename" ) == fileName );
    }

    bool preparingPublication;

    async Task PublishSave( SaveFileEntry save )
    {
        if ( !Networking.IsHost || preparingPublication ) return;

        preparingPublication = true;
        try
        {
            var entry = FindPublication( save.FileName );
            Storage.QueryItem published = null;
            var id = entry?.GetMeta<ulong>( "_workshopId" ) ?? 0;
            if ( id != 0 )
            {
                var result = await new Storage.Query { FileIds = [id] }.Run();
                if ( !this.IsValid() || !Networking.IsHost ) return;

                published = result?.Items?.FirstOrDefault( x => x.Id == id );
                if ( published is null )
                {
                    ShowPublishError();
                    return;
                }
            }

            var json = FileSystem.Data.ReadAllText( $"{SavesPath}/{save.FileName}" );
            var map = SaveSystem.GetSavedMap( json );
            if ( string.IsNullOrWhiteSpace( map ) )
            {
                ShowPublishError();
                return;
            }

            if ( entry is null )
            {
                Storage.CreateEntry( "save" ).SetMeta( "filename", save.FileName );
                // Publish the cached entry so subsequent edits see the ID that Steam assigns.
                entry = FindPublication( save.FileName );
            }

            entry.Files.WriteAllText( SaveSystem.WorkshopFileName, json );

            var thumb = ThumbnailPath( save.FileName );
            if ( FileSystem.Data.FileExists( thumb ) )
            {
                entry.Files.WriteAllBytes( "_thumb.png", FileSystem.Data.ReadAllBytes( thumb ).ToArray() );
            }
            else if ( entry.Files.FileExists( "_thumb.png" ) )
            {
                entry.Files.DeleteFile( "_thumb.png" );
            }

            var category = published?.KeyValues?.GetValueOrDefault( "Category" ) ?? nameof( SaveCategory.Build );
            var options = SandboxWorkshop.PublishOptions<SaveCategory>(
                published?.Title ?? save.DisplayName, SandboxWorkshop.SaveFilters( map, category ) );
            options.Description = published?.Description;
            options.Visibility = published is null ? Storage.Visibility.Public : (Storage.Visibility)published.Visibility;
            entry.Publish( options );
        }
        catch ( Exception e )
        {
            Log.Warning( $"Couldn't publish save '{save.FileName}': {e.Message}" );
            ShowPublishError();
        }
        finally
        {
            preparingPublication = false;
        }
    }

    void ShowPublishError()
    {
        Notices.AddNotice( "error", Game.Language.GetPhrase( "spawnmenu.saves.publish_failed" ) );
    }

    void DeleteSave( string fileName )
    {
        if ( !Networking.IsHost ) return;

        FindPublication( fileName )?.Delete();
        FileSystem.Data.DeleteFile( $"{SavesPath}/{fileName}" );
        var thumbPath = ThumbnailPath( fileName );
        if ( FileSystem.Data.FileExists( thumbPath ) )
            FileSystem.Data.DeleteFile( thumbPath );
        RefreshSaveList();
    }
}
