@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<SpawnMenuToolbar>
    <Left>
        <SpawnMenuSearchEntry Value:bind=@Filter />
    </Left>
    <Right>
        <ButtonGroup class="workshop-sort" Value=@SortOrder ValueChanged=@OnSortChanged Tooltip="#ui.sort_order">
            <ChildContent>
                @foreach ( var (mode, info) in DisplayInfo.ForEnumValues<WorkshopSortMode>() )
                {
                    <Button Text=@info.Name Value=@mode />
                }
            </ChildContent>
        </ButtonGroup>
    </Right>
</SpawnMenuToolbar>

@code
{
    /// <summary>
    /// Search text bound to the workshop page's filter.
    /// </summary>
    [Parameter] public string Filter { get; set; }

    /// <summary>
    /// Sort order bound to the workshop page's query.
    /// </summary>
    [Parameter] public WorkshopSortMode SortOrder { get; set; }

    void OnSortChanged( object value )
    {
        if ( value is WorkshopSortMode mode )
            SortOrder = mode;
    }
}
