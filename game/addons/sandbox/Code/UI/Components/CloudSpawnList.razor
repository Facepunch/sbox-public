@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<SpawnMenuContent>

    <Header>
        <SpawnMenuToolbar>
            <Left>
                <SpawnMenuSearchEntry Value:bind=@Filter />
            </Left>

            <Right>
                <UIDropdown class="big sort" Items=@SortItems Value=@SortOrder ValueChanged=@OnSortChanged Tooltip="#ui.sort_order" />
            </Right>
        </SpawnMenuToolbar>
    </Header>

    <Body>
        @if ( Packages.Count == 0 && (Loading || _waitingForViewModels) )
        {
            <UILoadingState />
        }
        else if ( Packages.Count == 0 )
        {
            <SpawnMenuEmptyState Icon="search_off" Subtitle="#spawnmenu.empty.try_another_category" />
        }
        else
        {
            <MixedVirtualGrid @ref=Grid Items=@Packages OnLastCell=@LoadMore ItemSize=@IconSize.ItemSize() class="@IconSize.CssClass() labeled-grid">
                <Item Context="item">
                    @if ( item is Package package )
                    {
                        <SpawnMenuIcon class="@(package.Public ? "" : "hidden-package")"
                            Ident=@PackageIdent(package) Title=@package.Title HideText=@(IconSize == SpawnMenuIconSize.Small) Tooltip=@(IconSize == SpawnMenuIconSize.Small ? package.Title : "") />
                    }
                </Item>
            </MixedVirtualGrid>
        }
    </Body>

</SpawnMenuContent>

@code
{
    protected string Filter
    {
        get;
        set { field = value; Rebuild(); }
    }

    /// <summary>
    /// Workshop ranking used for the package search.
    /// </summary>
    public PackageSortMode SortOrder
    {
        get;
        set { field = value; Rebuild(); }
    } = PackageSortMode.Popular;

    protected override void OnParametersSet()
    {
        Rebuild();
    }

    const int PageSize = 200;
    readonly List<Package> Packages = [];
    readonly HashSet<string> PackageIds = new( StringComparer.OrdinalIgnoreCase );
    string _query;
    int _offset;
    bool _hasMore;
    bool Loading;
    bool _waitingForViewModels;
    int _rebuildVersion;

    SpawnMenuIconSize IconSize => SpawnMenuIconSizeExtensions.Current;
    SpawnMenuIconSize _lastIconSize = SpawnMenuIconSizeExtensions.Current;
    MixedVirtualGrid Grid;

    void OnIconSizeChanged()
    {
        _lastIconSize = IconSize;

        // the tiles' text and tooltip depend on the size
        if ( Grid.IsValid() )
            Grid.RecreateCells();

        StateHasChanged();
    }

    List<UIDropdown.Item> SortItems => UIDropdown.ForEnum<PackageSortMode>();

    void OnSortChanged( object value )
    {
        if ( value is PackageSortMode mode )
            SortOrder = mode;
    }

    public override void Tick()
    {
        base.Tick();

        if ( _waitingForViewModels )
        {
            _ = SpawnMenuModels.LoadViewModels();
            if ( SpawnMenuModels.ViewModels is not null )
                LoadMore();
        }

        if ( _lastIconSize != IconSize )
            OnIconSizeChanged();
    }

    void Rebuild()
    {
        var query = $"sort:{SortOrder.ToIdentifier()} type:{PackageType}";
        if ( !string.IsNullOrEmpty( Filter ) ) query += $" {Filter}";
        if ( !string.IsNullOrEmpty( PackageQuery ) ) query += $" {PackageQuery}";
        if ( query == _query ) return;

        _query = query;
        _rebuildVersion++;
        _offset = 0;
        _hasMore = true;
        Loading = false;
        _waitingForViewModels = false;
        Packages.Clear();
        PackageIds.Clear();

        if ( Grid.IsValid() ) Grid.ScrollOffset = Vector2.Zero;

        LoadMore();
        StateHasChanged();
    }

    async void LoadMore()
    {
        if ( Loading || !_hasMore ) return;

        Loading = true;
        var version = _rebuildVersion;
        var previousCount = Packages.Count;

        if ( PackageType == "model" )
        {
            await SpawnMenuModels.LoadViewModels();
            if ( version != _rebuildVersion || !IsValid ) return;

            _waitingForViewModels = SpawnMenuModels.ViewModels is null;
            if ( _waitingForViewModels )
            {
                Loading = false;
                return;
            }
        }

        // Rankings can shift between requests. Advance by the raw page size even when models overlap.
        do
        {
            var result = await Package.FindAsync( _query, PageSize, _offset );
            if ( version != _rebuildVersion || !IsValid ) return;

            var page = result.Packages;
            _offset += page.Length;
            _hasMore = page.Length > 0 && _offset < result.TotalCount;
            foreach ( var package in page )
            {
                if ( package.TypeName == "model" && SpawnMenuModels.ViewModels?.Contains( package.FullIdent ) == true )
                    continue;

                if ( PackageIds.Add( package.FullIdent ) )
                    Packages.Add( package );
            }
        }
        while ( _hasMore && Packages.Count == previousCount );

        Loading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Value of the "type:" term in the package search, e.g. "model".
    /// </summary>
    protected virtual string PackageType => "";

    /// <summary>
    /// Extra terms appended to the package search.
    /// </summary>
    protected virtual string PackageQuery => null;

    /// <summary>
    /// Build the spawn ident for a cloud package.
    /// </summary>
    protected virtual string PackageIdent( Package package ) => $"{package.TypeName}:{package.FullIdent}";
}
