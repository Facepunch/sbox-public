@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    <div class="label @(Strength > 0f ? "active" : "")">@Title</div>
    <div class="sliders">
        <SliderControl Property=@_so?.GetProperty(nameof(Strength)) />
        @if (IsPaired)
        {
            <SliderControl Property=@_so?.GetProperty(nameof(Side)) Fill=@SliderFill.Center />
        }
    </div>
</root>

@code
{
    /// <summary>
    /// Renderer whose morph weights the sliders edit.
    /// </summary>
    [Parameter] public SkinnedModelRenderer Target { get; set; }

    /// <summary>
    /// Morph to edit, or the left morph for a paired control.
    /// </summary>
    [Parameter] public string NameA { get; set; }

    /// <summary>
    /// Right morph for a paired control.
    /// </summary>
    [Parameter] public string NameB { get; set; }

    /// <summary>
    /// Label shown beside the sliders.
    /// </summary>
    [Parameter] public string Title { get; set; }

    /// <summary>
    /// Reports each changed weight to the owning editor.
    /// </summary>
    [Parameter] public Action<string, float> OnMorphChanged { get; set; }

    bool IsPaired => NameB != null;

    SerializedObject _so;

    /// <summary>
    /// Weight of the stronger side, or of the single morph.
    /// </summary>
    [Range(0f, 1f), Step(0.01f)]
    public float Strength
    {
        get
        {
            if ( !Target.IsValid() || !Target.SceneModel.IsValid() ) return 0f;

            var morphs = Target.SceneModel.Morphs;
            return MathF.Max( morphs.Get( NameA ), IsPaired ? morphs.Get( NameB ) : 0f );
        }
        set
        {
            if ( !Target.IsValid() ) return;

            if ( IsPaired )
            {
                SetPair( value, Side );
            }
            else
            {
                SetMorph( NameA, value );
            }
        }
    }

    /// <summary>
    /// Balance of a paired morph, from fully right to fully left.
    /// </summary>
    [Range(-1f, 1f), Step(0.01f)]
    public float Side
    {
        get
        {
            if ( !Target.IsValid() || !IsPaired ) return 0f;

            var morphs = Target.SceneModel.Morphs;
            var left = morphs.Get( NameA );
            var right = morphs.Get( NameB );
            if ( left > right ) return 1f - right / left;
            if ( right > left ) return left / right - 1f;
            return 0f;
        }
        set
        {
            if ( Target.IsValid() && IsPaired ) SetPair( Strength, value );
        }
    }

    void SetPair( float strength, float balance )
    {
        var (left, right) = FacePoseMorphs.SplitStrength( strength, balance );
        SetMorph( NameA, left );
        SetMorph( NameB, right );
    }

    void SetMorph( string name, float value )
    {
        Target.SceneModel.Morphs.Set( name, value, 0f );
        OnMorphChanged?.Invoke( name, value );
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _so ??= TypeLibrary.GetSerializedObject(this);
    }

    protected override int BuildHash() => HashCode.Combine(Target, NameA, NameB);
}
