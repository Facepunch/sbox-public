@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    @if ( Target.IsValid() )
    {
        <FacePosePreview Editor=@this @ref=_preview />
    }
    <div class="pose-actions">
        <UIButton Text="#ui.common.reset" Icon="restart_alt" onclick=@ClearAll />
        <UIButton Text="#ui.common.randomize" Icon="casino" onclick=@Randomize />
    </div>
    <div class="morph-columns">
        <label>Strength</label>
        <label>Balance (Right ↔ Left)</label>
    </div>
    @foreach ( var group in BuildGroups() )
    {
        <div class="group-header">@group.Key</div>
        @foreach ( var row in group )
        {
            <FacePoseMorphRow Target=@Target
                              NameA=@row.NameA
                              NameB=@row.NameB
                              Title=@row.Title
                              OnMorphChanged=@QueueMorphChange />
        }
    }
</root>

@code
{
    internal SkinnedModelRenderer Target { get; private set; }
    internal FacePoser Tool { get; set; }

    FacePosePreview _preview;

    void QueueMorphChange( string name, float value )
    {
        if ( _preview.IsValid() ) _preview.SetMorph( Target, name, value );
        if ( Tool.IsValid() ) Tool.EditMorph( Target, name, value );
    }

    internal void SetMorph( string name, float value )
    {
        Target.SceneModel.Morphs.Set( name, value, 0f );
        QueueMorphChange( name, value );
    }

    /// <summary>
    /// Refreshes the portrait and controls when the tool changes its draft renderer.
    /// </summary>
    public override void Tick()
    {
        var draft = Tool.IsValid() ? Tool.EditableFace : null;
        if ( draft == Target ) return;

        Target = draft;
        StateHasChanged();
    }

    record MorphRow(string NameA, string NameB, string Title);

    List<MorphRow> BuildRows()
    {
        if (Target?.Morphs?.Names is not { Length: > 0 } names)
            return new();

        var rows = new List<MorphRow>();
        var byName = names.ToDictionary( n => n, StringComparer.OrdinalIgnoreCase );
        var paired = new HashSet<string>( StringComparer.OrdinalIgnoreCase );
        foreach ( var name in names )
        {
            var longSide = name.EndsWith( "_left", StringComparison.OrdinalIgnoreCase );
            if ( !longSide && !name.EndsWith( "L", StringComparison.OrdinalIgnoreCase ) ) continue;
            var stem = longSide ? name[..^5] : name[..^1];
            if ( !byName.TryGetValue( stem + (longSide ? "_right" : "R"), out var right ) ) continue;
            var title = longSide && stem is "upper" or "lower" ? $"Raise {stem} eyelid" : FormatTitle( stem.TrimEnd( '_' ) );
            rows.Add( new( name, right, title ) );
            paired.Add( name );
            paired.Add( right );
        }

        foreach (var name in names.Where( n => !paired.Contains( n ) ))
            rows.Add(new MorphRow(name, null, FormatTitle(name)));

        return rows;
    }

    IEnumerable<IGrouping<string, MorphRow>> BuildGroups() => BuildRows()
        .GroupBy( row => GetGroup( row.Title ) )
        .OrderBy( group => LocalizedText.Resolve( group.Key ), StringComparer.CurrentCultureIgnoreCase );

    void ClearAll()
    {
        if (!Target.IsValid() || Target.Morphs?.Names == null) return;

        ApplyExpression( new() );
    }

    void Randomize()
    {
        if (!Target.IsValid() || Target.Morphs?.Names is not { Length: > 0 }) return;

        var morphs = new Dictionary<string, float>();

        foreach (var row in BuildRows())
        {
            if (row.NameB != null)
            {
                (morphs[row.NameA], morphs[row.NameB]) = FacePoseMorphs.SplitStrength( Random.Shared.Float( 0, 1 ), Random.Shared.Float( -1, 1 ) );
            }
            else
            {
                morphs[row.NameA] = Random.Shared.Float(0, 1);
            }
        }

        ApplyExpression( morphs );
    }

    internal void ApplyExpression( Dictionary<string, float> morphs )
    {
        if ( !Tool.IsValid() || !Target.IsValid() ) return;

        Tool.Pose = new( morphs );
        StateHasChanged();
    }

    static string FormatTitle(string name)
    {
        // The Source mount exposes mesh flex descriptors. Keep their names in the
        // saved pose and translate the action units only for the slider labels.
        var sourceTitle = name switch
        {
            "AU1" => "Raise inner brow",
            "AU2" => "Raise outer brow",
            "AU1AU2" => "Raise whole brow",
            "AU4" => "Lower brow",
            "AU42" => "Narrow eyes",
            "AU6" => "Raise cheek",
            "AU9" => "Wrinkle nose",
            "AU38" => "Flare nostrils",
            "AU10" => "Raise upper lip",
            "AU12" => "Smile",
            "AU12AU25" => "Open-mouth smile",
            "AU15" => "Frown",
            "AU16" => "Lower bottom lip",
            "AU17" => "Raise chin",
            "AU18" => "Pucker lips",
            "AU20" => "Stretch lips",
            "AU22" => "Funnel lips",
            "AU24" => "Press lips",
            "AU25" => "Part lips",
            "AU26" => "Drop jaw",
            "AU26Z" => "Drop jaw (alternate)",
            "AU27" => "Stretch mouth",
            "AU27Z" => "Stretch mouth (alternate)",
            "AU31" => "Clench jaw",
            "AU32" => "Bite lip",
            _ => null
        };
        if ( sourceTitle is not null ) return sourceTitle;
        name = name.Replace("lower", "Lower").Replace("upper", "Upper")
        .Replace("raiser", "Raiser").Replace("inflate", "Inflate")
        .Replace("bulge", "Bulge").Replace("suck", "Suck")
        .Replace("thrust", "Thrust").Replace("sideways", "Sideways")
        .Replace("depressor", "Depressor").Replace("corner", "Corner")
        .Replace("puller", "Puller").Replace("pucker", "Pucker")
        .Replace("wrinkle", "Wrinkle").Replace("jaw", "Jaw")
        .Replace("mouth", "Mouth");
        return name.ToTitleCase();
    }

    static string GetGroup(string title)
    {
        if ( title is "Smile" or "Frown" ) return "#ui.faceposer.group.mouth";
        if (title.Contains("brow", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.eyes";
        if (title.Contains("eye", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.eyes";
        if (title.Contains("cheek", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.face";
        if (title.Contains("nose", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.face";
        if (title.Contains("nostril", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.face";
        if (title.Contains("chin", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.face";
        if (title.Contains("jaw", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.mouth";
        if (title.Contains("lip", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.mouth";
        if (title.Contains("mouth", StringComparison.OrdinalIgnoreCase)) return "#ui.faceposer.group.mouth";
        return "#ui.faceposer.group.misc";
    }

    protected override int BuildHash() => HashCode.Combine( Target, Target?.Model );
}
