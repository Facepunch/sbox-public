@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    <div class="list">
        @foreach ( var group in _groups )
        {
            <div class="group">
                <div class="group-header">
                    <Label Text="@(group.Key)" />
                </div>

                <div class="group-items">
                    @foreach ( var entry in group )
                    {
                        var path = entry.ClassName;
                        var enabled = _manager?.IsEnabled( path ) ?? false;
                        var selected = _manager?.SelectedPath == path;

                        <button class="item @( selected ? "selected" : "" )"
                                Tooltip="@(PostProcessManager.MenuTitle( entry ))"
                                @onclick="@(() => OnClick( entry ))"
                                @onmouseenter="@(() => _manager?.Preview( path ))"
                                @onmouseleave="@(() => _manager?.Unpreview())">
                            <Label Text="@(PostProcessManager.MenuTitle( entry ))" />
                            <SwitchControl class="compact" Value=@enabled OnValueChanged=@((bool _) => OnToggle( entry )) />
                        </button>
                    }
                </div>
            </div>
        }

        @if ( !_groups.Any() )
        {
            <div class="empty-state">#spawnmenu.effects.no_installed</div>
        }
    </div>
</root>

@code
{
    PostProcessManager _manager;
    IGrouping<string, TypeDescription>[] _groups = [];

    int _revision = -1;

    /// <summary>
    /// Refreshes an open menu when an effect is added, edited or unloaded.
    /// </summary>
    public override void Tick()
    {
        base.Tick();
        _manager ??= Game.ActiveScene.GetSystem<PostProcessManager>();
        if ( _manager.CatalogRevision != _revision ) RefreshInstalled();
    }

    void RefreshInstalled()
    {
        if ( _manager is null ) return;
        _revision = _manager.CatalogRevision;
        _groups = _manager.MenuGroups();
        StateHasChanged();
    }

    /// <summary>
    /// Sorts installed effects by their translated names after a language change.
    /// </summary>
    public override void LanguageChanged()
    {
        base.LanguageChanged();
        RefreshInstalled();
        StateHasChanged();
    }

    void OnClick( TypeDescription entry )
    {
        _manager?.Select( entry.ClassName );
        StateHasChanged();
    }

    void OnToggle( TypeDescription entry )
    {
        _manager?.Toggle( entry.ClassName );
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( _manager?.SelectedPath );
        hash.Add( _revision );

        foreach ( var group in _groups )
            foreach ( var entry in group )
                hash.Add( _manager?.IsEnabled( entry.ClassName ) ?? false );

        return hash.ToHashCode();
    }
}
