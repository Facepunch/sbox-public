@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    <div class="list">
        @foreach ( var group in _groups )
        {
            <div class="group">
                <div class="group-header">
                    <Label Text="@(DisplayInfo.ForEnumValues<PostProcessGroup>().FirstOrDefault( entry => entry.value == group.Key ).info.Name)" />
                </div>

                <div class="group-items">
                    @foreach ( var entry in group )
                    {
                        var path = entry.ResourcePath;
                        var enabled = _manager?.IsEnabled( path ) ?? false;
                        var selected = _manager?.SelectedPath == path;

                        <button class="item @( selected ? "selected" : "" )"
                                Tooltip="@entry.Title"
                                @onclick="@(() => OnClick( entry ))"
                                @onmouseenter="@(() => _manager?.Preview( path ))"
                                @onmouseleave="@(() => _manager?.Unpreview())">
                            <UICheckbox Value=@enabled OnValueChanged=@((bool _) => OnToggle( entry )) />
                            <Label Text="@entry.Title" />
                        </button>
                    }
                </div>
            </div>
        }

        @if ( !_groups.Any() )
        {
            <div class="empty-state">#spawnmenu.effects.no_installed</div>
        }
    </div>
</root>

@code
{
    PostProcessManager _manager;
    IGrouping<PostProcessGroup, PostProcessResource>[] _groups = [];

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( !firstTime ) return;

        _manager = Game.ActiveScene.GetSystem<PostProcessManager>();
        RefreshInstalled();
        StateHasChanged();
    }

    void RefreshInstalled()
    {
        _groups = ResourceLibrary.GetAll<PostProcessResource>()
            .Where( r => !r.IsRemote )
            .OrderBy( r => r.Group )
            .ThenBy( r => LocalizedText.Resolve( r.Title ), StringComparer.CurrentCultureIgnoreCase )
            .GroupBy( r => r.Group )
            .ToArray();
    }

    /// <summary>
    /// Sorts installed effects by their translated names after a language change.
    /// </summary>
    public override void LanguageChanged()
    {
        base.LanguageChanged();
        RefreshInstalled();
        StateHasChanged();
    }

    void OnClick( PostProcessResource entry )
    {
        _manager?.Select( entry.ResourcePath );
        StateHasChanged();
    }

    void OnToggle( PostProcessResource entry )
    {
        _manager?.Toggle( entry.ResourcePath );
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( _manager?.SelectedPath );

        foreach ( var group in _groups )
            foreach ( var entry in group )
                hash.Add( _manager?.IsEnabled( entry.ResourcePath ) ?? false );

        return hash.ToHashCode();
    }
}
