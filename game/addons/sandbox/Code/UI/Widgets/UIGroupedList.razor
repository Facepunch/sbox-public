@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox

<root>
    @Header

    <div class="list">
        @{ var groups = VisibleGroups().ToList(); }
        @if ( groups.Count == 0 && !string.IsNullOrWhiteSpace( Filter ) )
        {
            <SpawnMenuEmptyState />
        }
        @foreach ( var group in groups )
        {
            <div class="group">
                @if ( !string.IsNullOrWhiteSpace( group.Title ) )
                {
                    <div class="group-header">
                        <Label Text="@group.Title" />
                    </div>
                }

                <div class="group-items">
                    @foreach ( var item in group.Items )
                    {
                        <button class="item @(Equals( item.Value, Selected ) ? "selected" : "")" @onclick=@( () => OnSelect?.Invoke( item.Value ) )>
                            <Label Tokenize=@item.Tokenize Text="@item.Title" />
                        </button>
                    }
                </div>
            </div>
        }
    </div>

</root>

@code
{
    /// <summary>
    /// A selectable entry. The title can be a localization token.
    /// </summary>
    public record ListItem( string Title, object Value, bool Tokenize = true );

    /// <summary>
    /// A group heading and its selectable entries.
    /// </summary>
    public record ListGroup( string Title, List<ListItem> Items );

    /// <summary>
    /// Optional controls that stay above the scrolling list.
    /// </summary>
    [Parameter] public RenderFragment Header { get; set; }

    [Parameter] public List<ListGroup> Groups { get; set; } = new();

    /// <summary>
    /// The value of the entry that's highlighted.
    /// </summary>
    [Parameter] public object Selected { get; set; }

    [Parameter] public Action<object> OnSelect { get; set; }

    /// <summary>
    /// Bump this when the groups changed in a way their item count does not show (titles, order, values), to make the list build again.
    /// </summary>
    [Parameter] public int Revision { get; set; }

    /// <summary>
    /// Only show entries whose displayed title contains this text.
    /// </summary>
    [Parameter] public string Filter { get; set; }

    /// <summary>
    /// Gets the matching entries under each nonempty group.
    /// </summary>
    IEnumerable<ListGroup> VisibleGroups()
    {
        if ( Groups is null ) yield break;

        foreach ( var group in Groups )
        {
            var items = string.IsNullOrWhiteSpace( Filter )
                ? group.Items
                : group.Items.Where( x => Matches( x.Tokenize ? LocalizedText.Resolve( x.Title ) : x.Title ) ).ToList();

            if ( items.Count == 0 ) continue;

            yield return group with { Items = items };
        }
    }

    bool Matches( string text ) => text is not null && text.Contains( Filter.Trim(), StringComparison.CurrentCultureIgnoreCase );

    protected override int BuildHash()
    {
        var count = 0;
        if ( Groups is not null )
        {
            foreach ( var group in Groups ) count += group.Items.Count + 1;
        }

        return HashCode.Combine( Selected, Filter, count, Game.Language.SelectedCode, Revision );
    }
}
